FodyWeavers.xsd

# VS Code files for those working on multiple tools
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# Windows Installer files from build outputs
*.cab
*.msi
*.msix
*.msm
*.msp

# JetBrains Rider
*.sln.iml
.idea/
.jwt-key-dev

# SSH target for remote agent tunnel (machine-specific)
.remoteagent

# Performance baseline (local artifact, regenerated per run)
perf-baseline.json

astr
.playwright-mcp/*

# Runtime data (backend creates these at startup — target subdirs, not Data/ itself
# which also contains source code: Entities/, Migrations/, etc.)
src/Aetheus.Back/Data/git-repos/
src/Aetheus.Back/Data/artifacts/
.playwright-mcp


**/wwwroot/downloads/*

# Deployment config (version + secrets) shared between deploy.sh and launch-linux.sh
.env-prod
.env-accept
# Legacy local version tracking — kept for one release cycle for migration
.agent-version

**/git-repos/**
**/git-reposcopie/**
src/Aetheus.Back/Data/git-repos/1/jiji.git/config

# Claude Code agent worktrees (embedded git repos — must never be committed)
.claude/worktrees/
# Codex/local agent worktrees (embedded git repos — must never be committed)
.worktrees/
# Claude Code transient harness locks (never project content)
.claude/*.lock
# Transient marker for the relaunch-on-code-change Stop hook
.claude/.needs-relaunch
# Transient output captured by local UI launcher checks
/.ui-launch-pwsh.out
/.ui-launch-pwsh.err
# Transient guard: suppresses the backend relaunch during long self-deploy pipeline runs (per-checkout, local only)
.claude/.pipelines-running
.claude/.next-progress

# Generated dashboards are disposable renderings; dated Markdown audit sources are canonical.
/.claude/audit-report.html
/.claude/backlog-report.html
/.claude/plan-report.html

*.lscache

# Deploy backups (pg_dump snapshots created by deploy.sh)
backups/
deploy/snapshots/
# ...but never swallow hand-written source folders named "Backups" (PLAN-006 4.3 app-backup feature).
# Scoped to src/ and tests/ so the root/deploy "backups/" snapshot dirs stay ignored.
!src/**/Backups/
!tests/**/Backups/

# Local-only appsettings overrides (F-028)
**/appsettings.*.local.json

# Per-worktree ylaunch port overrides + the front ApiBaseUrl override it generates
# (lets a second worktree run the stack on its own ports — see ylaunch .ylaunch.local)
.ylaunch.local
src/Aetheus.Front/wwwroot/appsettings.Development.json

# Development appsettings contain well-known dev-only secrets — override via user-secrets
src/Aetheus.Back/appsettings.Development.json
src/Aetheus.Agent.Windows/appsettings.Development.json

# Scratch verification screenshots — keep deliberate ones under .claude/screenshots/ and real
# app assets under src/. Root-level captures and the E2E capture/ grid are transient.
/*.png
/*.jpeg
/*.jpg
/capture/

# Local pinned SDK installed for repository verification; never publish the runtime payload.
/.dotnet/

# Per-checkout process markers created by local Codex/launcher verification.
/.codex-runtime/

# Host publish consumed by deploy/docker/Dockerfile.back and Dockerfile.front; a build output,
# never a source, and large enough that committing it would be an accident nobody notices.
/.pipeline-publish/

# Coverage dumps of a 360 audit weigh tens of MB; the Markdown registers are the canonical evidence.
/.claude/audit/*/artefacts/metrics/coverage/
# Every other tool output of an audit (json/trx/diag reports, harness projects and their lock files) is
# regenerable and was scanned as product dependencies by the candidate security gate (run 2421); only
# the Markdown registers and the harness sources (.cs) under artefacts/ stay versioned.
/.claude/audit/*/artefacts/**
!/.claude/audit/*/artefacts/**/
!/.claude/audit/*/artefacts/**/*.md
!/.claude/audit/*/artefacts/**/*.cs
# Generated build intermediates of those harness projects are never sources.
/.claude/audit/*/artefacts/**/obj/
/.claude/audit/*/artefacts/**/bin/
# Raw shard dumps of the security audit; its Markdown registers are the canonical record.
/.claude/audit-secu/raw/
/.claude/audit-secu/raw2/
