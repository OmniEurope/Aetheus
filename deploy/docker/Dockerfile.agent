# =============================================================================
# Dockerfile - Aetheus Agent (.NET 10 Worker Service)
# =============================================================================
# NOTE: not referenced by any compose file — the agent normally installs onto a host via
# install-agent-linux.sh, not as a container. Kept for containerized agent smoke-testing. The build
# below is Central-Package-Management aware: Directory.Packages.props / Directory.Build.props /
# NuGet.config MUST be present before `dotnet restore`, or restore fails (PackageReference entries
# carry no Version=). The csproj files sit one level below these props (/src/<proj>), so MSBuild walks
# up to /src and finds them there.
# =============================================================================
FROM mcr.microsoft.com/dotnet/sdk:10.0.403@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b AS build
WORKDIR /src

# CPM + build conventions — required for restore to resolve centrally-managed versions.
COPY Directory.Packages.props Directory.Build.props NuGet.config ./
COPY scanner-manifest.json /scanner-manifest.json
COPY .aetheus/security-rules/opengrep/ /.aetheus/security-rules/opengrep/

COPY src/Aetheus.Shared/Aetheus.Shared.csproj Aetheus.Shared/
COPY src/Aetheus.Analyzers/Aetheus.Analyzers.csproj Aetheus.Analyzers/
COPY src/Aetheus.Agent.Core/Aetheus.Agent.Core.csproj Aetheus.Agent.Core/
COPY src/Aetheus.Agent.Linux/Aetheus.Agent.Linux.csproj Aetheus.Agent.Linux/
RUN dotnet restore Aetheus.Agent.Linux/Aetheus.Agent.Linux.csproj

COPY src/Aetheus.Shared/ Aetheus.Shared/
COPY src/Aetheus.Analyzers/ Aetheus.Analyzers/
COPY src/Aetheus.Agent.Core/ Aetheus.Agent.Core/
COPY src/Aetheus.Agent.Linux/ Aetheus.Agent.Linux/

RUN dotnet publish Aetheus.Agent.Linux/Aetheus.Agent.Linux.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14@sha256:de0ee358cdd672f7017a003bed21e9ac9ed48a27c922a59b18175b6e82fa7fee AS runtime
WORKDIR /app

COPY --from=build /app/publish .

RUN useradd -r -s /bin/false aetheus-agent \
    && mkdir -p /var/lib/aetheus-agent \
    && chown aetheus-agent:aetheus-agent /var/lib/aetheus-agent

USER aetheus-agent

ENTRYPOINT ["dotnet", "Aetheus.Agent.Linux.dll"]
