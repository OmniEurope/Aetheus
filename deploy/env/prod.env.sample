# SPDX-License-Identifier: EUPL-1.2
# Defines the first-deployment environment file, preserving existing installations. Literal values
# and declared whole-value placeholders are validated by prod-deploy-prepare.sh; see
# docs/self-deploy-guide.md.
APPNAME=aetheus
ENV=prod
# Example: https://api.example.org
API_BASE_URL=#{PUBLIC_API_URL}#
# Example: 1.1.1842
APP_VERSION=#{APP_VERSION}#
DB_USER=aetheus
DB_PASSWORD=#{SECRET_HEX_24}#
JWT_KEY=#{SECRET_HEX_32}#
ADMIN_PASSWORD=#{SECRET_HEX_16}#
ENCRYPTION_KEY=#{SECRET_HEX_32}#
ENCRYPTION_SALT=#{SECRET_HEX_16}#
DEPLOYMENT_BOOTSTRAP_IDENTITY_KEY=#{SECRET_HEX_32}#
# Example: https://app.example.org
FRONT_URL=#{PUBLIC_APP_URL}#
FRONT_URL_ACCEPT=#{PUBLIC_APP_URL}#
FRONT_URL_PROD=#{PUBLIC_APP_URL}#
