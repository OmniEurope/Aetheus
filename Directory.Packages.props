<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- ASP.NET Core / runtime (.NET 11 train, 11.0.0). Exception: Microsoft.EntityFrameworkCore.*, the EF health check and
       Npgsql.EntityFrameworkCore.PostgreSQL stay on the 10.x train (ADR-048): Npgsql's EF Core 11 provider is only a release
       candidate (11.0.0-rc.3 on 2026-11-11) and no prerelease ships. EF Core 10 runs on the net11.0 target. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <!-- Explicitly reference the current stable Microsoft.OpenApi release so the patched version
         wins over the older transitive dependency brought by Microsoft.AspNetCore.OpenApi. -->
    <!-- Microsoft.OpenApi 3.x makes IOpenApiMediaType.Example read-only, which breaks the
         Microsoft.AspNetCore.OpenApi 10.0.x XML-comment source generator (CS0200). The 2.x line was required while on Microsoft.AspNetCore.OpenApi 10.0.15 (it declares Microsoft.OpenApi [2.12.2, 3.0.0)); since the move to ASP.NET Core 11 (06f35bc7d) 3.x is accepted, so this stays on 3.x. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <!-- Patched release ahead of the vulnerable transitive 10.0.0 (MimeKit, NuGet.Packaging) and 9.0.6
         (Microsoft.CodeAnalysis.Analyzer.Testing): GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="11.0.0" />
  </ItemGroup>

  <!-- API versioning -->
  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
  </ItemGroup>

  <!-- Data / EF / Postgres -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageVersion Include="NuGet.Packaging" Version="8.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="8.0.0" />
  </ItemGroup>

  <!-- Third-party libraries -->
  <ItemGroup>
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="DnsClient" Version="1.8.0" />
    <!-- R1-16: SMTP client of the platform e-mail sender (MIT, depends on MimeKit, MIT). -->
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <!-- R1-17: server-side sanitizer of the HTML of the messages read in the mailbox (MIT, AngleSharp, MIT). The front keeps the version the OE package brings (transitive, not pinned). -->
    <PackageVersion Include="HtmlSanitizer" Version="11.0.26" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="OmniEurope.Blazor" Version="1.14.0" />
    <PackageVersion Include="OmniEurope.Diagnostics" Version="1.1.0" />
  </ItemGroup>

  <!-- OpenTelemetry distribution packages -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <!-- Roslyn / analyzers -->
  <ItemGroup>
    <!-- Microsoft.CodeAnalysis.* is pinned to 5.9.0: the compiler of the 10.0.4xx band, and the newest stable on
         nuget.org while the SDK 11.0.100 floor (global.json) ships Roslyn 5.12.0, not published there (ADR-048).
         It was the compiler of the 10.0.4xx feature band that
         held the global.json floor (10.0.403 since 2026-10-29), which is also the minimum
         Aetheus.Analyzers enforces (AetheusMinimumAnalyzerSdkVersion = 10.0.400). An analyzer built
         against a Roslyn newer than the host compiler is refused at compile time (CS9057), so building
         against the floor band's compiler is what lets the analyzers load under any SDK of that band
         or above. Raise it only together with the floor and AetheusMinimumAnalyzerSdkVersion
         (table of STD-SDKPIN, SdkPinGuardTests), never to follow a newer SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
  </ItemGroup>

  <!-- Test tooling -->
  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="AngleSharp" Version="1.10.1" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <!-- Only Aetheus.E2E, whose browser image still runs it through VSTest (see its project file). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <!-- Moves only together with the browser image the QA runs the E2E suite in: Dockerfile.e2e pins
         mcr.microsoft.com/playwright/dotnet:v1.64.1 by digest; bump both together, never this one alone,
         since a newer driver looks for browser builds that image does not carry. -->
    <PackageVersion Include="Microsoft.Playwright.NUnit" Version="1.64.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <!-- Testcontainers 4.13.0 allows 2025.1.0, which is affected by GHSA-q939-rpr3-3284. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- Every test project runs on Microsoft.Testing.Platform (global.json "test.runner"): xunit.v3 4.x
         refuses the VSTest target. TRX and Cobertura come from MTP extensions, not VSTest loggers and
         data collectors; coverlet.MTP is the same engine as the former coverlet.collector. -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
