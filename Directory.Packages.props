<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- ASP.NET Core / runtime (.NET 10 servicing train) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <!-- Explicitly reference the current stable Microsoft.OpenApi release so the patched version
         wins over the older transitive dependency brought by Microsoft.AspNetCore.OpenApi. -->
    <!-- Microsoft.OpenApi 3.x makes IOpenApiMediaType.Example read-only, which breaks the
         Microsoft.AspNetCore.OpenApi 10.0.x XML-comment source generator (CS0200). Stays on the 2.x line: Microsoft.AspNetCore.OpenApi 10.0.13, the latest for .NET 10, declares Microsoft.OpenApi [2.12.0, 3.0.0); only ASP.NET Core 11 accepts 3.x
         until the ASP.NET generator targets 3.x. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- Patched release ahead of the vulnerable transitive 10.0.0 (MimeKit, NuGet.Packaging) and 9.0.6
         (Microsoft.CodeAnalysis.Analyzer.Testing): GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
  </ItemGroup>

  <!-- API versioning -->
  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
  </ItemGroup>

  <!-- Data / EF / Postgres -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
  </ItemGroup>

  <!-- Third-party libraries -->
  <ItemGroup>
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="DnsClient" Version="1.8.0" />
    <!-- R1-16: SMTP client of the platform e-mail sender (MIT, depends on MimeKit, MIT). -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- R1-17: server-side sanitizer of the HTML of the messages read in the mailbox (MIT, AngleSharp, MIT); same version OE already brings to the front. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="OmniEurope.Blazor" Version="1.8.2" />
    <PackageVersion Include="OmniEurope.Performance" Version="1.1.0" />
  </ItemGroup>

  <!-- OpenTelemetry distribution packages -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <!-- Roslyn / analyzers -->
  <ItemGroup>
    <!-- Microsoft.CodeAnalysis.* is pinned to 5.9.0, the compiler of the 10.0.4xx feature band that
         holds the global.json floor (10.0.402 since 2026-10-17, ADR-048), which is also the minimum
         Aetheus.Analyzers enforces (AetheusMinimumAnalyzerSdkVersion = 10.0.400). An analyzer built
         against a Roslyn newer than the host compiler is refused at compile time (CS9057), so building
         against the floor band's compiler is what lets the analyzers load under any SDK of that band
         or above. Raise it only together with the floor and AetheusMinimumAnalyzerSdkVersion
         (table of STD-SDKPIN, SdkPinGuardTests), never to follow a newer SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
  </ItemGroup>

  <!-- Test tooling -->
  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="AngleSharp" Version="1.8.3" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.13.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- Only Aetheus.E2E, whose browser image still runs it through VSTest (see its project file). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Moves only together with the browser image the QA runs the E2E suite in: Dockerfile.e2e pins
         mcr.microsoft.com/playwright/dotnet:v1.63.0 by digest; bump both together, never this one alone,
         since a newer driver looks for browser builds that image does not carry. -->
    <PackageVersion Include="Microsoft.Playwright.NUnit" Version="1.63.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <!-- Testcontainers 4.13.0 allows 2025.1.0, which is affected by GHSA-q939-rpr3-3284. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- Every test project runs on Microsoft.Testing.Platform (global.json "test.runner"): xunit.v3 4.x
         refuses the VSTest target. TRX and Cobertura come from MTP extensions, not VSTest loggers and
         data collectors; coverlet.MTP is the same engine as the former coverlet.collector. -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
