{
  "minLines": 15,
  "minTokens": 70,
  "mode": "strict",
  "format": ["csharp", "javascript", "typescript", "python", "java"],
  "ignore": [
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    ".claude/**",
    ".codex/**",
    "**/.pipeline-artifacts/**",
    "**/.analysis-*/**",
    "**/.qa-test-results/**",
    "coverage*/**",
    "tests/**",
    "packages/**/test/**",
    "**/Data/Migrations/**",
    "src/Aetheus.Back/Data/DbInitializer.cs",
    "src/Aetheus.Front/wwwroot/lib/**",
    "site/**",
    ".aetheus/security-rules/tests/**",
    "deploy/pipelines/toto-conformance-fixture/**",
    "deploy/pipelines/toto-e2e-fixture/**",
    "**/*.Designer.cs",
    "**/GlobalUsings.cs",
    "src/**/I[A-Z]*.cs",
    "src/**/*Dtos.cs",
    "src/Aetheus.Back/Data/Entities/**",
    "src/Aetheus.Back/Data/Configurations/**",
    "docs-site/public/**"
  ],
  "reporters": ["json"],
  "output": ".analysis-duplication"
}
