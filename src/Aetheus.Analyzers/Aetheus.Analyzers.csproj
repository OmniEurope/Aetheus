<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>true</IsPackable>
    <PackageId>Aetheus.Analyzers</PackageId>
    <Authors>Aetheus</Authors>
    <Description>Custom Roslyn analyzers enforcing Aetheus coding standards (PRM001–PRM004)</Description>
    <PackageTags>analyzers;roslyn;aetheus</PackageTags>
    <RepositoryType>git</RepositoryType>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <AetheusMinimumAnalyzerSdkVersion>10.0.400</AetheusMinimumAnalyzerSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack the analyzer DLL into the analyzers/dotnet/cs folder so consuming projects get the rules automatically -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <Target Name="ValidateAnalyzerSdk" BeforeTargets="PrepareForBuild"
          Condition="$([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '$(AetheusMinimumAnalyzerSdkVersion)'))">
    <Error Text="Aetheus.Analyzers requires .NET SDK $(AetheusMinimumAnalyzerSdkVersion) or newer; current SDK is $(NETCoreSdkVersion)." />
  </Target>

</Project>
