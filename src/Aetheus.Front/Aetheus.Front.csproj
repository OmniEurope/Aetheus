<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- EN + FR are within the EFIGS ICU shard, but Firefox's WASM runtime rejects
         dynamic CultureInfo changes at startup unless full globalization data is loaded.
         The extra download (~200 KB gzipped) is the only reliable cross-browser fix.
         S-TECH-69 investigated <HybridGlobalization> (uses the browser Intl API instead of
         ICU, ~200 KB lighter): rejected. It is mutually exclusive with LoadAllGlobalizationData,
         and some CompareInfo/culture-sensitive operations throw PlatformNotSupportedException
         under it — adopting it needs a real Firefox/Chrome/Safari smoke test of culture switching
         and sorting that this environment can't run. Revisit only with that smoke test in hand. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- IL trimming is THE bundle-size lever. It is already the SDK default for
         a Release WASM publish (prod runs trimmed today, so the component library and serialization
         are trim-safe at the default mode) — stated explicitly for intent.
         TrimMode is left at the SDK default on purpose: do NOT switch to 'full'
         without a real browser smoke test. AOT is intentionally NOT enabled —
         it speeds CPU but ENLARGES the download, which is counterproductive for
         a first-paint/size bottleneck already covered by trimming + Brotli +
         the ICU fix. Revisit AOT only with the wasm-tools workload + smoke test. -->
    <PublishTrimmed>true</PublishTrimmed>
    <!-- PRM001 (TimeProvider) is a false positive in WASM: the client runs in the browser
         where DateTime.Now IS the correct local clock — there is no DI-injectable system
         clock to inject. See CLAUDE.md: "use DateTime.Now for elapsed-time math in front code". -->
    <NoWarn>$(NoWarn);PRM001</NoWarn>
  </PropertyGroup>

  <Target Name="PinBrowserRuntimePacks" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <!-- Workload manifests are machine-global and may drift ahead of global.json, so every pack
           whose version reaches packages.lock.json has to be pinned by the repository instead of
           by whatever the build machine happens to have installed.
           The linker is pinned too, but to the SDK's own runtime rather than the production one:
           it is a build tool that runs on the SDK image's shared framework. Left implicit, its
           version came from machine-global workload manifests and leaked into packages.lock.json,
           so a machine with a newer manifest wrote 10.0.11 while a clean agent resolved 10.0.6 and
           failed locked-mode restore with NU1004. Pinning it to the production runtime instead is
           equally wrong: the SDK image has no such runtime and publish dies with NETSDK1144. -->
      <KnownWebAssemblySdkPack Update="Microsoft.NET.Sdk.WebAssembly.Pack"
                               WebAssemblySdkPackVersion="$(AetheusRuntimeImageVersion)" />
      <KnownAspNetCorePack Update="Microsoft.AspNetCore.App.Internal.Assets"
                           AspNetCorePackVersion="$(AetheusRuntimeImageVersion)" />
      <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks"
                       ILLinkPackVersion="$(AetheusLinkerPackVersion)" />
    </ItemGroup>
  </Target>

  <!-- The browser runtime pack is the one pack the wasm-tools workload decides, so it cannot be pinned
       like the packs above without mixing it with the workload's relinking toolchain of another patch.
       The workload set is pinned instead (AetheusWasmWorkloadVersion, installed by the host publish),
       and a Release publish that resolved any other runtime is refused rather than shipped.
       PrepareForPublish also runs once more inside the WebAssembly publish, in an invocation that
       never resolves runtime packs; that pass has nothing to verify, so it is skipped rather than
       failed. The outer pass prints the version it checked ("Browser runtime pack: ..."). -->
  <Target Name="VerifyBrowserRuntimePack" BeforeTargets="PrepareForPublish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_AetheusBrowserRuntimePack Include="@(RuntimePack)"
                                  Condition="'%(RuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' and '%(RuntimePack.RuntimeIdentifier)' == 'browser-wasm'" />
    </ItemGroup>
    <Error Condition="'@(_AetheusBrowserRuntimePack)' != '' and '%(_AetheusBrowserRuntimePack.NuGetPackageVersion)' != '$(AetheusRuntimeImageVersion)'"
           Text="The browser runtime pack %(_AetheusBrowserRuntimePack.Identity) resolved to %(_AetheusBrowserRuntimePack.NuGetPackageVersion), not AetheusRuntimeImageVersion $(AetheusRuntimeImageVersion). Install the pinned workload set: dotnet workload install wasm-tools --version $(AetheusWasmWorkloadVersion)" />
    <Message Condition="'@(_AetheusBrowserRuntimePack)' != ''" Importance="high" Text="Browser runtime pack: %(_AetheusBrowserRuntimePack.Identity) %(_AetheusBrowserRuntimePack.NuGetPackageVersion)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Aetheus.Front.Tests" />
    <StaticWebAssetFingerprintPattern Include="AetheusCss"
                                      Pattern="css/*.css"
                                      Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aetheus.Analyzers\Aetheus.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aetheus.Shared\Aetheus.Shared.csproj" />
  </ItemGroup>

  <!-- The published OmniEurope.Blazor package (version pinned in Directory.Packages.props); it ships the
       OE0001 analyzer itself. On a machine with the OE sources (UseLocalOmniEurope, Directory.Build.props)
       the front references those sources and their analyzer project instead, recette R1-57. -->
  <ItemGroup Condition="'$(UseLocalOmniEurope)' != 'true'">
    <PackageReference Include="OmniEurope.Blazor" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalOmniEurope)' == 'true'">
    <ProjectReference Include="$(OmniEuropeBlazorLocalProject)" />
    <ProjectReference Include="$(OmniEuropeBlazorLocalAnalyzers)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="ReportOmniEuropeSource" BeforeTargets="Build">
    <Message Importance="high" Condition="'$(UseLocalOmniEurope)' == 'true'" Text="Aetheus.Front: OmniEurope.Blazor from local sources $(OmniEuropeBlazorLocalProject)" />
    <Message Importance="high" Condition="'$(UseLocalOmniEurope)' != 'true'" Text="Aetheus.Front: OmniEurope.Blazor from the NuGet package" />
  </Target>

  <!-- Firefox does not support the "integrity" key inside importmaps (Chrome 127+/Safari 18.2+ only).
       Strip it from every generated HTML so the WASM app loads on all browsers.
       Fingerprinted URLs still provide cache-busting; SRI on individual <script> tags is unaffected.
       Uses an inline C# task so it works on Linux Docker builds (no pwsh dependency). -->
  <UsingTask TaskName="StripImportMapIntegrityTask" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
foreach (var item in Files)
{
    var path = item.ItemSpec;
    if (!File.Exists(path)) continue;
    var content = File.ReadAllText(path);
    if (!content.Contains("\"integrity\"")) continue;
    content = Regex.Replace(content, @",\s*""integrity""\s*:\s*\{[^}]*\}", "");
    content = Regex.Replace(content, @"""integrity""\s*:\s*\{[^}]*\}\s*,?", "");
    File.WriteAllText(path, content);
    Log.LogMessage(MessageImportance.Normal, "Stripped importmap integrity from " + path);
}
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="StripImportMapIntegrity" AfterTargets="ResolveHtmlAssetPlaceholdersBuildStaticWebAssets;ResolveHtmlAssetPlaceholdersPublishStaticWebAssets">
    <ItemGroup>
      <_GeneratedHtml Include="$(IntermediateOutputPath)staticwebassets\htmlassetplaceholders\**\*.html" />
    </ItemGroup>
    <StripImportMapIntegrityTask Condition="'@(_GeneratedHtml)' != ''" Files="@(_GeneratedHtml)" />
  </Target>

</Project>
