@* Project detail shared layout - simplified version of ServerDetailLayout.

    Each project section page sets `@layout ProjectDetailLayout` and only renders its own
    body. The header bar, status badge, and back button live here once.

    The loader is shared (scoped DI) so all sections see the same ProjectDetailDto.

    IMPORTANT: @Body is always rendered (hidden when loading) so child pages can trigger
    the data load via their OnParametersSetAsync → EnsureLoadedAsync. Gating @Body behind
    an if-block creates a deadlock: the layout waits for data, but the child (which triggers
    the load) never mounts. *@

@inherits LayoutComponentBase
@layout MainLayout
@inject Aetheus.Front.Components.Shared.ProjectDetailLoader Loader
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject Aetheus.Front.Layout.BreadcrumbService Breadcrumb


<CascadingValue Value="Loader" Name="ProjectLoader">
    @* Render the header frame immediately to keep page content stable while the project loads.
       Only entity-dependent content waits. *@
    @if (Loader.Project is null && Loader.InitialLoadCompleted)
    {
        <OmniStack Align="OmniAlignment.Center" Gap="OmniSpacing.Medium" Class="detail-not-found">
            <OmniIcon Name="OmniIconName.Error" Class="omni-error-state-icon" />
            <OmniHeading Level="OmniHeadingLevel.H5">@L["ProjectNotFound"]</OmniHeading>
            <Aetheus.Front.Components.Shared.BrowserBackButton Text="@L["BackToProjects"]" Title="@L["GoBack"]" />
        </OmniStack>
    }
    else
    {
        @* Use the section name and icon in the title, with the project as a breadcrumb ancestor.
           Show project status only when inactive. *@
        @* Combine section-specific actions with Follow and Edit in the header menu, placing
           section actions first. *@
        RenderFragment? projectMenu = Loader.Project is { } project
            ? @<text>
                @foreach (var action in _sectionMenu.Actions)
                {
                    <OmniMenuItem OnClick="@action.Run" Disabled="@action.Disabled" title="@action.Title"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(action.Icon)" /></Icon><ChildContent>@action.Text</ChildContent></OmniMenuItem>
                }
                <Aetheus.Front.Components.Notifications.ProjectSubscriptionMenuItem State="@_subscription" />
                <OmniMenuItem OnClick="@(() => Nav.NavigateTo($"/projects/{project.Id}/edit"))"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent>@L["Settings"]</ChildContent></OmniMenuItem>
              </text>
            : null;
        <OmniPageHeader ShowBack="true" BackHref="@BackHref" Subtitle="@Breadcrumb.Subtitle()" MenuContent="@projectMenu" Icon="@MaterialIconMap.HeaderIcon(SectionIcon)">
            <Badges>
                @if (Loader.Project is { Status: not ProjectStatus.Active } inactive)
                {
                    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L[inactive.Status.ToString()]</OmniBadge>
                }
            </Badges>
            <Actions>
                <Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionName="@Aetheus.Front.Components.Shared.PipelinesList.HeaderActionsSection" />
            </Actions>
        </OmniPageHeader>
    }

    <div class="@(Loader.Project is null ? "blade-content blade-content-hidden" : "blade-content")">
        <CascadingValue Value="_sectionMenu" IsFixed="true">
            @Body
        </CascadingValue>
    </div>
</CascadingValue>
