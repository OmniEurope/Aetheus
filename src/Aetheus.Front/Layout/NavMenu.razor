<OmniPanelMenu Label="@L["MainNavigation"]">
    <OmniPanelMenuItem Text="@L["Dashboard"]" Icon="@IconFor("dashboard")" Href="/" />
    @if (Permissions.CanReadAny(ResourceType.Server))
    {
    <OmniPanelMenuItem Text="@L["Servers"]" Icon="@IconFor("dns")" Href="servers" Expanded="@IsOnSection("servers")">
        @* A group is open inside its section and closed elsewhere, and its entries are always
           there, so its chevron opens and closes a real list wherever the user is. *@
        @if (GetSpecificServerId() is { } serverId)
        {
            @* Item #1 - migrated from legacy `?section=` query strings to real routes. *@
            <OmniPanelMenuItem Text="@L["Overview"]" Icon="@IconFor("dashboard")" Href="@($"servers/{serverId}/overview")" />
            <OmniPanelMenuItem Text="@L["Services"]" Icon="@IconFor("engineering")" Href="@($"servers/{serverId}/services")" />
            @* R1-28: the mail configuration of this server, right under Services, only once its mail stack is installed
               (the general "Mailboxes" entry below stays the cross-server directory). Docker / Apache / Certbot /
               TeamSpeak / Portsentry / Rkhunter are listed in the Services tab as manageable modules. *@
            @if (HasServerMail(serverId))
            {
                <OmniPanelMenuItem Text="@L["Mail"]" Icon="@IconFor("mail")" Href="@($"servers/{serverId}/mail")" Match="OmniNavMatch.Exact" />
            }
            <OmniPanelMenuItem Text="@L["PatchTitle"]" Icon="@IconFor("system_update")" Href="@($"servers/{serverId}/updates")" />
            <OmniPanelMenuItem Text="@L["Projects"]" Icon="@IconFor("folder")" Href="@($"servers/{serverId}/projects")" />
            <OmniPanelMenuItem Text="@L["Pipelines"]" Icon="@IconFor("account_tree")" Href="@($"servers/{serverId}/pipelines")" />
            <OmniPanelMenuItem Text="@L["Libraries"]" Icon="@IconFor("library_books")" Href="@($"servers/{serverId}/libraries")" />
            <OmniPanelMenuItem Text="@L["Vaults"]" Icon="@IconFor("lock")" Href="@($"servers/{serverId}/vaults")" />
            <OmniPanelMenuItem Text="@L["Releases"]" Icon="@IconFor("new_releases")" Href="@($"servers/{serverId}/releases")" />
            <OmniPanelMenuItem Text="@L["PortRegistryTitle"]" Icon="@IconFor("lan")" Href="@($"servers/{serverId}/ports")" />
            <OmniPanelMenuItem Text="@L["Tasks"]" Icon="@IconFor("task_alt")" Href="@($"servers/{serverId}/tasks")" />
            <OmniPanelMenuItem Text="@L["Logs"]" Icon="@IconFor("receipt_long")" Href="@($"servers/{serverId}/logs")" />
        }
        else
        {
            <OmniPanelMenuItem Text="@L["Tasks"]" Icon="@IconFor("task_alt")" Href="tasks" />
            <OmniPanelMenuItem Text="@L["Logs"]" Icon="@IconFor("receipt_long")" Href="logs" />
            <div class="nav-alert-item">
                <OmniPanelMenuItem Text="@L["Alerts"]" Icon="@IconFor("notification_important")" Href="alerts"
                                   aria-describedby="@(AlertNotify.UnreadCount > 0 ? "nav-alert-count" : null)" />
                @if (AlertNotify.UnreadCount > 0)
                {
                    <OmniBadge Fill="OmniFill.Solid" Id="nav-alert-count" Tone="OmniTone.Danger" Class="nav-alert-count">
                        @DisplayFormatting.BadgeCount(AlertNotify.UnreadCount)
                    </OmniBadge>
                }
            </div>
        }
    </OmniPanelMenuItem>
    @* Recette R1-41: the mailboxes of every server the reader sees, one click from the menu. *@
    <OmniPanelMenuItem Text="@L["MailboxDirectory"]" Icon="@IconFor("inbox")" Href="mail" />
    }

    @if (CanReadProjectArea())
    {
    <OmniPanelMenuItem Text="@L["Projects"]" Icon="@IconFor("folder")" Href="projects" Expanded="@IsOnSection("projects")">
        @if (GetSpecificProjectId() is { } projectId)
        {
            @foreach (var item in ProjectNavigationCatalog.VisibleItems(Permissions, projectId))
            {
                <OmniPanelMenuItem Text="@L[item.LabelKey]" Icon="@IconFor(item.Icon)" Href="@item.Path(projectId)" />
            }
        }
        else
        {
            @if (Permissions.CanReadAny(ResourceType.Pipeline)
                || Permissions.CanReadAny(ResourceType.PipelineTemplate))
            {
                <OmniPanelMenuItem Text="@L["Pipelines"]" Icon="@IconFor("account_tree")" Href="pipelines" />
            }
            <OmniPanelMenuItem Text="@L["AnalysisPortfolio"]" Icon="@IconFor("shield")" Href="analysis" />
            @* Lists monitored applications across projects; project-specific supervision stays in
               the project menu. *@
            @if (Permissions.CanReadAny(ResourceType.Project))
            {
                <OmniPanelMenuItem Text="@L["Supervision"]" Icon="@IconFor("monitor_heart")" Href="monitoring" />
            }
            @if (Permissions.CanReadAny(ResourceType.Release))
            {
                <OmniPanelMenuItem Text="@L["Releases"]" Icon="@IconFor("new_releases")" Href="releases" />
            }
            @if (Permissions.CanReadAny(ResourceType.VariableLibrary))
            {
                <OmniPanelMenuItem Text="@L["VariableLibraries"]" Icon="@IconFor("data_object")" Href="variable-libraries" />
            }
            @if (Permissions.CanReadAny(ResourceType.Vault))
            {
                <OmniPanelMenuItem Text="@L["Vaults"]" Icon="@IconFor("lock")" Href="vaults" />
            }
            @if (Permissions.CanReadAny(ResourceType.Environment))
            {
                <OmniPanelMenuItem Text="@L["Environments"]" Icon="@IconFor("layers")" Href="environments" />
            }
        }
    </OmniPanelMenuItem>
    }
    @* Notifications, for every signed-in user, between Projects and Settings. *@
    <Aetheus.Front.Components.Notifications.NotificationsNavItem />
    <OmniPanelMenuItem Text="@L["Settings"]" Icon="@IconFor("settings")" Href="settings" />
    <OmniPanelMenuItem Text="@L["HelpCenter"]" Icon="@IconFor("help")" Href="help" />
    @if (Auth.IsAdmin)
    {
        <OmniPanelMenuItem Text="@L["Administration"]" Icon="@IconFor("admin_panel_settings")" Href="admin" Expanded="@IsOnSection("admin")">
            <OmniPanelMenuItem Text="@L["Users"]" Icon="@IconFor("group")" Href="admin/users" />
            <OmniPanelMenuItem Text="@L["Organizations"]" Icon="@IconFor("apartment")" Href="admin/organizations" />
            <OmniPanelMenuItem Text="@L["Roles"]" Icon="@IconFor("admin_panel_settings")" Href="admin/roles" />
            <OmniPanelMenuItem Text="@L["NotificationRules"]" Icon="@IconFor("notifications_active")" Href="admin/notifications" />
            <OmniPanelMenuItem Text="@L["MailTemplates"]" Icon="@IconFor("mail")" Href="admin/mail-templates" />
            <OmniPanelMenuItem Text="@L["AiRunnerProfiles"]" Icon="@IconFor("smart_toy")" Href="admin/ai-profiles" />
            <OmniPanelMenuItem Text="@L["PackageFeeds"]" Icon="@IconFor("inventory")" Href="admin/package-feeds" />
            <OmniPanelMenuItem Text="@L["PackageRegistry"]" Icon="@IconFor("deployed_code")" Href="admin/package-registry" />
            <OmniPanelMenuItem Text="@L["AuditLogs"]" Icon="@IconFor("policy")" Href="admin/audit" />
            <OmniPanelMenuItem Text="@L["SystemLogs"]" Icon="@IconFor("description")" Href="admin/system-logs" />
            <OmniPanelMenuItem Text="@L["Performance"]" Icon="@IconFor("speed")" Href="admin/performance" />
            <OmniPanelMenuItem Text="@L["Plugins"]" Icon="@IconFor("extension")" Href="admin/plugins" />
            <OmniPanelMenuItem Text="@L["Dashboards"]" Icon="@IconFor("space_dashboard")" Href="admin/dashboards" />
            <OmniPanelMenuItem Text="@L["Platform"]" Icon="@IconFor("tune")" Href="admin/settings" />
            <OmniPanelMenuItem Text="@L["ApiReference"]" Icon="@IconFor("api")" Href="admin/api-reference" />
        </OmniPanelMenuItem>
    }
</OmniPanelMenu>
