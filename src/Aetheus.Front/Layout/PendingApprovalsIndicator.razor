@* Show waiting approvals in the top bar only when decisions are pending. The indicator shares the
   task tracker layout and opens the approval list without navigating away. *@

@if (Approvals.Items.Count > 0)
{
    var count = Approvals.Items.Count;
    var label = string.Format(L["PendingApprovalsTooltip"].Value, count);
    <div class="task-tracker-container omni-task-tracker pending-approvals-container">
        @* User exception (2026-09-28): a waiting approval is red in the top bar, where the rule would make it grey. *@
        <OmniPopover Id="pending-approvals" Class="header-popover"
                     Open="@_popoverOpen" OpenChanged="@(open => _popoverOpen = open)"
                     TriggerVariant="OmniButtonVariant.Danger"
                     TriggerClass="header-action-btn task-tracker-btn task-tracker-btn-wide task-tracker-btn-busy pending-approvals-btn"
                     TriggerTitle="@label"
                     Label="@label"
                     PopupLabel="@L["PendingApprovalsTitle"]">
            <TriggerIcon><OmniIcon Name="OmniIconName.Stamp" Class="header-icon" /></TriggerIcon>
            <TriggerContent>
                <span class="task-tracker-count">@DisplayFormatting.BadgeCount(count)</span>
            </TriggerContent>
            <ChildContent>
                <div class="task-tracker-popover">
                    <div class="task-tracker-header">
                        <OmniHeading Level="OmniHeadingLevel.H5">@L["PendingApprovalsTitle"]</OmniHeading>
                        <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Warning">@count.ToString(System.Globalization.CultureInfo.CurrentCulture)</NumberBadge>
                    </div>
                    <div class="task-tracker-list">
                        @foreach (var approval in Approvals.Items)
                        {
                            <a href="@($"/pipelines/runs/{approval.PipelineRunId}")" class="task-tracker-row pending-approvals-row" @onclick="@(() => _popoverOpen = false)">
                                <OmniIcon Name="OmniIconName.Stamp" Class="task-tracker-icon-assigned" />
                                <div class="task-tracker-row-body">
                                    <div class="task-tracker-row-name">@($"{approval.PipelineName} #{approval.PipelineRunId}")</div>
                                    <div class="task-tracker-row-meta">
                                        @(approval.Scope == ApprovalScope.Pipeline
                                            ? string.Format(L["PendingPipelineApprovalLine"].Value, approval.StageName, approval.RequestedAt.ToLocalTime().ToString("g"))
                                            : string.Format(L["PendingApprovalLine"].Value, approval.StageName, approval.EnvironmentName, approval.RequestedAt.ToLocalTime().ToString("g")))
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </ChildContent>
        </OmniPopover>
    </div>
}
