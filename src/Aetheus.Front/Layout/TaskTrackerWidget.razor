@* Item #7 of the plan - top-bar task tracker. A square button showing the running-task count (or
   a check icon when nothing runs); click to reveal a popover with the in-flight task list. Lives
   in MainLayout between Help and the user menu. *@

<div class="task-tracker-container omni-task-tracker">
    @* An OmniPopover, closed by a click outside (another header menu included) or Escape, with no
       full-page veil. *@
    <OmniPopover Id="task-tracker" Class="header-popover"
                 Open="@_popoverOpen" OpenChanged="@(open => _popoverOpen = open)"
                 TriggerVariant="OmniButtonVariant.Primary"
                 TriggerClass="@(_count > 0 ? "header-action-btn task-tracker-btn task-tracker-btn-wide task-tracker-btn-busy" : "header-action-btn task-tracker-btn")"
                 TriggerTitle="@string.Format(L["TaskTrackerTooltip"], _count)"
                 Label="@string.Format(L["TaskTrackerTooltip"], _count)"
                 PopupLabel="@L["TaskTrackerTitle"]">
        @* Keep the task-list icon visible and widen the button when a running-task count
           accompanies it. *@
        <TriggerIcon><OmniIcon Name="OmniIconName.ListChecks" Class="header-icon" /></TriggerIcon>
        <TriggerContent>
            @if (_count > 0)
            {
                <span class="task-tracker-count">@DisplayFormatting.BadgeCount(_count)</span>
            }
        </TriggerContent>
        <ChildContent>
            <div class="task-tracker-popover">
                <div class="task-tracker-header">
                    <OmniHeading Level="OmniHeadingLevel.H5">@L["TaskTrackerTitle"]</OmniHeading>
                    <OmniBadge Fill="OmniFill.Solid" Tone="@(_count > 0 ? OmniTone.Accent : OmniTone.Neutral)">@_count.ToString()</OmniBadge>
                </div>
                <div class="task-tracker-list">
                    @if (_count == 0)
                    {
                        <div class="task-tracker-empty">
                            <OmniIcon Name="OmniIconName.Tray" Class="task-tracker-empty-icon" />
                            <OmniText Tone="OmniTextTone.Muted">@L["TaskTrackerEmpty"]</OmniText>
                        </div>
                    }
                    else if (_count <= 5)
                    {
                        @foreach (var task in Tracker.Tasks)
                        {
                            <a href="@($"/servers/{task.ServerId}/tasks")" class="task-tracker-row" @onclick="@(() => _popoverOpen = false)">
                                <OmniIcon Name="@StatusIcon(task.Status)" Class="@StatusIconClass(task.Status)" />
                                <div class="task-tracker-row-body">
                                    <div class="task-tracker-row-name">@task.Name</div>
                                    <div class="task-tracker-row-meta">
                                        @(string.IsNullOrWhiteSpace(task.ServerName) ? $"#{task.ServerId}" : task.ServerName)
                                        · @(IsStalledOnOfflineAgent(task) ? L["TaskAgentOffline"] : L[$"TaskStatus_{task.Status}"])
                                    </div>
                                </div>
                                @if (task.Status == TaskExecutionStatus.Running)
                                {
                                    <AetheusLoader Size="OmniControlSize.Small" Centered="false" />
                                }
                                else if (IsStalledOnOfflineAgent(task))
                                {
                                    <OmniIcon Name="OmniIconName.Offline" Class="task-tracker-row-offline" title="@L["TaskAgentOfflineHint"]" />
                                }
                            </a>
                        }
                    }
                    else
                    {
                        @* S-UX-08: group by server when count > 5 for readability *@
                        @foreach (var group in Tracker.Tasks.GroupBy(t => new { t.ServerId, t.ServerName }).OrderBy(g => g.Key.ServerName))
                        {
                            <div class="task-tracker-group-header">
                                <OmniIcon Name="OmniIconName.Database" Class="task-tracker-group-icon" />
                                <span class="task-tracker-group-name">@(string.IsNullOrWhiteSpace(group.Key.ServerName) ? $"#{group.Key.ServerId}" : group.Key.ServerName)</span>
                                <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral" Class="task-tracker-group-badge">@group.Count()</OmniBadge>
                            </div>
                            @foreach (var task in group)
                            {
                                <a href="@($"/servers/{task.ServerId}/tasks")" class="task-tracker-row task-tracker-row-grouped" @onclick="@(() => _popoverOpen = false)">
                                    <OmniIcon Name="@StatusIcon(task.Status)" Class="@StatusIconClass(task.Status)" />
                                    <div class="task-tracker-row-body">
                                        <div class="task-tracker-row-name">@task.Name</div>
                                        <div class="task-tracker-row-meta">@(IsStalledOnOfflineAgent(task) ? L["TaskAgentOffline"] : L[$"TaskStatus_{task.Status}"])</div>
                                    </div>
                                    @if (task.Status == TaskExecutionStatus.Running)
                                    {
                                        <AetheusLoader Size="OmniControlSize.Small" Centered="false" />
                                    }
                                    else if (IsStalledOnOfflineAgent(task))
                                    {
                                        <OmniIcon Name="OmniIconName.Offline" Class="task-tracker-row-offline" title="@L["TaskAgentOfflineHint"]" />
                                    }
                                </a>
                            }
                        }
                    }
                </div>
                <div class="task-tracker-footer">
                    @* The same neutral "See all" button as the bell. *@
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => GoTo("/tasks"))" Class="task-tracker-see-all"><Icon><OmniIcon Name="OmniIconName.ArrowRight" /></Icon><ChildContent><span>@L["SeeAll"]</span></ChildContent></OmniButton>
                </div>
            </div>
        </ChildContent>
    </OmniPopover>
</div>
