@inherits LayoutComponentBase

@if (!AppReady)
{
    @* Chantier I: gate the WHOLE chrome (not just @Body) behind boot readiness so the
       top bar never flashes half-rendered before auth/orgs/permissions resolve.
       The boot splash itself is the single #app-splash node from index.html (outside #app),
       faded out by Aetheus.hideSplash on ready - see OnAfterRenderAsync. No node-swap flash. *@
    return;
}

<a href="#main-content" class="skip-link">@L["SkipToContent"]</a>

@* The package tooltip for every title attribute, instead of the browser box. *@
<OmniTitleTooltips />

<OmniLayout data-testid="blazor-ready"
              data-viewport="@(_viewportKnown ? "ready" : "pending")"
              Class="@(_viewportKnown ? "viewport-ready" : "viewport-pending")">
    <OmniHeader>
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center"
                   Gap="OmniSpacing.None" Class="header-bar">
            @if (AuthenticatedChromeReady)
            {
                @* STD-SHELL: OE shows the menu glyph for a pushed sidebar and a close glyph for an
                   overlay drawer. *@
                <OmniSidebarToggle Controls="app-sidebar" Open="@_sidebarExpanded" Reveal="@SidebarReveal"
                                   OpenChanged="@OnSidebarOpenChanged"
                                   Label="@L["ToggleSidebar"]" />
            }
            <a href="/" class="app-home-link" aria-label="@L["Aetheus"]">
                <img src="aetheus-icon.svg" alt="" class="app-header-icon" />
                <OmniText Class="app-title">@L["Aetheus"]</OmniText>
            </a>
            <div class="flex-spacer"></div>
            @if (!_isProduction)
            {
                @* Dev banner: absolutely centred on the whole header (see .dev-env-banner in
                   app.css) so it stays mid-bar whatever the left/right content widths are -
                   a single chip lands dead-centre too. Order: environment, then label, then
                   branch; each chip shows only when its value is present. *@
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center"
                           Gap="OmniSpacing.Small" Class="dev-env-banner">
                    <span class="dev-env-chip dev-env-chip-env" title="@L["DevBannerEnvTooltip"]">
                        <OmniIcon Name="OmniIconName.Database" Class="dev-env-chip-icon" />
                        <span class="dev-env-chip-text">@_envName</span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_devLabel))
                    {
                        <span class="dev-env-chip dev-env-chip-label" title="@L["DevBannerLabelTooltip"]">
                            <OmniIcon Name="OmniIconName.Tag" Class="dev-env-chip-icon" />
                            <span class="dev-env-chip-text">@_devLabel</span>
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_devBranch))
                    {
                        <span class="dev-env-chip dev-env-chip-branch" title="@L["DevBannerBranchTooltip"]">
                            <OmniIcon Name="OmniIconName.Graph" Class="dev-env-chip-icon" />
                            <span class="dev-env-chip-text">@_devBranch</span>
                        </span>
                    }
                </OmniStack>
            }
            @if (AuthenticatedChromeReady)
            {
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center"
                           Gap="OmniSpacing.XSmall" Class="header-actions">
                    @{
                        var connected = BackendConnected;
                        // The first connection, started without holding the page, reads as an attempt in progress like a reconnection.
                        var reconnecting = _signalRState is Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting
                            or Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connecting;
                        var connClass = connected ? "header-conn-online" : reconnecting ? "header-conn-warning" : "header-conn-offline";
                    }
                    <OmniIcon Name="@(connected ? OmniIconName.WifiHigh : OmniIconName.WifiSlash)"
                                title="@(connected ? L["ConnectedToBackend"] : L["NotConnectedToBackend"])"
                                Label="@(connected ? L["ConnectedToBackend"] : L["NotConnectedToBackend"])"
                                Class="@($"header-conn-icon {connClass}")" />
                    @* Global search is not wired yet: the field and its mobile overlay were removed rather
                       than ship a dead control (SR7M). Reinstate the input here once search is implemented. *@
                    <OmniButton Variant="OmniButtonVariant.Ghost" OnClick="NavigateToHelp"
                                title="@L["Help"]" Label="@L["Help"]" Class="header-action-btn">
                        <OmniIcon Name="OmniIconName.Question" />
                    </OmniButton>
                    <PendingApprovalsIndicator />
                    <TaskTrackerWidget />
                    @* Notification bell, next to the task tracker and built like it. *@
                    <Aetheus.Front.Components.Notifications.NotificationBell />
                    @* STD-SHELL: the shared application menu groups account, organisation,
                       language, appearance, settings, version and sign-out actions. *@
                    <OmniAppMenu Class="header-app-menu" Open="@_userMenuOpen" OpenChanged="@(open => _userMenuOpen = open)"
                                 UserName="@Auth.Username" Role="@(Auth.IsAdmin ? L["Admin"] : L["User"])"
                                 Languages="@Languages" Language="@CurrentLanguage" LanguageChanged="@OnLanguageChanged"
                                 OnTheme="@OnThemeMenuClick" OnSettings="@OnSettingsMenuClick"
                                 Version="@($"Aetheus v{_version}")" OnSignOut="@OnLogout">
                        @if (Orgs.IsLoaded && Orgs.Available.Count > 0)
                        {
                            <OmniText Tone="OmniTextTone.Muted" Class="user-menu-caption">@L["ActiveOrganization"]</OmniText>
                            <OmniDropDown TValue="int"
                                          Options="@ActiveOrganizationOptions"
                                          Value="@ActiveOrganizationId"
                                          ValueChanged="@(id => OnActiveOrgChanged(id))"
                                          ValueExpression="@(() => ActiveOrganizationId)"
                                          Label="@L["ActiveOrganization"]"
                                          Class="user-menu-org-picker" />
                        }
                        else if (Auth.IsAdmin && Orgs.IsLoaded)
                        {
                            <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center"
                                       Justify="OmniJustification.Between" Gap="OmniSpacing.Small" Class="user-menu-all-orgs">
                                <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                                    <OmniIcon Name="OmniIconName.Buildings" />
                                    <OmniText>@L["ActiveOrganization"]</OmniText>
                                </OmniStack>
                                <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L["AllOrganizations"]</OmniBadge>
                            </OmniStack>
                        }
                    </OmniAppMenu>
                </OmniStack>
            }
            else if (!Auth.IsAuthenticated)
            {
                @* Signed out (the login page): the same menu without an account, its trigger an
                   icon; the mode, the theme and the language stay at the right of the bar. *@
                <OmniAppMenu Class="header-app-menu" Open="@_userMenuOpen" OpenChanged="@(open => _userMenuOpen = open)"
                             Languages="@Languages" Language="@CurrentLanguage" LanguageChanged="@OnLanguageChanged"
                             OnTheme="@OnThemeMenuClick" />
            }
        </OmniStack>
        <PageLoadProgressBar />
    </OmniHeader>

    <OmniBody>
    @if (AuthenticatedChromeReady && !Auth.MustChangePassword)
    {
        <OmniSidebar Id="app-sidebar" Open="@_sidebarExpanded" OpenChanged="@OnSidebarOpenChanged"
                     Position="OmniSidebarPosition.Start"
                     Reveal="@SidebarReveal"
                     Collapse="@(_isMobile ? OmniSidebarCollapse.Hidden : OmniSidebarCollapse.Icons)"
                     Transition="OmniSidebarTransition.Smooth"
                     Backdrop="@_isMobile" Class="sidebar-width" Label="@L["MainNavigation"]"
                     CloseLabel="@L["CloseSidebar"]">
            @* The mobile drawer overlays the app bar and exposes its own close button and logo. OE
               hides this header when the desktop sidebar is pushed. *@
            <Header>
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center"
                           Gap="OmniSpacing.None" Class="header-bar sidebar-drawer-header">
                    <OmniSidebarToggle Controls="app-sidebar" Open="@_sidebarExpanded" Reveal="@SidebarReveal"
                                       OpenChanged="@OnSidebarOpenChanged" Label="@L["CloseSidebar"]" />
                    <a href="/" class="app-home-link" aria-label="@L["Aetheus"]">
                        <img src="aetheus-icon.svg" alt="" class="app-header-icon" />
                        <OmniText Class="app-title">@L["Aetheus"]</OmniText>
                    </a>
                </OmniStack>
            </Header>
            <ChildContent>
                @* OE closes a floating drawer itself when an entry is chosen (any navigation), on its veil
                   and on Escape, through OpenChanged. *@
                <NavMenu />
            </ChildContent>
        </OmniSidebar>
    }

    <OmniMain Id="main-content" Scrollable="true">
        <div class="omni-u-px-md omni-u-py-md app-body-wrapper">
            @if (_newVersionAvailable)
            {
                <OmniAlert Severity="OmniSeverity.Success" Class="version-alert-bar">
                    <Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon>
                    <ChildContent>
                        <OmniText Class="version-alert-bar-text">@L["NewVersionAvailable"]</OmniText>
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="OnReloadClick">
                            <OmniIcon Name="OmniIconName.Refresh" /> @L["ReloadNow"]
                        </OmniButton>
                    </ChildContent>
                </OmniAlert>
            }
            @if (Auth.IsAuthenticated && !AuthenticatedChromeReady)
            {
                <AetheusLoader Size="OmniControlSize.Large" Class="session-bootstrap-loader" />
            }
            else if (_initialized)
            {
                @* PageHeader contains the breadcrumb and installs the route fallback used for its
                   title. *@
                @if (CanAccessCurrentRoute)
                {
                    <LoggedErrorBoundary @ref="_errorBoundary">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent Context="exception">
                            <OmniCard Class="error-card">
                                <OmniStack Align="OmniAlignment.Center" Gap="OmniSpacing.Medium">
                                    <OmniIcon Name="OmniIconName.Error" Class="error-icon" />
                                    <OmniHeading Level="OmniHeadingLevel.H5">@L["ErrorOccurred"]</OmniHeading>
                                    <OmniText Tone="OmniTextTone.Muted">@L["ErrorMessage"]</OmniText>
                                    @if (HostEnv.Environment == "Development")
                                    {
                                        <pre class="dev-exception-pre">@exception.ToString()</pre>
                                    }
                                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="RecoverError">
                                        <OmniIcon Name="OmniIconName.Refresh" /> @L["Recover"]
                                    </OmniButton>
                                </OmniStack>
                            </OmniCard>
                        </ErrorContent>
                    </LoggedErrorBoundary>
                }
                else if (Auth.IsAuthenticated && !Auth.MustChangePassword)
                {
                    <EmptyState Icon="lock" Title="@L["AccessDenied"]" />
                }
            }
        </div>
    </OmniMain>
    </OmniBody>
    @* The window the user menu's "Theme" opens (theme, palette, density). *@
    <Aetheus.Front.Components.Settings.SiteAppearanceWindow @ref="_appearanceWindow" />
</OmniLayout>

<ConnectionLostDialog Visible="@_showOfflineDialog"
                      ReconnectCountdown="@_countdown.Remaining"
                      ManualReconnecting="@_manualReconnecting"
                      LastFailureReason="@TaskTracker.LastFailureReason"
                      OnManualReconnect="@OnManualReconnect" />

@* The short catch-up when the page comes back to the foreground (a phone put down during a run). It
   gives way to the connection-lost overlay above, which stays the authority on a real outage. *@
@if (AuthenticatedChromeReady)
{
    <RealtimeSyncIndicator OfflineOverlayShown="@_showOfflineDialog" />
}
