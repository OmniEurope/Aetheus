@*  Item #1 of the plan - shared chrome for every server-detail section page.

    Replaces the monolithic ServerDetail.razor that switched 21 sections on `?section=`.
    Each section page (Overview, Services, Projects, …) sets `@layout ServerDetailLayout`
    and only renders its own body: the header bar, status badge, and action buttons live
    here once. (The "Dernière mise à jour" caption moved into the Overview heartbeat tile.)

    The page's `[Parameter] public int Id` flows in through `BodyContext` (a cascading
    value) so child pages can grab the id without reaching for the route directly. The
    loader is shared (scoped DI) so all sections see the same `_server` and SignalR
    heartbeats.

    IMPORTANT: @Body is always rendered (hidden when loading) so child pages can trigger
    the data load via their OnParametersSetAsync → EnsureLoadedAsync. Gating @Body behind
    an if-block creates a deadlock: the layout waits for data, but the child (which triggers
    the load) never mounts. *@

@inherits LayoutComponentBase
@layout MainLayout
@inject Aetheus.Front.Components.Shared.ServerDetailLoader Loader
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject Aetheus.Front.Components.Shared.BreadcrumbService Breadcrumb

@using Aetheus.Front.Components.Servers

<CascadingValue Value="Loader" Name="ServerLoader">
    @* Render the detail frame immediately with skeletons for loading entity data and a not-found
       state for an unknown server. Keep @Body mounted but hidden during loading as required above. *@
    @* Server-wide Configuration and Tools actions belong to Overview; other sections provide their
       own actions. Header rendering does not depend on server status or compatibility badges. *@
    @{
        RenderFragment? headerActions = Loader.Server is null ? null : @<text>
            <Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionName="@PageHeaderActions.SectionName" />
            @if (IsOverview)
            {
            @* "Configuration", the server's settings, rather than a bare "Edit". *@
            @if (_canWrite)
            {
                <OmniButton Variant="OmniButtonVariant.Primary" title="@L["Configuration"]" Label="@L["Configuration"]"
                            OnClick="@(_ => OpenEditDialog())">
                    <Icon><OmniIcon Name="OmniIconName.Settings" /></Icon><ChildContent><span>@L["Configuration"]</span></ChildContent>
                </OmniButton>
            }
            @* Group agent actions, configuration import/export and port checks in Tools. Port
               checks require only Read, so the menu itself is not gated on write permission. *@
            <OmniOverflowMenu Label="@L["Tools"]">
                @if (_canWrite)
                {
                    <OmniMenuItem OnClick="@OpenContactAgentDialog"><Icon><OmniIcon Name="OmniIconName.CellTower" /></Icon><ChildContent>@L["ContactAgent"]</ChildContent></OmniMenuItem>
                    <OmniMenuItem OnClick="@UpdateAgentAsync"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent>@L["UpdateAgent"]</ChildContent></OmniMenuItem>
                    @* R3-58: the installer's --enable-* flags exist on Linux only. *@
                    @if (CanEnableAgentCapabilities)
                    {
                        <OmniMenuItem OnClick="@OpenAgentCapabilitiesDialog"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent>@L["EnableAgentCapabilities"]</ChildContent></OmniMenuItem>
                    }
                    <OmniMenuItem OnClick="@GoToConfiguration"><Icon><OmniIcon Name="OmniIconName.Upload" /></Icon><ChildContent>@L["ImportYaml"]</ChildContent></OmniMenuItem>
                }
                <OmniMenuItem OnClick="@GoToConfiguration"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent>@L["ExportYaml"]</ChildContent></OmniMenuItem>
                <OmniMenuItem OnClick="@OpenPortCheckDialog"><Icon><OmniIcon Name="OmniIconName.MagnifyingGlassPlus" /></Icon><ChildContent>@L["CheckPorts"]</ChildContent></OmniMenuItem>
                @if (_canWrite)
                {
                    <OmniMenuItem OnClick="@OnRetireServer" Disabled="@_deleteBusy"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["RetireServer"]</ChildContent></OmniMenuItem>
                }
            </OmniOverflowMenu>
            }
        </text>;
    }
    <OmniDetailShell State="@DetailState" BackHref="/servers" BackText="@L["BackToServers"]" NotFoundTitle="@L["ServerNotFound"]">
        <HeaderContent>
            @* The section is the title and breadcrumb leaf; the server name is an ancestor. *@
            <OmniPageHeader ShowBack="true" BackHref="@BackHref" Subtitle="@Breadcrumb.Subtitle()" ActionsContent="@headerActions">
                <Icon><OmniIcon Name="@MaterialIconMap.Resolve(SectionIcon)" /></Icon>
            </OmniPageHeader>
        </HeaderContent>
        <ChildContent>
            @if (Loader.Server is not null)
            {
                @if (_editVisible)
                {
                    <OmniCard Class="omni-u-mb-lg edit-panel">
                        <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mb-sm">@L["EditServer"]</OmniHeading>
                        <OmniRow Gap="OmniSpacing.Large">
                            <OmniColumn Span="12" MediumSpan="6">
                                <OmniStack Gap="OmniSpacing.XSmall">
                                    <OmniLabel For="server-edit-name">@L["Name"]</OmniLabel>
                                    <OmniTextBox Id="server-edit-name" @bind-Value="_editName" maxlength="100" />
                                </OmniStack>
                            </OmniColumn>
                            <OmniColumn Span="6" MediumSpan="3">
                                <OmniStack Gap="OmniSpacing.XSmall">
                                    <OmniLabel For="server-edit-type">@L["Type"]</OmniLabel>
                                    <OmniDropDown Id="server-edit-type" TValue="ServerType" name="server-edit-type" Options="@(_serverTypes.ToOptions(item => (ServerType)item, item => item))" @bind-Value="_editType" />
                                </OmniStack>
                            </OmniColumn>
                            <OmniColumn Span="6" MediumSpan="3">
                                <OmniStack Gap="OmniSpacing.XSmall">
                                    <OmniLabel For="server-edit-tags">@L["TagsCommaSeparated"]</OmniLabel>
                                    <OmniTextBox Id="server-edit-tags" @bind-Value="_editTags" />
                                </OmniStack>
                            </OmniColumn>
                        </OmniRow>
                        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Class="omni-u-mt-md">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SaveEditAsync" Class="@(_editSaving ? "btn-busy" : null)" Busy="@(_editSaving)"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
                            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => _editVisible = false)"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@L["Cancel"]</span></ChildContent></OmniButton>
                        </OmniStack>
                    </OmniCard>
                }

                <AgentUpdateProgressCard @ref="_agentUpdateProgress" ServerId="Loader.Server.Id" Hub="Loader.Hub"
                    Request="@Loader.Server.AgentUpdateRequest"
                    OnRetry="@UpdateAgentAsync" OnStale="@ReloadAgentUpdateAsync" />
            }
            <div class="blade-content">
                @Body
            </div>
        </ChildContent>
    </OmniDetailShell>
</CascadingValue>
