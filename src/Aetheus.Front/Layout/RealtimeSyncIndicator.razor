@* Cover the page while foreground catch-up is running so stale content cannot be used. End the
   overlay on completion or SafetyTimeout, and give the connection-lost overlay precedence. *@
@if (Visible)
{
    <div class="realtime-sync-indicator" data-testid="realtime-sync-indicator" role="status" aria-live="polite" aria-busy="true">
        <div class="realtime-sync-card">
            <AetheusLoader Size="OmniControlSize.Large" />
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0 realtime-sync-text">@L["RealtimeSyncInProgress"]</OmniText>
        </div>
    </div>
}
