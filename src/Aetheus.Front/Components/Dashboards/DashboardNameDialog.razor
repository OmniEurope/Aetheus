<OmniStack Gap="OmniSpacing.Large">
    <OmniFormField Label="@L["Name"]" For="dashboard-name-input">
        <div @onkeydown="@OnKeyDown"><OmniTextBox @bind-Value="_value" Id="dashboard-name-input" /></div>
    </OmniFormField>
    <Aetheus.Front.Components.Shared.DialogFooter OnCancel="@(() => Dialog.Close())">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@Save" Disabled="@string.IsNullOrWhiteSpace(_value)"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
    </Aetheus.Front.Components.Shared.DialogFooter>
</OmniStack>
