@page "/admin/dashboards"
@page "/dashboards"

<PageTitle>@L["Dashboards"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["Dashboards"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("space_dashboard")" /></Icon>
    <Badges>
        <HelpLink PageKey="dashboards" />
    </Badges>
    <ActionsContent>
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@CreateDashboard"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
    </ActionsContent>
</OmniPageHeader>

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else if (_dashboards.Count == 0)
{
    @* B-bis: no blue Info banner - use the shared empty state with a create action. *@
    <EmptyState Icon="dashboard" Title="@L["NoRecords"]">
        <ActionContent>
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@CreateDashboard"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
        </ActionContent>
    </EmptyState>
}
else
{
    @* R-3: the dashboards are OE cards of one OmniTileGrid (same width, same height). *@
    <OmniTileGrid Columns="3" Gap="OmniSpacing.Large">
        @foreach (var dashboard in _dashboards)
        {
                <OmniCard Class="omni-u-p-lg">
                    <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Gap="OmniSpacing.Large">
                        <OmniHeading Level="OmniHeadingLevel.H5">@dashboard.Name</OmniHeading>
                        @if (dashboard.IsDefault)
                        {
                            <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.Star))" Fill="OmniFill.Solid" Tone="OmniTone.Success">@L["IsDefault"]</OmniBadge>
                        }
                    </OmniStack>
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-mt-sm">
                        @dashboard.Widgets.Count @L["Widgets"]
                    </OmniText>
                    <OmniText Element="OmniTextElement.Caption" Tone="OmniTextTone.Muted" Class="omni-u-mt-xs">
                        @dashboard.CreatedAt.ToString("g")
                    </OmniText>
                    @* STD-BTN detection 11: Edit visible, the other actions in the menu. *@
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mt-md">
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => EditDashboard(dashboard))"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent><span>@L["Edit"]</span></ChildContent></OmniButton>
                        <OmniOverflowMenu Label="@L["MoreActions"]">
                            <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => DeleteDashboard(dashboard.Id))"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["Delete"]</ChildContent></OmniMenuItem>
                        </OmniOverflowMenu>
                    </OmniStack>
                </OmniCard>
        }
    </OmniTileGrid>
}
