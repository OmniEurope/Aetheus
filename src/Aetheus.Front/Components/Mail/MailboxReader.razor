@* One message. The HTML arrives sanitized by the backend (no script, no event handler, no remote
   resource unless "Show images" fetched it through the backend); the page's own Content Security
   Policy still refuses any remote image or script that would slip through. *@
<OmniCard Class="mailbox-reader">
    <Header>
        <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0 mailbox-reader-subject">@Subject</OmniText>
    </Header>
    <ChildContent>
        <OmniStack Gap="OmniSpacing.Medium">
            @* Recette R3-52: one visible action (Répondre, grey: Écrire is the page's blue one), the others in the
               menu beside it; deleting sits there in red, no longer as a red button among the others. *@
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="mailbox-reader-actions">
                <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@(!CanWrite)" OnClick="@(() => OnCompose.InvokeAsync(MailboxComposeMode.Reply))" Class="mailbox-reply"><OmniIcon Name="@MaterialIconMap.Resolve("undo")" /> <span>@L["MailboxReply"]</span></OmniButton>
                <OmniOverflowMenu Label="@L["MoreActions"]" Disabled="@(!CanWrite)" Class="mailbox-reader-more">
                    <OmniMenuItem OnClick="@(() => OnCompose.InvokeAsync(MailboxComposeMode.ReplyAll))"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("group")" /></Icon><ChildContent>@L["MailboxReplyAll"]</ChildContent></OmniMenuItem>
                    <OmniMenuItem OnClick="@(() => OnCompose.InvokeAsync(MailboxComposeMode.Forward))"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("arrow_forward")" /></Icon><ChildContent>@L["MailboxForward"]</ChildContent></OmniMenuItem>
                    <OmniMenuItem OnClick="@(() => OnToggleRead.InvokeAsync())"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(Message.IsRead ? "visibility_off" : "visibility")" /></Icon><ChildContent>@(Message.IsRead ? L["MailboxMarkUnread"] : L["MailboxMarkRead"])</ChildContent></OmniMenuItem>
                    <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => OnDelete.InvokeAsync())"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["Delete"]</ChildContent></OmniMenuItem>
                </OmniOverflowMenu>
            </OmniStack>
            <OmniDescriptionList Columns="2">
                <OmniDescriptionItem Label="@L["MailboxFrom"]">@Message.From</OmniDescriptionItem>
                <OmniDescriptionItem Label="@L["Date"]">@Message.Date.ToString("g")</OmniDescriptionItem>
                <OmniDescriptionItem Label="@L["MailboxTo"]">@Message.To</OmniDescriptionItem>
                @if (!string.IsNullOrWhiteSpace(Message.Cc))
                {
                    <OmniDescriptionItem Label="@L["MailboxCc"]">@Message.Cc</OmniDescriptionItem>
                }
            </OmniDescriptionList>
            @if (Message.BlockedRemoteImages > 0)
            {
                <OmniAlert Severity="OmniSeverity.Info" Class="mailbox-images-blocked">
                    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Wrap="true">
                        <OmniText>@string.Format(L["MailboxImagesBlocked"], Message.BlockedRemoteImages)</OmniText>
                        <OmniButton Variant="OmniButtonVariant.Secondary" Busy="@LoadingImages" OnClick="@(() => OnLoadImages.InvokeAsync())"><OmniIcon Name="@MaterialIconMap.Resolve("photo_library")" /> <span>@L["MailboxLoadImages"]</span></OmniButton>
                    </OmniStack>
                </OmniAlert>
            }
            @if (Message.Attachments.Count > 0)
            {
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Wrap="true" Class="mailbox-attachments">
                    <OmniText Element="OmniTextElement.Strong">@L["MailboxAttachments"]</OmniText>
                    @foreach (var attachment in Message.Attachments)
                    {
                        <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="@(() => OnDownload.InvokeAsync(attachment))" title="@L["Download"]"><OmniIcon Name="OmniIconName.Download" /> <span>@attachment.FileName</span></OmniButton>
                    }
                </OmniStack>
            }
            @if (Message.Html is not null)
            {
                @* Custom Aetheus, no OE equivalent: a sandboxed frame without script, form or same-origin
                   right, so the message can neither run code nor reach the page, its styles stay inside it,
                   and Blazor never re-creates a script from it (no MarkupString). Links open in a new tab. *@
                <iframe class="mailbox-html" sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"
                    title="@Subject" srcdoc="@Document"></iframe>
            }
            else
            {
                <pre class="mailbox-text">@Message.Text</pre>
            }
        </OmniStack>
    </ChildContent>
</OmniCard>
