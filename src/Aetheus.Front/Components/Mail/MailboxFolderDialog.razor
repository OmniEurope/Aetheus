@* The name of a new folder at the top of the mailbox. No field takes the focus on open. *@
<OmniTemplateForm TModel="MailboxFolderModel" Model="@_model" OnValidSubmit="@Submit">
    <OmniDataAnnotationsValidator Localizer="@L" />
    <OmniFormField Label="@L["MailboxFolderName"]" Help="@L["MailboxFolderNameRule"]" For="mailbox-folder-name">
        <OmniTextBox Id="mailbox-folder-name" @bind-Value="_model.Name" Autocomplete="off" />
    </OmniFormField>
    <ValidationMessage For="@(() => _model.Name)" />
    <DialogFooter OnCancel="@(() => Dialog.Close())">
        <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
    </DialogFooter>
</OmniTemplateForm>
