@* SPDX-License-Identifier: EUPL-1.2 *@
@* The integrated mailbox of one account. Locked until the reader types the mailbox password (held
   by the backend in memory only); then folders, the messages of the chosen folder and the reading
   pane beside them. On a narrow screen the folders, the list and the message stack one above the other. *@
@using Microsoft.AspNetCore.Components.Sections
@if (Unlocked)
{
    @* Recette R-109 (rule 1 of R-30) after R3-52: one main action (Écrire) in the server page's header, on the
       title line, the others in the menu beside it; the way back is that header's back button. *@
    <SectionContent SectionName="@PageHeaderActions.SectionName">
        <OmniButton Variant="OmniButtonVariant.Primary" Disabled="@(!CanWrite)" OnClick="@(() => ComposeAsync(MailboxComposeMode.New))" Class="mailbox-compose"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent><span>@L["MailboxCompose"]</span></ChildContent></OmniButton>
        <OmniOverflowMenu Label="@L["MoreActions"]" Class="mailbox-more-actions">
            <OmniMenuItem OnClick="@RefreshAsync"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["Refresh"]</ChildContent></OmniMenuItem>
            <OmniMenuItem OnClick="@CreateFolderAsync" Disabled="@(!CanWrite)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("note_add")" /></Icon><ChildContent>@L["MailboxNewFolder"]</ChildContent></OmniMenuItem>
            <OmniMenuItem OnClick="@LockAsync"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("lock")" /></Icon><ChildContent>@L["MailboxLock"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    </SectionContent>
}

<OmniStack Gap="OmniSpacing.Medium" Class="mailbox-view">
    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Wrap="true" Class="mailbox-header">
        @* The way back to the mail accounts is a link, not a button: the page header keeps its one main action. *@
        <OmniLink Href="@($"/servers/{ServerId}/mail?tab=accounts")" Class="mailbox-back">@L["Back"]</OmniLink>
        <OmniText Element="OmniTextElement.Strong" Class="mailbox-address">@(_access?.Email ?? string.Empty)</OmniText>
        @if (_access is { IsUnlocked: true, UnlockedUntil: { } until })
        {
            <NumberBadge Tone="OmniTone.Success" Fill="OmniFill.Tonal">@string.Format(L["MailboxUnlockedUntil"], until.ToString("t"))</NumberBadge>
        }
        @if (_access is { IsUnlocked: true, OpenedAsAdministrator: true })
        {
            @* Recette R1-41: the reader sees that this opening went through the administrator access (audited). *@
            <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Warning))" Tone="OmniTone.Warning" Fill="OmniFill.Tonal" Class="mailbox-admin-badge">@L["MailboxOpenedAsAdministrator"]</OmniBadge>
        }
    </OmniStack>

    @if (_failed)
    {
        <OmniAlert Severity="OmniSeverity.Danger" Class="mailbox-failed">@L["LoadFailed"]</OmniAlert>
    }
    else if (_access is null)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
    }
    else if (!Unlocked)
    {
        <OmniAlert Severity="OmniSeverity.Warning" Class="mailbox-locked">
            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Wrap="true">
                <OmniText>@L["MailboxLocked"]</OmniText>
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@UnlockAsync"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("lock_open")" /></Icon><ChildContent><span>@L["MailboxUnlock"]</span></ChildContent></OmniButton>
            </OmniStack>
        </OmniAlert>
    }
    else
    {
        @* Recette R3-52: a modern mail layout. Folders on the left, the messages of the folder, the message read
           beside them on a wide screen (below them on a medium one); on a phone everything stacks. *@
        <OmniRow Class="mailbox-layout">
            <OmniColumn Span="12" MediumSpan="3" LargeSpan="2">
                <nav class="mailbox-folders" aria-label="@L["MailboxFolders"]">
                    <OmniDataList TItem="MailboxFolderDto" Items="@_folders">
                        <ItemTemplate Context="folder">
                            <OmniButton Variant="@(folder.Path == _folder ? OmniButtonVariant.Secondary : OmniButtonVariant.Ghost)" Class="mailbox-folder"
                                OnClick="@(() => SelectFolderAsync(folder.Path))" aria-current="@(folder.Path == _folder ? "true" : null)">
                                <Icon><OmniIcon Name="@MaterialIconMap.Resolve(FolderIcon(folder.Role))" /></Icon><ChildContent><span class="mailbox-folder__name">@FolderLabel(folder)</span>
                                @if (folder.Unread > 0)
                                {
                                    <NumberBadge Tone="OmniTone.Accent">@folder.Unread</NumberBadge>
                                }</ChildContent>
                            </OmniButton>
                        </ItemTemplate>
                        <EmptyContent>@L["MailboxNoFolders"]</EmptyContent>
                    </OmniDataList>
                </nav>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="9" LargeSpan="4">
                <AetheusDataGrid @ref="_grid" TItem="MailboxMessageSummaryDto" Data="@_messages" Count="@_total" IsLoading="@_loading"
                    LoadData="@LoadMessagesAsync" KeyProperty="Uid" PageSize="25" ExportRead="@ReadExportAsync" ExportName="@L["Mailbox"]"
                    EmptyText="@L["MailboxNoMessages"]" RowClick="@OpenAsync" RowRender="@OnMessageRowRender" Class="mailbox-messages"
                    AllowAlternatingRows="false" ShowHeaderFilterMenu="false"
                    Virtualize="@AetheusGrid.RemoteVirtualization"
                    VirtualData="@(() => new OmniDataGridResult<MailboxMessageSummaryDto>(_messages, _total))">
                    <Columns>
                        <OmniDataGridColumn TItem="MailboxMessageSummaryDto" Property="Subject" Truncate="true" Title="@L["MailboxMessages"]" MinWidth="16rem" Sortable="false" Filterable="false">
                            <Template Context="m">
                                <OmniStack Gap="OmniSpacing.XSmall" Class="mailbox-message">
                                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                                        <OmniText Element="@(m.IsRead ? OmniTextElement.Span : OmniTextElement.Strong)" Truncate="true" Class="mailbox-message__from">@m.From</OmniText>
                                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 mailbox-message__date">@m.Date.ToString("g")</OmniText>
                                    </OmniStack>
                                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                        @if (!m.IsRead)
                                        {
                                            <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.Envelope))" Tone="OmniTone.Accent">@L["MailboxUnread"]</OmniBadge>
                                        }
                                        @if (m.HasAttachments)
                                        {
                                            <OmniIcon Name="@MaterialIconMap.Resolve("link")" title="@L["MailboxAttachments"]" />
                                        }
                                        <OmniText Element="@(m.IsRead ? OmniTextElement.Span : OmniTextElement.Strong)" Truncate="true" Class="mailbox-message__subject">@m.Subject</OmniText>
                                    </OmniStack>
                                </OmniStack>
                            </Template>
                        </OmniDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </OmniColumn>
            <OmniColumn Span="12" LargeSpan="6">
                @if (_message is not null)
                {
                    <MailboxReader Message="@_message" CanWrite="@CanWrite" LoadingImages="@_loadingImages"
                        OnCompose="@ComposeAsync" OnToggleRead="@ToggleReadAsync" OnDelete="@DeleteAsync"
                        OnLoadImages="@LoadImagesAsync" OnDownload="@DownloadAsync" />
                }
                else
                {
                    <OmniCard Class="mailbox-reader-empty">
                        <EmptyState Icon="inbox" Title="@L["MailboxSelectMessage"]" />
                    </OmniCard>
                }
            </OmniColumn>
        </OmniRow>
    }

    <MailClientSettingsHelp ServerId="@ServerId" Email="@_access?.Email" />
</OmniStack>
