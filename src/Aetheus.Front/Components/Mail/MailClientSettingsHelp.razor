@* How to read the mailboxes in an external mail client, as a card under the mailbox or alone in a
   dialog opened from the accounts tab. *@
@if (InDialog)
{
    <MailClientSettings ServerId="@ServerId" Email="@Email" />
    <DialogFooter CancelText="@L["Close"]" OnCancel="@(() => Dialog.Close())" />
}
else
{
    <OmniCard Class="mail-client-help">
        <HeaderContent>
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["MailClientHelpTitle"]</OmniText>
        </HeaderContent>
        <ChildContent>
            <MailClientSettings ServerId="@ServerId" Email="@Email" />
        </ChildContent>
    </OmniCard>
}
