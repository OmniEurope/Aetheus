@* Recette R1-17: the mailbox password, typed to unlock the integrated mailbox. Checked by the server's
   own login before Aetheus holds it, in memory only. No field takes the focus on open.
   Recette R1-41 / R3-50: an administrator of a server whose administrator access is prepared opens the
   mailbox without its password (the main action, traced in the audit log); typing it stays possible. *@
<OmniTemplateForm TModel="MailboxUnlockModel" Model="@_model" OnValidSubmit="@UnlockAsync">
    <OmniDataAnnotationsValidator Localizer="@L" />
    <OmniStack Gap="OmniSpacing.Medium">
        @if (CanOpenAsAdministrator)
        {
            <OmniAlert Severity="OmniSeverity.Info" Class="mailbox-admin-open">
                <OmniStack Gap="OmniSpacing.Small">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["MailboxAdminOpenExplain"]</OmniText>
                    @if (_adminError is not null)
                    {
                        <OmniText Element="OmniTextElement.Paragraph" Tone="OmniTextTone.Danger" Class="omni-u-m-0 mailbox-admin-open-error">@_adminError</OmniText>
                    }
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small">
                        <OmniButton Variant="OmniButtonVariant.Primary" Busy="@_adminBusy" Class="mailbox-admin-open-button" OnClick="@OpenAsAdministratorAsync"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("admin_panel_settings")" /></Icon><ChildContent><span>@L["MailboxAdminOpen"]</span></ChildContent></OmniButton>
                    </OmniStack>
                </OmniStack>
            </OmniAlert>
        }
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["MailboxUnlockExplain"]</OmniText>
        <OmniFormField Label="@L["Password"]" For="mailbox-unlock-password" Error="@_error">
            <OmniPassword Id="mailbox-unlock-password" @bind-Value="_model.Password" />
        </OmniFormField>
        <ValidationMessage For="@(() => _model.Password)" />
    </OmniStack>
    <DialogFooter OnCancel="@(() => Dialog.Close())">
        @if (CanOpenAsAdministrator)
        {
            <OmniButton Variant="OmniButtonVariant.Secondary" ButtonType="OmniButtonType.Submit" Busy="@_busy"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("lock_open")" /></Icon><ChildContent><span>@L["MailboxUnlock"]</span></ChildContent></OmniButton>
        }
        else
        {
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Busy="@_busy"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("lock_open")" /></Icon><ChildContent><span>@L["MailboxUnlock"]</span></ChildContent></OmniButton>
        }
    </DialogFooter>
</OmniTemplateForm>
