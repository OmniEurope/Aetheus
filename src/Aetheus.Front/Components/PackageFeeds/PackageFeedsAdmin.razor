@inherits Aetheus.Front.Components.Shared.RealtimeAdminGridPageBase<PackageFeedDto>
@page "/admin/package-feeds"

<PageTitle>@L["PackageFeeds"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["PackageFeeds"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("inventory")" /></Icon>
    <ActionsContent>
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenCreateAsync"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
    </ActionsContent>
    <Filters>
        <OmniTextBox aria-label="@L["Search"]" Placeholder="@L["Search"]" @bind-Value="_search"
            @bind-Value:after="ResetSearchAsync" Class="pipeline-list-search" />
    </Filters>
</OmniPageHeader>

<AetheusDataGrid @ref="_grid" RowClick="@(feed => ManagePackagesAsync(feed))" Data="@_feeds" TItem="PackageFeedDto" Count="@_totalCount"
    IsLoading="@_loading" LoadData="@LoadDataAsync" ExportRead="@ReadExportAsync" PageSize="20"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<PackageFeedDto>(_feeds, _totalCount))"
    FullHeight="true">
    <EmptyTemplate>
        <EmptyState Icon="inventory" Title="@L["NoPackageFeeds"]" Description="@L["NoPackageFeedsDescription"]" />
    </EmptyTemplate>
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="PackageFeedDto" Property="Name" Title="@L["Name"]" Filterable="true" />
        <OmniDataGridColumn TItem="PackageFeedDto" Property="FeedType" Title="@L["Type"]" Width="120px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@FeedTypeText" >
            <Template Context="f"><OmniBadge Icon="@(BadgeIcon.For(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L.Localize(f.FeedType)</OmniBadge></Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="PackageFeedDto" Property="UpstreamUrl" Title="@L["UpstreamUrl"]" Filterable="true" >
            <Template Context="f"><span class="text-mono">@f.UpstreamUrl</span></Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="PackageFeedDto" Property="PackageCount" Title="@L["Packages"]" Width="100px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="PackageFeedDto" Title="@L["Actions"]" Width="200px" Sortable="false" Filterable="false" >
            <Template Context="f">
                <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ManagePackagesAsync(f))" title="@L["ManagePackages"]" Label="@L["ManagePackages"]"><Icon><OmniIcon Name="OmniIconName.Archive" /></Icon></OmniButton>
                <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteAsync(f))" title="@L["Delete"]" Label="@L["Delete"]"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton>
                </span>
            </Template>
        </OmniDataGridColumn>
    </Columns>
</AetheusDataGrid>
