@* R-99: OE's veil lies over the dialog while a package is being removed; its content stays mounted under it. *@
<OmniStack Class="@(_removing ? "omni-busy" : null)" aria-busy="@(_removing ? "true" : "false")" data-testid="package-feed-packages-zone">
<OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
        <OmniTextBox aria-label="@L["PackageName"]" @bind-Value="_newPackage" Placeholder="@L["PackageName"]" Class="omni-u-grow" />
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@AddAsync" Disabled="@string.IsNullOrWhiteSpace(_newPackage)" Class="@(_adding ? "btn-busy" : null)" Busy="@(_adding)"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Add"]</span></ChildContent></OmniButton>
        @* STD-BTN detection 11: Add visible, the other actions in the menu. *@
        <OmniOverflowMenu Label="@L["MoreActions"]">
            <OmniMenuItem OnClick="@SyncAsync" Disabled="@(_syncing)"><Icon><OmniIcon Name="OmniIconName.Sync" /></Icon><ChildContent>@L["SyncNow"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    </OmniStack>

    @if (_lastSync is not null)
    {
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">
            @string.Format(L["PackageFeedSyncSummary"], _lastSync.Synced, _lastSync.Failed, _lastSync.Unsupported)
            @if (!string.IsNullOrEmpty(_lastSync.Message)) { <span> - @_lastSync.Message</span> }
        </OmniText>
    }

    <AetheusDataGrid @ref="_grid" IsLoading="@_loading" Data="@_packages" TItem="PackageEntryDto" KeyProperty="Id" Virtualize="true" NewRowHighlight="@NewRowHighlight">
        <EmptyTemplate>
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-p-lg">@L["NoTrackedPackages"]</OmniText>
        </EmptyTemplate>
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="PackageEntryDto" Property="Name" Title="@L["PackageName"]" Filterable="true" />
            <OmniDataGridColumn TItem="PackageEntryDto" Property="LatestVersion" Title="@L["LatestVersion"]" Width="8.75rem" Filterable="true">
                <Template Context="p">
                    @if (string.IsNullOrEmpty(p.LatestVersion))
                    {
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["NotSyncedYet"]</OmniText>
                    }
                    else
                    {
                        <span class="text-mono">@p.LatestVersion</span>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PackageEntryDto" Property="LastSyncedAt" Title="@L["LastFetched"]" Width="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true">
                <Template Context="p">@(p.LastSyncedAt.Year < 2000 ? "-" : p.LastSyncedAt.ToString("g"))</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PackageEntryDto" Title="" Width="3.5rem" Sortable="false" TextAlign="OmniAlignment.Center">
                <Template Context="p">
                    <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => RemoveAsync(p))" title="@L["Delete"]" Label="@L["Delete"]"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>

    <DialogFooter CancelText="@L["Close"]" OnCancel="@Close" />
</OmniStack>
