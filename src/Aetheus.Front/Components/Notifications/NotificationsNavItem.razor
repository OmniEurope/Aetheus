@* The sidebar Notifications entry uses the same unread count as the header bell and the Alerts
   entry layout. *@

<div class="nav-alert-item">
    <OmniPanelMenuItem Text="@L["MyNotifications"]" Icon="@BellIcon" Href="notifications"
                       aria-describedby="@(Feed.UnreadCount > 0 ? "nav-notification-count" : null)" />
    @if (Feed.UnreadCount > 0)
    {
        <NumberBadge Id="nav-notification-count" Fill="OmniFill.Solid" Tone="OmniTone.Success" Class="nav-alert-count"
                   title="@string.Format(L["NotificationBellTooltip"], Feed.UnreadCount)">
            @DisplayFormatting.BadgeCount(Feed.UnreadCount)
        </NumberBadge>
    }
</div>
