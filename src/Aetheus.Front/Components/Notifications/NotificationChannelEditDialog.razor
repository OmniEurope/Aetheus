@inherits EntityEditDialogBase

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else if (!CanSubmit)
{
    <OmniAlert Severity="@(_notFound ? OmniSeverity.Warning : OmniSeverity.Danger)">@(_notFound ? L["NotificationChannelNotFound"] : L["LoadFailed"])</OmniAlert>
    <DialogFooter OnCancel="@Cancel" />
}
else
{
    <OmniTemplateForm TModel="EditModel" Model="@_model" OnValidSubmit="@SubmitAsync">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniRow Gap="OmniSpacing.Large">
            <OmniColumn Span="12" MediumSpan="6">
                <OmniFormField For="oe-pages-notifications-notificationchanneleditdialog-1" Class="omni-u-w-100"><LabelContent>@L["Name"]</LabelContent><ChildContent>
                    <OmniTextBox @bind-Value="_model.Name" Id="oe-pages-notifications-notificationchanneleditdialog-1" />
                </ChildContent></OmniFormField>
                <ValidationMessage For="@(() => _model.Name)" />
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OmniFormField Label="@L["Type"]" Class="omni-u-w-100" For="oe-formfield-pages-notifications-notificationchanneleditdialog-1">
                    <OmniDropDown Id="oe-formfield-pages-notifications-notificationchanneleditdialog-1" @bind-Value="_model.Type" Options="@_types" Disabled="@IsEdit" />
                </OmniFormField>
            </OmniColumn>
            @if (IsEdit)
            {
                <OmniColumn Span="12">
                    <OmniSwitch @bind-Value="_model.IsEnabled">@L["Active"]</OmniSwitch>
                </OmniColumn>
            }
            <OmniColumn Span="12">
                <OmniFormField For="oe-pages-notifications-notificationchanneleditdialog-3" Help="@L["NotificationChannelConfigHint"]" Class="omni-u-w-100"><LabelContent>@L["ChannelConfiguration"]</LabelContent><ChildContent>
                    <OmniTextArea @bind-Value="_model.ConfigurationJson" Rows="5" Class="text-mono" Id="oe-pages-notifications-notificationchanneleditdialog-3" />
                </ChildContent></OmniFormField>
            </OmniColumn>
        </OmniRow>
        <DialogFooter OnCancel="@Cancel">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((IsEdit ? "save" : "add"))" /></Icon><ChildContent><span>@(IsEdit ? L["Save"] : L["Create"])</span></ChildContent></OmniButton>
        </DialogFooter>
    </OmniTemplateForm>
}
