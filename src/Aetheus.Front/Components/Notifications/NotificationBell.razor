@* The bell shares UserNotificationsFeed.UnreadCount with the menu and inbox. OmniPopover closes on
   outside clicks or Escape without intercepting the page pointer. *@

<div class="task-tracker-container omni-task-tracker notification-bell">
    @* The bell uses the user-approved success colour to distinguish it from tasks.
       ButtonRoleColourGuardTests records this STD-BTN exception. *@
    <OmniPopover Id="notification-bell" Class="header-popover"
                 Open="@_popoverOpen" OpenChanged="OnOpenChangedAsync"
                 TriggerVariant="OmniButtonVariant.Success"
                 TriggerClass="@(Feed.UnreadCount > 0 ? "header-action-btn task-tracker-btn task-tracker-btn-wide notification-bell-btn" : "header-action-btn task-tracker-btn notification-bell-btn")"
                 TriggerTitle="@string.Format(L["NotificationBellTooltip"], Feed.UnreadCount)"
                 Label="@string.Format(L["NotificationBellTooltip"], Feed.UnreadCount)"
                 PopupLabel="@L["MyNotifications"]">
        <TriggerContent>
            <OmniIcon Name="OmniIconName.Bell" Class="header-icon" />
            @if (Feed.UnreadCount > 0)
            {
                <span class="task-tracker-count notification-bell-count">@(Feed.UnreadCount > 99 ? "99+" : Feed.UnreadCount.ToString(System.Globalization.CultureInfo.CurrentCulture))</span>
            }
        </TriggerContent>
        <ChildContent>
            <div class="task-tracker-popover">
                <div class="task-tracker-header">
                    <OmniHeading Level="OmniHeadingLevel.H5">@L["MyNotifications"]</OmniHeading>
                    @if (Feed.UnreadCount > 0)
                    {
                        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Success">@string.Format(L["NotificationUnreadCount"], Feed.UnreadCount)</OmniBadge>
                    }
                </div>
                @* The recipients of a project event are the project's followers; a user who
                   follows nothing receives nothing, and is told so with the way out. *@
                @if (_followsNothing)
                {
                    <OmniEmptyState Class="notification-bell-no-subscription" Title="@L["NotificationSubscriptionsEmpty"]"
                                    Description="@L["NotificationNoSubscriptionHint"]">
                        <Icon><OmniIcon Name="OmniIconName.BellSlash" /></Icon>
                        <Actions>
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="FollowAllAsync" Busy="@_followingAll"
                                        Class="notification-bell-follow-all" title="@L["NotificationFollowAllProjects"]">
                                <OmniIcon Name="OmniIconName.Bell" />
                                <span>@L["NotificationFollowAll"]</span>
                            </OmniButton>
                            @* Settings is a link beside the one action (user decision, 2026-10-17). *@
                            <OmniLink Href="/settings?tab=notifications" OnClick="@ClosePopover"
                                      Class="notification-bell-preferences">@L["Settings"]</OmniLink>
                        </Actions>
                    </OmniEmptyState>
                }
                <div class="task-tracker-list">
                    @* The hint above already says why the list is empty. *@
                    @if (Feed.Latest.Count == 0 && !_followsNothing)
                    {
                        <div class="task-tracker-empty">
                            <OmniIcon Name="OmniIconName.Tray" Class="task-tracker-empty-icon" />
                            <OmniText Tone="OmniTextTone.Muted">@L["NotificationsEmpty"]</OmniText>
                        </div>
                    }
                    else
                    {
                        @foreach (var delivery in Feed.Latest)
                        {
                            @* One icon, on the left, for what happened; an unread row reads in
                               bold instead of carrying a read or status icon. *@
                            <a href="/notifications" class="@(delivery.ReadAt is null ? "task-tracker-row notification-bell-row notification-bell-row--unread" : "task-tracker-row notification-bell-row")"
                               @onclick="@(() => _popoverOpen = false)">
                                <OmniIcon Name="@NotificationLabels.EventIcon(delivery.EventType)" Class="notification-event-icon" />
                                <div class="task-tracker-row-body">
                                    <div class="task-tracker-row-name">@NotificationLabels.EventLabel(L, delivery.EventType)</div>
                                    <div class="task-tracker-row-meta">
                                        <span title="@delivery.CreatedAt.ToString("g", System.Globalization.CultureInfo.CurrentCulture)">@RelativeTime.FormatAgo(L, delivery.CreatedAt)</span>
                                        · @delivery.Subject
                                    </div>
                                </div>
                            </a>
                        }
                    }
                </div>
                <div class="task-tracker-footer notification-bell-footer">
                    @if (Feed.UnreadCount > 0)
                    {
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="MarkAllReadAsync" Busy="@_busy" Class="@(_busy ? "notification-bell-mark-all btn-busy" : "notification-bell-mark-all")">
                            <OmniIcon Name="OmniIconName.CheckCircle" />
                            <span>@L["NotificationsMarkAllRead"]</span>
                        </OmniButton>
                    }
                    @* "Mark all read" is the footer's action, "See all" a link (user decision, 2026-10-17). *@
                    <OmniLink Href="/notifications" OnClick="@ClosePopover" Class="task-tracker-see-all">@L["SeeAll"]</OmniLink>
                </div>
            </div>
        </ChildContent>
    </OmniPopover>
</div>
