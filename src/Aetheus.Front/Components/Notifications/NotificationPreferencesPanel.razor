@inject GridExportContext ExportContext
@* R-116: the notification preferences of /settings, read from and saved to the server
   (api/notifications/me/preferences), one switch per event type of the backend catalogue, and the
   projects the user follows. Each notification is also e-mailed to the account address (R1-16). *@

@* Use the full tab width with two preference tiles per row. *@
<OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Medium" Class="notification-preferences">
    @if (_loading)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
    }
    else if (_loadFailed)
    {
        <OmniText Tone="OmniTextTone.Muted">@L["NotificationPreferencesUnavailable"]</OmniText>
    }
    else
    {
        @* The events are grouped by what raises them, one settings section per group, one tile per
           event with its icon and its switch; the followed projects are a section of their own. *@
        @foreach (var group in Groups)
        {
            @* R-3: OE pairs the settings tiles itself (two per row, stacked on a narrow width). *@
            <OmniSettingsSection Title="@L[group.TitleKey]" Paired="true">
                @foreach (var preference in group.Items)
                {
                    <OmniSettingsTile Title="@PreferenceText(preference)" Class="notification-preference-toggle">
                        <Icon><OmniIcon Name="@NotificationLabels.EventIcon(preference.EventType)" /></Icon>
                        <ChildContent>
                            <OmniSwitch Value="@preference.IsEnabled" ValueExpression="@(() => preference.IsEnabled)" aria-label="@PreferenceText(preference)"
                                        ValueChanged="@((bool value) => SaveAsync(preference.EventType, value))" />
                        </ChildContent>
                    </OmniSettingsTile>
                }
            </OmniSettingsSection>
        }

        <OmniSettingsSection Title="@L["NotificationSubscriptions"]" Description="@L["NotificationSubscriptionsHint"]">
            @* Following nothing is why nothing arrives; the empty state says so and offers the way
               out, following every project the user can read. *@
            @if (_subscriptions.Count == 0)
            {
                <OmniEmptyState Class="notification-subscriptions-empty" Title="@L["NotificationSubscriptionsEmpty"]"
                                Description="@L["NotificationNoSubscriptionHint"]">
                    <Icon><OmniIcon Name="OmniIconName.BellSlash" /></Icon>
                    <ActionsContent>
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="FollowAllAsync" Busy="@_followingAll"
                                    Class="notification-follow-all" title="@L["NotificationFollowAllProjects"]">
                            <Icon><OmniIcon Name="OmniIconName.Bell" /></Icon><ChildContent><span>@L["NotificationFollowAll"]</span></ChildContent>
                        </OmniButton>
                    </ActionsContent>
                </OmniEmptyState>
            }
            else
            {
                <div class="notification-subscriptions-actions">
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="FollowAllAsync" Busy="@_followingAll"
                                Class="notification-follow-all" title="@L["NotificationFollowAllProjects"]">
                        <Icon><OmniIcon Name="OmniIconName.Bell" /></Icon><ChildContent><span>@L["NotificationFollowAll"]</span></ChildContent>
                    </OmniButton>
                </div>
                @* Recette R1-56: the followed projects are a compact grid (project link, unfollow), not a mosaic of cards. *@
                <div data-testid="notification-subscriptions">
                    <OmniDataGrid ExportTitle="@ExportContext.Title(L["NotificationSubscriptions"])" ExportFields="@ExportContext.Fields()"
                                  Items="@_subscriptions" TItem="ProjectSubscriptionDto" KeyOf="@(row => row.ProjectId)"
                                  ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
                        <Columns>
                            <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="ProjectSubscriptionDto" Property="ProjectName" Title="@L["Project"]" Filterable="true">
                                <Template Context="subscription">
                                    <OmniLink Href="@($"/projects/{subscription.ProjectId}")">@subscription.ProjectName</OmniLink>
                                </Template>
                            </OmniDataGridColumn>
                            <OmniDataGridColumn TItem="ProjectSubscriptionDto" Title="@L["Actions"]" Width="6rem" Sortable="false" Filterable="false">
                                <Template Context="subscription">
                                    <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => UnsubscribeAsync(subscription))"
                                                Class="notification-unsubscribe" title="@L["Unsubscribe"]" Label="@L["Unsubscribe"]">
                                        <Icon><OmniIcon Name="OmniIconName.BellSlash" /></Icon>
                                    </OmniButton>
                                </Template>
                            </OmniDataGridColumn>
                        </Columns>
                    </OmniDataGrid>
                </div>
            }
        </OmniSettingsSection>
    }
</OmniStack>
