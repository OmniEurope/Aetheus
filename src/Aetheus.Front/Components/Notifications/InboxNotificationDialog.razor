@* One notification opened from its row: the subject, when and how it went, then the elements the
   event carried (its payload), one line each. *@
<OmniStack Gap="OmniSpacing.Medium" Class="notification-detail">
    <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@Notification.Subject</OmniHeading>
    <dl class="notification-detail-facts">
        <dt>@L["Date"]</dt>
        <dd>@Notification.CreatedAt.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture)</dd>
        <dt>@L["NotificationEvent"]</dt>
        <dd>@NotificationLabels.EventLabel(L, Notification.EventType)</dd>
        <dt>@L["NotificationChannel"]</dt>
        <dd>@(Notification.ChannelName ?? L["NotificationChannelNone"].Value)</dd>
        <dt>@L["Status"]</dt>
        <dd><OmniBadge Icon="@(BadgeIcon.ForState(NotificationLabels.StatusVariant(Notification)))" Fill="OmniFill.Solid" Tone="@NotificationLabels.StatusVariant(Notification)">@NotificationLabels.StatusLabel(L, Notification)</OmniBadge></dd>
        @if (!string.IsNullOrWhiteSpace(Notification.ErrorMessage))
        {
            <dt>@L["Error"]</dt>
            <dd>@Notification.ErrorMessage</dd>
        }
    </dl>
    <OmniHeading Level="OmniHeadingLevel.H6" Class="omni-u-m-0">@L["NotificationContent"]</OmniHeading>
    @if (Elements.Count > 0)
    {
        <dl class="notification-detail-facts">
            @foreach (var (name, value) in Elements)
            {
                <dt>@name</dt>
                <dd class="omni-u-mono">@value</dd>
            }
        </dl>
    }
    else
    {
        <OmniText Tone="OmniTextTone.Muted">@L["NotificationNoContent"]</OmniText>
    }
    <DialogFooter OnCancel="@(() => Dialog.Close())" CancelText="@L["Close"]">
        @if (Target is not null)
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@Open"><Icon><OmniIcon Name="OmniIconName.ArrowRight" /></Icon><ChildContent><span>@L["Open"]</span></ChildContent></OmniButton>
        }
    </DialogFooter>
</OmniStack>
