@page "/artifacts/{ArtifactId:int}"

<PageTitle>@(_artifact?.Name ?? L["Artifact"]) - Aetheus</PageTitle>

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else if (_artifact is null)
{
    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["ArtifactNotFound"]</OmniText>
}
else
{
    <OmniPageHeader Title="@_artifact.Name"
        ShowBack="@(!string.IsNullOrWhiteSpace(_artifact.ProjectId.HasValue ? $"/projects/{_artifact.ProjectId}/artifacts" : $"/pipelines/runs/{_artifact.PipelineRunId}"))" Subtitle="@Breadcrumb.Subtitle()">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("inventory_2")" /></Icon>
        <Badges>
            @if (_artifact.ProjectId.HasValue)
            {
                <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.Folder))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral"><EntityNameLink Kind="EntityNameKind.Project" Id="_artifact.ProjectId" Name="@(_artifact.ProjectName ?? L["Project"])" /></OmniBadge>
            }
            <OmniBadge Icon="@(BadgeIcon.For(GetRetentionBadge(_artifact.RetentionPolicy)))" Fill="OmniFill.Solid" Tone="@GetRetentionBadge(_artifact.RetentionPolicy)">@L.Localize(_artifact.RetentionPolicy)</OmniBadge>
        </Badges>
        <ActionsContent>
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="DownloadAsync" Class="@(_downloading ? "btn-busy" : null)" Busy="@(_downloading)"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L["Download"]</span></ChildContent></OmniButton>
        </ActionsContent>
    </OmniPageHeader>

    <OmniStack>
    @* Key facts *@
    <OmniTileGrid Columns="3">
        <OmniCard Class="run-overview-card">
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.HardDrive" Class="run-tile-icon" /> @L["Size"]</OmniText>
            <OmniText Element="OmniTextElement.Paragraph">@DisplayFormatting.Size(_artifact.SizeBytes)</OmniText>
        </OmniCard>
        <OmniCard Class="run-overview-card">
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Timer" Class="run-tile-icon" /> @L["CreatedAt"]</OmniText>
            <OmniText Element="OmniTextElement.Paragraph">@_artifact.CreatedAt.ToString("g")</OmniText>
        </OmniCard>
        <OmniCard Class="run-overview-card">
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Delete" Class="run-tile-icon" /> @L["Retention"]</OmniText>
            <OmniText Element="OmniTextElement.Paragraph" title="@_artifact.RetentionExpiresAt.ToString("F")">@Aetheus.Front.Components.Shared.RelativeTime.FormatUntil(L, _artifact.RetentionExpiresAt)</OmniText>
        </OmniCard>
    </OmniTileGrid>

    @* Provenance (where it comes from) vs Distribution (where it goes). R-3: two OE cards of one OmniTileGrid. *@
    <OmniTileGrid Columns="2" Gap="OmniSpacing.Large">
            <OmniCard>
                <div class="detail-panel-title">
                    <OmniIcon Name="OmniIconName.Graph" Class="run-tile-icon omni-u-text-accent" />
                    <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Provenance"]</OmniText>
                </div>
                @if (!string.IsNullOrEmpty(_artifact.PipelineName))
                {
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Graph" Class="run-tile-icon" /> @L["Pipeline"]</OmniText>
                        <a href="/pipelines/@_artifact.PipelineId" class="detail-value-link">@_artifact.PipelineName</a>
                    </OmniStack>
                }
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Play" Class="run-tile-icon" /> @L["PipelineRun"]</OmniText>
                    <a href="/pipelines/runs/@_artifact.PipelineRunId" class="detail-value-link">#@_artifact.PipelineRunId</a>
                </OmniStack>
                @if (_artifact.Branches.Count > 0)
                {
                    @foreach (var branch in _artifact.Branches)
                    {
                        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.GitFork" Class="run-tile-icon" /> @L["Branch"]</OmniText>
                            <a href="@BranchHref(branch)" class="detail-value-link">@branch.Name</a>
                        </OmniStack>
                    }
                }
                else if (!string.IsNullOrEmpty(_artifact.BranchName))
                {
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.GitFork" Class="run-tile-icon" /> @L["Branch"]</OmniText>
                        <a href="@BranchHref(_artifact.BranchName)" class="detail-value-link">@_artifact.BranchName</a>
                    </OmniStack>
                }
                @if (_artifact.Commits.Count > 0)
                {
                    @foreach (var commit in _artifact.Commits)
                    {
                        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.GitCommit" Class="run-tile-icon" /> @L["Commit"]</OmniText>
                            <ShortId Value="@commit.Sha" Href="@CommitHref(commit)" Copyable="false" Class="text-mono" />
                        </OmniStack>
                    }
                }
                else if (!string.IsNullOrEmpty(_artifact.CommitHash))
                {
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.GitCommit" Class="run-tile-icon" /> @L["Commit"]</OmniText>
                        <ShortId Value="@_artifact.CommitHash" Href="@CommitHref(_artifact.CommitHash)" Copyable="false" Class="text-mono" />
                    </OmniStack>
                }
            </OmniCard>

        @if (HasDistribution)
        {
                <OmniCard>
                    <div class="detail-panel-title">
                        <OmniIcon Name="OmniIconName.RocketLaunch" Class="run-tile-icon omni-u-text-success" />
                        <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Distribution"]</OmniText>
                    </div>
                    @foreach (var release in _artifact.Releases)
                    {
                        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Sparkle" Class="run-tile-icon" /> @L["Release"]</OmniText>
                            <a href="/releases/@release.Id" class="detail-value-link">
                                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                    <ShortId Value="@release.Version" Copyable="false" Class="release-version" />
                                    <ReleaseStatusBadge Status="@release.Status" />
                                </OmniStack>
                            </a>
                        </OmniStack>
                    }
                    @if (!string.IsNullOrEmpty(_artifact.EnvironmentName))
                    {
                        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Cloud" Class="run-tile-icon omni-u-text-warning" /> @L["Environment"]</OmniText>
                            <OmniText Element="OmniTextElement.Paragraph">@_artifact.EnvironmentName</OmniText>
                        </OmniStack>
                    }
                    @if (_artifact.ProjectId.HasValue)
                    {
                        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row">
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Folder" Class="run-tile-icon" /> @L["Project"]</OmniText>
                            <a href="/projects/@_artifact.ProjectId" class="detail-value-link">@(_artifact.ProjectName ?? L["Project"])</a>
                        </OmniStack>
                    }
                </OmniCard>
        }
    </OmniTileGrid>

    @* File details *@
    <OmniCard Class="omni-u-p-lg">
        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
            <OmniIcon Name="OmniIconName.Document" Class="run-tile-icon" />
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Details"]</OmniText>
        </OmniStack>
        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-filepath-box">
            <OmniText Element="OmniTextElement.Paragraph" Class="text-mono">@_artifact.FilePath</OmniText>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="CopyPathAsync" title="@L["Copy"]" Label="@L["Copy"]"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon></OmniButton>
        </OmniStack>
        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-filepath-box omni-u-mt-sm">
            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                <OmniIcon Name="OmniIconName.Tag" Class="run-tile-icon omni-u-text-muted" />
                @if (!string.IsNullOrEmpty(_artifact.Sha256))
                {
                    <OmniText Element="OmniTextElement.Paragraph" Class="text-mono" title="@L["Checksum"]">@_artifact.Sha256</OmniText>
                }
                else
                {
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["ChecksumUnavailable"]</OmniText>
                }
            </OmniStack>
            @if (!string.IsNullOrEmpty(_artifact.Sha256))
            {
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="CopyChecksumAsync" title="@L["Copy"]" Label="@L["Copy"]"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon></OmniButton>
            }
        </OmniStack>
    </OmniCard>
    </OmniStack>
}
