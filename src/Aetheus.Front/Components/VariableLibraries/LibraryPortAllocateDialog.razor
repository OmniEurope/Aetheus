@namespace Aetheus.Front.Components.VariableLibraries
@* Allocate free ports with PORT_ keys so the pipeline preflight guard can recognize them. *@
<OmniStack Gap="OmniSpacing.Large">
    <OmniText Element="OmniTextElement.Paragraph">@L["PortAllocateLibraryHint"]</OmniText>

    @if (_blocker is not null)
    {
        <OmniAlert Severity="OmniSeverity.Warning"><Icon><OmniIcon Name="OmniIconName.Warning" /></Icon><ChildContent>@_blocker</ChildContent></OmniAlert>
    }
    else
    {
        <OmniFormField Label="@L["Server"]" For="alloc-server" Required="true" Class="omni-u-w-100">
            <OmniDropDown Id="alloc-server" name="alloc-server" TValue="int?" Options="@(_servers.ToOptions(item => (int?)item.ServerId, item => item.ServerName))" @bind-Value="_serverId" AllowEmpty="true" Placeholder="@L["Server"]" Class="w-100" />
        </OmniFormField>

        <OmniFormField Label="@L["PortAllocatePreset"]" For="alloc-preset" Class="omni-u-w-100">
            <OmniDropDown Id="alloc-preset" name="alloc-preset" TValue="string" Options="@(Presets.ToOptions(item => item, item => PresetLabel(item)))" @bind-Value="_preset"
                @bind-Value:after="ApplyPreset" Class="w-100" />
        </OmniFormField>

        <OmniFormField Label="@L["PortAllocateKeys"]" For="alloc-keys" Required="true" Class="omni-u-w-100">
            <OmniTextArea Id="alloc-keys" @bind-Value="_keysInput" Rows="4" Class="w-100" />
        </OmniFormField>

        @if (_created.Count == 0)
        {
            var (toCreate, toFill, taken) = KeyPlan();
            <OmniStack Gap="OmniSpacing.XSmall">
                @if (toCreate.Count > 0)
                {
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@string.Format(L["PortAllocateKeysWillBeCreated"].Value, string.Join(", ", toCreate))</OmniText>
                }
                @if (toFill.Count > 0)
                {
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@string.Format(L["PortAllocateKeysWillBeFilled"].Value, string.Join(", ", toFill))</OmniText>
                }
                @if (taken.Count > 0)
                {
                    <OmniAlert Severity="OmniSeverity.Warning"><Icon><OmniIcon Name="OmniIconName.Warning" /></Icon><ChildContent>@string.Format(L["PortAllocateKeysHaveValue"].Value, string.Join(", ", taken))</ChildContent></OmniAlert>
                }
            </OmniStack>
        }

        @if (_created.Count > 0)
        {
            <OmniStack Gap="OmniSpacing.XSmall">
                @foreach (var entry in _created)
                {
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@entry.Key = @entry.Value</OmniText>
                }
            </OmniStack>
        }
    }

    @if (_error is not null)
    {
        <OmniAlert Severity="OmniSeverity.Danger"><Icon><OmniIcon name="OmniIconName.Error" /></Icon><ChildContent>@_error</ChildContent></OmniAlert>
    }

    <DialogFooter OnCancel="@(() => Dialog.Close(_created.Count > 0))">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@AllocateAsync" Disabled="@(_blocker is not null || _serverId is null || HasTakenKeys)" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><Icon><OmniIcon name="OmniIconName.Archive" /></Icon><ChildContent><span>@L["PortAllocate"]</span></ChildContent></OmniButton>
    </DialogFooter>
</OmniStack>
