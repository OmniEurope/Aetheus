<OmniStack Gap="OmniSpacing.Large">
    @if (Branches.Count > 0)
    {
        <OmniFormField Label="@L["CommitBranch"]" For="oe-formfield-pages-pipelines-pipelinesavedialog-1">
            <OmniDropDown Id="oe-formfield-pages-pipelines-pipelinesavedialog-1" TValue="string" Options="@(Branches.ToOptions(item => (string)item, item => item))" Value="_branch" ValueChanged="OnBranchChangedAsync" ValueExpression="@(() => _branch)" />
        </OmniFormField>
    }

    @if (_loading)
    {
        <OmniAlert Severity="OmniSeverity.Info">@L["PipelineSaveRepositoryLoading"]</OmniAlert>
    }
    else if (_repository is null)
    {
        <OmniAlert Severity="OmniSeverity.Warning">@L["PipelineSaveRepositoryUnreadable"]</OmniAlert>
    }
    else if (AdoptsRepositoryFile)
    {
        <OmniAlert Severity="OmniSeverity.Info">@L["PipelineSaveRepositoryFileKept"]</OmniAlert>
    }
    else if (OverwritesRepositoryChange)
    {
        <OmniAlert Severity="OmniSeverity.Warning">@L["PipelineSaveRepositoryChanged"]</OmniAlert>
    }
    else
    {
        <OmniAlert Severity="OmniSeverity.Info">
            @L["PipelineSaveCommitPreview"]
        </OmniAlert>
    }

    <OmniDiffViewer Original="@DiffOriginal" Modified="@DiffModified" Language="yaml" Height="24rem" InteropModulePath="@EditorModules.Frame" ShowNavigation="true" Label="@L["Diff"]" />

    <DialogFooter OnCancel="Cancel">
        <OmniButton Variant="OmniButtonVariant.Primary" Busy="_loading" OnClick="Confirm"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
    </DialogFooter>
</OmniStack>
