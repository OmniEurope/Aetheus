@using static Aetheus.Front.Components.Pipelines.PipelineRunFormatting

@* Recette R-363: the top-level tree scrolls sideways inside its frame when its labels need more
   width than the panel gives; each row's durations sit in .run-tl-times, pinned to the right edge. *@
<div class="@(Depth == 0 ? "run-tree-scroll" : null)">
<div class="run-tree@(Depth > 0 ? " run-tree-nested" : "")">
    @foreach (var stage in _stages)
    {
        var multi = stage.Steps.Count > 1;
        @if (multi)
        {
            <div class="run-tl-row run-tl-stage-header@(stage.IsSystem ? " run-tl-system-row" : "")">
                <span class="run-tl-name run-tl-bold run-tl-name-grow@(stage.IsSystem ? " run-tl-system" : "")">@stage.DisplayName</span>
                @if (stage.SkippedCondition is { Length: > 0 } stageCondition)
                {
                    <span class="run-tl-chip run-tl-skipped" title="@stageCondition">@L["StageSkippedByCondition"]</span>
                }
                else if (RunsConcurrently(stage))
                {
                    <span class="run-tl-chip run-tl-parallel" title="@L["StageRunsInParallelHint"]">@L["StageRunsInParallel"]</span>
                }
                <span class="run-tl-times"><span class="run-tl-dur"><PipelineRunLiveDuration StartedAt="stage.StartedAt" CompletedAt="stage.CompletedAt" IsRunning="@(stage.Status == TaskExecutionStatus.Running)" /></span></span>
            </div>
        }
        @foreach (var step in stage.Steps)
        {
            @if (step.TriggeredRunId is int childId)
            {
                var open = IsExpanded(childId);
                var (triggerDesc, triggerChip) = SplitTriggerName(step.StepName);
                <div class="run-tl-row run-tl-trigger@(open ? " run-tl-open" : "")" @onclick="() => ToggleChild(childId)" role="button" tabindex="0" @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") await ToggleChild(childId); })">
                    <OmniIcon Name="@MaterialIconMap.Resolve(open ? "expand_more" : "chevron_right")" Class="run-tl-caret" />
                    <StepStatusBadge Step="@step" Class="run-status-badge" />
                    <span class="run-tl-trigger-text">
                        <span class="run-tl-stage-label">@stage.DisplayName</span>
                        @if (triggerChip is not null)
                        {
                            <a class="run-tl-chip" href="@ChildRunHref(childId)" title="@L["OpenChildRun"]" @onclick:stopPropagation="true"><OmniIcon Name="OmniIconName.Graph" Class="run-tl-chip-icon" />@triggerChip</a>
                        }
                        <span class="run-tl-name run-tl-name-grow run-tl-desc">@triggerDesc</span>
                        @* Lot 12.1: collapsed, this row used to say only "running". The stage actually
                           executing is one or more levels below it. *@
                        @if (!open && CurrentChildStage(childId) is { Length: > 0 } childStage)
                        {
                            <span class="run-tl-current-stage" title="@L["ChildCurrentStage"]">
                                <OmniIcon Name="OmniIconName.Play" />@childStage
                            </span>
                        }
                    </span>
                    <span class="run-tl-times">
                        <span class="run-tl-dur"><PipelineRunLiveDuration StartedAt="step.StartedAt" CompletedAt="step.CompletedAt" IsRunning="@(step.Status == TaskExecutionStatus.Running)" /></span>
                        <a class="run-tl-open-link" href="@ChildRunHref(childId)" @onclick:stopPropagation="true" title="@L["OpenChildRun"]"><OmniIcon Name="OmniIconName.OpenExternal" /></a>
                    </span>
                </div>
                @if (open)
                {
                    <div class="run-tl-children">
                        @if (IsLoading(childId))
                        {
                            <div class="run-tl-note"><OmniIcon Name="OmniIconName.Hourglass" Class="run-icon-spin" /><span>@L["Loading"]</span></div>
                        }
                        else if (ChildRun(childId) is { } child)
                        {
                            <RunTimelineTree Run="child" Depth="Depth + 1" SelectedStepId="SelectedStepId" OnSelectStep="OnSelectStep"
                                             PreloadedChildren="PreloadedChildren" Baselines="Baselines"
                                             ProjectId="ProjectId" ServerId="ServerId" />
                        }
                        else
                        {
                            <div class="run-tl-note">@L["ChildRunNotFound"]</div>
                        }
                    </div>
                }
            }
            else
            {
                var isSelected = SelectedStepId == step.Id;
                var label = multi ? step.StepName : stage.DisplayName;
                var stepClass = "run-tl-row run-tl-step" + (multi ? " run-tl-substep" : "") + (isSelected ? " selected" : "") + (stage.IsSystem ? " run-tl-system-row" : "");
                var nameClass = "run-tl-name run-tl-name-grow" + (stage.IsSystem ? " run-tl-system" : "");
                <div class="@stepClass" @onclick="() => OnSelectStep.InvokeAsync(step)" role="button" tabindex="0" title="@label" @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") await OnSelectStep.InvokeAsync(step); })">
                    <StepStatusBadge Step="@step" Class="run-status-badge" />
                    <span class="@nameClass">@label</span>
                    @* Candidate 2634: a suite whose tests failed publishes a gate status of 1 and stays
                       green, so the step that made the candidate F read as a plain success. *@
                    @if (PipelineRunGateProducer.HasGateFindings(step))
                    {
                        <OmniBadge Tone="OmniTone.Warning" Fill="OmniFill.Tonal" Class="run-tl-gate-findings" title="@L["StepGateFindingsHint"]">@L["StepGateFindings"]</OmniBadge>
                    }
                    @* A one-step stage renders no header. It used to carry a "skipped" chip here beside a
                       badge reading "Annulé"; since R-246 the badge itself reads "Skipped", with its icon
                       and the condition as tooltip, so the chip would only repeat it. *@
                    <span class="run-tl-times">
                        <span class="run-tl-dur"><PipelineRunLiveDuration StartedAt="step.StartedAt" CompletedAt="step.CompletedAt" IsRunning="@(step.Status == TaskExecutionStatus.Running)" /></span>
                        @* PLAN-003 lot 20 / D26: duration only, plus the usual duration while running.
                           CPU, memory and I/O live in the progression columns above. *@
                        @if (UsualDuration(step) is { } usual)
                        {
                            <span class="run-tl-prev-dur" title="@L["StepUsualDurationHint"]">@L["StepUsualDuration", usual]</span>
                        }
                    </span>
                </div>
            }
        }
    }
</div>
</div>
