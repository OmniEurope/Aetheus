@inject GridExportContext ExportContext
@using static Aetheus.Front.Components.Shared.PipelineRunFormatting

@if (Run.Artifacts.Count > 0)
{
    <OmniTabsItem Key="artifacts" Title="@L["Artifacts"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("inventory_2"))" /></Icon><ChildContent>
            @* The table alone, no card around it and no "Artifacts (n)" title above it: the tab
               already names the content and the grid holds the rows. *@
            <OmniDataGrid Items="@Run.Artifacts" ExportTitle="@ExportContext.Title(L["Artifacts"])" ExportFields="@ExportContext.Fields()" TItem="PipelineArtifactDto"
 Class="run-artifacts-grid" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
                <Columns>
                    <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="PipelineArtifactDto" Property="Name" Title="@L["Name"]" Filterable="true">
                        <Template Context="artifact">
                            <a href="/artifacts/@artifact.Id" class="pipeline-name-link">@artifact.Name</a>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="PipelineArtifactDto" Property="StageName" Title="@L["Stage"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" />
                    <OmniDataGridColumn TItem="PipelineArtifactDto" Property="SizeBytes" Title="@L["Size"]" Width="8rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators">
                        <Template Context="artifact">@FormatSize(artifact.SizeBytes)</Template>
                    </OmniDataGridColumn>
                    @* The stored digest identifies the exact artifact bytes across a restore. *@
                    <OmniDataGridColumn TItem="PipelineArtifactDto" Property="Sha256" Title="@L["Digest"]" Width="10rem" Filterable="true">
                        <Template Context="artifact">
                            @if (artifact.Sha256 is { Length: > 0 } digest)
                            {
                                <ShortId Value="@digest" Href="@($"/artifacts/{artifact.Id}")" Copyable="false" Class="run-artifact-digest" />
                            }
                            else
                            {
                                @* Artifacts published before the store computed one. Saying so beats
                                   an empty cell that reads as "not verified". *@
                                <span class="omni-u-text-muted">@L["DigestUnavailable"]</span>
                            }
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="PipelineArtifactDto" Title="@L["Actions"]" Width="5rem" Sortable="false" Filterable="false">
                        <Template Context="artifact">
                            @* Download uses a blue row action as the project's explicit STD-BTN
                               exception. *@
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => ArtifactDownloadRequested.InvokeAsync(artifact))" title="@L["Download"]" Label="@L["Download"]"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon></OmniButton>
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>
    </ChildContent></OmniTabsItem>
}

@if (PipelineRunMetrics.HasCoverage(Run))
{
    <OmniTabsItem Key="coverage" Title="@L["Coverage"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("bar_chart"))" /></Icon><ChildContent>
        <OmniCard Class="omni-u-mt-md omni-u-p-md">
            <OmniText Element="OmniTextElement.Title" Class="omni-u-mb-sm">@L["Coverage"]</OmniText>
            @if (Run.CoverageSummary is { } coverage)
            {
                <OmniRow Gap="OmniSpacing.ExtraLarge" Align="OmniAlignment.Center" Class="omni-u-mb-lg">
                    <div class="coverage-gauge-wrap">
                        <OmniArcGauge Label="@L["LineCoverage"]" Class="coverage-gauge">
                            <OmniArcGaugeScale Minimum="0" Maximum="100">
                                <OmniArcGaugeScaleValue Value="@(Math.Round(coverage.LineRate * 100, 1))" ColorIndex="@CoverageChartColorIndex(coverage.LineRate)" ShowValue="false" />
                            </OmniArcGaugeScale>
                        </OmniArcGauge>
                        <div class="coverage-gauge-label">
                            <OmniHeading Level="OmniHeadingLevel.H5" Class="@($"{CoverageColorClass(coverage.LineRate)} omni-u-m-0")" title="@CoverageTierText(coverage.LineRate)">@FormatPercent(coverage.LineRate)</OmniHeading>
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@L["LineCoverage"]</OmniText>
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@coverage.LinesCovered / @coverage.LinesValid @L["Lines"]</OmniText>
                        </div>
                    </div>
                    <div class="coverage-gauge-wrap">
                        <OmniArcGauge Label="@L["BranchCoverage"]" Class="coverage-gauge">
                            <OmniArcGaugeScale Minimum="0" Maximum="100">
                                <OmniArcGaugeScaleValue Value="@(Math.Round(coverage.BranchRate * 100, 1))" ColorIndex="@CoverageChartColorIndex(coverage.BranchRate)" ShowValue="false" />
                            </OmniArcGaugeScale>
                        </OmniArcGauge>
                        <div class="coverage-gauge-label">
                            <OmniHeading Level="OmniHeadingLevel.H5" Class="@($"{CoverageColorClass(coverage.BranchRate)} omni-u-m-0")">@FormatPercent(coverage.BranchRate)</OmniHeading>
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@L["BranchCoverage"]</OmniText>
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@coverage.BranchesCovered / @coverage.BranchesValid @L["Branches"]</OmniText>
                        </div>
                    </div>
                    @if (Metrics.CoverageTrend.Count >= 2)
                    {
                        <OmniChart Label="@L["CoverageTrend"]" Class="coverage-trend-chart" AspectRatio="TrendChartAspectRatio">
                            <OmniLineSeries Data="@CoverageLinePoints" Title="@L["LineCoverage"]" ColorIndex="0" /><OmniMarkers Data="@CoverageLinePoints" ColorIndex="0" />
                            <OmniLineSeries Data="@CoverageBranchPoints" Title="@L["BranchCoverage"]" ColorIndex="1" />
                            <OmniValueAxis Minimum="0" Maximum="100" /><OmniAxisTitle Text="%" Orientation="OmniOrientation.Vertical" />
                            <OmniCategoryAxis Labels="@OmniChartData.Labels(CoverageLinePoints)" />
                            <OmniLegend Items="@(new[] { L["LineCoverage"].Value, L["BranchCoverage"].Value })" Placement="OmniLegendPlacement.Bottom" />
                        </OmniChart>
                    }
                </OmniRow>


                @* The per-file tree is read when this tab opens, not with every run reload. *@
                <PipelineRunCoverageFiles Summary="@coverage" />
            }
            else
            {
                var coverageStep = Run.Steps.FirstOrDefault(s => s.StageName.Contains("Coverage", StringComparison.OrdinalIgnoreCase) && !s.IsSystem);
                if (coverageStep is not null)
                {
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-md">
                        <StepStatusBadge Step="@coverageStep" />
                        <OmniText Element="OmniTextElement.Paragraph">@coverageStep.StepName</OmniText>
                        @if (coverageStep.ServerName is not null) { <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@coverageStep.ServerName</OmniText> }
                        @{ var duration = FormatDuration(coverageStep.StartedAt, coverageStep.CompletedAt); }
                        @if (!string.IsNullOrEmpty(duration)) { <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@duration</OmniText> }
                    </OmniStack>
                    if (coverageStep.TaskId is { } coverageTaskId)
                    {
                        var logs = StepLogs.GetValueOrDefault(coverageTaskId);
                        if (logs is null) { <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => CoverageLogsRequested.InvokeAsync(coverageTaskId))"><Icon><OmniIcon Name="OmniIconName.TerminalWindow" /></Icon><ChildContent><span>@L["Logs"]</span></ChildContent></OmniButton> }
                        else if (logs.Count > 0) { <PipelineRunLogLines Logs="@logs" Compact="true" /> }
                        else { <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["NoCoverageData"]</OmniText> }
                    }
                }
                else { <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["NoCoverageData"]</OmniText> }
            }
        </OmniCard>
    </ChildContent></OmniTabsItem>
}

@if (Run.TestResultSummary is { } tests)
{
    <OmniTabsItem Key="tests" Title="@L["TestResults"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("science"))" /></Icon><ChildContent>
        <OmniCard Class="omni-u-mt-md omni-u-p-md">
            <OmniText Element="OmniTextElement.Title" Class="omni-u-mb-sm">@L["TestResults"]</OmniText>
            <OmniRow Gap="OmniSpacing.ExtraLarge">
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center"><OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@tests.TotalTests.ToString()</OmniBadge><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["Total"]</OmniText></OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center"><OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Success">@tests.Passed.ToString()</OmniBadge><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["Passed"]</OmniText></OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center"><OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Danger">@tests.Failed.ToString()</OmniBadge><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["Failed"]</OmniText></OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center"><OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Warning">@tests.Skipped.ToString()</OmniBadge><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["Skipped"]</OmniText></OmniStack>
            </OmniRow>
        </OmniCard>
    </ChildContent></OmniTabsItem>
}

@if (HasLintTab)
{
    <OmniTabsItem Key="lint" Title="@L["Lint"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("rule"))" /></Icon><ChildContent>
        <OmniCard Class="omni-u-mt-md omni-u-p-md">
            <OmniText Element="OmniTextElement.Title" Class="omni-u-mb-sm">@L["Lint"]</OmniText>
            @if (Run.LintSummary is { } lint)
            {
                <OmniRow Gap="OmniSpacing.ExtraLarge" Class="omni-u-mb-lg">
                    @if (!string.IsNullOrEmpty(lint.Tool)) { <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["LintTool"]</OmniText><OmniText Element="OmniTextElement.Paragraph">@lint.Tool</OmniText></OmniStack> }
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center"><OmniBadge Fill="OmniFill.Solid" Tone="@(lint.ErrorCount > 0 ? OmniTone.Danger : OmniTone.Success)">@lint.ErrorCount.ToString()</OmniBadge><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["LintErrors"]</OmniText></OmniStack>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center"><OmniBadge Fill="OmniFill.Solid" Tone="@(lint.WarningCount > 0 ? OmniTone.Warning : OmniTone.Neutral)">@lint.WarningCount.ToString()</OmniBadge><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["LintWarnings"]</OmniText></OmniStack>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center"><OmniBadge Fill="OmniFill.Solid" Tone="@(lint.InfoCount > 0 ? OmniTone.Accent : OmniTone.Neutral)">@lint.InfoCount.ToString()</OmniBadge><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["LintInfo"]</OmniText></OmniStack>
                </OmniRow>
            }
            @foreach (var lintStep in LintSteps)
            {
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-md">
                    <StepStatusBadge Step="@lintStep" /><OmniText Element="OmniTextElement.Paragraph">@lintStep.StepName</OmniText>
                    @if (lintStep.ServerName is not null) { <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@lintStep.ServerName</OmniText> }
                    @{ var duration = FormatDuration(lintStep.StartedAt, lintStep.CompletedAt); }
                    @if (!string.IsNullOrEmpty(duration)) { <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@duration</OmniText> }
                </OmniStack>
                @if (lintStep.TaskId is { } lintTaskId)
                {
                    var logs = StepLogs.GetValueOrDefault(lintTaskId);
                    if (logs is null) { <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => LintLogsRequested.InvokeAsync(lintTaskId))" Class="omni-u-mb-md"><Icon><OmniIcon Name="OmniIconName.TerminalWindow" /></Icon><ChildContent><span>@L["Logs"]</span></ChildContent></OmniButton> }
                    else if (logs.Count > 0) { <PipelineRunLogLines Logs="@logs" HighlightLintWarnings="true" /> }
                    else { <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-mb-md">@L["NoLogs"]</OmniText> }
                }
            }
        </OmniCard>
    </ChildContent></OmniTabsItem>
}

@if (PipelineRunMetrics.HasComplexity(Run))
{
    <OmniTabsItem Key="quality" Title="@L["CodeQuality"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("code"))" /></Icon><ChildContent>
        <OmniCard Class="omni-u-mt-md omni-u-p-md">
            <OmniText Element="OmniTextElement.Title" Class="omni-u-mb-md">@L["CodeQuality"]</OmniText>
            @* R-5: the metrics are OE tiles of one OmniTileGrid (same width, same height). *@
            <OmniTileGrid Columns="3" Gap="OmniSpacing.Medium">
                @{ var averageComplexity = PipelineRunMetrics.Metric(Run, "complexity.cyclomatic.avg") ?? 0; }
                <OmniCard Class="omni-u-p-md coverage-card"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["AvgComplexity"]</OmniText><OmniHeading Level="OmniHeadingLevel.H4" Class="@ComplexityColorClass(averageComplexity)">@averageComplexity.ToString("0.0")</OmniHeading></OmniCard>
                <OmniCard Class="omni-u-p-md coverage-card"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["MaxComplexity"]</OmniText><OmniHeading Level="OmniHeadingLevel.H4">@((PipelineRunMetrics.Metric(Run, "complexity.cyclomatic.max") ?? 0).ToString("0"))</OmniHeading></OmniCard>
                @if (PipelineRunMetrics.Metric(Run, "complexity.crap.avg") is { } crap) { <OmniCard Class="omni-u-p-md coverage-card"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["Crap"]</OmniText><OmniHeading Level="OmniHeadingLevel.H4" Class="@CrapColorClass(crap)">@crap.ToString("0.0")</OmniHeading></OmniCard> }
                <OmniCard Class="omni-u-p-md coverage-card"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["HighComplexity"]</OmniText><OmniHeading Level="OmniHeadingLevel.H4" Class="@((PipelineRunMetrics.Metric(Run, "complexity.high") ?? 0) > 0 ? "omni-u-text-warning" : "omni-u-text-success")">@((PipelineRunMetrics.Metric(Run, "complexity.high") ?? 0).ToString("0"))</OmniHeading><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">CC &gt; @PipelineRunMetrics.ComplexityHighThreshold</OmniText></OmniCard>
                <OmniCard Class="omni-u-p-md coverage-card"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["Methods"]</OmniText><OmniHeading Level="OmniHeadingLevel.H4">@((PipelineRunMetrics.Metric(Run, "complexity.methods") ?? 0).ToString("N0"))</OmniHeading></OmniCard>
                <OmniCard Class="omni-u-p-md coverage-card"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["LinesOfCode"]</OmniText><OmniHeading Level="OmniHeadingLevel.H4">@((PipelineRunMetrics.Metric(Run, "loc.total") ?? 0).ToString("N0"))</OmniHeading></OmniCard>
            </OmniTileGrid>
            @if (Metrics.ComplexityTrend.Count >= 2)
            {
                <OmniText Element="OmniTextElement.Title" Class="omni-u-mt-lg omni-u-mb-sm">@L["ComplexityTrend"]</OmniText>
                <OmniChart Label="@L["ComplexityTrend"]" Class="coverage-trend-chart" AspectRatio="TrendChartAspectRatio">
                    <OmniLineSeries Data="@ComplexityAveragePoints" Title="@L["AvgComplexity"]" ColorIndex="0" /><OmniMarkers Data="@ComplexityAveragePoints" ColorIndex="0" />
                    <OmniLineSeries Data="@ComplexityMaximumPoints" Title="@L["MaxComplexity"]" ColorIndex="1" />
                    @if (Metrics.ComplexityTrend.All(point => point.Crap.HasValue)) { <OmniLineSeries Data="@ComplexityCrapPoints" Title="@L["Crap"]" ColorIndex="2" /> }
                    <OmniAxisTitle Text="@L["ComplexityAxisTitle"]" Orientation="OmniOrientation.Vertical" /><OmniCategoryAxis Labels="@OmniChartData.Labels(ComplexityAveragePoints)" /><OmniLegend Items="@(new[] { L["AvgComplexity"].Value, L["MaxComplexity"].Value, L["Crap"].Value })" Placement="OmniLegendPlacement.Bottom" />
                </OmniChart>
            }
        </OmniCard>
    </ChildContent></OmniTabsItem>
}
