@* Copying an existing project has dedicated steps within the shared wizard frame. *@
<WizardDialog Steps="@_steps" CanAdvance="@CanAdvance" StepChanged="@OnStepChanged"
              OnFinishClicked="@FinishAsync" OnCancelClicked="@OnCancel"
              FinishText="@(Result is null ? L["PipelineCopyFinish"] : L["PipelineCopyOpenPipelines"])" />
