<OmniCard Class="analysis-run-gate-overview analysis-run-gate-page omni-u-p-md">
    @* Recette R1-62: the title row carries the actions (Quality blue, Export grey), then the grade and its
       first cause, the counts, the families, and the findings. *@
    @* R-14 / R-36: the title row and the alerts of the card are separated by this stack's gap, not by a margin of their own. *@
    <OmniStack>
    <div class="analysis-run-gate-heading">
        <OmniIcon Name="OmniIconName.ShieldCheck" />
        <div>
            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["AnalysisGateTab"]</OmniHeading>
        </div>
        @* The letter carries the verdict without a redundant word. *@
        @if (PipelineRunGatePresentation.ShowsStatusWord(Gate))
        {
            <OmniBadge Icon="@(BadgeIcon.ForState(PipelineRunGatePresentation.GateStyle(Gate.Status)))" Fill="OmniFill.Solid" Tone="@PipelineRunGatePresentation.GateStyle(Gate.Status)">@L[PipelineRunGatePresentation.StatusKey(Gate.Status)]</OmniBadge>
        }
        <div class="analysis-run-gate-actions">
            @* STD-BTN detection 11: Open project quality visible, the other actions in the menu; Export is the
               visible action when the run has no project. *@
            @if (ProjectId is int projectId)
            {
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenProjectQuality(projectId))" title="@L["AnalysisOpenProjectQuality"]"><Icon><OmniIcon Name="OmniIconName.OpenExternal" /></Icon><ChildContent><span>@L["AnalysisOpenProjectQuality"]</span></ChildContent></OmniButton>
                <OmniOverflowMenu Label="@L["MoreActions"]">
                    <OmniMenuItem OnClick="ExportAllAiPromptAsync" Disabled="@(GridCount == 0 || _exporting)" title="@L["AnalysisExportAllAiPrompt"]"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent>@L["AnalysisExport"]</ChildContent></OmniMenuItem>
                </OmniOverflowMenu>
            }
            else
            {
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="ExportAllAiPromptAsync" Disabled="@(GridCount == 0)" Busy="@_exporting" title="@L["AnalysisExportAllAiPrompt"]"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L["AnalysisExport"]</span></ChildContent></OmniButton>
            }
        </div>
    </div>
    @if (PipelineRunGatePresentation.GradeComesFromSeal(Gate, RunGrade))
    {
        @* R-36: the blocking tests are listed with the findings below, where they are counted. *@
        <OmniAlert Severity="OmniSeverity.Warning" Title="@L["GateSealedGradeTitle"]">
            <div>@string.Format(L["GateSealedGradeDetail"], Gate.Grade?.OverallGrade?.ToString() ?? "-")</div>
        </OmniAlert>
    }
    @* Recette R-17: why the gate is rejected, in one sentence (the rules it crossed), and why the letter can still
       be good. *@
    @if (PipelineRunGatePresentation.RejectionReason(Gate, L) is { } rejection)
    {
        <OmniAlert Severity="OmniSeverity.Warning" data-testid="gate-rejection-reason">
            <div>@rejection</div>
            @if (PipelineRunGatePresentation.RejectedByRules(Gate) && PipelineRunGatePresentation.HeadlineGrade(Gate, RunGrade) is not null)
            {
                <small class="omni-u-text-muted">@L["GateRejectedGradeNote"]</small>
            }
        </OmniAlert>
    }
    </OmniStack>
    @* Recette R1-37 (mockup pipeline-run-gate): the single grade block on the left, the key figures stacked
       in a column on the right (under the block on a narrow window); then the findings section. *@
    <div class="@(HasGradeBlock ? "analysis-run-gate-layout" : "analysis-run-gate-layout analysis-run-gate-layout--figures-only")">
        @* Recette R2-052: what the letter is made of. A B over "0 findings" came from a measure (coverage,
           duplication, complexity, a cycle) the tab did not show. *@
        @* Recette R1-38: the Gate grade is the first row of the single grade block (it was a wide frame of its own). *@
        <AnalysisGradeBreakdown Grade="@Gate.Grade" GateRow="true" GateGrade="@PipelineRunGatePresentation.HeadlineGrade(Gate, RunGrade)"
                                SealBlockedByTests="@(PipelineRunGatePresentation.GradeComesFromSeal(Gate, RunGrade) && BlockingTests.Count > 0)" />
        @* The OE key-figure tile: value over its label, the label wraps, so a narrow column keeps
           both inside the tile (a side-by-side nowrap pair spilled out of it at 375 px). *@
        @* Recette R1-36 / ADR-056: no rule-alert tile. A threshold the analysis crosses is a finding, counted
           and listed with the others. *@
        <OmniTileGrid Columns="@(HasGradeBlock ? 1 : 4)" Gap="OmniSpacing.Small" Class="analysis-run-gate-metrics">
            @* Recette R-74: the total covers every domain; the detail splits it by domain, so it adds up with the grade lines. *@
            <OmniStatTile Value="@($"{Gate.FindingCount + BlockingTests.Count}")" Title="@L["AnalysisGateFindings"]" Detail="@ByDomainDetail" />
            <OmniStatTile Value="@($"{Gate.NewFindingCount}")" Title="@L["AnalysisGateNewFindings"]" />
        </OmniTileGrid>
    </div>
    @* The findings section: its title with the count of the list, and on the right the switch that adds
       the findings already decided on (hidden until asked for; the switch says how many). *@
    <div class="analysis-run-gate-section-head" data-testid="gate-findings-head">
        <OmniHeading Level="OmniHeadingLevel.H6" Class="omni-u-m-0">@L["AnalysisGateFindings"]</OmniHeading>
        <NumberBadge Tone="OmniTone.Neutral" Fill="OmniFill.Tonal" data-testid="gate-findings-count">@ListedCount</NumberBadge>
        @if (Gate.DecidedFindingCount > 0)
        {
            <OmniSwitch TValue="bool" @bind-Value="_showDecided" @bind-Value:after="ShowDecidedChangedAsync" Class="analysis-run-gate-decided-switch">@string.Format(L["AnalysisGateShowDecided"], Gate.DecidedFindingCount)</OmniSwitch>
        }
    </div>
    @* R-36: the tests the seal held the candidate back for are findings of the gate: counted above, listed here,
       each leading to the log of the step that produced it. *@
    @if (BlockingTests.Count > 0)
    {
        <div class="analysis-run-gate-blocking" data-testid="gate-blocking-tests">
            <PipelineRunBlockingTests Tests="BlockingTests" ViewingRunId="@Gate.PipelineRunId" />
        </div>
    }
    @if (ListedCount == 0)
    {
        <div class="analysis-run-gate-empty">
            <EmptyState Icon="task_alt" Title="@L["AnalysisNoFindings"]" Description="@L["AnalysisNoFindingsDescription"]" />
        </div>
    }
    else if (GridCount > 0)
    {
        @* The columns of every findings list (AnalysisFindingColumns), over this run's findings; a
           click on the row opens the finding, as on the project's Quality page. *@
        @* FullHeight lets OE size the grid to what is left under it, inside the card. *@
        @* The findings of the run and the runs it triggered, read from the server page by page,
           filtered and sorted there, like the project's Quality list. *@
        <AetheusDataGrid ShowFooterBar="true" @ref="_grid" Data="@_rows" Count="@_total" TItem="AnalysisFindingDto" KeyProperty="Id" LoadData="LoadAsync" ExportRead="@ReadExportAsync" RowClick="OpenFinding"
                         AllowSorting="true" AllowFiltering="true" FilterMode="OmniDataGridFilterMode.Simple" PageSize="25"
                         Virtualize="@AetheusGrid.RemoteVirtualization" VirtualData="@(() => new OmniDataGridResult<AnalysisFindingDto>(_rows, _total))"
                         FullHeight="true" class="analysis-run-findings-grid" VirtualizationOverscanCount="3">
            <Columns>
                <AnalysisFindingColumns ShowStatus="@_showDecided" ShowOwnership="false" RunId="@Gate.PipelineRunId"
                                        CanRevertDecisions="@(_showDecided && CanDecide)" RevertDecision="@RevertDecisionAsync" />
            </Columns>
        </AetheusDataGrid>
    }
</OmniCard>
