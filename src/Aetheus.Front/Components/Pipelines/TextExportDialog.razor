@namespace Aetheus.Front.Components.Pipelines
@* The export preview exposes the full text with download, copy and close actions. *@
<OmniStack Gap="OmniSpacing.Medium">
    <OmniTextArea Value="@Text" ReadOnly="true" Rows="18" Class="w-100 text-export-dialog-body"
                    aria-label="@L["ExportContent"]"  ValueExpression="@(() => Text)"/>
    <DialogFooter OnCancel="@(() => Dialog.Close())" CancelText="@L["Close"]">
        @* STD-BTN detection 11: Download visible, the other actions in the menu. *@
        <OmniOverflowMenu Label="@L["MoreActions"]">
            <OmniMenuItem OnClick="@CopyAsync"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon><ChildContent>@L["Copy"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@DownloadAsync"><OmniIcon Name="OmniIconName.Download" /> <span>@L["Download"]</span></OmniButton>
    </DialogFooter>
</OmniStack>
