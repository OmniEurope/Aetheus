@* Where each blocking test came from: the step that published its non-zero status, a link to that
   step's log, and the failed tests the suite named. An entry no step can be traced to keeps the
   seal's own words. *@
@if (Tests.Count > 0)
{
    <div class="omni-u-mt-xs run-blocking-tests">
        <div>@L["CandidateBlockingTests"]:</div>
        @foreach (var test in Tests)
        {
            <div class="omni-u-mt-xs run-blocking-test">
                @if (test.Producer is { } producer)
                {
                    <span>@string.Format(L["CandidateBlockingTestSource"], test.Key, producer.StepName, producer.RunId, producer.PipelineName)</span>
                    <OmniLink Href="@LogsHref(producer, ViewingRunId)" Class="run-blocking-test-logs">@L["CandidateBlockingTestOpenLogs"]</OmniLink>
                    @if (producer.FailedTests.Count > 0)
                    {
                        <div class="run-blocking-test-failures">@L["CandidateBlockingFailedTests"]: <strong>@string.Join(", ", producer.FailedTests)</strong></div>
                    }
                }
                else
                {
                    <strong>@test.Text</strong>
                }
            </div>
        }
    </div>
}
