@inject GridExportContext ExportContext

<OmniDataGrid Items="@ParameterList" ExportTitle="@ExportContext.Title(L["RunParameters"])" ExportFields="@ExportContext.Fields()" TItem="KeyValuePair<string, string>"
 Class="run-params-grid" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="KeyValuePair<string, string>" Property="Key" Title="@L["Parameter"]" Width="40%" Filterable="true" />
        <OmniDataGridColumn TItem="KeyValuePair<string, string>" Property="Value" Truncate="true" Title="@L["Value"]" Filterable="true">
            <Template Context="parameter"><code>@parameter.Value</code></Template>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>
<OmniStack Orientation="OmniOrientation.Horizontal" Justify="OmniJustification.End" Class="omni-u-mt-md" Gap="OmniSpacing.Large">
    <Aetheus.Front.Components.Servers.DialogCloseButton />
</OmniStack>
