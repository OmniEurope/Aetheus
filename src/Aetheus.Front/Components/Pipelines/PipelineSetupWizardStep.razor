@if (Step == 0)
{
    <OmniStack Gap="OmniSpacing.Large" Class="pipeline-setup-step">
        <OmniHeading Level="OmniHeadingLevel.H5">@L["SelectPipelineProject"]</OmniHeading>
        <OmniFormField Label="@L["Project"]" Class="omni-u-w-100" For="oe-formfield-pages-pipelines-pipelinesetupwizardstep-1">
            <OmniDropDown Id="oe-formfield-pages-pipelines-pipelinesetupwizardstep-1" TValue="int?" Options="@(Projects.ToOptions(item => (int?)item.Id, item => item.Name))"
                            Value="@ProjectId" ValueChanged="@ProjectIdChanged" ValueExpression="@(() => ProjectId)" Class="omni-u-w-100" />
        </OmniFormField>
        <OmniFormField Label="@L["PipelinePrefix"]" Help="@L["PipelinePrefixHint"]" Class="omni-u-w-100" For="oe-formfield-pages-pipelines-pipelinesetupwizardstep-2">
            <OmniTextBox Id="oe-formfield-pages-pipelines-pipelinesetupwizardstep-2" Value="@Prefix" ValueChanged="@PrefixChanged" Class="omni-u-w-100"  ValueExpression="@(() => Prefix)"/>
        </OmniFormField>
    </OmniStack>
}
else if (Step == 1)
{
    @* The type first (what is built and checked), its detail below it. *@
    <div class="pipeline-setup-step">
        <OmniHeading Level="OmniHeadingLevel.H5">@L["PipelineArchitectureQuestion"]</OmniHeading>
        <OmniSelectableCardGroup TValue="PipelineArchitecture" TSelection="PipelineArchitecture?"
                                 Label="@L["PipelineArchitectureTitle"]" Value="@Architecture" ValueChanged="@ArchitectureChanged"
                                 ValueExpression="@(() => Architecture)" Class="pipeline-setup-architectures">
            @foreach (var architecture in Enum.GetValues<PipelineArchitecture>())
            {
                var labels = PipelineSetupArchitecture.LabelKeys(architecture);
                <OmniSelectableCard @key="architecture" Choice="@architecture" Title="@L[labels.Title]" Description="@L[labels.Description]"
                                    data-testid="@($"setup-architecture-{PipelineSetupArchitecture.Slug(architecture)}")">
                    <Icon><OmniIcon Name="@ArchitectureIcon(architecture)" /></Icon>
                </OmniSelectableCard>
            }
        </OmniSelectableCardGroup>
        @if (Architecture is PipelineArchitecture.Application)
        {
            @* The one-project application shape is an explicit yes/no choice with no default. *@
            <OmniRadioButtonList TValue="bool?" Label="@L["PipelineSameProjectQuestion"]" Options="@YesNoOptions"
                                 Value="@SameProject" ValueChanged="@SameProjectChanged" ValueExpression="@(() => SameProject)"
                                 Class="pipeline-setup-detail" data-testid="setup-same-project" />
            @if (SameProject == true)
            {
                <OmniText Element="OmniTextElement.Paragraph" Tone="OmniTextTone.Muted" Class="pipeline-setup-detail">@L["PipelineSameProjectYesDetail"]</OmniText>
                <div class="pipeline-setup-options">
                    @Option(OmniIconName.Database, L["Database"], L["DatabasePipelineHint"], Database, DatabaseChanged)
                </div>
            }
            else if (SameProject == false)
            {
                <div class="pipeline-setup-options">
                    @Option(OmniIconName.Monitor, L["Frontend"], L["FrontendPipelineHint"], Frontend, FrontendChanged)
                    @Option(OmniIconName.Globe, L["Backend"], L["BackendPipelineHint"], Backend, BackendChanged)
                    @Option(OmniIconName.Database, L["Database"], L["DatabasePipelineHint"], Database, DatabaseChanged)
                </div>
            }
        }
        @if (Architecture is PipelineArchitecture.Application or PipelineArchitecture.Package)
        {
            <OmniFormField Label="@L["PipelineStack"]" Help="@L["PipelineStackHint"]" Class="pipeline-setup-detail"
                           For="oe-formfield-pages-pipelines-pipelinesetupwizardstep-stack">
                <OmniDropDown Id="oe-formfield-pages-pipelines-pipelinesetupwizardstep-stack" TValue="string" Options="@StackOptions"
                              Value="@Stack" ValueChanged="@StackChanged" ValueExpression="@(() => Stack)" />
            </OmniFormField>
        }
    </div>
}
else if (Step == 2)
{
    <div class="pipeline-setup-step">
        <OmniHeading Level="OmniHeadingLevel.H5">@L["SelectPipelineCapabilities"]</OmniHeading>
        @* Only what the type of step 2 proposes (PipelineSetupArchitecture.Proposes). *@
        <div class="pipeline-setup-options">
            @if (Proposes("external-security")) { @Option(OmniIconName.ShieldCheck, L["ExternalSecurityPipeline"], L["ExternalSecurityPipelineHint"], ExternalSecurity, ExternalSecurityChanged) }
            @if (Proposes("ci")) { @Option(OmniIconName.Wrench, "CI", L["CiPipelineHint"], Ci, CiChanged) }
            @if (Proposes("quality")) { @Option(OmniIconName.ChartLine, L["Quality"], L["QualityPipelineHint"], Quality, QualityChanged) }
            @if (Proposes("security")) { @Option(OmniIconName.ShieldCheck, L["Security"], L["SecurityPipelineHint"], Security, SecurityChanged) }
            @if (Proposes("qa")) { @Option(OmniIconName.Flask, "QA", L["QaPipelineHint"], Qa, QaChanged) }
            @if (Proposes("qa-extended")) { @Option(OmniIconName.Gauge, L["QaExtended"], L["QaExtendedPipelineHint"], QaExtended, QaExtendedChanged) }
            @if (Proposes("security-history")) { @Option(OmniIconName.Key, L["SecurityHistory"], L["SecurityHistoryPipelineHint"], SecurityHistory, SecurityHistoryChanged) }
            @if (Proposes("candidate")) { @Option(OmniIconName.CheckCircle, L["Candidate"], L["CandidatePipelineHint"], Candidate, CandidateChanged) }
            @if (Proposes("nightly")) { @Option(OmniIconName.Timer, L["Nightly"], L["NightlyPipelineHint"], Nightly, NightlyChanged) }
            @if (Proposes("production")) { @Option(OmniIconName.RocketLaunch, L["ProductionDeployment"], L["ProductionPipelineHint"], Production, ProductionChanged) }
            @if (Proposes("fast-deploy")) { @Option(OmniIconName.Lightning, L["FastDeploy"], L["FastPipelineHint"], FastDeploy, FastDeployChanged) }
            @if (Proposes("rollback")) { @Option(OmniIconName.Reset, L["Rollback"], L["RollbackPipelineHint"], Rollback, RollbackChanged) }
            @if (Proposes("packages")) { @Option(OmniIconName.Package, L["Packages"], L["PackagesPipelineHint"], Packages, PackagesChanged) }
        </div>
    </div>
}
else
{
    <div class="pipeline-setup-step">
        <OmniHeading Level="OmniHeadingLevel.H5">@L["PipelinesToCreate"]</OmniHeading>
        <OmniAlert Severity="OmniSeverity.Info">
            @ProjectName · @ArchitectureSummary · @SummaryItems.Count @L["Pipelines"]
        </OmniAlert>
        <div class="pipeline-setup-summary">
            @foreach (var item in SummaryItems)
            {
                <div><OmniIcon Name="OmniIconName.Graph" /><strong>@item.Name</strong><span>@item.TemplateName</span></div>
            }
        </div>
        @if (ProjectId is { } projectId)
        {
            <PipelineSetupReadinessPanel ProjectId="@projectId" Readiness="@Readiness" Loading="@ReadinessLoading"
                TemplateNames="@SummaryItems.Select(item => item.TemplateName).ToList()"
                ReturnUrl="@ReturnUrl" OnChanged="@OnReadinessChanged" />
        }
    </div>
}
