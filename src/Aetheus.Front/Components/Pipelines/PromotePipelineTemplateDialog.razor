@inherits PipelineTemplatePromotionBase

@if (_loading)
{
    <AetheusLoader />
}
else if (_preview is not null)
{
    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniStack Gap="OmniSpacing.Large">
            <OmniText Element="OmniTextElement.Strong">@string.Format(L["PromoteTemplateVersion"], _preview.TemplateName, _preview.LatestVersion + 1)</OmniText>
            <MonacoDiffViewer OriginalValue="@_preview.LatestTemplateYaml" ModifiedValue="@_preview.EffectivePipelineYaml" />
            <OmniFormField For="oe-pages-pipelines-promotepipelinetemplatedialog-1"><LabelContent>@L["ChangelogEntry"]</LabelContent><ChildContent>
                <OmniTextBox @bind-Value="_model.ChangelogEntry" Id="oe-pages-pipelines-promotepipelinetemplatedialog-1" />
            </ChildContent></OmniFormField>
            <ValidationMessage For="@(() => _model.ChangelogEntry)" />
            <OmniText Element="OmniTextElement.Strong">@L["NewTemplateYaml"]</OmniText>
            <MonacoEditor Value="@_model.YamlContent" ValueChanged="@(value => _model.YamlContent = value)" />
            <OmniCheckBox @bind-Value="_model.RebaseSourcePipeline">@L["RebaseSourcePipeline"]</OmniCheckBox>
            <DialogFooter OnCancel="@Cancel">
                <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><Icon><OmniIcon Name="OmniIconName.Upload" /></Icon><ChildContent><span>@L["PublishVersion"]</span></ChildContent></OmniButton>
            </DialogFooter>
        </OmniStack>
    </EditForm>
}
else if (_forbidden)
{
    <OmniAlert Severity="OmniSeverity.Warning">@L["AccessDenied"]</OmniAlert>
    <DialogFooter OnCancel="@Cancel" />
}
else if (_notAvailable)
{
    <OmniAlert Severity="OmniSeverity.Warning">@L["PromoteUnavailable"]</OmniAlert>
    <DialogFooter OnCancel="@Cancel" />
}
else if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger">@L["LoadError"]</OmniAlert>
    <DialogFooter OnCancel="@Cancel">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@LoadPreviewAsync"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["Retry"]</span></ChildContent></OmniButton>
    </DialogFooter>
}
