@inject GridExportContext ExportContext

<div class="dry-run-dialog">
    @if (Result is not null)
    {
        @if (Result.Warnings.Count > 0)
        {
            <OmniAlert Severity="OmniSeverity.Warning" Class="omni-u-mb-lg">
                @foreach (var warning in Result.Warnings)
                {
                    <div>@warning</div>
                }
            </OmniAlert>
        }

        <OmniText Element="OmniTextElement.Strong" Class="omni-u-mb-sm">
            @L["ResolvedVariables"] (@Result.ResolvedVariables.Count)
        </OmniText>

        @if (Result.ResolvedVariables.Count > 0)
        {
            <OmniDataGrid Items="@Result.ResolvedVariables.ToList()" ExportTitle="@ExportContext.Title(L["ResolvedVariables"])" ExportFields="@ExportContext.Fields()" TItem="KeyValuePair<string, string>"
 Class="omni-u-mb-lg" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="12rem">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="KeyValuePair<string, string>" Property="Key" Title="@L["Key"]" Width="12.5rem" Filterable="true" />
                    <OmniDataGridColumn TItem="KeyValuePair<string, string>" Property="Value" Truncate="true" Title="@L["Value"]" Filterable="true" />
                </Columns>
            </OmniDataGrid>
        }

        @foreach (var stage in Result.Stages)
        {
            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-sm omni-u-mb-xs">@stage.StageName (@stage.Agent)</OmniHeading>
            <OmniDataGrid Items="@stage.Steps" ExportTitle="@ExportContext.Title(stage.StageName)" ExportFields="@ExportContext.Fields()" TItem="DryRunStepDto" Class="omni-u-mb-sm" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="DryRunStepDto" Property="StepName" Title="@L["Step"]" Filterable="true" />
                    <OmniDataGridColumn TItem="DryRunStepDto" Property="OriginalCommand" Truncate="true" Title="@L["OriginalCommand"]" Filterable="true" />
                    <OmniDataGridColumn TItem="DryRunStepDto" Property="ResolvedCommand" Truncate="true" Title="@L["ResolvedCommand"]" Filterable="true" />
                </Columns>
            </OmniDataGrid>
        }
    }
    <OmniStack Orientation="OmniOrientation.Horizontal" Justify="OmniJustification.End" Class="omni-u-mt-md" Gap="OmniSpacing.Large">
        <Aetheus.Front.Components.Servers.DialogCloseButton />
    </OmniStack>
</div>
