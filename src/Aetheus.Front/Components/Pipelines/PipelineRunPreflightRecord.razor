@* What the launch preflight verified to let this run start. The refusal path was loud (a 400 and an
   audit entry) and the accepted path silent, so a run dying on an environment gave no way to tell
   whether that environment had been checked at launch or never looked at. *@
@if (Checks.Count > 0)
{
    @* R1-33: folded by default, one click opens the whole record. *@
    <OmniFieldset Collapsible="true" Expanded="false" data-testid="preflight-record">
        <Legend><OmniIcon Name="OmniIconName.ListChecks" Class="run-tile-icon" /> @L["PreflightRecordTitle"]</Legend>
        <ChildContent>
            @foreach (var check in Checks)
            {
                <div class="run-preflight-check">
                    <OmniIcon Name="@MaterialIconMap.Resolve(check.Satisfied ? "check_circle" : "cancel")" Class="@(check.Satisfied ? "run-preflight-ok" : "run-preflight-ko")" />
                    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@check.Kind</OmniBadge>
                    <span class="run-preflight-subject">@check.Subject</span>
                    @if (check.Detail is { Length: > 0 } detail)
                    {
                        <span class="run-preflight-detail">@detail</span>
                    }
                </div>
            }
        </ChildContent>
    </OmniFieldset>
}
