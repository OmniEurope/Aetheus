<OmniTemplateForm TModel="object" Model="@_formModel" OnValidSubmit="@OnSubmit">
    <div class="run-params-dialog">
        <RunParameterFields @ref="_fields" Parameters="@Parameters" Prefill="@Prefill" AvailableReleases="@AvailableReleases" AvailableReleaseTotal="@AvailableReleaseTotal" />

        @* The actions stay at the bottom of the dialog while the list above scrolls (R-27); a missing
           required value is told under its own field (R-26), not here. *@
        <div class="run-params-footer" data-testid="run-params-footer">
            <DialogFooter OnCancel="@OnCancel">
                <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(SubmitIcon)" /></Icon><ChildContent><span>@(SubmitText ?? L["Run"])</span></ChildContent></OmniButton>
            </DialogFooter>
        </div>
    </div>
</OmniTemplateForm>
