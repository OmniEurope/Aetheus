@* The lineage tile links to the parent run or initiating user and to subsequent follow-up runs.
   Trigger-stage children belong in the timeline. R-28: an OmniFactTile (OE); a run is an OmniLink in the
   value of its row, the tile itself being a plain group. *@
<OmniFactTile Title="@L["RunLineage"]" Class="@TileClass" DoubleWidth="@IsWide">
    <Icon><OmniIcon Name="OmniIconName.Path" /></Icon>
    <ChildContent>
        @if (ParentPipeline is { } parentPipeline)
        {
            <OmniFactTileRow Term="@L["ParentPipeline"]"><Icon><OmniIcon Name="OmniIconName.Path" /></Icon><ChildContent>
                @if (ParentRunId is { } parentRunId)
                {
                    <OmniLink Href="@PipelineRunPresentation.Href(parentRunId, ProjectId, ServerId)" Class="run-lineage-parent">@parentPipeline #@parentRunId</OmniLink>
                }
                else
                {
                    <span class="run-lineage-parent">@parentPipeline</span>
                }
            </ChildContent></OmniFactTileRow>
        }
        else
        {
            <OmniFactTileRow Term="@L["RunLaunchedBy"]"><Icon><OmniIcon Name="OmniIconName.User" /></Icon><ChildContent><span class="run-lineage-actor">@ActorText</span></ChildContent></OmniFactTileRow>
        }
        @if (_lineage is { Downstream.Count: > 0 } lineage)
        {
            @* The first follow-ups only, the full list behind "See all". *@
            @foreach (var (child, index) in lineage.Downstream.Take(MaxShown).Select((child, index) => (child, index)))
            {
                <OmniFactTileRow Term="@(index == 0 ? L["RunStarted"].Value : string.Empty)"><Icon>@if (index == 0) { <OmniIcon Name="OmniIconName.Play" /> }</Icon><ChildContent>@* The status first: a long pipeline name is cut by the row, never the status. *@<PipelineRunStatusBadge Status="child.Status" /> <OmniLink Href="@PipelineRunPresentation.Href(child.RunId, child.ProjectId ?? ProjectId, ServerId)" Class="run-lineage-child">@child.PipelineName #@child.BuildNumber</OmniLink></ChildContent></OmniFactTileRow>
            }
            @if (lineage.Downstream.Count > MaxShown)
            {
                <OmniFactTileRow Term="@string.Empty"><ChildContent><OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" Class="run-lineage-see-all" OnClick="@ShowAllAsync"><Icon><OmniIcon Name="OmniIconName.ListBullets" /></Icon><ChildContent><span>@L["SeeAll"] (@lineage.Downstream.Count)</span></ChildContent></OmniButton></ChildContent></OmniFactTileRow>
            }
        }
    </ChildContent>
</OmniFactTile>