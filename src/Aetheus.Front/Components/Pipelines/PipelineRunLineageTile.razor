@* The lineage tile links to the parent run or initiating user and to subsequent follow-up runs.
   Trigger-stage children belong in the timeline. *@
<OmniCard Class="@TileClass">
    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Path" Class="run-tile-icon" /> @L["RunLineage"]</OmniText>
    <div class="run-tile-main run-tile-main-rows">
        <span class="run-tile-subrow">
            @if (ParentPipeline is { } parentPipeline)
            {
                <span class="run-tile-sublabel">@L["ParentPipeline"]</span>
                @if (ParentRunId is { } parentRunId)
                {
                    <a href="@PipelineRunPresentation.Href(parentRunId, ProjectId, ServerId)" class="pipeline-name-link run-tile-value run-lineage-parent" title="@parentPipeline">@parentPipeline #@parentRunId</a>
                }
                else
                {
                    <span class="run-tile-value run-lineage-parent" title="@parentPipeline">@parentPipeline</span>
                }
            }
            else
            {
                <span class="run-tile-sublabel">@L["RunLaunchedBy"]</span>
                <span class="run-tile-value run-lineage-actor" title="@ActorText">@ActorText</span>
            }
        </span>
    </div>
    <div class="run-tile-foot">
        @if (_lineage is { Downstream.Count: > 0 } lineage)
        {
            <span class="run-tile-sublabel">@L["RunStarted"]</span>
            @* The first follow-ups only, the full list behind "See all". *@
            @foreach (var child in lineage.Downstream.Take(MaxShown))
            {
                <span class="run-tile-subrow">
                    <a href="@PipelineRunPresentation.Href(child.RunId, child.ProjectId ?? ProjectId, ServerId)" class="pipeline-name-link run-tile-value run-lineage-child" title="@child.PipelineName">@child.PipelineName #@child.BuildNumber</a>
                    <OmniBadge Fill="OmniFill.Solid" Tone="@PipelineRunPresentation.Badge(child.Status)">@L.Localize(child.Status)</OmniBadge>
                </span>
            }
            @if (lineage.Downstream.Count > MaxShown)
            {
                <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" Class="run-lineage-see-all" OnClick="@ShowAllAsync"><OmniIcon Name="OmniIconName.ListBullets" /> <span>@L["SeeAll"] (@lineage.Downstream.Count)</span></OmniButton>
            }
        }
    </div>
</OmniCard>
