@* The radio value is the visible label itself, so whatever reads the radio (a screen reader, an
   inspection tool) gets the label and never a raw "True" / "False". *@
<OmniRadioButtonList TValue="string" Label="@L["PipelineSetupStartFrom"]" Options="@Options"
                     Value="@Selected" ValueChanged="@OnChanged" ValueExpression="@(() => Selected)"
                     data-testid="setup-start-from" />
