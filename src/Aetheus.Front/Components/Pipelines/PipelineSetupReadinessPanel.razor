@* R2-17 / R2-26: ONE block "to do before creating" in three zones: the Git repository line, the libraries and
   vaults line, then the list of those libraries and vaults below both. Each line keeps its height before and
   after its creation, and the two create buttons (Primary, an exception the user chose) share one column.
   Creating updates this block in place: OE's busy veil lies over it and its content stays mounted underneath
   (R2-20). Explanations are tooltips (R2-18); the only alert is the one saying the creation cannot go on. *@
<div class="pipeline-setup-readiness" data-testid="setup-readiness">
    @if (Readiness is null && Loading)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
    }
    else if (Readiness is null)
    {
        <OmniAlert Severity="OmniSeverity.Info">
            @L["PipelineSetupReadinessUnavailable"]
        </OmniAlert>
    }
    else
    {
        <OmniCard Class="@(Busy ? "omni-busy" : null)" aria-busy="@(Busy ? "true" : "false")" data-testid="setup-todo">
            <HeaderContent>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center"
                           Justify="OmniJustification.Between" Gap="OmniSpacing.Small">
                    <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                        <strong>@L["PipelineSetupRecapTodoTitle"]</strong>
                        <PipelineInfoTip Text="@L["PipelineSetupRecapTodoHelp"].Value" />
                    </OmniStack>
                    <OmniBadge Tone="@(ActionCount > 0 ? OmniTone.Warning : OmniTone.Success)" Fill="OmniFill.Outline"
                               data-testid="setup-todo-state">@StateText</OmniBadge>
                </OmniStack>
            </HeaderContent>
            <ChildContent>
                <div class="pipeline-setup-todo">
                    <div class="pipeline-setup-todo-row" data-testid="setup-todo-repository">
                        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Wrap="true" Gap="OmniSpacing.Small">
                            <OmniBadge Tone="@(RepositoryMissing ? OmniTone.Warning : OmniTone.Success)" Fill="OmniFill.Tonal">
                                <Icon><OmniIcon Name="@(RepositoryMissing ? OmniIconName.Warning : OmniIconName.Check)" /></Icon>
                            </OmniBadge>
                            <strong>@L["PipelineSetupRecapRepository"]</strong>
                            <PipelineInfoTip Text="@RepositoryHelp" />
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 omni-u-text-muted">
                                @L[RepositoryMissing ? "PipelineSetupRecapRepositoryMissing" : "PipelineSetupRecapRepositoryReady"]
                            </OmniText>
                        </OmniStack>
                        <div class="pipeline-setup-todo-action">
                            @if (RepositoryMissing)
                            {
                                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@CreateRepositoryAsync"
                                            data-testid="setup-readiness-create-repository"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["CreateGitRepository"]</span></ChildContent></OmniButton>
                            }
                        </div>
                    </div>

                    @if (Elements.Count > 0)
                    {
                        <div class="pipeline-setup-todo-row" data-testid="setup-todo-elements">
                            <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Wrap="true" Gap="OmniSpacing.Small">
                                <OmniBadge Tone="@(Pending.Count > 0 ? OmniTone.Warning : OmniTone.Success)" Fill="OmniFill.Tonal">
                                    <Icon><OmniIcon Name="@(Pending.Count > 0 ? OmniIconName.Warning : OmniIconName.Check)" /></Icon>
                                </OmniBadge>
                                <strong>@L["PipelineSetupRecapElements"]</strong>
                                <PipelineInfoTip Text="@L["PipelineSetupRecapElementsHelp"].Value" />
                                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 omni-u-text-muted"
                                          data-testid="setup-todo-elements-state">@ElementsState</OmniText>
                            </OmniStack>
                            <div class="pipeline-setup-todo-action">
                                @if (CanProvision)
                                {
                                    <div data-testid="setup-provision">
                                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ProvisionAsync" Busy="@_provisioning"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["PipelineSetupProvision"]</span></ChildContent></OmniButton>
                                    </div>
                                }
                            </div>
                        </div>

                        <OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Gap="OmniSpacing.Small"
                                   Class="pipeline-setup-todo-list" data-testid="setup-todo-elements-list">
                            @foreach (var element in Elements)
                            {
                                <OmniTooltip Text="@Purpose(element)" Focusable="true" MaxWidth="OmniTooltipWidth.Wide">
                                    <OmniBadge Tone="@(element.Created ? OmniTone.Success : OmniTone.Neutral)" Fill="OmniFill.Tonal"
                                               data-testid="@(element.Created ? "setup-provisioned-created" : "setup-provisioned-pending")">@ChipText(element)</OmniBadge>
                                </OmniTooltip>
                            }
                        </OmniStack>
                    }
                </div>
            </ChildContent>
        </OmniCard>

        @if (OtherChecks.Count > 0)
        {
            @* R2-24: the findings are another block than the to-do list, told apart by a rule. *@
            <OmniDivider />
            <OmniCard data-testid="setup-checks">
                <HeaderContent><strong>@L["PipelineSetupRecapChecksTitle"]</strong></HeaderContent>
                <ChildContent>
                    <OmniStack Gap="OmniSpacing.Medium">
                        <PipelineReadinessChecks Checks="@OtherChecks" ProjectId="@ProjectId" ReturnUrl="@ReturnUrl"
                                                 BlockingAsAlert="false" OnChanged="@OnChanged" />
                    </OmniStack>
                </ChildContent>
            </OmniCard>
        }
        @if (_provisionError is not null)
        {
            <OmniAlert Severity="OmniSeverity.Danger">
                @_provisionError
            </OmniAlert>
        }
        @if (Blocked)
        {
            <OmniAlert Severity="OmniSeverity.Warning" data-testid="setup-blocked">
                @L["PipelineSetupRecapBlocked"]
            </OmniAlert>
        }
    }
</div>
