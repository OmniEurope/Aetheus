<div class="pipeline-setup-readiness" data-testid="setup-readiness">
    <OmniHeading Level="OmniHeadingLevel.H5">@L["PipelineSetupReadinessTitle"]</OmniHeading>
    @if (Loading)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
    }
    else if (Readiness is null)
    {
        <OmniAlert Severity="OmniSeverity.Info">
            @L["PipelineSetupReadinessUnavailable"]
        </OmniAlert>
    }
    else
    {
        @if (Readiness.Checks.Count == 0)
        {
            <OmniAlert Severity="OmniSeverity.Success">
                @L["PipelineSetupReadinessAllClear"]
            </OmniAlert>
        }
        else
        {
            @foreach (var check in Readiness.Checks)
            {
                <OmniAlert Severity="@(check.Severity == PipelineSetupReadinessSeverity.Blocking ? OmniSeverity.Warning : OmniSeverity.Info)"
                             data-testid="setup-readiness-check">
                    <OmniStack Gap="OmniSpacing.Small">
                        <strong>@L[TitleKey(check.Kind)]</strong>
                        <span>@L[HintKey(check.Kind)]</span>
                        @if (check.Items.Count > 0)
                        {
                            <ul class="pipeline-setup-readiness-items">
                                @foreach (var item in check.Items)
                                {
                                    <li>
                                        <code>@item</code>
                                        @if (ItemRole(check.Kind, item) is { } role)
                                        {
                                            <span data-testid="setup-readiness-item-role"> : @role</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (RemediationHref(check.Kind) is { } href)
                        {
                            <OmniLink Href="@href"><OmniIcon Name="OmniIconName.ArrowRight" /> @L[RemediationKey(check.Kind)]</OmniLink>
                        }
                    </OmniStack>
                </OmniAlert>
            }
        }

        @* PLAN-003 lot 30 / D22: the two findings a click can fix get their fix here. *@
        @if (CanProvision)
        {
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Medium"
                         Class="omni-u-mt-sm" data-testid="setup-provision">
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ProvisionAsync" Class="@(_provisioning ? "btn-busy" : null)" Busy="@(_provisioning)"><OmniIcon Name="OmniIconName.Add" /> <span>@L["PipelineSetupProvision"]</span></OmniButton>
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 omni-u-text-muted">
                    @L["PipelineSetupProvisionHint"]
                </OmniText>
            </OmniStack>
        }
        @if (_provisionError is not null)
        {
            <OmniAlert Severity="OmniSeverity.Danger" Class="omni-u-mt-sm">
                @_provisionError
            </OmniAlert>
        }
        @if (_provisioned is not null && (_provisioned.Libraries.Count > 0 || _provisioned.Vaults.Count > 0))
        {
            <OmniAlert Severity="OmniSeverity.Success"
                         Class="omni-u-mt-sm" data-testid="setup-provisioned">
                <OmniStack Gap="OmniSpacing.XSmall">
                    <strong>@L["PipelineSetupProvisioned"]</strong>
                    @foreach (var library in _provisioned.Libraries)
                    {
                        <span>
                            <a href="@($"/variable-libraries/{library.Id}")">@library.Name</a>
                            · @string.Format(L["PipelineSetupProvisionedKeys"], library.Keys.Count)
                            @if (library.KeysCopiedFrom is null)
                            {
                                <text> · @L["PipelineSetupProvisionedEmpty"]</text>
                            }
                        </span>
                    }
                    @foreach (var vault in _provisioned.Vaults)
                    {
                        <span>
                            <a href="@($"/vaults/{vault.Id}")">@vault.Name</a>
                            · @string.Format(L["PipelineSetupProvisionedKeys"], vault.Keys.Count)
                            @if (vault.KeysCopiedFrom is null)
                            {
                                <text> · @L["PipelineSetupProvisionedEmpty"]</text>
                            }
                        </span>
                    }
                </OmniStack>
            </OmniAlert>
        }

        @* Never let an empty finding list read as "the files are there" when they were never read. *@
        @if (!Readiness.RepositoryInspected)
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">
                @L["PipelineSetupReadinessFilesNotChecked"]
            </OmniText>
        }
        else if (!string.IsNullOrWhiteSpace(Readiness.InspectedBranch))
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">
                @string.Format(L["PipelineSetupReadinessCheckedOn"], Readiness.InspectedBranch)
            </OmniText>
        }
    }
</div>
