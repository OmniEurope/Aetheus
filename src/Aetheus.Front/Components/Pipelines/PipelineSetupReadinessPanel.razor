<div class="pipeline-setup-readiness" data-testid="setup-readiness">
    <OmniHeading Level="OmniHeadingLevel.H5">@L["PipelineSetupReadinessTitle"]</OmniHeading>
    @if (Loading)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
    }
    else if (Readiness is null)
    {
        <OmniAlert Severity="OmniSeverity.Info">
            @L["PipelineSetupReadinessUnavailable"]
        </OmniAlert>
    }
    else
    {
        @if (Readiness.Checks.Count == 0)
        {
            <OmniAlert Severity="OmniSeverity.Success">
                @L["PipelineSetupReadinessAllClear"]
            </OmniAlert>
        }
        else
        {
            <PipelineReadinessChecks Checks="@Readiness.Checks" ProjectId="@ProjectId" ReturnUrl="@ReturnUrl"
                                     ProvisionOffered="true" OnChanged="@OnChanged" />
        }

        @* Missing required libraries and vaults can be created directly from their readiness
           findings. *@
        @if (CanProvision)
        {
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Medium"
                         Class="omni-u-mt-sm" data-testid="setup-provision">
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ProvisionAsync" Class="@(_provisioning ? "btn-busy" : null)" Busy="@(_provisioning)"><OmniIcon Name="OmniIconName.Add" /> <span>@L["PipelineSetupProvision"]</span></OmniButton>
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 omni-u-text-muted">
                    @L["PipelineSetupProvisionHint"]
                </OmniText>
            </OmniStack>
        }
        @if (_provisionError is not null)
        {
            <OmniAlert Severity="OmniSeverity.Danger" Class="omni-u-mt-sm">
                @_provisionError
            </OmniAlert>
        }
        @* Each created library or vault stays listed as created, and is checked only once the user
           has opened it. *@
        @if (Provisioned.Count > 0)
        {
            <OmniAlert Severity="@(AllChecked ? OmniSeverity.Success : OmniSeverity.Info)"
                         Class="omni-u-mt-sm" data-testid="setup-provisioned">
                <OmniStack Gap="OmniSpacing.Small">
                    <strong>@L["PipelineSetupProvisioned"]</strong>
                    @foreach (var element in Provisioned)
                    {
                        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small" Wrap="true"
                                   data-testid="setup-provisioned-item">
                            @if (element.Checked)
                            {
                                <OmniBadge Tone="OmniTone.Success" data-testid="setup-provisioned-checked"><Icon><OmniIcon Name="OmniIconName.Check" /></Icon><ChildContent>@L["PipelineSetupProvisionedChecked"]</ChildContent></OmniBadge>
                            }
                            else
                            {
                                <OmniBadge Tone="OmniTone.Info" data-testid="setup-provisioned-created">@L["PipelineSetupProvisionedCreated"]</OmniBadge>
                            }
                            <strong>@L[element.Kind == ProvisionedKind.Library ? "VariableLibrary" : "Vault"] @element.Name</strong>
                            <span>@string.Format(L["PipelineSetupProvisionedKeys"], element.KeyCount)</span>
                            @if (!element.KeysCopied)
                            {
                                <span>@L["PipelineSetupProvisionedEmpty"]</span>
                            }
                            <OmniLink Href="@CheckHref(element)" OnClick="@(() => MarkChecked(element))"
                                      data-testid="setup-provisioned-open"><OmniIcon Name="OmniIconName.ArrowRight" /> @L["PipelineSetupProvisionedOpen"]</OmniLink>
                        </OmniStack>
                    }
                    @if (!AllChecked)
                    {
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted"
                                  data-testid="setup-provisioned-pending">
                            @L["PipelineSetupProvisionedCheckFirst"]
                        </OmniText>
                    }
                </OmniStack>
            </OmniAlert>
        }

        @* Never let an empty finding list read as "the files are there" when they were never read. *@
        @if (!Readiness.RepositoryInspected)
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">
                @L["PipelineSetupReadinessFilesNotChecked"]
            </OmniText>
        }
        else if (!string.IsNullOrWhiteSpace(Readiness.InspectedBranch))
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">
                @string.Format(L["PipelineSetupReadinessCheckedOn"], Readiness.InspectedBranch)
            </OmniText>
        }
    }
</div>
