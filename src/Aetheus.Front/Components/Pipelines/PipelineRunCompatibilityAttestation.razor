@* The QA compatibility attestation has its own timeline tile, with explanatory labels and a link
   to the previous version's commit. *@
@if (Mode is { Length: > 0 } mode)
{
    <OmniCard Class="run-attestation-card">
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.ShieldCheck" Class="run-tile-icon" /> @L["CompatibilityAttestation"]</OmniText>
        <div class="run-attestation-row" data-testid="attestation-mode">
            <span class="run-tile-sublabel">@L["CompatibilityMode"]</span>
            <span class="run-attestation-value" title="@mode">@Readable(ModeCodes, "CompatibilityModeValue", mode)</span>
            @if (Hint(ModeCodes, "CompatibilityModeHint", mode) is { } modeHint)
            {
                <span class="run-attestation-hint">@modeHint</span>
            }
        </div>
        <div class="run-attestation-row" data-testid="attestation-previous">
            <span class="run-tile-sublabel">@L["PreviousVersionTested"]</span>
            @if (PreviousSha is { } sha)
            {
                @* PreviousHref is null only for a run with neither repository nor project. *@
                <ShortId Value="@sha" Href="@PreviousHref" Copyable="false" Class="cross-link-sha run-attestation-value" />
            }
            else if (Previous is { Length: > 0 } previous && previous != NoPrevious)
            {
                <span class="run-attestation-value">@previous</span>
            }
            else
            {
                <span class="run-attestation-value">@L["CompatibilityNoPreviousVersion"]</span>
            }
        </div>
        @if (Verdict is { Length: > 0 } verdict)
        {
            <div class="run-attestation-row" data-testid="attestation-verdict">
                <span class="run-tile-sublabel">@L["CompatibilityVerdict"]</span>
                <OmniBadge Fill="OmniFill.Solid" Tone="@VerdictVariant(verdict)" title="@verdict">@Readable(VerdictCodes, "CompatibilityVerdictValue", verdict)</OmniBadge>
                @if (Hint(VerdictCodes, "CompatibilityVerdictHint", verdict) is { } verdictHint)
                {
                    <span class="run-attestation-hint">@verdictHint</span>
                }
            </div>
        }
    </OmniCard>
}
