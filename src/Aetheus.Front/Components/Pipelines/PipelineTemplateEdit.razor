@page "/templates/new"
@page "/templates/{Id:int}"

<PageTitle>@(_isNew ? L["NewTemplate"] : _template?.Name ?? L["EditTemplate"]) - Aetheus</PageTitle>

@{
    // STD-BTN detection 11: Versions sits in the header menu, shown only once a template is loaded.
    RenderFragment templateMenu = @<text>
        <OmniMenuItem OnClick="@ViewHistory"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent>@L["Versions"]</ChildContent></OmniMenuItem>
    </text>;
}
<OmniPageHeader Title="@(_isNew ? L["NewTemplate"] : _template?.Name ?? L["EditTemplate"])" ShowBack="true" Subtitle="@Breadcrumb.Subtitle()" MenuContent="@(_template is null ? null : templateMenu)">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("description")" /></Icon>
    <Badges>
        @if (_template is not null)
        {
            <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@($"v{_template.Version}")</NumberBadge>
        }
    </Badges>
    <ActionsContent>
        @if (_template is not null)
        {
            @* STD-BTN detection 11: Use template visible, the other actions in the menu. *@
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@UseTemplate"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["UseTemplate"]</span></ChildContent></OmniButton>
        }
    </ActionsContent>
</OmniPageHeader>

@if (_loading)
{
    <AetheusLoader />
}
else if (_notFound)
{
    <OmniAlert Severity="OmniSeverity.Warning">@L["TemplateNotFound"]</OmniAlert>
}
else if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger">@L["LoadFailed"]</OmniAlert>
}
else
{
    <OmniTemplateForm TModel="TemplateFormModel" Model="@_model" OnValidSubmit="@OnSubmitAsync">
        <OmniDataAnnotationsValidator Localizer="@L" />
        @* R-14: the blocks of the form (fields, YAML, changelog, actions) are separated only by this stack's gap. *@
        <OmniStack>
        @if (_readOnly)
        {
            @* The server says the user cannot change this template (CanEdit): a shared delivery template, or no
               Write on it. It is shown to read, with no save. *@
            <OmniAlert Severity="OmniSeverity.Info">@(_template!.IsShared ? L["SharedTemplateReadOnlyNote"] : L["ReadOnlyTemplateNote"])</OmniAlert>
        }
        <OmniRow Gap="OmniSpacing.Large">
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField Label="@L["Name"]" Class="omni-u-w-100" For="Name">
                        <OmniTextBox @bind-Value="_model.Name"
                            Id="Name" Disabled="@(!_isNew)" Class="omni-u-w-100" />
                    </OmniFormField>
                    <ValidationMessage For="@(() => _model.Name)" />
                    <OmniFormField Label="@L["Category"]" Class="omni-u-w-100" For="Category">
                        <OmniTextBox @bind-Value="_model.Category"
                            Id="Category" Disabled="@_readOnly" Class="omni-u-w-100" />
                    </OmniFormField>
                    <ValidationMessage For="@(() => _model.Category)" />
                </OmniStack>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField Label="@L["Description"]" Class="omni-u-w-100" For="Description">
                        <OmniTextArea @bind-Value="_model.Description"
                            Id="Description" Rows="3" Disabled="@_readOnly" Class="omni-u-w-100" />
                    </OmniFormField>
                    @if (!_readOnly)
                    {
                        <OmniFormField Label="@L["ChangelogEntry"]" Class="omni-u-w-100" For="ChangelogEntry">
                            <OmniTextBox @bind-Value="_model.ChangelogEntry"
                                Id="ChangelogEntry" Placeholder="@L["DescribeChanges"]" Class="omni-u-w-100" />
                        </OmniFormField>
                        <ValidationMessage For="@(() => _model.ChangelogEntry)" />
                    }
                </OmniStack>
            </OmniColumn>
        </OmniRow>

        <OmniText Element="OmniTextElement.Strong">@L["YAML"]</OmniText>
        @if (_readOnly)
        {
            <OmniCodeViewer Code="@_model.YamlContent" Title="@_model.Name" Language="yaml" />
        }
        else
        {
            <MonacoEditor Value="@_model.YamlContent" ValueChanged="@(value => _model.YamlContent = value)" />
            <ValidationMessage For="@(() => _model.YamlContent)" />
        }

        @if (!string.IsNullOrWhiteSpace(_template?.Changelog))
        {
            <OmniFieldset Collapsible="true" Expanded="false"><Legend>@L["Changelog"]</Legend><ChildContent>
                <pre class="text-block-pre">@_template.Changelog</pre>
            </ChildContent></OmniFieldset>
        }

        <OmniStack Orientation="OmniOrientation.Horizontal" Justify="OmniJustification.End" Gap="OmniSpacing.Small">
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@Cancel"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@L["GoBack"]</span></ChildContent></OmniButton>
            @if (!_readOnly)
            {
                <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
            }
        </OmniStack>
        </OmniStack>
    </OmniTemplateForm>
}
