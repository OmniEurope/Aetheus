@using static Aetheus.Front.Components.Shared.PipelineRunFormatting

@if (_files.Count > 0)
{
    @* Coverage files are grouped under projects with aggregate figures so large reports remain
       navigable. *@
    <OmniText Element="OmniTextElement.Strong" Class="omni-u-mb-sm">@L["CoverageByProject"]</OmniText>
    <OmniTree TValue="string" Label="@L["CoverageByProject"]" Class="coverage-project-tree">
        @foreach (var project in _projects)
        {
            <OmniTreeItem @key="project.Name" TValue="string" Value="@project.Name"
                          Text="@CoverageTreeText(project.Name, project.LineRate, project.LinesCovered, project.LinesValid)">
                @foreach (var file in project.Files)
                {
                    <OmniTreeItem @key="file.File" TValue="string" Value="@file.File" title="@file.File"
                                  Text="@CoverageTreeText(ShortPath(file.File), file.LineRate, file.LinesCovered, file.LinesValid)" />
                }
            </OmniTreeItem>
        }
    </OmniTree>
}
else if (_loading)
{
    <AetheusLoader />
}
