@* The tile is itself the link to the Gate tab (OmniFactTile.Href), a direct child of the run's OmniTileGrid. *@
<OmniFactTile Title="@L["AnalysisGateOverview"]" Href="@Href" Class="analysis-run-gate-tile">
    <Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon>
    <ChildContent>
        @* The word is dropped when the letter carries the same verdict; see
           PipelineRunGatePresentation.ShowsStatusWord for the blocked and error cases. *@
        @if (PipelineRunGatePresentation.ShowsStatusWord(Gate))
        {
            <OmniFactTileRow Term="@L["Status"]"><Icon><OmniIcon Name="OmniIconName.Info" /></Icon><ChildContent><OmniBadge Fill="OmniFill.Solid" Tone="@PipelineRunGatePresentation.GateStyle(Gate.Status)">@L[PipelineRunGatePresentation.StatusKey(Gate.Status)]</OmniBadge></ChildContent></OmniFactTileRow>
        }
        @if (PipelineRunGatePresentation.HeadlineGrade(Gate, RunGrade) is { } grade)
        {
            <OmniFactTileRow Term="@L["GateGrade"]"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent><GradeBadge Value="@grade" Title="@L["GateGrade"]" Class="pipeline-gate-grade-badge" /></ChildContent></OmniFactTileRow>
        }
        <OmniFactTileRow Term="@L["AnalysisGateFindings"]"><Icon><OmniIcon Name="OmniIconName.ListChecks" /></Icon><ChildContent>@Gate.FindingCount</ChildContent></OmniFactTileRow>
    </ChildContent>
</OmniFactTile>