@*
    The run page's approval region, extracted from PipelineRun.razor when adding the second state below
    took that file over its 600-line budget. Two states, and the second is the point: a run parked on a
    decision that is offered, and a run parked on one that is not.
*@
@if (Approval?.Pending is not null)
{
    @* Banner text and actions wrap on narrow screens; Approve and Reject retain accessible labels
       when only icons are visible. *@
    <OmniAlert Severity="OmniSeverity.Warning" Title="@BannerTitle" Class="run-approval-banner">
        @* The pipeline's own approval and the environment's are told apart. *@
        <div>@(Approval.Pending.Scope == ApprovalScope.Pipeline
                  ? string.Format(L["PipelineApprovalRequiredDetail"], Approval.Pending.StageName)
                  : string.Format(L["ApprovalRequiredDetail"], Approval.Pending.StageName, Approval.Pending.EnvironmentName))</div>
        @if (!string.IsNullOrWhiteSpace(Approval.EnvironmentInstructions))
        {
            @* The environment's approval instructions, named as such for the approver. *@
            <div class="omni-u-mt-sm approval-instructions"><span class="approval-instructions-label">@L["ApprovalInstructionsForApprover"]</span> @Approval.EnvironmentInstructions</div>
        }
        @* A newer Aetheus was deployed than the one this page runs. The approval that confirms a
           production switch is answered from the new version, after checking it works: the
           decision is offered again once the page is reloaded. *@
        @if (VersionState.NewVersionAvailable)
        {
            <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Small" Align="OmniAlignment.Start" Class="omni-u-mt-md approval-reload-first">
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["ApprovalReloadFirst"]</OmniText>
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@Reload"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["ReloadNow"]</span></ChildContent></OmniButton>
            </OmniStack>
        }
        else
        {
        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Small" Class="omni-u-mt-md role-edit-stack">
            @* The comment field appears on request; Approve and Reject both stay visible (user decision, 2026-10-17). *@
            @if (CommentOpen)
            {
                <OmniTextArea aria-label="@L["ApprovalCommentsOptional"]" @bind-Value="Approval.Comments" Placeholder="@L["ApprovalCommentsOptional"]" Rows="2" Id="@CommentFieldId" Class="omni-u-w-100 approval-comment" />
            }
            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Wrap="true" Class="approval-decisions">
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => Approval.DecideAsync(ApprovalStatus.Approved))" Class="@DecisionClass" Busy="@(Approval.Deciding)" Label="@L["Approve"]" title="@L["Approve"]"><Icon><OmniIcon Name="OmniIconName.CheckCircle" /></Icon><ChildContent><span>@L["Approve"]</span></ChildContent></OmniButton>
                <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => Approval.DecideAsync(ApprovalStatus.Rejected))" Class="@DecisionClass" Busy="@(Approval.Deciding)" Label="@L["Reject"]" title="@L["Reject"]"><Icon><OmniIcon Name="OmniIconName.Prohibit" /></Icon><ChildContent><span>@L["Reject"]</span></ChildContent></OmniButton>
                @if (!CommentOpen)
                {
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@OpenComment" Disabled="@(Approval.Deciding)" Class="approval-add-comment"><Icon><OmniIcon Name="OmniIconName.Chat" /></Icon><ChildContent><span>@L["ApprovalAddComment"]</span></ChildContent></OmniButton>
                }
            </OmniStack>
        </OmniStack>
        }
    </OmniAlert>
}
else if (Approval?.WaitingWithoutApproval == true)
{
    @* Run 2152 sat here for eight days showing nothing at all: the status said it waited on a human,
       and the page offered no human anything to do. Saying which of the two reasons applies beats it. *@
    <OmniAlert Severity="OmniSeverity.Danger" Title="@L["ApprovalMissingTitle"]">
        <div>@L[Approval.LoadFailed ? "ApprovalLoadFailedDetail" : "ApprovalMissingDetail"]</div>
    </OmniAlert>
}
