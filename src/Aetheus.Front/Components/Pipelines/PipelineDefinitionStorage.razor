@* Recette R1-34: where this pipeline's definition is kept. In the project's internal Git repository
   (.pipeline/{name}.yaml, with its history) when there is one, in Aetheus otherwise. Nothing is said
   when the backend could not be read: the page never claims a place it did not read. *@
@if (_loaded)
{
    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="pipeline-definition-storage" data-testid="pipeline-definition-storage">
        <OmniIcon Name="@(_source is null ? OmniIconName.Database : OmniIconName.GitCommit)" />
        @if (_source is null)
        {
            <span>@L["PipelineDefinitionStoredInAetheus"]</span>
        }
        else
        {
            <span>@string.Format(L["PipelineDefinitionStoredInGit"], _source.Path, _source.Branch)</span>
            <OmniLink Href="@($"/git-repositories/{_source.RepositoryId}")">@L["PipelineDefinitionOpenRepository"]</OmniLink>
        }
    </OmniText>
}
