@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Sections

@if (!Embedded)
{
    <PageTitle>@L["PipelineTemplates"] - Aetheus</PageTitle>
}

@if (!Embedded)
{
    <OmniPageHeader Title="@L["PipelineTemplates"]" Subtitle="@Breadcrumb.Subtitle()">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("description")" /></Icon>
        <Badges>
            <HelpLink PageKey="templates" />
        </Badges>
        <ActionsContent>
            <SectionOutlet SectionName="@PageHeaderActions.SectionName" />
        </ActionsContent>
    </OmniPageHeader>
}

@* Recette R-109 (rule 1 of R-30): Create, the main action, sits in the page header (the pipelines hub's, or this
   page's own), with Import in the menu beside it. *@
@if (_canWrite)
{
    <SectionContent SectionName="@PageHeaderActions.SectionName">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@CreateTemplate" title="@L["NewTemplate"]"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
        <OmniOverflowMenu Label="@L["Tools"]">
            <OmniMenuItem OnClick="@OnImportClickAsync"><Icon><OmniIcon Name="OmniIconName.Upload" /></Icon><ChildContent>@L["Import"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    </SectionContent>
}

@if (_showImporter)
{
    <OmniUpload MaximumFileSize="1048576"
                AllowedContentTypes="@YamlContentTypes"
                OnFilesSelect="@OnFileSelectedAsync" />
}

@if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger">
        @L["LoadFailed"]
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@LoadTemplatesAsync" title="@L["Retry"]"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["Retry"]</span></ChildContent></OmniButton>
    </OmniAlert>
}
else
{
    <AetheusDataGrid @ref="_grid" Data="@_templates" TItem="PipelineTemplateSummaryDto" IsLoading="@_loading"
        RowClick="@EditTemplate" FullHeight="true" Virtualize="@(_templates.Count > 20)" PageSize="20">
        <EmptyTemplate>
            <EmptyState Icon="description" Title="@L["NoRecords"]" Description="@L["EmptyTemplatesHint"]">
                <ActionContent>
                    @if (_canWrite)
                    {
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@CreateTemplate" title="@L["NewTemplate"]"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
                    }
                </ActionContent>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="PipelineTemplateSummaryDto" Property="Name" Title="@L["Name"]" Filterable="true" >
                <Template Context="template">
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                        <a href="@($"/templates/{template.Id}")" class="pipeline-name-link" title="@template.Name"
                            @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@template.Name</a>
                        @if (template.IsShared)
                        {
                            <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Neutral))" Fill="OmniFill.Tonal" Tone="OmniTone.Neutral">@L["SharedTemplate"]</OmniBadge>
                        }
                    </OmniStack>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineTemplateSummaryDto" Property="Version" Title="@L["VersionShort"]"
                Width="5rem" Filterable="false" TextAlign="OmniAlignment.Center">
                <Template Context="template">@($"v{template.Version}")</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineTemplateSummaryDto" Property="Description" Truncate="true" Title="@L["Description"]" Width="8rem" Filterable="true" >
                <Template Context="template"><span title="@template.Description">@template.Description</span></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineTemplateSummaryDto" Property="UpdatedAt" Title="@L["Updated"]"
                Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true">
                <Template Context="template">
                    @if (template.UpdatedAt.Year < 2000)
                    {
                        <span>@L["Never"]</span>
                    }
                    else
                    {
                        <span title="@template.UpdatedAt.ToString("F")">@RelativeTime.FormatAgo(L, template.UpdatedAt)</span>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineTemplateSummaryDto" Property="PipelineCount" Title="@L["Pipelines"]"
                Width="6.5rem" Filterable="false" TextAlign="OmniAlignment.Center">
                <Template Context="template">
                    @if (template.PipelineCount > 0)
                    {
                        <a href="@($"/pipelines?templateId={template.Id}")" class="pipeline-name-link"
                            title="@string.Format(L["ViewPipelinesUsingTemplate"], template.Name)"
                            @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@template.PipelineCount</a>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineTemplateSummaryDto" Property="LatestRunAt" Title="@L["LatestRunShort"]"
                Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true">
                <Template Context="template">
                    @if (template.LatestRunAt is { } latestRunAt)
                    {
                        <span title="@latestRunAt.ToString("F")">@RelativeTime.FormatAgo(L, latestRunAt)</span>
                    }
                    else
                    {
                        <span>@L["Never"]</span>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineTemplateSummaryDto" Title="@L["Actions"]" Width="8rem"
                Sortable="false" Filterable="false" TextAlign="OmniAlignment.End">
                <Template Context="template">
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        @* STD-BTN detection 11: Edit and Delete visible (Use template without write access), the other actions in the menu. *@
                        @* A template the user may not change (a shared one, or no Write on it, from the server's CanEdit) opens read-only: no Edit or Delete. *@
                        @if (_canWrite && template.CanEdit)
                        {
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => EditTemplate(template))" title="@L["Edit"]" Label="@L["Edit"]"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon></OmniButton>
                            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteTemplateAsync(template))" title="@L["Delete"]" Label="@L["Delete"]"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton>
                        }
                        else
                        {
                            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => UseTemplate(template))" title="@L["UseTemplate"]" Label="@L["UseTemplate"]"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon></OmniButton>
                        }
                        <OmniOverflowMenu Label="@L["MoreActions"]">
                            @if (_canWrite && template.CanEdit)
                            {
                                <OmniMenuItem OnClick="@(() => UseTemplate(template))" title="@L["UseTemplate"]"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent>@L["UseTemplate"]</ChildContent></OmniMenuItem>
                            }
                            <OmniMenuItem OnClick="@(() => ViewHistory(template))" title="@L["VersionHistoryTitle"]"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent>@L["Versions"]</ChildContent></OmniMenuItem>
                            <OmniMenuItem OnClick="@(() => ExportTemplateAsync(template))"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent>@L["Export"]</ChildContent></OmniMenuItem>
                        </OmniOverflowMenu>
                    </span>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
}
