<OmniTemplateForm TModel="object" Model="@_formModel" OnValidSubmit="@OnSubmit">
    <div class="run-params-dialog">
        @if (Branches.Count > 0)
        {
            <div class="run-params-field">
    <OmniLabel For="launch-branch" Class="omni-u-mb-xs run-params-label">@L["Branch"]</OmniLabel>
                <OmniDropDown Id="launch-branch" TValue="string" Value="@_branch" ValueExpression="@(() => _branch)" name="launch-branch"
                                ValueChanged="@(async (string value) => await OnBranchChangedAsync(value))"
                                Options="@(Branches.ToOptions(item => (string)item.Name, item => item.Name))"
                                Disabled="@_reloading"
                                Class="run-params-input" />
            </div>
        }

        <RunParameterFields @key="_parametersRevision" @ref="_fields"
                            Parameters="@_parameters" AvailableReleases="@AvailableReleases" AvailableReleaseTotal="@AvailableReleaseTotal" />

        @* Offered only when the platform setting allows it; the backend refuses it otherwise. *@
        @if (RunToEndAllowed)
        {
            @* Drawn like the boolean parameters above: the label carries the "?", the switch sits under it. *@
            <OmniFormField For="launch-run-to-end" Label="@L["RunToEnd"]" Help="@L["RunToEndHelp"]" Class="run-params-field">
                <OmniSwitch Id="launch-run-to-end" @bind-Value="_runToEnd" aria-labelledby="launch-run-to-end-label" />
            </OmniFormField>
        }

        @if (Branches.Count == 0 && _parameters.Count == 0 && !RunToEndAllowed)
        {
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["NoRunOptions"]</OmniText>
        }

        @* The actions stay at the bottom of the dialog while the list above scrolls (R-27); a missing
           required value is told under its own field (R-26), not here. *@
        <div class="run-params-footer" data-testid="run-params-footer">
            <DialogFooter OnCancel="@OnCancel">
                <OmniButton Variant="OmniButtonVariant.Primary" Disabled="@_reloading" ButtonType="OmniButtonType.Submit"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent><span>@L["Run"]</span></ChildContent></OmniButton>
            </DialogFooter>
        </div>
    </div>
</OmniTemplateForm>
