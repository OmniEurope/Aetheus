@* SPDX-License-Identifier: EUPL-1.2 *@
@page "/pipelines/runs/{RunId:int}"
@using static Aetheus.Front.Components.Shared.PipelineRunFormatting
@using static Aetheus.Front.Components.Pipelines.PipelineRunLogView

<PageTitle>@(L["PipelineRun"]) #@RunId - Aetheus</PageTitle>

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else if (_run is null)
{
    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["RunNotFound"]</OmniText>
}
else
{
    @* R-14: the blocks of the page (header, approval, alerts, tabs) are separated only by this stack's gap. *@
    <OmniStack Class="pipeline-run-page">
    <PipelineRunHeader Run="@_run" PipelineHref="@PipelineHref" GitBranch="@GitBranch"
        WaitingReasonCount="@WaitViews.Count" GateIncomplete="@_gateState.IsIncomplete"
        BlockingWarningCount="@BlockingWarnings.Count" InfoWarningCount="@InfoWarnings.Count"
        RunInProgress="@(RunInProgress && !_run.CancellationRequested)" CanRerun="@CanRerun" HasFailedSteps="@HasFailedSteps"
        Cancelling="@_cancelling" Rerunning="@_rerunning" Retrying="@_retrying"
        VariablesRequested="@ShowVariables" EditRequested="@(() => Nav.NavigateTo(PipelineHref))"
        CancelRequested="@CancelRunAsync" RerunRequested="@OnRerunClick" RetryFailedRequested="@RetryFailedAsync" />
    @* F2: the approval region - the decision when there is one, and why there is none when there is not. *@
    <PipelineRunApprovalPanel Approval="_approval" />
    <PipelineRunResumePanel Run="@_run" Changed="@ReloadRunAsync" />

    @* Alerts *@
    @if (BlockingWarningViews.Count > 0)
    {
            <OmniAlert Severity="OmniSeverity.Danger" Title="@L["RunBlockedTitle"]">
            @foreach (var item in BlockingWarningViews)
            {
                <div class="run-warning-line">
                    @item.Message
                    @if (item.ConfigHref is not null)
                    {
                        <a href="@item.ConfigHref" class="pipeline-name-link omni-u-ms-sm">@L["ConfigureTarget"]</a>
                    }
                </div>
            }
            </OmniAlert>
    }
    @if (InfoWarnings.Count > 0)
    {
        <OmniAlert Severity="OmniSeverity.Warning"><Icon><OmniIcon Name="OmniIconName.Warning" /></Icon><ChildContent>
            @foreach (var warning in InfoWarnings) { <div class="run-warning-line">@SayWarning(warning)</div> }
        </ChildContent></OmniAlert>
    }
    @* Recette R-16: information about the run (no baseline on a first release), in blue, with a "?" saying what it implies. *@
    @foreach (var noticeCode in RunNoticeCodes)
    {
        <OmniAlert Severity="OmniSeverity.Info" data-testid="run-notice">
            <span class="run-warning-line">@RunNoticeText(noticeCode)</span>
            @if (RunNoticeHelp(noticeCode) is { } noticeHelp)
            {
                <PipelineInfoTip Text="@noticeHelp" />
            }
        </OmniAlert>
    }
    @if (_run.CancellationRequested && RunInProgress)
    {
            <OmniAlert Severity="OmniSeverity.Info" Title="@L["CancellationAcceptedTitle"]">
            @L["CancellationAcceptedDetail"]
            @if (PipelineRunPresentation.CancelledByText(_run, L) is { } cancelledBy)
            {
                <div class="run-cancelled-by">@cancelledBy</div>
            }
            </OmniAlert>
    }
    else if (_run.Status == PipelineStatus.Cancelled && PipelineRunPresentation.CancelledByText(_run, L) is { } cancelledBy)
    {
        @* Who stopped the run, once it is over. *@
        <OmniAlert Severity="OmniSeverity.Info"><Icon><OmniIcon Name="OmniIconName.Info" /></Icon><ChildContent>
            <div class="run-cancelled-by">@cancelledBy</div>
        </ChildContent></OmniAlert>
    }
    @* Header badges summarize the assurance verdict and waiting reasons; the overview tab holds
       their detail. *@
    @* S-UX-RUNB: surface WHY a run failed at the top of the page (failed step names + exit codes), so the
       "why" reads at a glance without opening the Overview tab or drilling into a step. *@
    @* Amber identifies a deployment whose rollback restored the previous version. *@
    @if (_run.Status is PipelineStatus.Failed or PipelineStatus.RolledBack && FailedSteps.Count > 0)
    {
        var rolledBack = _run.Status == PipelineStatus.RolledBack;
            <OmniAlert Severity="@(rolledBack ? OmniSeverity.Warning : OmniSeverity.Danger)"
                Title="@L[rolledBack ? "RunRolledBackTitle" : "RunFailedTitle"]">
            @string.Format(L["RunFailedStepsLabel"], FailedRunReason)
            </OmniAlert>
    }
    <PipelineRunToEndAlert Run="@_run" />
    <PipelineRunGateOverrideAlert Run="@_run" />

    @* Tabs *@
    @if (!TabsReady)
    {
        <AetheusLoader Size="OmniControlSize.Large" />
    }
    else
    {
    <UrlSyncedTabs class="pipeline-run-tabs" Slugs="@TabSlugs()" @bind-SelectedIndex="_selectedTab">
        <Tabs>
            @* Tab 1: Overview *@
            <OmniTabsItem Key="overview" Title="@L["Overview"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("dashboard"))" /></Icon><ChildContent>
                @* One vertical stack: its gap is the only space between the overview's blocks (R-14). *@
                <OmniStack Class="run-overview">
                    @{
                        var envNames = _run.Steps
                            .SelectMany(s => s.OutputVariables)
                            .Where(kv => kv.Key == "ENVIRONMENT_NAME")
                            .Select(kv => kv.Value)
                            .Distinct()
                            .ToList();
                        if (envNames.Count == 0)
                            envNames = _run.Artifacts
                                .Where(a => !string.IsNullOrEmpty(a.EnvironmentName))
                                .Select(a => a.EnvironmentName!)
                                .Distinct()
                                .ToList();
                        var stepProgress = PipelineRunPresentation.StepProgress(_run);
                    }
                    @* All run facts + produced outputs (release/artifact/env) share ONE OE tile grid: every
                       tile has the same width and height (recette R1-20) and a tile that leads somewhere is
                       itself the link or the button (OmniCard.Href / OnClick), never wrapped. *@
                    @* R-15: up to four tiles, fewer when the area is narrow: the column count follows the width of
                       the grid itself (MinColumnWidth), sidebar included, never below this width per tile. *@
                    <OmniTileGrid Columns="4" MinColumnWidth="@RunTileMinColumnWidth" Class="run-overview-tiles">
                        @* R-28: every tile is an OmniFactTile (OE): a title, then rows of icon, term and value on
                           columns shared by all the tiles; the clickable ones are themselves the link or the button. *@
                        @* Recette R1-64: the pipeline's id first; the run's own number is in the page title. *@
                        <OmniFactTile Title="@L["PipelineRun"]" Class="run-id-tile">
                            <Icon><OmniIcon Name="OmniIconName.Tag" /></Icon>
                            <ChildContent>
                                <OmniFactTileRow Term="@L["RunIdTile"]"><Icon><OmniIcon Name="OmniIconName.Tag" /></Icon><ChildContent>@_run.Id</ChildContent></OmniFactTileRow>
                                <OmniFactTileRow Term="@L["Pipeline"]"><Icon><OmniIcon Name="OmniIconName.Path" /></Icon><ChildContent><OmniLink Href="@PipelineHref" data-testid="run-pipeline-link">@_run.PipelineName</OmniLink></ChildContent></OmniFactTileRow>
                            </ChildContent>
                        </OmniFactTile>
                        @* Status and step progress answer the same question ("where does the run stand?"),
                           so they share one tile that links to the step logs. *@
                        <OmniFactTile Title="@L["Status"]" Href="@(TabHref("gate") ?? TabHref("logs"))" Class="run-status-tile">
                            <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                            <ChildContent>
                                <OmniFactTileRow Term="@L["Status"]"><Icon><OmniIcon Name="OmniIconName.Info" /></Icon><ChildContent><PipelineRunStatusBadge Status="_run.Status" /></ChildContent></OmniFactTileRow>
                                @* 2026-10-06: live updates down for more than a few seconds are said here, with
                                   since when; meanwhile the page reloads a running run by itself. *@
                                @if (RunInProgress && _live?.InterruptedSince is { } interruptedSince)
                                {
                                    <OmniFactTileRow Term="@L["RunLiveUpdates"]"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Warning" Class="run-live-interrupted-badge"
                                               title="@L["RunLiveInterruptedTitle"]">@string.Format(L["RunLiveInterrupted"].Value, interruptedSince.ToLocalTime().ToString("t"))</NumberBadge></ChildContent></OmniFactTileRow>
                                }
                                @* R1-12: an analysis report takes seconds to publish; say so while it lasts
                                   (the timeline below is veiled too). *@
                                @if (_live?.AnalysisPublishing == true)
                                {
                                    <OmniFactTileRow Term="@L["Quality"]"><Icon><OmniIcon Name="OmniIconName.Sync" /></Icon><ChildContent><OmniBadge Icon="@(BadgeIcon.For(OmniTone.Info))" Fill="OmniFill.Solid" Tone="OmniTone.Info" Class="run-analysis-publishing-badge"
                                               title="@L["AnalysisPublishingTitle"]">@L["AnalysisPublishing"]</OmniBadge></ChildContent></OmniFactTileRow>
                                }
                                @* The grade is the Quality tile's; a refused
                                   candidate (Deployable false) is stated here in short
                                   words (its full sentence is the tooltip); a cleared or
                                   undecided one shows nothing (R1-33). A Rejected run already says the
                                   candidate was refused. *@
                                @if (AssuranceVerdict is { Deployable: false } && _run.Status != PipelineStatus.Rejected)
                                {
                                    <OmniFactTileRow Term="@L["Candidate"]"><Icon><OmniIcon Name="OmniIconName.Prohibit" /></Icon><ChildContent><OmniBadge Icon="@(BadgeIcon.For(OmniTone.Warning))" Fill="OmniFill.Solid" Tone="OmniTone.Warning" Class="run-candidate-verdict-badge"
                                               title="@L["CandidateNotDeployableTitle"]">@L["CandidateNotDeployableShort"]</OmniBadge></ChildContent></OmniFactTileRow>
                                }
                                <OmniFactTileRow Term="@L["Steps"]"><Icon><OmniIcon Name="OmniIconName.Rows" /></Icon><ChildContent>@stepProgress.Completed / @stepProgress.Total</ChildContent></OmniFactTileRow>
                                @* R1-30: a deploy run has no Quality tile, so the Gate grade of the candidate it deployed is read here. *@
                                @if (PipelineRunGatePresentation.DeployedCandidateGrade(_run, ShowGateTab && _gateState.Result is not null) is { } deployedGrade)
                                {
                                    <OmniFactTileRow Term="@L["RunDeployedCandidateGate"]" data-testid="run-deployed-candidate-gate"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent><GradeBadge Value="@deployedGrade" Title="@L["GateGrade"]" Class="pipeline-gate-grade-badge" /></ChildContent></OmniFactTileRow>
                                }
                            </ChildContent>
                        </OmniFactTile>
                        @* Start instant and elapsed time are one timing fact, read together. *@
                        <OmniFactTile Title="@L["RunTiming"]">
                            <Icon><OmniIcon Name="OmniIconName.Timer" /></Icon>
                            <ChildContent>
                                <OmniFactTileRow Term="@L["Started"]" title="@_run.StartedAt.ToString("F")"><Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon><ChildContent>@_run.StartedAt.ToString("g")</ChildContent></OmniFactTileRow>
                                <OmniFactTileRow Term="@L["Duration"]"><Icon><OmniIcon Name="OmniIconName.Timer" /></Icon><ChildContent><PipelineRunLiveDuration StartedAt="@_run.StartedAt" CompletedAt="@_run.CompletedAt" IsRunning="@RunInProgress" /></ChildContent></OmniFactTileRow>
                                @if (_pipelineRunsSummary is { } runsSummary)
                                {
                                    <OmniFactTileRow Term="@L["AverageSuccessDuration"]" data-testid="run-average-success-duration"><Icon><OmniIcon Name="OmniIconName.Timer" /></Icon><ChildContent>@runsSummary.AverageDurationLabel(L["NotAvailableShort"])</ChildContent></OmniFactTileRow>
                                }
                            </ChildContent>
                        </OmniFactTile>
                        @if (ShowGateTab && _gateState.Result is { } gate)
                        {
                            <PipelineRunGateOverview Gate="@gate" BlockingTestCount="@(AssuranceVerdict?.BlockingTests.Count ?? 0)" RunGrade="@_run.GateGrade" Href="@TabHref("gate")" />
                        }
                        @if (_run.Parameters.Count > 0)
                        {
                            @* A button (it opens a dialog), so its content is phrasing content only. *@
                            <OmniFactTile Title="@L["RunParameters"]" OnClick="@ShowParameters" Class="run-parameters-tile">
                                <Icon><OmniIcon Name="OmniIconName.Sliders" /></Icon>
                                <ChildContent>
                                    <OmniFactTileRow Term="@L["RunTileCount"]"><Icon><OmniIcon Name="OmniIconName.Sliders" /></Icon><ChildContent>@_run.Parameters.Count</ChildContent></OmniFactTileRow>
                                    @* R-37: the libraries and vaults the run read, from the definition it executed. *@
                                    @if (UsedResources.Libraries.Count > 0)
                                    {
                                        <OmniFactTileRow Term="@L["Libraries"]" data-testid="run-used-libraries"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("data_object"))" /></Icon><ChildContent>@string.Join(", ", UsedResources.Libraries)</ChildContent></OmniFactTileRow>
                                    }
                                    @if (UsedResources.Vaults.Count > 0)
                                    {
                                        <OmniFactTileRow Term="@L["Vaults"]" data-testid="run-used-vaults"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("lock"))" /></Icon><ChildContent>@string.Join(", ", UsedResources.Vaults)</ChildContent></OmniFactTileRow>
                                    }
                                </ChildContent>
                            </OmniFactTile>
                        }
                        <PipelineRunSourceTile Run="@_run" RepoId="@_repoId" />
                        @* Parent run or the person who launched, and the runs this one started. *@
                        <PipelineRunLineageTile Run="@_run" ProjectId="@(ProjectId ?? _run.ProjectId)" ServerId="@ServerId" />
                        @* No coverage tile here. The figure belongs to quality: the run's Coverage
                           tab gives its detail and the project's Quality page its trend. *@
                        @* Produced outputs - same grid as the run facts so all tiles share the row and wrap together. *@
                        @foreach (var release in _releases)
                        {
                            <OmniFactTile Title="@L["Release"]" Href="@($"/releases/{release.Id}")">
                                <Icon><OmniIcon Name="OmniIconName.Sparkle" /></Icon>
                                <ChildContent>
                                    @* A commit-derived release name is a full 40-char sha; shorten it so the tile keeps
                                       its column width. No Href: the whole tile is already the link to the release. *@
                                    <OmniFactTileRow Term="@L["Release"]"><Icon><OmniIcon Name="OmniIconName.Sparkle" /></Icon><ChildContent><ShortId Value="@release.Version" Copyable="false" Class="run-release-version release-version" /> <ReleaseStatusBadge Status="@release.Status" /></ChildContent></OmniFactTileRow>
                                    @if (AppVersion is { Length: > 0 } appVersion)
                                    {
                                        <OmniFactTileRow Term="@L["Version"]" title="@appVersion"><Icon><OmniIcon Name="OmniIconName.Tag" /></Icon><ChildContent><span class="run-release-app-version">@appVersion</span></ChildContent></OmniFactTileRow>
                                    }
                                </ChildContent>
                            </OmniFactTile>
                        }
                        @if (_run.Artifacts.Count > 0)
                        {
                            @* A single artifact reads by its name, several by their count. *@
                            <OmniFactTile Title="@L["Artifacts"]" Href="@TabHref("artifacts")" Class="run-artifacts-tile">
                                <Icon><OmniIcon Name="OmniIconName.Archive" /></Icon>
                                <ChildContent>
                                    @if (_run.Artifacts.Count == 1)
                                    {
                                        <OmniFactTileRow Term="@L["Name"]"><Icon><OmniIcon Name="OmniIconName.Archive" /></Icon><ChildContent><span class="run-artifact-name">@_run.Artifacts[0].Name</span></ChildContent></OmniFactTileRow>
                                    }
                                    else
                                    {
                                        <OmniFactTileRow Term="@L["RunTileCount"]"><Icon><OmniIcon Name="OmniIconName.Archive" /></Icon><ChildContent>@_run.Artifacts.Count</ChildContent></OmniFactTileRow>
                                    }
                                </ChildContent>
                            </OmniFactTile>
                        }
                        @foreach (var env in envNames)
                        {
                            <OmniFactTile Title="@L["Environment"]">
                                <Icon><OmniIcon Name="OmniIconName.Cloud" /></Icon>
                                <ChildContent>
                                    <OmniFactTileRow Term="@L["Name"]"><Icon><OmniIcon Name="OmniIconName.Cloud" /></Icon><ChildContent>@env</ChildContent></OmniFactTileRow>
                                </ChildContent>
                            </OmniFactTile>
                        }
                        @* R-82: where a succeeded deployment put the application; absent when not known. *@
                        <PipelineRunDeployedTile Run="@_run" />
                    </OmniTileGrid>

                    @* The stage timeline precedes secondary details so the run's progress is
                       visible first. *@
                    @* R1-12: OE's veil lies over the timeline while a report is published; it stays mounted. *@
                    <div id="run-timeline-zone" class="@(_live?.AnalysisPublishing == true ? "run-timeline-zone omni-busy" : "run-timeline-zone")" aria-busy="@(_live?.AnalysisPublishing == true ? "true" : "false")"
                         title="@(_live?.AnalysisPublishing == true ? L["AnalysisPublishingTitle"].Value : null)">
                    <RunTimelineTree Run="_run!" Depth="0" SelectedStepId="_selectedStep?.Id" OnSelectStep="SelectStep"
                                     PreloadedChildren="ChildRuns" Baselines="_baselines.Runs"
                                     ProjectId="ProjectId" ServerId="ServerId" />
                    </div>
                    <PipelineRunAiResultsCard Results="@_aiResults" OnView="@OpenAiResultAsync" />
                    @* S-UX-28: inline error logs for failed steps, surfaced directly on the Overview *@
                    @if (FailedSteps.Count > 0)
                    {
                        <OmniCard Class="omni-u-p-md run-failed-card">
                            <OmniText Element="OmniTextElement.Title" Class="omni-u-mb-sm omni-u-text-danger">
                                <OmniIcon Name="OmniIconName.Error" Class="run-tile-icon" /> @L["FailedSteps"]
                            </OmniText>
                            @foreach (var failed in FailedSteps)
                            {
                                <OmniStack Class="run-failed-step">
                                    @* OE removed OmniStack.OnClick (a stack is not a button): the row is the interactive element. *@
                                    <div class="clickable-cell" role="button" tabindex="0" @onclick="@(() => SelectStep(failed))" @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") await SelectStep(failed); })">
                                        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Medium">
                                            <StepStatusBadge Step="@failed" Class="run-status-badge" />
                                            <span class="run-tl-name">@failed.StepName</span>
                                            @if (failed.ExitCode is { } code)
                                            {
                                                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@string.Format(L["ExitCodeLabel"], code)</OmniText>
                                            }
                                            <OmniIcon Name="OmniIconName.ChevronRight" Class="run-failed-open-hint" />
                                        </OmniStack>
                                    </div>
                                    <PipelineStepStopAlert Step="@failed" />
                                    @{ var errLines = ErrorLinesFor(failed, _stepLogsCache); }
                                    @if (errLines.Count > 0)
                                    {
                                        <div class="run-logs-terminal run-logs-terminal-sm">
                                            <div class="run-logs-lines">
                                                @foreach (var log in errLines)
                                                {
                                                    <div class="run-log-line @(log.Level == TaskLogLevel.Error ? "step-log-error" : "")"><OmniAnsiText Text="@log.Message" /></div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </OmniStack>
                            }
                        </OmniCard>
                    }

                    @* The preflight results explain why this run was allowed to start. *@
                    <PipelineRunPreflightRecord Checks="_run.PreflightChecks" />
                    @* D15: the detail behind the header badges. The verdict and the waiting reasons
                       are what you open the run for; they just no longer push the tabs down. *@
                    <PipelineRunAssuranceBanner Verdict="AssuranceVerdict" ViewingRunId="@_run.Id" />
                    <PipelineRunWaitingAlert Waits="WaitViews" />
                    @if (_gateState.IsIncomplete)
                    {
                <OmniAlert Severity="OmniSeverity.Warning" Title="@L["AnalysisGateIncompleteTitle"]">
                            @string.Format(L["AnalysisGateIncompleteDetail"], string.Join(", ", _gateState.FailedRunIds))
                </OmniAlert>
                    }
                    @* Test Results Summary *@
                    @if (_run.TestResultSummary is not null)
                    {
                        <OmniCard Class="omni-u-p-md">
                            <OmniText Element="OmniTextElement.Title" Class="omni-u-mb-sm">@L["TestResults"]</OmniText>
                            <OmniRow Gap="OmniSpacing.Large">
                                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@_run.TestResultSummary.TotalTests.ToString()</NumberBadge>
                                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["Total"]</OmniText>
                                </OmniStack>
                                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Success">@_run.TestResultSummary.Passed.ToString()</NumberBadge>
                                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["Passed"]</OmniText>
                                </OmniStack>
                                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Danger">@_run.TestResultSummary.Failed.ToString()</NumberBadge>
                                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["Failed"]</OmniText>
                                </OmniStack>
                                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Warning">@_run.TestResultSummary.Skipped.ToString()</NumberBadge>
                                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["Skipped"]</OmniText>
                                </OmniStack>
                            </OmniRow>
                        </OmniCard>
                    }

                    @* The shared time axis shows actual stage overlap, which the ordered list
                       alone cannot show. *@
                    <RunGanttStrip Run="_run" ScrollTargetId="run-timeline-zone" Baselines="@(_run is null ? null : _baselines.Runs.GetValueOrDefault(_run.Id))" />
                </OmniStack>
            </ChildContent></OmniTabsItem>

            @* Tab 2: Logs *@
            <OmniTabsItem Key="logs" Title="@L["Logs"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("terminal"))" /></Icon><ChildContent>
                @* Side-by-side split: run tree left, logs right. Orchestration runs get a wider left
                   column so the stage label + child-pipeline chip + description fit on one line. *@
                @* R-80: the container the split asks its width of. The columns stack when this container (the
                   width really left to the page, side menu included) is too narrow for a readable log, not when
                   the screen is (see .run-split-container in app.css). *@
                <div class="run-split-container">
                <div class="run-split-layout @(IsOrchestration ? "run-split-wide" : "")">
                    @* Left panel: compact timeline *@
                    <div class="run-split-timeline">
                        @* A1-A4: recursive, collapsible run tree. Trigger steps are child-run nodes that
                           lazy-load and nest the triggered pipeline's own timeline instead of an opaque
                           empty-log row. *@
                        <RunTimelineTree Run="_run!" Depth="0" SelectedStepId="_selectedStep?.Id" OnSelectStep="SelectStep"
                                         PreloadedChildren="ChildRuns" Baselines="_baselines.Runs"
                                         ProjectId="ProjectId" ServerId="ServerId" />
                    </div>

                    @* Right panel: log viewer *@
                    <div class="run-split-logs">
                        @if (_selectedStep is null)
                        {
                            <div class="run-logs-empty">
                                <OmniIcon Name="OmniIconName.TerminalWindow" Class="run-empty-icon" />
                                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-mt-sm">@L["SelectStepToViewLogs"]</OmniText>
                            </div>
                        }
                        else
                        {
                            <div class="run-logs-header run-step-logs-header">
                                <div class="run-step-logs-heading">
                                    <StepStatusBadge Step="@_selectedStep" />
                                    <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0 run-step-logs-title" title="@_selectedStep.StepName">@_selectedStep.StepName</OmniText>
                                    @if (_selectedStep.IsSystem)
                                    {
                                        <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.Settings))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral" Class="run-system-label">@L["System"]</OmniBadge>
                                    }
                                    @if (_selectedStep.IsContainerIsolated)
                                    {
                                        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral" Class="run-system-label"><Icon><OmniIcon Name="OmniIconName.Package" /></Icon><ChildContent>@L["Container"]</ChildContent></OmniBadge>
                                    }
                                    @if (_selectedStep.OutputVariables.TryGetValue("RELEASE_ID", out var releaseId))
                                    {
                                        <a href="/releases/@releaseId" class="pipeline-name-link">
                                            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Success"><Icon><OmniIcon Name="OmniIconName.OpenExternal" /></Icon><ChildContent>@L["Release"]</ChildContent></OmniBadge>
                                        </a>
                                    }
                                    @foreach (var logArt in _run!.Artifacts.Where(a => a.StageName == _selectedStep.StageName))
                                    {
                                        <a href="/artifacts/@logArt.Id" class="pipeline-name-link">
                                            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent"><Icon><OmniIcon Name="OmniIconName.Archive" /></Icon><ChildContent>@logArt.Name</ChildContent></OmniBadge>
                                        </a>
                                    }
                                    @{ var logDur = FormatDuration(_selectedStep.StartedAt, _selectedStep.CompletedAt); }
                                    @if (!string.IsNullOrEmpty(logDur))
                                    {
                                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted run-step-logs-duration">@logDur</OmniText>
                                    }
                                </div>
                                <div class="run-step-logs-toolbar">
                                    @if (!string.IsNullOrEmpty(_selectedStep.Command))
                                    {
                                        @* The framed toggle buttons are filled while their content
                                           is visible. *@
                                        <OmniButton Variant="@(_showCommand ? OmniButtonVariant.Secondary : OmniButtonVariant.Ghost)" Class="run-logs-toggle" aria-pressed="@(_showCommand ? "true" : "false")" OnClick="@(() => _showCommand = !_showCommand)" title="@(_showCommand ? L["HideCommand"] : L["ShowCommand"])"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_showCommand ? "code_off" : "code"))" /></Icon><ChildContent><span>@L["Command"]</span></ChildContent></OmniButton>
                                    }
                                    <OmniButton Variant="@(_showResults ? OmniButtonVariant.Secondary : OmniButtonVariant.Ghost)" Class="run-logs-toggle" aria-pressed="@(_showResults ? "true" : "false")" OnClick="@(() => _showResults = !_showResults)" title="@(_showResults ? L["HideOutput"] : L["ShowOutput"])"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_showResults ? "visibility" : "visibility_off"))" /></Icon><ChildContent><span>@L["Output"]</span></ChildContent></OmniButton>
                                    <OmniTextBox @bind-Value="_logSearch" Placeholder="@L["SearchLogs"]" aria-label="@L["SearchLogs"]" Class="run-logs-search" />
                                    <div class="run-step-logs-actions">
                                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@CopyLogsAsync" title="@L["CopyLogs"]" Label="@L["CopyLogs"]"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon></OmniButton>
                                        @* STD-BTN detection 11: Copy visible, the other actions in the menu (R-2). *@
                                        <OmniOverflowMenu Label="@L["MoreActions"]">
                                            <OmniMenuItem OnClick="@ScrollLogsToTopAsync"><Icon><OmniIcon Name="OmniIconName.ArrowLineUp" /></Icon><ChildContent>@L["ScrollToTop"]</ChildContent></OmniMenuItem>
                                            <OmniMenuItem OnClick="@ScrollLogsToBottomAsync"><Icon><OmniIcon Name="OmniIconName.ArrowLineDown" /></Icon><ChildContent>@L["ScrollToBottom"]</ChildContent></OmniMenuItem>
                                            <OmniMenuItem OnClick="@ToggleFollowLogs"><Icon><OmniIcon Name="OmniIconName.ArrowDown" /></Icon><ChildContent>@L["FollowLogs"]</ChildContent></OmniMenuItem>
                                        </OmniOverflowMenu>
                                    </div>
                                </div>
                            </div>
                            @* The stop reason sits in its own padded zone: the panel's blocks are not separated by a margin on the alert. *@
                            @if (PipelineStepStopReason.For(_selectedStep, L) is not null)
                            {
                                <div class="run-step-stop-zone"><PipelineStepStopAlert Step="@_selectedStep" /></div>
                            }
                            @if (_showCommand && !string.IsNullOrEmpty(_selectedStep.Command))
                            {
                                <div class="run-cmd" title="@L["ExecutedCommand"]">
                                    <OmniIcon Name="OmniIconName.ChevronRight" Class="run-cmd-icon" />
                                    <code class="run-cmd-text">@_selectedStep.Command</code>
                                </div>
                            }
                            @if (!_showResults)
                            {
                                <div class="run-logs-terminal run-logs-collapsed">
                                    <div class="step-log-empty">
                                        <OmniIcon Name="OmniIconName.EyeSlash" Class="step-log-empty-icon" />
                                        <span>@L["OutputHidden"]</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                            <div class="run-logs-terminal" @ref="_logsTerminal">
                                @if (_selectedStep.Status == TaskExecutionStatus.Pending)
                                {
                                    <div class="step-log-empty">
                                        <OmniIcon Name="OmniIconName.Timer" Class="step-log-empty-icon" />
                                        <span>@GetPendingReason(_selectedStep, _stages, _run, L)</span>
                                    </div>
                                }
                                else if (_selectedStep.Status == TaskExecutionStatus.Assigned)
                                {
                                    <div class="step-log-empty">
                                        <OmniIcon Name="OmniIconName.Hourglass" Class="step-log-empty-icon" />
                                        <span>@GetQueueReason(_selectedStep, L)</span>
                                    </div>
                                }
                                else if (_logsLoading && _selectedStep.TaskId.HasValue && !_stepLogsCache.ContainsKey(_selectedStep.TaskId.Value))
                                {
                                    @* Recette R-116: the step's logs are being read, OE's busy veil lies over the zone they will fill. *@
                                    <div class="omni-busy action-veil-placeholder" aria-busy="true" data-testid="step-logs-pending"></div>
                                }
                                else
                                {
                                    var logs = _selectedStep.TaskId.HasValue ? _stepLogsCache.GetValueOrDefault(_selectedStep.TaskId.Value) : null;
                                    @if (logs is null or { Count: 0 })
                                    {
                                        <div class="step-log-empty">@GetEmptyLogsReason(_selectedStep, L)</div>
                                    }
                                    else
                                    {
                                        var filteredLogs = FilterLogs(logs, _logSearch);
                                        @if (filteredLogs.Count == 0)
                                        {
                                            <div class="step-log-empty">@L["NoLogs"]</div>
                                        }
                                        else
                                        {
                                            @* Virtualized so a step with thousands of log lines (a full test run)
                                               renders only the visible rows instead of flooding the DOM and freezing
                                               the tab. ItemSize is the single-line height; wrapped lines are rare in
                                               tool output, so approximate sizing is acceptable here. *@
                                            @if (_logWindow.HasEarlierLines(_selectedStep.TaskId!.Value))
                                            {
                                                @* The live view retains a bounded tail; complete
                                                   logs are fetched on demand, page by page. *@
                                                <OmniAlert Severity="OmniSeverity.Info">
                                                    <span>@L["EarlierLogLinesHidden"]</span>
                                                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@ShowCompleteLogAsync" Busy="@_completeLogLoading"><Icon><OmniIcon Name="OmniIconName.ArrowLineUp" /></Icon><ChildContent><span>@L["ShowCompleteLog"]</span></ChildContent></OmniButton>
                                                </OmniAlert>
                                            }
                                            <div class="run-logs-lines">
                                                <AetheusVirtualList Items="@filteredLogs" ItemSize="21" OverscanCount="20" Context="entry">
                                                    <div class="run-log-line @(entry.Log.Level == TaskLogLevel.Error ? "step-log-error" : "")"><span class="run-log-num">@entry.Num</span>@if (AnsiLine.HasSequences(entry.Log.Message)) { <OmniAnsiText Text="@entry.Log.Message" /> } else { @HighlightLogVariables(entry.Log.Message, _logVarRegex) }</div>
                                                </AetheusVirtualList>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                            }
                        }
                    </div>
                </div>
                </div>
            </ChildContent></OmniTabsItem>

            @if (ShowGateTab && _gateState.Result is { } gateResult)
            {
                <OmniTabsItem Key="gate" Title="@L["AnalysisGateTab"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("rule"))" /></Icon><ChildContent>
                    <PipelineRunGateFindings Gate="@gateResult" RunGrade="@_run?.GateGrade" BlockingTests="@(AssuranceVerdict?.BlockingTests ?? [])" RunIds="@_gateState.RunIds" ProjectId="@EffectiveProjectId" ProjectName="@_run?.ProjectName" FindingReopened="@(_ => _gateState.ReopenFindingAsync(Api, _pageCache))" />
                </ChildContent></OmniTabsItem>
            }

            @* G0: structural tab - YAML snapshot sits right after Journaux, before the data-driven tabs. *@
            @if (!string.IsNullOrEmpty(_run.YamlSnapshot))
            {
                <OmniTabsItem Key="yaml" Title="YAML"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("data_object"))" /></Icon><ChildContent>
                    @* Definition left, full-height; `pipeline: <name>` refs are clickable and open the
                       referenced pipeline's live definition in a right peek pane (one at a time). *@
                    <div class="run-yaml-split">
                        <div class="run-yaml-pane">
                            <div class="run-logs-header">
                                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Definition"]</OmniText>
                                <span class="omni-u-text-muted run-yaml-subtitle">@_run.PipelineName</span>
                                <div class="pipeline-list-spacer"></div>
                                @* STD-BTN detection 11: Wrap visible, the other actions in the menu. *@
                                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => _yamlWrap = !_yamlWrap)" title="@L["WrapLinesHint"]"><Icon><OmniIcon Name="OmniIconName.ArrowElbowDownLeft" /></Icon><ChildContent><span>@L["WrapLines"]</span></ChildContent></OmniButton>
                                <OmniOverflowMenu Label="@L["MoreActions"]">
                                    <OmniMenuItem OnClick="@CopyYamlAsync"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon><ChildContent>@L["Copy"]</ChildContent></OmniMenuItem>
                                </OmniOverflowMenu>
                            </div>
                            <div class="run-yaml-code @(_yamlWrap ? "run-yaml-wrap" : "")">
                                @foreach (var yl in PipelineYamlLines.Parse(_run.YamlSnapshot))
                                {
                                    <div class="yaml-line">@if (yl.PipelineRef is { } pref){@yl.Text<span class="yaml-pipeline-link" role="link" tabindex="0" title="@L["PeekPipelineDefinition"]" @onclick="@(() => _peekName = pref)" @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") _peekName = pref; })">@pref</span>}else{@yl.Text}</div>
                                }
                            </div>
                        </div>
                        @if (_peekName is not null)
                        {
                            <PipelineDefinitionPeek PipelineName="@_peekName" ProjectId="@(_run.ProjectId)" OnClose="ClosePeek" />
                        }
                    </div>
                </ChildContent></OmniTabsItem>
            }

            @* R-18: the database's expand/contract tracking, only for a run a migrate step reported on. *@
            @if (_schemaState.HasGate && _schemaState.Schema is { } schema)
            {
                <OmniTabsItem Key="schema" Title="@L["SchemaTab"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("storage"))" /></Icon><ChildContent>
                    <PipelineRunSchemaTab Schema="@schema" />
                </ChildContent></OmniTabsItem>
            }

            <PipelineRunResultsTabs Run="@_run" Metrics="@_metrics" StepLogs="@_stepLogsCache"
                LintSteps="@LintSteps" HasLintTab="@HasLintTab"
                ArtifactDownloadRequested="@DownloadArtifactAsync"
                CoverageLogsRequested="@LoadResultStepLogsAsync" LintLogsRequested="@LoadResultStepLogsAsync" />
       </Tabs>
    </UrlSyncedTabs>
    }
    </OmniStack>
}
