@namespace Aetheus.Front.Components.Pipelines
@* What the Gate said about a release: its verdict (accepted or rejected) and its grade. "Published" and
   "Success" say the build went through, not that the release is worth deploying (recette R-22). *@
<OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="release-gate" data-testid="release-gate">
    @if (Release.Deployable is { } deployable)
    {
        <OmniBadge Icon="@(BadgeIcon.For(deployable ? OmniTone.Success : OmniTone.Danger))" Fill="OmniFill.Solid" Tone="@(deployable ? OmniTone.Success : OmniTone.Danger)"
                   data-testid="release-gate-verdict">@L[deployable ? "ReleaseGateAccepted" : "ReleaseGateRejected"]</OmniBadge>
    }
    @if (Release.AssuranceGrade is { } grade)
    {
        <GradeBadge Value="@grade" Title="@L["AssuranceGrade"]" />
    }
    @if (Release.Deployable is null && Release.AssuranceGrade is null)
    {
        @* R-59: "Not qualified" is a state, so a text badge with its icon like the verdicts beside it. *@
        <OmniBadge Icon="@(BadgeIcon.ForState(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral"
                   title="@L["ReleaseNotQualifiedHint"]" data-testid="release-not-qualified">@L["ReleaseNotQualified"]</OmniBadge>
    }
</OmniStack>
