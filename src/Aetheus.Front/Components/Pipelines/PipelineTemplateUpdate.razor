@inherits PipelineFleetUpdateBase
@page "/pipelines/{PipelineId:int}/template/update/{TargetVersion:int}"

<PageTitle>@L["UpdatePipelineTemplate"] - Aetheus</PageTitle>

@* Recette R-109 (rule 1 of R-30): Confirm, the main action, sits in the page header; dismissing is the header's back button. *@
<OmniPageHeader Title="@L["UpdatePipelineTemplate"]" ShowBack="true" BackHref="@($"/pipelines/{PipelineId}")" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("system_update_alt")" /></Icon>
    <ActionsContent>
        @if (!_loading && !_forbidden && !_notAvailable && !_loadFailed && _preview is not null)
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ConfirmAsync" Disabled="@(_preview.RequiresOrphanAcknowledgement && !_acknowledged)" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L["ConfirmUpdate"]</span></ChildContent></OmniButton>
        }
    </ActionsContent>
</OmniPageHeader>

@if (_loading)
{
    <AetheusLoader />
}
else if (_forbidden)
{
    <OmniAlert Severity="OmniSeverity.Warning">@L["AccessDenied"]</OmniAlert>
}
else if (_notAvailable)
{
    <OmniAlert Severity="OmniSeverity.Warning">@L["FleetUpdateUnavailable"]</OmniAlert>
}
else if (_loadFailed || _preview is null)
{
    <OmniAlert Severity="OmniSeverity.Danger"><Icon><OmniIcon Name="OmniIconName.Error" /></Icon><ChildContent>
        @L["LoadError"]
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@LoadPreviewAsync"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["Retry"]</span></ChildContent></OmniButton>
    </ChildContent></OmniAlert>
}
else
{
    <OmniStack Class="page-fill-body">
        <OmniText Element="OmniTextElement.Strong">
            @string.Format(L["TemplateVersionTransition"], _preview.TemplateName, _preview.CurrentVersion, _preview.TargetVersion)
        </OmniText>
        @if (_preview.OrphanOverrides.Count > 0)
        {
            <OmniAlert Severity="OmniSeverity.Warning"><Icon><OmniIcon Name="OmniIconName.Warning" /></Icon><ChildContent>
                <OmniText Element="OmniTextElement.Paragraph">@L["OrphanOverridesWarning"]</OmniText>
                <ul>
                    @foreach (var orphan in _preview.OrphanOverrides)
                    {
                        <li><code>@orphan</code></li>
                    }
                </ul>
            </ChildContent></OmniAlert>
            <OmniCheckBox @bind-Value="_acknowledged">@L["AcknowledgeOrphanOverrides"]</OmniCheckBox>
        }
        <OmniDiffViewer Original="@_preview.CurrentResolvedYaml" Modified="@_preview.TargetResolvedYaml" Language="yaml" FillAvailableHeight="true" InteropModulePath="@EditorModules.Frame" ShowNavigation="true" Label="@L["Diff"]" />
    </OmniStack>
}
