@* Failed steps are red and filled, a non-blocking one included; condition-skipped steps use the
   skipped status. Advisory AI work carries a separate neutral badge so its outcome remains visible
   without implying a blocking failure. *@
<OmniBadge Tone="@BadgeVariant" Fill="@BadgeFill" Icon="@StatusIcon"
           title="@PipelineRunFormatting.StepStatusTitle(Step, L)" Class="@Class">
    @PipelineRunFormatting.StepStatusText(Step, L)
</OmniBadge>
@if (Step.IsAdvisory)
{
    <OmniBadge Tone="OmniTone.Neutral" Fill="OmniFill.Outline" title="@L["StepAdvisoryHint"].Value" Class="@Class">
        @L["StepAdvisory"]
    </OmniBadge>
}
