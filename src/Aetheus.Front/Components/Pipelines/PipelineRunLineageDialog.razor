@* Every follow-up run of a run, when the lineage tile shows only the first ones. *@
<OmniStack Gap="OmniSpacing.Small" Class="run-lineage-dialog-list">
    @foreach (var child in Runs)
    {
        <span class="run-tile-subrow">
            <a href="@PipelineRunPresentation.Href(child.RunId, child.ProjectId ?? ProjectId, ServerId)" class="pipeline-name-link run-tile-value run-lineage-child" title="@child.PipelineName">@child.PipelineName #@child.BuildNumber</a>
            <PipelineRunStatusBadge Status="child.Status" />
        </span>
    }
</OmniStack>
<OmniStack Orientation="OmniOrientation.Horizontal" Justify="OmniJustification.End" Class="omni-u-mt-md" Gap="OmniSpacing.Large">
    <Aetheus.Front.Components.Servers.DialogCloseButton />
</OmniStack>
