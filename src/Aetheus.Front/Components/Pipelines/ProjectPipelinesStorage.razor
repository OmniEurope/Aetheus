@* Recette R1-34: where this project's pipeline definitions are kept, above its pipelines. Nothing is
   said when the repositories could not be read. *@
@if (_ownRepositories is { } repositories)
{
    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="pipeline-definition-storage" data-testid="project-pipelines-storage">
        <OmniIcon Name="@(repositories.Count == 0 ? OmniIconName.Database : OmniIconName.GitCommit)" />
        @if (repositories.Count == 0)
        {
            <span>@L["ProjectPipelinesStoredInAetheus"]</span>
        }
        else
        {
            <span>@string.Format(L["ProjectPipelinesStoredInGit"], string.Join(", ", repositories.Select(repository => repository.Name)))</span>
        }
    </OmniText>
}
