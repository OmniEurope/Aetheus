@page "/pipelines/setup"

<PageTitle>@L["PipelineSetupWizard"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["PipelineSetupWizard"]" ShowBack="@(!string.IsNullOrWhiteSpace(BackHref))" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("auto_awesome")" /></Icon>
</OmniPageHeader>

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else
{
    @* One wizard for both starting points: the "start from" choice is the first thing of its Project step
       and swaps the steps behind it (the templates' steps, or those of copying an existing project). *@
    <WizardDialog Steps="@_steps" CanAdvance="@CanAdvance" StepChanged="@OnStepChanged" InitialStep="@_initialStep"
                  OnFinishClicked="@FinishAsync" OnCancelClicked="@GoBack" FinishText="@FinishText" />
}
