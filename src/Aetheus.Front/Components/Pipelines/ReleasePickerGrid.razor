@namespace Aetheus.Front.Components.Pipelines
@* PLAN-005 lot 5 / D38, R-10: the releases a version parameter can take, as a table: short name,
   date, status with its explanation, and the outcome of the last run that recorded it ("Published"
   beside "Failed" is a deployment that failed). Sortable and filterable like every grid, and since
   recette R-327 it scrolls like every other table: no pager, the rows of the window are cut from the
   loaded list as the reader scrolls. Clicking a row fills the version field, when there is exactly
   one to fill. *@
<div class="release-picker" data-testid="release-picker">
    <AetheusDataGrid Data="@_page" Count="@_count" LoadData="@LoadPage" TItem="ReleaseDto" PageSize="@PageSize" ExportMarkdown="false"
                     Virtualize="@AetheusGrid.RemoteVirtualization"
                     VirtualData="@(() => new OmniDataGridResult<ReleaseDto>(_page, _count))"
                     EmptyText="@L["NoDeployableRelease"]"
                     RowClick="@(release => Pick.InvokeAsync(release.Version))"
                     class="@(Pick.HasDelegate ? "dashboard-clickable-grid" : null)">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="ReleaseDto" Property="Version" Title="@L["Version"]" MinWidth="10rem" Filterable="true" >
                <Template Context="release"><ShortId Value="@release.Version" Copyable="false" Class="release-version" /></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ReleaseDto" Property="CreatedAt" Title="@L["ReleasePickerCreated"]" Width="9rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" >
                <Template Context="release">@(ReleaseHelper.CreatedAt(release)?.ToLocalTime().ToString("g") ?? "-")</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ReleaseDto" Property="Status" Title="@L["Status"]" Width="8rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText" >
                <Template Context="release"><ReleaseStatusBadge Status="@release.Status" /></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ReleaseDto" Property="PipelineRunStatus" Title="@L["ReleasePickerLastRun"]" Width="8rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@RunStatusText" >
                <Template Context="release">
                    @if (release.PipelineRunStatus is { } runStatus)
                    {
                        <OmniBadge Fill="OmniFill.Solid" Tone="@PipelineHelper.GetRunBadge(runStatus)"
                                     data-testid="release-picker-run-status">@L.Localize(runStatus)</OmniBadge>
                    }
                    else
                    {
                        @("-")
                    }
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
    @if (TotalCount > Releases.Count)
    {
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0" data-testid="release-picker-truncated">
            @string.Format(L["ReleasePickerTruncated"], Releases.Count, TotalCount)
        </OmniText>
    }
</div>
