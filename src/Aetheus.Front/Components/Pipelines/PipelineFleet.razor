@inherits EntityLiveListBase

<PageTitle>@L["PipelineFleet"] - Aetheus</PageTitle>

@* Filters live in the header's Filters slot: they belong to the page, not to the fixed chrome.
   Recette R-224: the search box and the template and status dropdowns became the grid's column header
   filters. The project picker stays: it keeps every pipeline of a project, including the ones an
   environment or a server of that project owns, which no column shows (the Owner column names the
   environment or the server, not its project). *@
<OmniPageHeader Title="@L["PipelineFleet"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("account_tree")" /></Icon>
    <Filters>
        <OmniDropDown aria-label="@L["AllProjects"]" TValue="int?" Options="@(_projects.ToOptions(item => (int?)item.Id, item => item.Name))"
                        Value="@_projectId" ValueChanged="OnProjectChanged"
                        ValueExpression="@(() => _projectId)"
                        Placeholder="@L["AllProjects"]" AllowEmpty="true" />
        @* Recette R-181: no Refresh, a pipeline or model change reloads the fleet (entities hub). *@
    </Filters>
</OmniPageHeader>

<OmniStack Gap="OmniSpacing.Large">

    @if (_filtersLoadError)
    {
        <OmniAlert Severity="OmniSeverity.Danger">@L["FiltersLoadError"]</OmniAlert>
    }

    @if (_gridLoadError)
    {
        <OmniAlert Severity="OmniSeverity.Danger">@L["LoadError"]</OmniAlert>
    }

    <AetheusDataGrid FullHeight="true" @ref="_grid" Data="@_items" TItem="PipelineFleetItemDto" Count="@_totalCount"
                LoadData="@LoadDataAsync" ExportRead="@ReadExportAsync" IsLoading="@_loading" PageSize="25"
                Virtualize="@AetheusGrid.RemoteVirtualization"
                VirtualData="@(() => new OmniDataGridResult<PipelineFleetItemDto>(_items, _totalCount))"
                EmptyText="@L["NoRecords"]">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="PipelineFleetItemDto" Property="PipelineName" Title="@L["Pipeline"]" MinWidth="14rem" Filterable="true" >
                <Template Context="item">
                    <OmniLink Href="@($"pipelines/{item.PipelineId}")">@item.PipelineName</OmniLink>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineFleetItemDto" Property="OwnerName" Title="@L["Owner"]" MinWidth="12rem" Filterable="true" />
            <OmniDataGridColumn TItem="PipelineFleetItemDto" Property="TemplateName" Title="@L["Template"]" MinWidth="12rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.Templates" FilterSearchable="true" />
            <OmniDataGridColumn TItem="PipelineFleetItemDto" Property="PinnedVersion" Title="@L["PinnedVersion"]" Width="8rem" TextAlign="OmniDataGridTextAlign.Center" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" >
                <Template Context="item">@(item.PinnedVersion is null ? (item.UsesLegacyReference ? L["LegacyLatest"] : "-") : $"v{item.PinnedVersion}")</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineFleetItemDto" Property="LatestVersion" Title="@L["LatestVersion"]" Width="8rem" TextAlign="OmniDataGridTextAlign.Center" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" >
                <Template Context="item">@(item.LatestVersion is null ? "-" : $"v{item.LatestVersion}")</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineFleetItemDto" Property="Freshness" Title="@L["Status"]" Width="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@FreshnessFilterText" >
                <Template Context="item">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@FreshnessStyle(item.Freshness)">@FreshnessText(item.Freshness)</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PipelineFleetItemDto" Title="@L["Actions"]" Width="11rem" Sortable="false" Filterable="false" >
                <Template Context="item">
                    @if (item.Freshness == PipelineFleetFreshness.Outdated && item.LatestVersion is not null && CanUpdate(item))
                    {
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenUpdateAsync(item))" title="@L["Update"]" Label="@L["Update"]"><OmniIcon Name="OmniIconName.Download" /></OmniButton>
                    }
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
</OmniStack>
