@* Repository / branch / commit are one answer - "which source did this run build?" - so they share a
   single tile with one link per line instead of three tiles. Extracted from PipelineRun.razor, which
   had outgrown its line budget. *@
@if (HasSourceFacts)
{
    <OmniCard Class="run-overview-card run-source-tile">
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.FolderOpen" Class="run-tile-icon" /> @L["SourceRepository"]</OmniText>
        @* Repository and branch fill the value slot, the commit the footer, all with the same
           label-left, value-right sub-row. *@
        <div class="run-tile-main run-tile-main-rows">
            @if (RepositoryHref is not null)
            {
                <span class="run-tile-subrow">
                    <span class="run-tile-sublabel"><OmniIcon Name="OmniIconName.Database" Class="run-tile-icon" /> @L["Repository"]</span>
                    <a href="@RepositoryHref" class="pipeline-name-link run-tile-value" title="@(Run.ProjectName ?? L["Repository"].Value)">@(Run.ProjectName ?? L["Repository"].Value)</a>
                </span>
            }
            @foreach (var branch in BranchLinks)
            {
                <span class="run-tile-subrow">
                    <span class="run-tile-sublabel"><OmniIcon Name="OmniIconName.Graph" Class="run-tile-icon" /> @L["Branch"]</span>
                    <a href="@branch.Href" class="pipeline-name-link run-tile-value" title="@branch.Name">@branch.Name</a>
                </span>
            }
        </div>
        <div class="run-tile-foot">
            @if (!string.IsNullOrEmpty(CommitSha))
            {
                <span class="run-tile-subrow">
                    <span class="run-tile-sublabel"><OmniIcon Name="OmniIconName.GitCommit" Class="run-tile-icon" /> @L["Commit"]</span>
                    @* CommitHref is null only for a run with neither repository nor project. *@
                    <ShortId Value="@CommitSha" Href="@CommitHref" Copyable="false" Class="cross-link-sha run-tile-value" />
                </span>
            }
        </div>
    </OmniCard>
}
