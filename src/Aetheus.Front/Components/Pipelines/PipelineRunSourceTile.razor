@* Repository / branch / commit are one answer - "which source did this run build?" - so they share a
   single tile with one link per line instead of three tiles. Extracted from PipelineRun.razor, which
   had outgrown its line budget. R-28: an OmniFactTile (OE), each value a link through the row's Href. *@
@if (HasSourceFacts)
{
    <OmniFactTile Title="@L["SourceRepository"]" Class="run-source-tile">
        <Icon><OmniIcon Name="OmniIconName.FolderOpen" /></Icon>
        <ChildContent>
            @if (RepositoryHref is not null)
            {
                <OmniFactTileRow Term="@L["Repository"]" Href="@RepositoryHref"><Icon><OmniIcon Name="OmniIconName.Database" /></Icon><ChildContent>@(Run.ProjectName ?? L["Repository"].Value)</ChildContent></OmniFactTileRow>
            }
            @foreach (var branch in BranchLinks)
            {
                <OmniFactTileRow Term="@L["Branch"]" Href="@branch.Href"><Icon><OmniIcon Name="OmniIconName.Graph" /></Icon><ChildContent>@branch.Name</ChildContent></OmniFactTileRow>
            }
            @if (!string.IsNullOrEmpty(CommitSha))
            {
                @* CommitHref is null only for a run with neither repository nor project. *@
                <OmniFactTileRow Term="@L["Commit"]"><Icon><OmniIcon Name="OmniIconName.GitCommit" /></Icon><ChildContent><ShortId Value="@CommitSha" Href="@CommitHref" Copyable="false" Class="cross-link-sha" /></ChildContent></OmniFactTileRow>
            }
        </ChildContent>
    </OmniFactTile>
}