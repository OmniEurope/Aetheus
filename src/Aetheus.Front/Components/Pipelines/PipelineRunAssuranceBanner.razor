@* A green run whose candidate is NOT deployable is the case that reads wrong: the run succeeded, and
   the one sentence that mattered lived in a step log. *@
@if (Verdict is { Deployable: false })
{
    <OmniAlert Severity="OmniSeverity.Warning" Title="@L["CandidateNotDeployableTitle"]">
        <div>@L["CandidateNotDeployableDetail"]</div>
        <PipelineRunBlockingTests Tests="Verdict.BlockingTests" ViewingRunId="@ViewingRunId" />
    </OmniAlert>
}
