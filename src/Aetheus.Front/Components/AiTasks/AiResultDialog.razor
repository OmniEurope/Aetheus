@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else if (_results.Count == 0)
{
    <EmptyState Icon="description" Title="@L["NoAiResults"]" Description="@L["NoAiResultsDescription"]" />
}
else
{
    <OmniRow Gap="OmniSpacing.Large">
        <OmniColumn Span="12" MediumSpan="4">
            <OmniListBox aria-label="@L["Results"]" TValue="int" TSelection="int" @bind-Value="_selectedId" @bind-Value:after="SelectResult"
                         Options="@_results.Select(result => new OmniOption<int>(result.Id, result.DisplayName)).ToList()"
                         Class="omni-u-w-100" />
            @if (InitialResult is null && _totalCount > PageSize)
            {
            <OmniPager Page="@_page" PageCount="@Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize))"
                       PageChanged="@OnPageChangedAsync" PageSize="@PageSize" Class="omni-u-mt-sm" />
            }
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="8">
            @if (_selected is not null)
            {
                <OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                    <OmniBadge Icon="@(BadgeIcon.ForState(AiVerdictText.Tone(_selected.Verdict)))" Fill="OmniFill.Solid" Tone="@AiVerdictText.Tone(_selected.Verdict)">@AiVerdictText.Label(L, _selected.Verdict)</OmniBadge>
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">
                        @_selected.ProfileName · @FormatDuration(_selected.DurationMs) · @_selected.CreatedAt.ToLocalTime().ToString("g")
                    </OmniText>
                    @if (_selected.SendsDataExternally)
                    {
                        <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Warning))" Fill="OmniFill.Solid" Tone="OmniTone.Warning">@L["ExternalData"]</OmniBadge>
                    }
                    @if (_selected.Truncated)
                    {
                        <OmniBadge Icon="@(BadgeIcon.ForState(OmniTone.Warning))" Fill="OmniFill.Solid" Tone="OmniTone.Warning">@L["Truncated"]</OmniBadge>
                    }
                </OmniStack>
                <OmniTabs>
                        <OmniTabsItem Title="@L["Report"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("description"))" /></Icon><ChildContent>
                            @* nosemgrep: aetheus.razor.markupstring-dynamic - Markdig pipeline with DisableHtml, raw HTML is dropped *@
                            <div class="markdown-content omni-u-p-md">@((MarkupString)_reportHtml)</div>
                        </ChildContent></OmniTabsItem>
                        <OmniTabsItem Title="@L["Diff"]" Disabled="@string.IsNullOrWhiteSpace(_selected.DiffPatch)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("difference"))" /></Icon><ChildContent>
                            @if (!string.IsNullOrWhiteSpace(_selected.DiffPatch))
                            {
                                <OmniStack>
                                <OmniStack Orientation="OmniOrientation.Horizontal"><OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@DownloadPatchAsync"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L["DownloadPatch"]</span></ChildContent></OmniButton></OmniStack>
                                @if (!string.IsNullOrWhiteSpace(_selected.ProposedBranchName))
                                {
                                    <OmniAlert Severity="OmniSeverity.Success">
                                        @L["ProposedBranchCreated"]: <a href="/git-repositories/@_selected.ProposedRepositoryId">@_selected.ProposedBranchName</a>
                                    </OmniAlert>
                                }
                                <OmniDiffViewer Modified="@_selected.DiffPatch" Height="28rem" InteropModulePath="@EditorModules.Frame" ShowNavigation="true" Label="@L["Diff"]" />
                                </OmniStack>
                            }
                        </ChildContent></OmniTabsItem>
                </OmniTabs>
            </OmniStack>
            }
        </OmniColumn>
    </OmniRow>
}

<DialogFooter OnCancel="@Close" CancelText="@L["Close"]" />
