@page "/ai-tasks/{TaskId:int}"
@page "/projects/{ProjectId:int}/ai-tasks/{TaskId:int}"

<PageTitle>@(_task?.Name ?? L["AiTasks"]) - Aetheus</PageTitle>

<OmniPageHeader Title="@(_task?.Name ?? L["AiTasks"])" Subtitle="@Breadcrumb.Subtitle()" ShowBack="true" BackHref="@ListUrl">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("psychology")" /></Icon>
    <ActionsContent>
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@RunAsync" Busy="@(_starting || _runningServerTaskId is not null)"
                    Disabled="@(!CanWrite)"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent><span>@L["Run"]</span></ChildContent></OmniButton>
    </ActionsContent>
    @* STD-BTN detection 11: Run visible, the other actions in the menu. *@
    <MenuContent>
        <OmniMenuItem OnClick="@EditAsync" Disabled="@(!CanWrite)"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent>@L["Edit"]</ChildContent></OmniMenuItem>
    </MenuContent>
</OmniPageHeader>

<OmniStack>
@if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger">
        @L["LoadFailed"]
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => LoadAsync(_selected?.Id))"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["Retry"]</span></ChildContent></OmniButton>
    </OmniAlert>
}

<OmniTileGrid Columns="4" Class="ai-results-tiles">
    <OmniStatTile Value="@_totalCount.ToString(System.Globalization.CultureInfo.CurrentCulture)" Title="@L["AiTaskRuns"]">
        <Icon><OmniIcon Name="OmniIconName.ListBullets" /></Icon>
    </OmniStatTile>
    <OmniStatTile Value="@SuccessRateText" Title="@L["SuccessRate"]" Detail="@L["AiTaskOnThisPage"]">
        <Icon><OmniIcon Name="OmniIconName.CheckCircle" /></Icon>
    </OmniStatTile>
    <OmniStatTile Value="@AverageDurationText" Title="@L["AverageDuration"]" Detail="@L["AiTaskOnThisPage"]">
        <Icon><OmniIcon Name="OmniIconName.Timer" /></Icon>
    </OmniStatTile>
    <OmniStatTile Value="@LastRunText" Title="@L["LastRun"]" Detail="@_task?.ProfileName">
        <Icon><OmniIcon Name="OmniIconName.Hourglass" /></Icon>
    </OmniStatTile>
</OmniTileGrid>

@if (_loading && _runs.Count == 0)
{
    <AetheusLoader />
}
else if (_runs.Count == 0)
{
    <EmptyState Icon="description" Title="@L["NoAiResults"]" Description="@L["NoAiResultsDescription"]" />
}
else
{
    <div class="ai-results-layout">
        <OmniCard Class="ai-results-runs">
            <OmniHeading Level="OmniHeadingLevel.H5" Class="ai-results-section-title">@L["AiTaskRuns"]</OmniHeading>
            <OmniTimeline Label="@L["AiTaskRuns"]">
                @foreach (var run in _runs)
                {
                    var current = run.Id == _selected?.Id;
                    <OmniTimelineItem DateText="@RunDate(run)" Level="OmniHeadingLevel.H6">
                        <button type="button" class="@($"ai-results-run {(current ? "ai-results-run--selected" : null)}")"
                                aria-pressed="@(current ? "true" : "false")" @onclick="@(() => Select(run))">
                            <OmniBadge Icon="@(BadgeIcon.ForState(AiVerdictText.Tone(run.Verdict)))" Fill="OmniFill.Solid" Tone="@AiVerdictText.Tone(run.Verdict)">@AiVerdictText.Label(L, run.Verdict)</OmniBadge>
                            <OmniBadge Icon="@(BadgeIcon.ForState(run.Succeeded ? OmniTone.Success : OmniTone.Danger))" Fill="OmniFill.Tonal" Tone="@(run.Succeeded ? OmniTone.Success : OmniTone.Danger)">@(run.Succeeded ? L["AiRunSucceeded"] : L["AiRunFailed"])</OmniBadge>
                            <span class="ai-results-run-duration">@FormatDuration(run.DurationMs)</span>
                        </button>
                    </OmniTimelineItem>
                }
            </OmniTimeline>
            @if (_totalCount > PageSize)
            {
                <OmniPager Page="@_page" PageCount="@Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize))"
                           PageChanged="@OnPageChangedAsync" PageSize="@PageSize" Class="omni-u-mt-md" />
            }
        </OmniCard>

        @if (_selected is { } run)
        {
            <OmniCard Class="ai-results-detail">
                <div class="ai-results-detail-head">
                    <OmniBadge Icon="@(BadgeIcon.ForState(AiVerdictText.Tone(run.Verdict)))" Fill="OmniFill.Solid" Tone="@AiVerdictText.Tone(run.Verdict)">@AiVerdictText.Label(L, run.Verdict)</OmniBadge>
                    @if (run.SendsDataExternally)
                    {
                        <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Warning))" Fill="OmniFill.Tonal" Tone="OmniTone.Warning">@L["ExternalData"]</OmniBadge>
                    }
                    @if (run.Truncated)
                    {
                        <OmniBadge Icon="@(BadgeIcon.ForState(OmniTone.Warning))" Fill="OmniFill.Tonal" Tone="OmniTone.Warning">@L["Truncated"]</OmniBadge>
                    }
                </div>
                <dl class="ai-results-facts">
                    <dt>@L["Date"]</dt><dd>@RunDate(run)</dd>
                    <dt>@L["AiRunnerProfile"]</dt><dd>@run.ProfileName</dd>
                    <dt>@L["Duration"]</dt><dd>@FormatDuration(run.DurationMs)</dd>
                    <dt>@L["Status"]</dt><dd>@(run.Succeeded ? L["AiRunSucceeded"] : L["AiRunFailed"])</dd>
                </dl>
                @if (string.IsNullOrWhiteSpace(run.DiffPatch))
                {
                    @* nosemgrep: aetheus.razor.markupstring-dynamic - Markdig pipeline with DisableHtml, raw HTML is dropped *@
                    <div class="markdown-content ai-results-report">@((MarkupString)_reportHtml)</div>
                }
                else
                {
                    <UrlSyncedTabs Slugs="@(new[] { "report", "diff" })">
                        <Tabs>
                        <OmniTabsItem Key="report" Title="@L["Report"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("description")" /></Icon><ChildContent>
                            @* nosemgrep: aetheus.razor.markupstring-dynamic - Markdig pipeline with DisableHtml, raw HTML is dropped *@
                            <div class="markdown-content ai-results-report">@((MarkupString)_reportHtml)</div>
                        </ChildContent></OmniTabsItem>
                        <OmniTabsItem Key="diff" Title="@L["Diff"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("difference")" /></Icon><ChildContent>
                            <OmniStack>
                            <OmniStack Orientation="OmniOrientation.Horizontal"><OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@DownloadPatchAsync"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L["DownloadPatch"]</span></ChildContent></OmniButton></OmniStack>
                            @if (!string.IsNullOrWhiteSpace(run.ProposedBranchName))
                            {
                                <OmniAlert Severity="OmniSeverity.Success">
                                    @L["ProposedBranchCreated"]: <a href="/git-repositories/@run.ProposedRepositoryId">@run.ProposedBranchName</a>
                                </OmniAlert>
                            }
                            <OmniDiffViewer Modified="@run.DiffPatch" Height="28rem" InteropModulePath="@EditorModules.Frame" ShowNavigation="true" Label="@L["Diff"]" />
                            </OmniStack>
                        </ChildContent></OmniTabsItem>
                        </Tabs>
                    </UrlSyncedTabs>
                }
            </OmniCard>
        }
    </div>
}
</OmniStack>
