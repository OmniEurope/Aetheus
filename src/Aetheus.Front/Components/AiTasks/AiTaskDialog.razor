@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else
{
    <OmniTemplateForm TModel="EditModel" Model="@_model" OnValidSubmit="@SubmitAsync">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniRow Gap="OmniSpacing.Large">
            <OmniColumn Span="12" MediumSpan="6">
                <OmniFormField For="oe-pages-ai-aitaskdialog-1" Class="omni-u-w-100"><LabelContent>@L["Name"]</LabelContent><ChildContent>
                    <OmniTextBox @bind-Value="_model.Name" Class="omni-u-w-100" Id="oe-pages-ai-aitaskdialog-1" />
                </ChildContent></OmniFormField>
                <ValidationMessage For="@(() => _model.Name)" />
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OmniFormField Label="@L["AiRunnerProfile"]" Required="true" Class="omni-u-w-100" For="oe-formfield-pages-ai-aitaskdialog-1">
                    <OmniDropDown Id="oe-formfield-pages-ai-aitaskdialog-1" @bind-Value="_model.ProfileId" Options="@(_profiles.ToOptions(item => item.Id, item => item.Name))" Class="omni-u-w-100" />
                </OmniFormField>
            </OmniColumn>
            @if (!FixedProjectId.HasValue)
            {
                <OmniColumn Span="12" MediumSpan="4">
                    <OmniFormField Label="@L["OwnerType"]" Class="omni-u-w-100" For="oe-formfield-pages-ai-aitaskdialog-2">
                        <OmniDropDown Id="oe-formfield-pages-ai-aitaskdialog-2" @bind-Value="_model.OwnerType" Options="@_ownerTypes" Class="omni-u-w-100" />
                    </OmniFormField>
                </OmniColumn>
                <OmniColumn Span="12" MediumSpan="8">
                    @if (_model.OwnerType == "project")
                    {
                        <OmniFormField Label="@L["Project"]" Class="omni-u-w-100" For="oe-formfield-pages-ai-aitaskdialog-3">
                            <OmniDropDown Id="oe-formfield-pages-ai-aitaskdialog-3" TValue="int?" @bind-Value="_model.ProjectId" Options="@(_projects.ToOptions(item => (int?)item.Id, item => item.Name))" Filterable="true" Class="omni-u-w-100" />
                        </OmniFormField>
                    }
                    else
                    {
                        <OmniFormField Label="@L["Server"]" Class="omni-u-w-100" For="oe-formfield-pages-ai-aitaskdialog-4">
                            <OmniDropDown Id="oe-formfield-pages-ai-aitaskdialog-4" TValue="int?" @bind-Value="_model.ServerId" Options="@(_servers.ToOptions(item => (int?)item.Id, item => item.Name))" Filterable="true" Class="omni-u-w-100" />
                        </OmniFormField>
                    }
                </OmniColumn>
            }
            <OmniColumn Span="12">
                <OmniFormField For="oe-pages-ai-aitaskdialog-6" Class="omni-u-w-100"><LabelContent>@L["PromptTemplate"]</LabelContent><ChildContent>
                    <OmniTextArea @bind-Value="_model.PromptTemplate" Rows="9" Class="omni-u-w-100 text-mono" Id="oe-pages-ai-aitaskdialog-6" />
                </ChildContent></OmniFormField>
                <ValidationMessage For="@(() => _model.PromptTemplate)" />
            </OmniColumn>
            @if (FixedProjectId.HasValue || _model.OwnerType == "project")
            {
                <OmniColumn Span="12" MediumSpan="6">
                    <AiContextFilePicker ProjectId="@(FixedProjectId ?? _model.ProjectId)" Paths="@ContextPathList" PathsChanged="@OnContextPathsChanged" />
                </OmniColumn>
                <OmniColumn Span="12" MediumSpan="6">
                    <OmniFormField For="oe-pages-ai-aitaskdialog-10" Help="@L["AiGitRangeHint"]" Id="oe-pages-ai-aitaskdialog-10-field" Class="omni-u-w-100"><LabelContent>@L["AiGitRange"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_model.GitRange" Placeholder="@L["AiGitRangePlaceholder"]" Class="omni-u-w-100 text-mono" Id="oe-pages-ai-aitaskdialog-10" />
                    </ChildContent></OmniFormField>
                </OmniColumn>
            }
            <OmniColumn Span="12" MediumSpan="6">
                <OmniFormField For="oe-pages-ai-aitaskdialog-7" Help="@L["AiScheduleHint"]" Id="oe-pages-ai-aitaskdialog-7-field" Class="omni-u-w-100"><LabelContent>@L["Schedule"]</LabelContent><ChildContent>
                    <OmniTextBox @bind-Value="_model.Schedule" Placeholder="0 0 */6 * * *" Class="omni-u-w-100 text-mono" Id="oe-pages-ai-aitaskdialog-7" />
                </ChildContent></OmniFormField>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OmniFormField For="oe-pages-ai-aitaskdialog-8" Help="@L["AiEventTypesHint"]" Id="oe-pages-ai-aitaskdialog-8-field" Class="omni-u-w-100"><LabelContent>@L["EventTypes"]</LabelContent><ChildContent>
                    <OmniTextBox @bind-Value="_model.EventTypes" Placeholder="@L["PlaceholderEventTypes"]"
                                   Class="omni-u-w-100 text-mono" Id="oe-pages-ai-aitaskdialog-8" />
                </ChildContent></OmniFormField>
            </OmniColumn>
            <OmniColumn Span="12">
                <OmniSwitch @bind-Value="_model.Enabled">@L["Active"]</OmniSwitch>
            </OmniColumn>
        </OmniRow>
        <DialogFooter OnCancel="@Cancel">
            <OmniButton Busy="@_busy" ButtonType="OmniButtonType.Submit" Variant="OmniButtonVariant.Primary"><Icon><OmniIcon Name="@(IsEdit ? OmniIconName.Save : OmniIconName.Add)" /></Icon><ChildContent><span>@(IsEdit ? L["Save"] : L["Create"])</span></ChildContent></OmniButton>
        </DialogFooter>
    </OmniTemplateForm>
}
