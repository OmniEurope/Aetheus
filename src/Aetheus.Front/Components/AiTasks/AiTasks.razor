@inherits PagedDataGridPageBase<AiTaskDefinitionDto>
@page "/ai-tasks"
@page "/projects/{ProjectId:int}/ai-tasks"

<PageTitle>@L["AiTasks"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["AiTasks"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("psychology")" /></Icon>
</OmniPageHeader>

<OmniRow Gap="OmniSpacing.Large" Class="omni-u-mb-lg">
    <OmniColumn Span="12" MediumSpan="4">
        <OmniCard>
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["RunsLastSevenDays"]</OmniText>
            <OmniHeading Level="OmniHeadingLevel.H4">@(_consumption?.RunCount ?? 0)</OmniHeading>
        </OmniCard>
    </OmniColumn>
    <OmniColumn Span="12" MediumSpan="4">
        <OmniCard>
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["FailedRuns"]</OmniText>
            <OmniHeading Level="OmniHeadingLevel.H4">@(_consumption?.FailedCount ?? 0)</OmniHeading>
        </OmniCard>
    </OmniColumn>
    <OmniColumn Span="12" MediumSpan="4">
        <OmniCard>
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["ExecutionTime"]</OmniText>
            <OmniHeading Level="OmniHeadingLevel.H4">@FormatDuration(_consumption?.DurationMs ?? 0)</OmniHeading>
        </OmniCard>
    </OmniColumn>
</OmniRow>

<OmniStack Orientation="OmniStackOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center"
             Justify="OmniJustification.Between" Class="omni-u-mb-md" Gap="OmniSpacing.Large">
    <OmniTextBox aria-label="@L["Search"]" Placeholder="@L["Search"]" @bind-Value="_search" @bind-Value:after="OnSearchChangedAsync" />
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenDialogAsync(null))" Disabled="@(!CanCreate)" title="@(!CanCreate ? L["InsufficientPermissions"] : "")"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
</OmniStack>

@* Keep the grid mounted while IsLoading indicates progress to avoid restarting its initial fetch
   on each render. Show failures with a Retry action. *@
@if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger" Class="omni-u-mb-sm">
        @L["LoadFailed"]
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@ReloadPageAsync"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Retry"]</span></OmniButton>
    </OmniAlert>
}
    <AetheusDataGrid FullHeight="true" @ref="_grid" RowClick="@OpenResults" Data="@_tasks" Count="@_totalCount"
                TItem="AiTaskDefinitionDto" PageSize="25"
                LoadData="@LoadDataAsync" ExportRead="@ReadExportAsync" IsLoading="@_loading"
                Virtualize="@AetheusGrid.RemoteVirtualization"
                VirtualData="@(() => new OmniDataGridResult<AiTaskDefinitionDto>(_tasks, _totalCount))"
                class="omni-u-w-100">
        <EmptyTemplate>
            <EmptyState Icon="psychology" Title="@L["NoAiTasks"]" Description="@L["NoAiTasksDescription"]" />
        </EmptyTemplate>
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="AiTaskDefinitionDto" Property="Name" Title="@L["Name"]" Filterable="true" />
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Property="ProfileName" Title="@L["AiRunnerProfile"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_profileNames" FilterSearchable="true" >
                <Template Context="task">
                    @task.ProfileName
                    @if (task.ProfileSendsDataExternally)
                    {
                        <OmniIcon Name="OmniIconName.CloudArrowUp" Class="omni-u-text-warning omni-u-ms-xs"
                                    title="@L["ExternalData"]" Label="@L["ExternalData"]" />
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Title="@L["Source"]" ExportValue="@SourceExport" Width="210px" Filterable="false" >
                <Template Context="task">
                    @if (task.ProjectId is { } projectId)
                    {
                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><OmniLink Href="@($"/projects/{projectId}/overview")">@($"{L["Project"]}: {task.ProjectName ?? $"#{projectId}"}")</OmniLink></span>
                    }
                    else if (task.ServerId is { } serverId)
                    {
                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><OmniLink Href="@($"/servers/{serverId}/overview")">@($"{L["Server"]}: {task.ServerName ?? $"#{serverId}"}")</OmniLink></span>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Property="Schedule" Title="@L["Schedule"]" Width="170px" Filterable="true" >
                <Template Context="task"><code>@(task.Schedule ?? L["Manual"])</code></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Property="Enabled" Title="@L["Status"]" Width="105px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@EnabledText" >
                <Template Context="task">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@(task.Enabled ? OmniTone.Success : OmniTone.Neutral)">@(task.Enabled ? L["Active"] : L["Disabled"])</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Title="@L["Actions"]" Width="190px"
                                  Sortable="false" Filterable="false" TextAlign="OmniDataGridTextAlign.Center">
                <Template Context="task">
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => RunAsync(task))" Disabled="@(_runningTaskId.HasValue || !CanWrite(task))" Class="@((_runningTaskId == task.Id) ? "btn-busy" : null)" Busy="@((_runningTaskId == task.Id))" title="@L["RunNow"]"><OmniIcon Name="OmniIconName.Play" /></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenResults(task))" title="@L["Results"]"><OmniIcon Name="OmniIconName.Document" /></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Success" OnClick="@(() => OpenDialogAsync(task))" Disabled="@(!CanWrite(task))" title="@L["Edit"]"><OmniIcon Name="OmniIconName.Edit" /></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteAsync(task))" Disabled="@(!CanAdmin(task))" title="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                    </span>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
