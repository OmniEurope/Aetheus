@inherits PagedDataGridPageBase<AiTaskDefinitionDto>
@page "/ai-tasks"
@page "/projects/{ProjectId:int}/ai-tasks"

<PageTitle>@L["AiTasks"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["AiTasks"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("psychology")" /></Icon>
</OmniPageHeader>

@* R-5: the consumption figures are OE stat tiles of one OmniTileGrid (same width, same height). *@
<OmniTileGrid Columns="3" Gap="OmniSpacing.Large" Class="omni-u-mb-lg">
    <OmniStatTile Value="@((_consumption?.RunCount ?? 0).ToString(System.Globalization.CultureInfo.CurrentCulture))" Title="@L["RunsLastSevenDays"]" />
    <OmniStatTile Value="@((_consumption?.FailedCount ?? 0).ToString(System.Globalization.CultureInfo.CurrentCulture))" Title="@L["FailedRuns"]" />
    <OmniStatTile Value="@FormatDuration(_consumption?.DurationMs ?? 0)" Title="@L["ExecutionTime"]" />
</OmniTileGrid>

<OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center"
             Justify="OmniJustification.Between" Class="omni-u-mb-md" Gap="OmniSpacing.Large">
    <OmniTextBox aria-label="@L["Search"]" Placeholder="@L["Search"]" @bind-Value="_search" @bind-Value:after="OnSearchChangedAsync" />
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenDialogAsync(null))" Disabled="@(!CanCreate)" title="@(!CanCreate ? L["InsufficientPermissions"] : "")"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
</OmniStack>

@* Keep the grid mounted while IsLoading indicates progress to avoid restarting its initial fetch
   on each render. Show failures with a Retry action. *@
@if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger" Class="omni-u-mb-sm">
        @L["LoadFailed"]
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@ReloadPageAsync"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["Retry"]</span></ChildContent></OmniButton>
    </OmniAlert>
}
    <AetheusDataGrid FullHeight="true" @ref="_grid" RowClick="@OpenResults" Data="@_tasks" Count="@_totalCount"
                TItem="AiTaskDefinitionDto" PageSize="25"
                LoadData="@LoadDataAsync" ExportRead="@ReadExportAsync" IsLoading="@_loading"
                Virtualize="@AetheusGrid.RemoteVirtualization"
                VirtualData="@(() => new OmniDataGridResult<AiTaskDefinitionDto>(_tasks, _totalCount))"
                class="omni-u-w-100">
        <EmptyTemplate>
            <EmptyState Icon="psychology" Title="@L["NoAiTasks"]" Description="@L["NoAiTasksDescription"]" />
        </EmptyTemplate>
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="AiTaskDefinitionDto" Property="Name" Title="@L["Name"]" Filterable="true" />
            <OmniDataGridColumn Class="omni-data-grid__cell--text" TItem="AiTaskDefinitionDto" Property="ProfileName" Title="@L["AiRunnerProfile"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_profileNames" FilterSearchable="true" >
                <Template Context="task">
                    @task.ProfileName
                    @if (task.ProfileSendsDataExternally)
                    {
                        <OmniIcon Name="OmniIconName.CloudArrowUp" Class="omni-u-text-warning omni-u-ms-xs"
                                    title="@L["ExternalData"]" Label="@L["ExternalData"]" />
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Title="@L["Source"]" ExportValue="@SourceExport" Width="210px" Filterable="false" >
                <Template Context="task">
                    @if (task.ProjectId is { } projectId)
                    {
                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><OmniLink Href="@($"/projects/{projectId}/overview")">@($"{L["Project"]}: {task.ProjectName ?? $"#{projectId}"}")</OmniLink></span>
                    }
                    else if (task.ServerId is { } serverId)
                    {
                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><OmniLink Href="@($"/servers/{serverId}/overview")">@($"{L["Server"]}: {task.ServerName ?? $"#{serverId}"}")</OmniLink></span>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Property="Schedule" Title="@L["Schedule"]" Width="170px" Filterable="true" >
                <Template Context="task"><code>@(task.Schedule ?? L["Manual"])</code></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Property="Enabled" Title="@L["Status"]" Width="105px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@EnabledText" >
                <Template Context="task">
                    <OmniBadge Width="OmniBadgeWidth.Small" Fill="OmniFill.Solid" Tone="@(task.Enabled ? OmniTone.Success : OmniTone.Neutral)">@(task.Enabled ? L["Active"] : L["Disabled"])</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AiTaskDefinitionDto" Title="@L["Actions"]" Width="190px"
                                  Sortable="false" Filterable="false" TextAlign="OmniAlignment.Center">
                <Template Context="task">
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => RunAsync(task))" Disabled="@(_runningTaskId.HasValue || !CanWrite(task))" Class="@((_runningTaskId == task.Id) ? "btn-busy" : null)" Busy="@((_runningTaskId == task.Id))" title="@L["RunNow"]"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon></OmniButton>
                    <OmniOverflowMenu Label="@L["MoreActions"]">
                        <OmniMenuItem OnClick="@(() => OpenResults(task))"><Icon><OmniIcon Name="OmniIconName.Document" /></Icon><ChildContent>@L["Results"]</ChildContent></OmniMenuItem>
                        <OmniMenuItem OnClick="@(() => OpenDialogAsync(task))" Disabled="@(!CanWrite(task))"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent>@L["Edit"]</ChildContent></OmniMenuItem>
                        <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => DeleteAsync(task))" Disabled="@(!CanAdmin(task))"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["Delete"]</ChildContent></OmniMenuItem>
                    </OmniOverflowMenu>
                    </span>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
