@inherits ProjectLoaderSectionBase
@page "/projects/{Id:int}/monitoring"
@layout Aetheus.Front.Layout.ProjectDetailLayout
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

<PageTitle>@(Loader?.Project?.Name ?? L["Project"]) - @L["Monitoring"] - Aetheus</PageTitle>

@if (Loader?.Project is not null)
{
    @* Lists monitored applications above the selected application's telemetry, with its own picker
       and sub-tabs. *@
    <MonitoredAppsList ProjectId="Id" />
    <OmniHeading Level="OmniHeadingLevel.H5" Class="monitoring-telemetry-heading">@L["Telemetry"]</OmniHeading>
    <AppTelemetryPanel ProjectId="Id" SelectedAppId="App" />
}
