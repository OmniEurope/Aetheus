@page "/projects"

<PageTitle>@L["Projects"] - Aetheus</PageTitle>
<OmniPageHeader Title="@L["Projects"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("folder")" /></Icon>
    <Badges>
        <HelpLink PageKey="projects" />
    </Badges>
    <ActionsContent>
        @* The supervision of every project is a side-menu entry (NavMenu), not a button here. *@
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenCreateDialog" Disabled="@(!_canWrite)" Class="project-list-create" title="@(!_canWrite ? L["InsufficientPermissions"] : "")"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
    </ActionsContent>
</OmniPageHeader>

<div class="project-list-toolbar">

    <div class="project-list-controls">
        <div class="project-list-search-wrap">
            <OmniTextBox Placeholder="@L["SearchProjects"]" @bind-Value="_search" @bind-Value:after="ApplyFilters"
                Class="project-list-search" aria-label="@L["SearchProjects"]" />
        </div>
        <OmniDropDown TValue="ProjectStatus?" Options="@_statusOptions"
            Placeholder="@L["AllStatuses"]" AllowEmpty="true" @bind-Value="_statusFilter"
            @bind-Value:after="ApplyFilters" Label="@L["FilterByStatus"]" Class="project-list-status-filter" />
        <OmniDropDown TValue="ProjectSortOption" Options="@_sortOptions"
            @bind-Value="_sortOption" Label="@L["SortProjects"]" Class="project-list-sort" />
        <OmniButton Variant="@(_favoritesOnly ? OmniButtonVariant.Primary : OmniButtonVariant.Ghost)" OnClick="@ToggleFavoritesOnly" Class="project-favorites-filter" title="@L["FavoritesOnly"]" aria-pressed="@_favoritesOnly"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_favoritesOnly ? "star" : "star_border"))" /></Icon><ChildContent><span>@L["Favorites"]</span></ChildContent></OmniButton>
        <div class="project-view-switch" role="group" aria-label="@L["ProjectViewMode"]">
            <OmniButton Variant="@(_viewMode == ProjectViewMode.Comfortable ? OmniButtonVariant.Primary : OmniButtonVariant.Ghost)" OnClick="@(() => SetViewModeAsync(ProjectViewMode.Comfortable))" title="@L["ComfortableView"]" Label="@L["ComfortableView"]" aria-pressed="@(_viewMode == ProjectViewMode.Comfortable)"><Icon><OmniIcon Name="OmniIconName.SquaresFour" /></Icon></OmniButton>
            <OmniButton Variant="@(_viewMode == ProjectViewMode.Dense ? OmniButtonVariant.Primary : OmniButtonVariant.Ghost)" OnClick="@(() => SetViewModeAsync(ProjectViewMode.Dense))" title="@L["DenseView"]" Label="@L["DenseView"]" aria-pressed="@(_viewMode == ProjectViewMode.Dense)"><Icon><OmniIcon Name="OmniIconName.Rows" /></Icon></OmniButton>
        </div>
        @if (_statusFilter.HasValue || !string.IsNullOrEmpty(_search) || _favoritesOnly)
        {
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@ClearFilters"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@L["ClearFilters"]</span></ChildContent></OmniButton>
        }
    </div>
</div>

@if (_loading)
{
    <div class="project-card-grid-loading">
        <AetheusLoader />
    </div>
}
else if (_viewMode == ProjectViewMode.Comfortable)
{
    @* R-5: the project cards sit in one OmniTileGrid (same width, same height). The click target is the
       wrapper, not OmniCard.OnClick/Href: the card holds its own links and buttons and OE refuses inline
       event handlers on a card (see the OE need in the R-5 report). *@
    <OmniTileGrid Columns="3">
        @foreach (var project in VisibleProjects)
        {
            <div role="link" tabindex="0" data-testid="project-item" class="project-card-item"
                 @onclick="@(() => OpenProject(project.Id))"
                 @onkeydown="@((KeyboardEventArgs args) => OnProjectKeyDown(args, project.Id))">
            <OmniCard Class="project-card">
                <div class="project-card-header">
                    <div class="project-card-heading">
                        <a href="@($"/projects/{project.Id}")" class="project-card-name"
                            @onclick:stopPropagation="true">@project.Name</a>
                        @if (project.DeletionRequestedAt is not null)
                        {
                            <OmniBadge Icon="@(BadgeIcon.ForState(OmniTone.Warning))" Fill="OmniFill.Solid" Tone="OmniTone.Warning" data-testid="project-deletion-pending">@L["ProjectDeletionPending"]</OmniBadge>
                        }
                    </div>
                    @if (!Permissions.CanWrite(ResourceType.Project, project.Id))
                    {
                        <OmniIcon Name="OmniIconName.Lock" Class="omni-u-text-muted icon-xs-app" title="@L["Read"]" />
                    }
                    @if (project.DeletionRequestedAt is null)
                    {
                        <span class="project-card-action" @onclick:stopPropagation="true">
                            <OmniButton Variant="OmniButtonVariant.Ghost" OnClick="@(() => ToggleFavoriteAsync(project))" Class="@(_favoriteProjectIds.Contains(project.Id) ? "project-favorite active" : "project-favorite")" title="@(_favoriteProjectIds.Contains(project.Id) ? L["RemoveFromFavorites"] : L["AddToFavorites"])" Label="@(_favoriteProjectIds.Contains(project.Id) ? L["RemoveFromFavorites"] : L["AddToFavorites"])" aria-pressed="@_favoriteProjectIds.Contains(project.Id)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_favoriteProjectIds.Contains(project.Id) ? "star" : "star_border"))" /></Icon></OmniButton>
                        </span>
                    }
                </div>

                @* R-8: a project whose deletion is to be finished keeps its name and the badge only; no data block
                   (description, production, grade, last commit, last run, tags) applies to it any more. *@
                @if (project.DeletionRequestedAt is null)
                {
                @if (!string.IsNullOrWhiteSpace(project.Description))
                {
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted project-card-desc" title="@project.Description">
                        @project.Description
                    </OmniText>
                }

                @* No frame; two lines ruled like "Last commit" / "Last run" below. Line 1:
                   Production, and its state on the right. Line 2: the grade, and the people online
                   on the right when the app reports them. *@
                <div class="project-production">
                    <div class="project-production-row">
                        <span class="project-production-label">@L["Production"]</span>
                        <OmniBadge Icon="@(BadgeIcon.ForState(ProductionStatusTone(project.ProductionStatus)))" Fill="OmniFill.Solid" Tone="@ProductionStatusTone(project.ProductionStatus)" data-testid="project-production-status">@L[$"Production{project.ProductionStatus}"]</OmniBadge>
                    </div>
                    <div class="project-production-row">
                        <a href="@($"/projects/{project.Id}/quality")" class="project-gate-summary"
                            @onclick:stopPropagation="true" title="@L["AnalysisGlobalGrade"]">
                            <span class="project-production-label">@L["AnalysisGrade"]</span>
                            <GradeBadge Value="@project.LatestGateGrade" />
                        </a>
                        @if (project.OnlineUserCount.HasValue)
                        {
                            <span class="project-online-users" title="@L["OnlineUsersAvailable"]">
                                <OmniIcon Name="OmniIconName.Users" />
                                @(string.Format(L["OnlineUsers"], project.OnlineUserCount.Value))
                            </span>
                        }
                    </div>
                </div>

                <div class="project-activity">
                    <div class="project-activity-row">
                        <span class="project-activity-label">@L["LastCommit"]</span>
                        <div class="project-activity-content">
                            @if (project.LastCommitId.HasValue)
                            {
                                @* Display the SHA and first message line, with the full message in
                                   the title and a fallback label when absent. *@
                                <span class="project-activity-link">
                                    <ShortId Value="@LastCommitSha(project)" Href="@GitCommitHref(project)" Copyable="false" />
                                    @if (string.IsNullOrWhiteSpace(project.LastCommitMessage))
                                    {
                                        <span>@L["Commit"]</span>
                                    }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(project.LastCommitMessage))
                                {
                                    <span class="project-activity-line" title="@project.LastCommitMessage">@FirstLine(project.LastCommitMessage)</span>
                                }
                                @if (project.LastCommitAt.HasValue)
                                {
                                    <span class="project-activity-date"><OmniRelativeTime Value="@AsOffset(project.LastCommitAt.Value)" /></span>
                                }
                            }
                            else
                            {
                                <span class="project-activity-empty">@L["Unavailable"]</span>
                            }
                        </div>
                    </div>
                    <div class="project-activity-row">
                        @* Identify an active or latest run explicitly and render its status as a
                           labelled badge. *@
                        <span class="project-activity-label">@(project.LastRunIsActive ? L["RunInProgress"] : L["LastRun"])</span>
                        <div class="project-activity-content">
                            @if (project.LastRunId.HasValue)
                            {
                                @* R-27: three lines, each on one line (ellipsis, full text in the tooltip): badge and run
                                   number, pipeline name, then the step of a run in progress or the date. *@
                                <div class="project-activity-run">
                                    @if (project.LastRunStatus is { } runStatus)
                                    {
                                        <PipelineRunStatusBadge Status="runStatus" />
                                    }
                                    <a href="@($"/pipelines/runs/{project.LastRunId}")" class="project-activity-link"
                                        @onclick:stopPropagation="true">#@project.LastRunId</a>
                                </div>
                                <span class="project-activity-line project-activity-ellipsis" title="@(project.LastRunName ?? L["PipelineRun"])">@(project.LastRunName ?? L["PipelineRun"])</span>
                                @if (project.LastRunIsActive && !string.IsNullOrWhiteSpace(project.LastRunCurrentStep))
                                {
                                    <span class="project-activity-line project-activity-ellipsis" title="@project.LastRunCurrentStep">@project.LastRunCurrentStep</span>
                                }
                                else if (project.LastRunAt.HasValue)
                                {
                                    <span class="project-activity-date"><OmniRelativeTime Value="@AsOffset(project.LastRunAt.Value)" /></span>
                                }
                            }
                            else
                            {
                                <span class="project-activity-empty">@L["Unavailable"]</span>
                            }
                        </div>
                    </div>
                </div>

                @if (project.Tags.Count > 0)
                {
                    <OmniRow Gap="OmniSpacing.XSmall" Class="project-card-tags">
                        @foreach (var tag in project.Tags.Take(4))
                        {
                            <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@tag</OmniBadge>
                        }
                        @if (project.Tags.Count > 4)
                        {
                            <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@($"+{project.Tags.Count - 4}")</NumberBadge>
                        }
                    </OmniRow>
                }
                }
            </OmniCard>
            </div>
        }
    </OmniTileGrid>
}
else
{
    <div class="project-dense-list">
        <div class="project-dense-header" aria-hidden="true">
            <span>@L["Project"]</span>
            <span>@L["Production"]</span>
            <span>@L["AnalysisGrade"]</span>
            <span>@L["LastCommit"]</span>
            <span>@L["LastRun"]</span>
            <span>@L["OnlineUsersHeader"]</span>
        </div>
        @foreach (var project in VisibleProjects)
        {
            <div class="project-dense-row" role="link" tabindex="0" data-testid="project-item"
                @onclick="@(() => OpenProject(project.Id))"
                @onkeydown="@((KeyboardEventArgs args) => OnProjectKeyDown(args, project.Id))">
                <div class="project-dense-project">
                    @if (project.DeletionRequestedAt is null)
                    {
                        <span @onclick:stopPropagation="true">
                            <OmniButton Variant="OmniButtonVariant.Ghost" OnClick="@(() => ToggleFavoriteAsync(project))" Class="@(_favoriteProjectIds.Contains(project.Id) ? "project-favorite active" : "project-favorite")" title="@(_favoriteProjectIds.Contains(project.Id) ? L["RemoveFromFavorites"] : L["AddToFavorites"])" Label="@(_favoriteProjectIds.Contains(project.Id) ? L["RemoveFromFavorites"] : L["AddToFavorites"])" aria-pressed="@_favoriteProjectIds.Contains(project.Id)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_favoriteProjectIds.Contains(project.Id) ? "star" : "star_border"))" /></Icon></OmniButton>
                        </span>
                    }
                    <div>
                        <a href="@($"/projects/{project.Id}")" @onclick:stopPropagation="true">@project.Name</a>
                        @if (project.DeletionRequestedAt is not null)
                        {
                            <OmniBadge Icon="@(BadgeIcon.ForState(OmniTone.Warning))" Fill="OmniFill.Solid" Tone="OmniTone.Warning" data-testid="project-deletion-pending">@L["ProjectDeletionPending"]</OmniBadge>
                        }
                        @if (project.DeletionRequestedAt is null)
                        {
                            <span class="project-dense-description" title="@project.Description">@TruncateText(project.Description, 64)</span>
                        }
                    </div>
                </div>
                @* R-8: a project whose deletion is to be finished shows its name and the badge only. *@
                @if (project.DeletionRequestedAt is null)
                {
                <div>
                    <OmniBadge Icon="@(BadgeIcon.ForState(ProductionStatusTone(project.ProductionStatus)))" Fill="OmniFill.Solid" Tone="@ProductionStatusTone(project.ProductionStatus)" data-testid="project-production-status">@L[$"Production{project.ProductionStatus}"]</OmniBadge>
                </div>
                <div>
                    <a href="@($"/projects/{project.Id}/quality")"
                        @onclick:stopPropagation="true" title="@L["AnalysisGlobalGrade"]">
                        <GradeBadge Value="@project.LatestGateGrade" />
                    </a>
                </div>
                <div class="project-dense-activity">
                    @if (project.LastCommitId.HasValue)
                    {
                        <div>
                            <ShortId Value="@LastCommitSha(project)" Href="@GitCommitHref(project)" Copyable="false" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(project.LastCommitMessage))
                        {
                            <span class="project-activity-line" title="@project.LastCommitMessage">@FirstLine(project.LastCommitMessage)</span>
                        }
                        <span title="@project.LastCommitAt?.ToString("F")">
                            @(project.LastCommitAt.HasValue ? RelativeTime.FormatAgo(L, project.LastCommitAt.Value) : "-")
                        </span>
                    }
                    else
                    {
                        <span class="project-activity-empty">@L["Unavailable"]</span>
                    }
                </div>
                <div class="project-dense-activity">
                    @if (project.LastRunId.HasValue)
                    {
                        <div class="project-activity-run">
                            @if (project.LastRunStatus is { } denseStatus)
                            {
                                <PipelineRunStatusBadge Status="denseStatus" />
                            }
                            <a href="@($"/pipelines/runs/{project.LastRunId}")" @onclick:stopPropagation="true"
                               title="#@project.LastRunId · @(project.LastRunName ?? L["PipelineRun"])">
                                #@project.LastRunId · @(project.LastRunName ?? L["PipelineRun"])
                            </a>
                        </div>
                        @if (project.LastRunIsActive && !string.IsNullOrWhiteSpace(project.LastRunCurrentStep))
                        {
                            <span class="project-activity-line" title="@project.LastRunCurrentStep">@project.LastRunCurrentStep</span>
                        }
                        else
                        {
                            <span title="@project.LastRunAt?.ToString("F")">
                                @(project.LastRunAt.HasValue ? RelativeTime.FormatAgo(L, project.LastRunAt.Value) : "-")
                            </span>
                        }
                    }
                    else
                    {
                        <span class="project-activity-empty">@L["Unavailable"]</span>
                    }
                </div>
                <div class="project-dense-users">
                    @if (project.OnlineUserCount.HasValue)
                    {
                        <OmniIcon Name="OmniIconName.Users" />
                        <span>@project.OnlineUserCount</span>
                    }
                    else
                    {
                        <span class="project-activity-empty">-</span>
                    }
                </div>
                }
            </div>
        }
    </div>
}

@if (VisibleProjects.Count == 0 && !_loading)
{
    <EmptyState Icon="folder" Title="@L["NoProjectsFound"]" Description="@L["EmptyProjectsHint"]">
        <ActionContent>
            @if (_statusFilter.HasValue || !string.IsNullOrEmpty(_search) || _favoritesOnly)
            {
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@ClearFilters"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@L["ClearFilters"]</span></ChildContent></OmniButton>
            }
            else
            {
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenCreateDialog" Disabled="@(!_canWrite)"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
            }
        </ActionContent>
    </EmptyState>
}
