@if (Project is null)
{
    <AetheusLoader />
}
else
{
    <OmniHeading Level="OmniHeadingLevel.H5">@L["EditProject"]</OmniHeading>
    <OmniTemplateForm TModel="Aetheus.Front.Components.Projects.ProjectFormModel" Model="@_model" OnValidSubmit="@OnSubmit">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniRow Gap="OmniSpacing.Large">
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField For="oe-pages-projects-projectdetailsections-projecteditsection-1"><LabelContent>@L["Name"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_model.Name" Id="oe-pages-projects-projectdetailsections-projecteditsection-1" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </ChildContent></OmniFormField>
                    <OmniFormField For="oe-pages-projects-projectdetailsections-projecteditsection-2"><LabelContent>@L["Description"]</LabelContent><ChildContent>
                        <OmniTextArea @bind-Value="_model.Description" Rows="3" Id="oe-pages-projects-projectdetailsections-projecteditsection-2" />
                    </ChildContent></OmniFormField>
                </OmniStack>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField For="oe-pages-projects-projectdetailsections-projecteditsection-3"><LabelContent>@L["RepositoryUrl"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_model.RepositoryUrl" Placeholder="@L["PlaceholderUrl"]" Id="oe-pages-projects-projectdetailsections-projecteditsection-3" />
                    </ChildContent></OmniFormField>
                    <OmniFormField For="oe-pages-projects-projectdetailsections-projecteditsection-4"><LabelContent>@L["DefaultBranch"]</LabelContent><ChildContent>
                        @if (_branchesLoaded)
                        {
                            <OmniDropDown Id="oe-pages-projects-projectdetailsections-projecteditsection-4" Label="@L["DefaultBranch"]" @bind-Value="_model.DefaultBranch" Options="@(_branches.ToOptions(item => item, item => item))" name="DefaultBranch"
                                AllowEmpty="false" Filterable="true" />
                        }
                        else
                        {
                            <OmniTextBox @bind-Value="_model.DefaultBranch" Placeholder="main" Id="oe-pages-projects-projectdetailsections-projecteditsection-4" />
                        }
                    </ChildContent></OmniFormField>
                    @if (DefaultBranchesDiffer)
                    {
                        <OmniAlert Severity="OmniSeverity.Warning">
                            @string.Format(L["ProjectGitDefaultBranchMismatch"], _model.DefaultBranch, _repositoryDefaultBranch)
                        </OmniAlert>
                    }
                    <OmniFormField Label="@L["Status"]" For="oe-formfield-pages-projects-projectdetailsections-projecteditsection-1">
                        <OmniDropDown Id="oe-formfield-pages-projects-projectdetailsections-projecteditsection-1" @bind-Value="_model.Status" Options="@_statusOptions" />
                    </OmniFormField>
                </OmniStack>
            </OmniColumn>
        </OmniRow>

        <OmniFormField Label="@L["TagsCommaSeparated"]" Class="omni-u-mt-lg omni-u-w-100" For="Tags">
            <OmniTextBox @bind-Value="_model.TagsRaw"

                           Id="Tags" />
        </OmniFormField>

        @* S-FEAT-15 / S-FEAT-16: per-project CI/CD settings (blank = use the global / built-in default) *@
        <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-lg omni-u-mb-sm">@L["ProjectCiSettings"]</OmniHeading>
        <OmniRow Gap="OmniSpacing.Large" Class="project-ci-settings-row">
            <OmniColumn Span="12" MediumSpan="4">
                <OmniFormField For="project-edit-artifact-retention"><LabelContent>@L["ArtifactRetentionDays"]</LabelContent><ChildContent>
                    <OmniNumeric @bind-Value="_model.ArtifactRetentionDays" Minimum="1" Maximum="3650" Id="project-edit-artifact-retention" />
                    <ValidationMessage For="@(() => _model.ArtifactRetentionDays)" />
                </ChildContent></OmniFormField>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="4">
                <OmniFormField For="project-edit-artifact-latest-retention"><LabelContent>@L["ArtifactLatestRetentionDays"]</LabelContent><ChildContent>
                    <OmniNumeric @bind-Value="_model.ArtifactLatestRetentionDays" Minimum="1" Maximum="3650" Id="project-edit-artifact-latest-retention" />
                    <ValidationMessage For="@(() => _model.ArtifactLatestRetentionDays)" />
                </ChildContent></OmniFormField>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="4">
                <OmniFormField Label="@L["ReleaseNumberingPattern"]" Class="omni-u-w-100" For="ReleaseNumberingPattern">
                    <OmniTextBox @bind-Value="_model.ReleaseNumberingPattern" Id="ReleaseNumberingPattern" Placeholder="1.0.$(BUILD_BUILDID)" Class="omni-u-w-100" />
                    <ValidationMessage For="@(() => _model.ReleaseNumberingPattern)" />
                </OmniFormField>
            </OmniColumn>
        </OmniRow>

        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Class="omni-u-mt-lg">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
        </OmniStack>
    </OmniTemplateForm>
}
