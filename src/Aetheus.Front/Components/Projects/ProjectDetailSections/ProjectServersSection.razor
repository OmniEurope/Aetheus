@inherits ProjectPagedSectionBase<ProjectServerDto>
@using Microsoft.AspNetCore.Components.Sections
@if (_servers is null)
{
    <AetheusLoader />
}
else
{
    @* The breadcrumb leaf already reads "Servers" - no need to repeat it as a section title. *@
    @* Server header filters are applied by the endpoint; computed status and action columns have
       no stored filter value. *@
    @* The main action sits in the project header, on the title line. *@
    <SectionContent SectionName="@PageHeaderActions.SectionName">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenAddDialogAsync"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Add"]</span></ChildContent></OmniButton>
    </SectionContent>

    <AetheusDataGrid FullHeight="true" @ref="_grid" Data="@_servers" TItem="ProjectServerDto"
                        Count="@_totalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync" ExportRead="@ReadExportAsync"
                        PageSize="25" EmptyText="@L["NoRecords"]" class="aetheus-clickable-rows"
                        Virtualize="@AetheusGrid.RemoteVirtualization"
                        VirtualData="@(() => new OmniDataGridResult<ProjectServerDto>(_servers, _totalCount))"
                        RowClick="@OnRowClick">
            <EmptyTemplate>
                <EmptyState Icon="dns" Title="@L["NoProjectServers"]" Description="@L["EmptyProjectServersHint"]">
                    <ActionContent>
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenAddDialogAsync" title="@L["AddServer"]"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Add"]</span></ChildContent></OmniButton>
                    </ActionContent>
                </EmptyState>
            </EmptyTemplate>
            <Columns>
                <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="ProjectServerDto" Property="DisplayName" Title="@L["Name"]" Filterable="true" >
                    <Template Context="s">
                        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                            @if (s.Type == ProjectServerType.AgentServer && s.ServerId.HasValue)
                            {
                                <a href="/servers/@s.ServerId/overview" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@s.DisplayName</a>
                            }
                            else
                            {
                                @s.DisplayName
                            }
                            @if (s.ViaEnvironmentName is not null)
                            {
                                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@string.Format(L["ProjectServerViaEnvironment"].Value, s.ViaEnvironmentName)</OmniText>
                            }
                        </OmniStack>
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="ProjectServerDto" Property="Host" Title="@L["Host"]" Filterable="true" />
                <OmniDataGridColumn TItem="ProjectServerDto" Property="Port" Title="@L["Port"]" Width="90px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
                <OmniDataGridColumn TItem="ProjectServerDto" Property="Type" Title="@L["Type"]" Width="140px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@TypeText" >
                    <Template Context="s">
                        <OmniBadge Icon="@(BadgeIcon.For(GetTypeBadge(s.Type)))" Fill="OmniFill.Solid" Tone="@GetTypeBadge(s.Type)">@L[s.Type.ToString()]</OmniBadge>
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="ProjectServerDto" Title="@L["Status"]" ExportValue="@StatusExport" Width="120px" Sortable="false" Filterable="false" >
                    <Template Context="s">
                        @if (s.Type == ProjectServerType.AgentServer && s.ServerStatus.HasValue)
                        {
                            <OmniBadge Icon="@(BadgeIcon.ForState(GetStatusBadge(s.ServerStatus)))" Fill="OmniFill.Solid" Tone="@GetStatusBadge(s.ServerStatus)">@L[s.ServerStatus.ToString()!]</OmniBadge>
                        }
                        else
                        {
                            <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.Globe))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L["External"]</OmniBadge>
                        }
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="ProjectServerDto" Title="" Width="100px" TextAlign="OmniAlignment.Center" Sortable="false" Filterable="false" >
                    <Template Context="s">
                        @* A server reached through an environment has no project link to edit or detach (R-83). *@
                        @if (s.ViaEnvironmentId is null)
                        {
                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenEditDialogAsync(s))" title="@L["Edit"]"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon></OmniButton>
                                <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteServerAsync(s))" title="@L["Delete"]"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton>
                            </span>
                        }
                    </Template>
                </OmniDataGridColumn>
            </Columns>
        </AetheusDataGrid>
}
