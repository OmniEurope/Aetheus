@inherits ProjectPagedSectionBase<ServerTaskDto>
@if (_result is null)
{
    <AetheusLoader />
}
else
{
    @* The breadcrumb leaf already reads "Tasks" - no need to repeat it as a section title. *@
    @* Recette R-184: no search box and no pager; the grid is virtualized (R-049) and its header
       filters do the searching. *@
    <AetheusDataGrid FullHeight="true" @ref="_grid" Data="@_result.Items" TItem="ServerTaskDto"
        Count="@_result.TotalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync" ExportRead="@ReadExportAsync"
        PageSize="25" EmptyText="@L["NoRecords"]"
        Virtualize="@AetheusGrid.RemoteVirtualization"
        VirtualData="@(() => new OmniDataGridResult<ServerTaskDto>(_result.Items, _result.TotalCount))">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="ServerTaskDto" Property="Name" Title="@L["Task"]" Filterable="true" />
            <OmniDataGridColumn TItem="ServerTaskDto" Property="ServerName" Title="@L["Server"]" Width="150px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.ServerNames" FilterSearchable="true" />
            <OmniDataGridColumn TItem="ServerTaskDto" Title="@L["Source"]" ExportValue="@SourceExport" Width="210px" Sortable="false" Filterable="false" >
                <Template Context="task">
                    @if (task.PipelineRunId is { } pipelineRunId)
                    {
                        <OmniLink Href="@($"/pipelines/runs/{pipelineRunId}")">@($"{L["PipelineRun"]} #{pipelineRunId}")</OmniLink>
                    }
                    else
                    {
                        <OmniLink Href="@($"/servers/{task.ServerId}/overview")">@($"{L["Server"]}: {SourceServerName(task)}")</OmniLink>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ServerTaskDto" Property="Status" Title="@L["Status"]" Width="220px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText" >
                <Template Context="task">
                    @* Recette R-446: each status its colour, the one mapping of the server task pages. *@
                    <OmniBadge Fill="OmniFill.Solid" Tone="@Aetheus.Front.Components.Tasks.TaskListView.GetTaskBadge(task.Status)">@L[task.Status.ToString()]</OmniBadge>
                    @if (!string.IsNullOrWhiteSpace(task.FailureCode))
                    {
                        <OmniBadge Fill="OmniFill.Solid" Tone="@GetFailureBadge(task.FailureCode)" title="@task.FailureReason" Class="omni-u-ms-xs"><Icon><OmniIcon Name="@GetFailureIcon(task.FailureCode)" /></Icon><ChildContent>@L[task.FailureCode]</ChildContent></OmniBadge>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ServerTaskDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:g}" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" />
            <OmniDataGridColumn TItem="ServerTaskDto" Property="ExitCode" Title="@L["Exit"]" Width="80px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        </Columns>
    </AetheusDataGrid>
}
