@if (_loading)
{
    <AetheusLoader />
}
else
{
    <div class="@($"analysis-quality-workspace {(_qualitySectionIndex == 1 ? "analysis-quality-findings" : string.Empty)}")">
        <UrlSyncedTabs Slugs="@QualitySectionSlugs" RenderAllPanels="true"
                       @bind-SelectedIndex="_qualitySectionIndex"
                       Change="OnQualitySectionChangedAsync"
                       class="analysis-workspace-tabs">
            <Tabs>
                <OmniTabsItem Key="overview" Title="@L["AnalysisOverview"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("insights"))" /></Icon></OmniTabsItem>
                <OmniTabsItem Key="findings" Title="@SectionText(L["AnalysisFindings"], _summary.OpenCount)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("policy"))" /></Icon></OmniTabsItem>
            </Tabs>
        </UrlSyncedTabs>

        <section class="analysis-workspace-panel" role="tabpanel">
        @if (_qualitySectionIndex == 0)
        {
                @* Recette R-174: the hero is one band, the letter then a single reading line (title,
                   limiting domain, commit, date). The letter keeps its size through
                   analysis-grade-letter and its colour from the shared badge scale. *@
                <OmniCard Class="analysis-grade-overview">
                    <div class="analysis-grade-primary">
                        <GradeBadge Value="@_summary.Grade?.OverallGrade" Title="@L["AnalysisGlobalGrade"]"
                                    Class="analysis-grade-letter" />
                        <div class="analysis-grade-headline">
                            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["AnalysisGlobalGrade"]</OmniHeading>
                            @if (_summary.Grade is null)
                            {
                                <OmniText Element="OmniTextElement.Span">@L["AnalysisGradeNotConfigured"]</OmniText>
                            }
                            else if (_summary.Grade.Completeness == AnalysisGradeCompleteness.Incomplete)
                            {
                                <OmniText Element="OmniTextElement.Span">@L["AnalysisGradeIncomplete"]</OmniText>
                            }
                        </div>
                        @* Recette R2-143 (replaces the R-174 strip): commit, date, latest analysis run and
                           latest release as aligned tiles; R-430's links are kept, each tile opens its page.
                           Recette R2-139: no "limiting domain" sentence, the breakdown bolds it. *@
                        <div class="analysis-grade-meta-tiles">
                            @if (GradeCommitHref is { } commitHref)
                            {
                                <OmniStatTile Value="@ShortHash(_summary.Grade?.CommitHash)" Label="@L["Commit"]" OnClick="@(() => Navigation.NavigateTo(commitHref))" />
                            }
                            else
                            {
                                <OmniStatTile Value="@(ShortHash(_summary.Grade?.CommitHash) ?? L["NotAvailable"])" Label="@L["Commit"]" />
                            }
                            <OmniStatTile Value="@(_summary.Grade?.EvaluatedAt?.ToString("g") ?? L["NotAvailable"])" Label="@L["Date"]" />
                            @if (_summary.LastAnalysisRunId is { } lastRunId)
                            {
                                <OmniStatTile Value="@($"#{lastRunId}")" Label="@L["LastRun"]" OnClick="@(() => Navigation.NavigateTo($"/pipelines/runs/{lastRunId}"))" />
                            }
                            @if (_summary.LatestReleaseId is { } latestReleaseId)
                            {
                                <OmniStatTile Value="@_summary.LatestReleaseVersion" Label="@L["LatestRelease"]" OnClick="@(() => Navigation.NavigateTo($"/releases/{latestReleaseId}"))" />
                            }
                        </div>
                    </div>
                    @* Recette R2-052: the breakdown is shared with a run's Quality tab. *@
                    <AnalysisGradeBreakdown Grade="@_summary.Grade" CrapScore="@_complexity.LastOrDefault()?.Crap" />
                </OmniCard>

                @* Recette R-311: a count card shows only when its count is at least one. *@
                <OmniRow Gap="OmniSpacing.Large" Class="omni-u-mb-lg analysis-summary-row">
                    @if (_summary.OpenCount > 0)
                    {
                        <OmniColumn Span="6" MediumSpan="4" LargeSpan="2">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open))" Class="analysis-summary-card analysis-summary-action" title="@L["AnalysisOpenFindings"]" Label="@L["AnalysisOpenFindings"]" data-quality-shortcut="open">
                                <OmniIcon Name="OmniIconName.Bug" Size="OmniControlSize.Large" /><OmniText Element="OmniTextElement.Strong" Class="analysis-summary-figure">@_summary.OpenCount</OmniText><OmniText Element="OmniTextElement.Span" Class="analysis-summary-label">@L["AnalysisOpenFindings"]</OmniText>
                            </OmniButton>
                        </OmniColumn>
                    }
                    @if (_summary.NewCount > 0)
                    {
                        <OmniColumn Span="6" MediumSpan="4" LargeSpan="2">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenFindingsAsync(isNew: true))" Class="analysis-summary-card analysis-summary-action" title="@L["AnalysisNewFindings"]" Label="@L["AnalysisNewFindings"]" data-quality-shortcut="new">
                                <OmniIcon Name="OmniIconName.Sparkle" Size="OmniControlSize.Large" /><OmniText Element="OmniTextElement.Strong" Class="analysis-summary-figure">@_summary.NewCount</OmniText><OmniText Element="OmniTextElement.Span" Class="analysis-summary-label">@L["AnalysisNewFindings"]</OmniText>
                            </OmniButton>
                        </OmniColumn>
                    }
                    @if (_summary.CriticalCount > 0)
                    {
                        <OmniColumn Span="6" MediumSpan="4" LargeSpan="2">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open, severity: AnalysisSeverity.Critical))" Class="analysis-summary-card analysis-summary-action analysis-critical" title="@L["Critical"]" Label="@L["Critical"]" data-quality-shortcut="critical">
                                <OmniIcon Name="OmniIconName.ShieldWarning" Size="OmniControlSize.Large" /><OmniText Element="OmniTextElement.Strong" Class="analysis-summary-figure">@_summary.CriticalCount</OmniText><OmniText Element="OmniTextElement.Span" Class="analysis-summary-label">@L["Critical"]</OmniText>
                            </OmniButton>
                        </OmniColumn>
                    }
                    @if (_summary.HighCount > 0)
                    {
                        <OmniColumn Span="6" MediumSpan="4" LargeSpan="2">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open, severity: AnalysisSeverity.High))" Class="analysis-summary-card analysis-summary-action analysis-high" title="@L["High"]" Label="@L["High"]" data-quality-shortcut="high">
                                <OmniIcon Name="OmniIconName.Warning" Size="OmniControlSize.Large" /><OmniText Element="OmniTextElement.Strong" Class="analysis-summary-figure">@_summary.HighCount</OmniText><OmniText Element="OmniTextElement.Span" Class="analysis-summary-label">@L["High"]</OmniText>
                            </OmniButton>
                        </OmniColumn>
                    }
                    @if (_summary.FixedCount > 0)
                    {
                        <OmniColumn Span="6" MediumSpan="4" LargeSpan="2">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Fixed))" Class="analysis-summary-card analysis-summary-action" title="@L["Fixed"]" Label="@L["Fixed"]" data-quality-shortcut="fixed">
                                <OmniIcon Name="OmniIconName.ShieldCheck" Size="OmniControlSize.Large" /><OmniText Element="OmniTextElement.Strong" Class="analysis-summary-figure">@_summary.FixedCount</OmniText><OmniText Element="OmniTextElement.Span" Class="analysis-summary-label">@L["Fixed"]</OmniText>
                            </OmniButton>
                        </OmniColumn>
                    }
                    <OmniColumn Span="6" MediumSpan="4" LargeSpan="2">
                        <div class="analysis-summary-card analysis-summary-static" aria-label="@L["AnalysisLastRun"]">
                            <OmniIcon Name="OmniIconName.Timer" Size="OmniControlSize.Large" /><OmniText Element="OmniTextElement.Strong" Class="analysis-summary-figure" title="@LastAnalysisText">@LastAnalysisText</OmniText><OmniText Element="OmniTextElement.Span" Class="analysis-summary-label">@L["AnalysisLastRun"]</OmniText>
                        </div>
                    </OmniColumn>
                </OmniRow>

                @if (!HasAny)
                {
                    <EmptyState Icon="insights" Title="@L["NoQualityData"]" Description="@L["NoQualityDataDescription"]" />
                }
                else
                {
                    <OmniRow Gap="OmniSpacing.Large">
                        @if (_tests.Count >= 2)
                        {
                            <OmniColumn Span="12" LargeSpan="@ChartLargeSpan"><OmniCard Class="analysis-chart-card">
                                <OmniText Element="OmniTextElement.Strong">@L["TestTrend"]</OmniText>
                                <OmniChart Title="@L["TestTrend"]" AspectRatio="@ChartAspectRatio"><OmniLineSeries Data="@TestPassedPoints" Title="@L["Passed"]" ColorIndex="2" /><OmniLineSeries Data="@TestFailedPoints" Title="@L["Failed"]" ColorIndex="3" /><OmniCategoryAxis Labels="@OmniChartData.Labels(TestPassedPoints)" /><OmniLegend Items="@(new[] { L["Passed"].Value, L["Failed"].Value })" /></OmniChart>
                            </OmniCard></OmniColumn>
                        }
                        @if (_complexity.Count >= 2)
                        {
                            <OmniColumn Span="12" LargeSpan="@ChartLargeSpan"><OmniCard Class="analysis-chart-card">
                                <OmniText Element="OmniTextElement.Strong">@L["ComplexityTrend"]</OmniText>
                                <OmniChart Title="@L["ComplexityTrend"]" AspectRatio="@ChartAspectRatio"><OmniLineSeries Data="@ComplexityCrapPoints" Title="@L["Crap"]" ColorIndex="3" /><OmniLineSeries Data="@ComplexityAveragePoints" Title="@L["AvgCyclomatic"]" ColorIndex="0" /><OmniCategoryAxis Labels="@OmniChartData.Labels(ComplexityCrapPoints)" /><OmniLegend Items="@(new[] { L["Crap"].Value, L["AvgCyclomatic"].Value })" /></OmniChart>
                            </OmniCard></OmniColumn>
                        }
                    </OmniRow>
                }
        }
        else
        {
                @* Recette R-221: no search row; the column header filters are the only filters. Recette
                   R2-054 (2026-10-02): "Export all" is back under the table, the blue Markdown button of
                   every grid's export bar, and leaves the "..." menu R-431 had put it in. *@
                 <AetheusDataGrid ShowFooterBar="true" @ref="_findingsGrid" Data="@_findings" Count="@_findingCount" TItem="AnalysisFindingDto" LoadData="LoadFindingsAsync" ExportRead="@ReadFindingsAsync" ExportName="@L["AnalysisFindings"]" RowClick="OpenFinding" AllowSorting="true" AllowFiltering="true" FilterMode="OmniDataGridFilterMode.Simple" PageSize="25" class="analysis-table aetheus-clickable-rows aetheus-grid-fullheight" AllowColumnResize="true" Virtualize="@AetheusGrid.RemoteVirtualization" VirtualData="@(() => new OmniDataGridResult<AnalysisFindingDto>(_findings, _findingCount))" FullHeight="true" VirtualizationOverscanCount="3">
                    <Columns>
                        @* Recette R-502: the one definition of a findings list, shared with the Gate tab of a run. *@
                        <AnalysisFindingColumns Defaults="@_findingDefaults" />
                    </Columns>
                </AetheusDataGrid>
                @* It writes the AI prompt of every open finding (what resolves them), which OE's bar cannot: its
                   Markdown is a table of the columns. Same place, label and colour as that bar. *@
                <div class="analysis-findings-export" role="group" aria-label="@L["AnalysisExportAllAiPrompt"]">
                    <OmniButton Variant="OmniButtonVariant.Primary" Size="OmniControlSize.Small" Class="analysis-findings-export-button"
                                Busy="@_exportingPrompt" Disabled="@(_findingCount == 0 || _exportingPrompt)" OnClick="@ExportAllAiPromptAsync">
                        <OmniIcon Name="OmniIconName.FileMd" /> <span>@L["AnalysisExportAllAiPrompt"]</span>
                    </OmniButton>
                </div>
        }
        </section>
    </div>
}
