@if (_loading)
{
    <AetheusLoader />
}
else
{
    @* R-110: the tabs and their panel are separated by this stack's gap. *@
    <OmniStack Class="@($"analysis-quality-workspace {(_qualitySectionIndex == 1 ? "analysis-quality-findings" : string.Empty)}")">
        <UrlSyncedTabs Slugs="@QualitySectionSlugs" RenderAllPanels="true"
                       @bind-SelectedIndex="_qualitySectionIndex"
                       Change="OnQualitySectionChangedAsync"
                       class="analysis-workspace-tabs">
            <Tabs>
                <OmniTabsItem Key="overview" Title="@L["AnalysisOverview"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("insights"))" /></Icon></OmniTabsItem>
                <OmniTabsItem Key="findings" Title="@SectionText(L["AnalysisFindings"], _summary.OpenCount)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("policy"))" /></Icon></OmniTabsItem>
            </Tabs>
        </UrlSyncedTabs>

        <OmniStack Class="analysis-workspace-panel" role="tabpanel">
        @if (_qualitySectionIndex == 0)
        {
                @* The quality hero uses the shared grade colours with its own larger letter
                   sizing. *@
                <OmniCard Class="analysis-grade-overview">
                    <div class="analysis-grade-primary">
                        <GradeBadge Value="@_summary.Grade?.OverallGrade" Title="@L["AnalysisGlobalGrade"]"
                                    Class="analysis-grade-letter" />
                        <div class="analysis-grade-headline">
                            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["AnalysisGlobalGrade"]</OmniHeading>
                            @if (_summary.Grade is null)
                            {
                                <OmniText Element="OmniTextElement.Span">@L["AnalysisGradeNotConfigured"]</OmniText>
                            }
                            else if (_summary.Grade.OverallGrade is null)
                            {
                                @* Recettes R-73, R-74: a grade is never "incomplete"; without any measure there is no letter yet. *@
                                <OmniText Element="OmniTextElement.Span" data-testid="quality-grade-no-measure">@L["AnalysisGradeNoMeasure"]</OmniText>
                            }
                            else if (AnalysisGradeBreakdown.MissingMeasureCount(_summary.Grade) is > 0 and var missingMeasures)
                            {
                                <OmniText Element="OmniTextElement.Span" data-testid="quality-grade-partial">@string.Format(L["AnalysisGradePartial"], missingMeasures)</OmniText>
                            }
                        </div>
                    </div>
                        @* Linked commit, date, analysis-run and release tiles align beside the
                           grade; the breakdown highlights limiting domains. *@
                        <OmniTileGrid Columns="4" MinColumnWidth="@Aetheus.Front.Components.Pipelines.PipelineRun.RunTileMinColumnWidth" Gap="OmniSpacing.Small" Class="analysis-grade-meta-tiles">
                            @if (GradeCommitHref is { } commitHref)
                            {
                                <OmniStatTile Value="@ShortHash(_summary.Grade?.CommitHash)" Title="@L["Commit"]" Href="@commitHref" />
                            }
                            else
                            {
                                <OmniStatTile Value="@(ShortHash(_summary.Grade?.CommitHash) ?? L["NotAvailable"])" Title="@L["Commit"]" />
                            }
                            <OmniStatTile Value="@(_summary.Grade?.EvaluatedAt?.ToString("g") ?? L["NotAvailable"])" Title="@L["Date"]" />
                            @if (_summary.LastAnalysisRunId is { } lastRunId)
                            {
                                <OmniStatTile Value="@($"#{lastRunId}")" Title="@L["LastRun"]" Href="@($"/pipelines/runs/{lastRunId}")" />
                            }
                            @if (_summary.LatestReleaseId is { } latestReleaseId)
                            {
                                <OmniStatTile Value="@_summary.LatestReleaseVersion" Title="@L["LatestRelease"]" Href="@($"/releases/{latestReleaseId}")" />
                            }
                        </OmniTileGrid>

                    @* The breakdown is shared with a run's Quality tab. *@
                    <AnalysisGradeBreakdown Grade="@_summary.Grade" CrapScore="@_complexity.LastOrDefault()?.Crap" />
                </OmniCard>

                @* A count card shows only when its count is at least one. *@
                <OmniTileGrid Columns="6" MinColumnWidth="@Aetheus.Front.Components.Pipelines.PipelineRun.RunTileMinColumnWidth" Gap="OmniSpacing.Small" Class="analysis-summary-row">
                    @if (_summary.OpenCount > 0)
                    {
                        <OmniStatTile Value="@($"{_summary.OpenCount}")" Title="@L["AnalysisOpenFindings"]" OnClick="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open))" data-quality-shortcut="open">
                            <Icon><OmniIcon Name="OmniIconName.Bug" /></Icon>
                        </OmniStatTile>
                    }
                    @if (_summary.NewCount > 0)
                    {
                        <OmniStatTile Value="@($"{_summary.NewCount}")" Title="@L["AnalysisNewFindings"]" OnClick="@(() => OpenFindingsAsync(isNew: true))" data-quality-shortcut="new">
                            <Icon><OmniIcon Name="OmniIconName.Sparkle" /></Icon>
                        </OmniStatTile>
                    }
                    @if (_summary.CriticalCount > 0)
                    {
                        <OmniStatTile Class="analysis-critical" Value="@($"{_summary.CriticalCount}")" Title="@L["Critical"]" OnClick="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open, severity: AnalysisSeverity.Critical))" data-quality-shortcut="critical">
                            <Icon><OmniIcon Name="OmniIconName.ShieldWarning" /></Icon>
                        </OmniStatTile>
                    }
                    @if (_summary.HighCount > 0)
                    {
                        <OmniStatTile Class="analysis-high" Value="@($"{_summary.HighCount}")" Title="@L["High"]" OnClick="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Open, severity: AnalysisSeverity.High))" data-quality-shortcut="high">
                            <Icon><OmniIcon Name="OmniIconName.Warning" /></Icon>
                        </OmniStatTile>
                    }
                    @if (_summary.FixedCount > 0)
                    {
                        <OmniStatTile Value="@($"{_summary.FixedCount}")" Title="@L["Fixed"]" OnClick="@(() => OpenFindingsAsync(status: AnalysisFindingStatus.Fixed))" data-quality-shortcut="fixed">
                            <Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon>
                        </OmniStatTile>
                    }
                    <OmniStatTile Class="analysis-summary-static" Value="@LastAnalysisText" Title="@L["AnalysisLastRun"]">
                        <Icon><OmniIcon Name="OmniIconName.Timer" /></Icon>
                    </OmniStatTile>
                </OmniTileGrid>

                @if (!HasAny)
                {
                    <EmptyState Icon="insights" Title="@L["NoQualityData"]" Description="@L["NoQualityDataDescription"]" />
                }
                else
                {
                    @* R-3: the trend charts are OE cards of one OmniTileGrid (same width, same height). *@
                    <OmniTileGrid Columns="@(ChartLargeSpan == 12 ? 1 : 2)" Gap="OmniSpacing.Large">
                        @if (_tests.Count >= 2)
                        {
                            <OmniCard>
                                <OmniText Element="OmniTextElement.Strong">@L["TestTrend"]</OmniText>
                                <OmniChart Label="@L["TestTrend"]" AspectRatio="@ChartAspectRatio"><OmniLineSeries Data="@TestPassedPoints" Title="@L["Passed"]" ColorIndex="2" /><OmniLineSeries Data="@TestFailedPoints" Title="@L["Failed"]" ColorIndex="3" /><OmniCategoryAxis Labels="@OmniChartData.Labels(TestPassedPoints)" /><OmniLegend Items="@(new[] { L["Passed"].Value, L["Failed"].Value })" /></OmniChart>
                            </OmniCard>
                        }
                        @if (_complexity.Count >= 2)
                        {
                            <OmniCard>
                                <OmniText Element="OmniTextElement.Strong">@L["ComplexityTrend"]</OmniText>
                                <OmniChart Label="@L["ComplexityTrend"]" AspectRatio="@ChartAspectRatio"><OmniLineSeries Data="@ComplexityCrapPoints" Title="@L["Crap"]" ColorIndex="3" /><OmniLineSeries Data="@ComplexityAveragePoints" Title="@L["AvgCyclomatic"]" ColorIndex="0" /><OmniCategoryAxis Labels="@OmniChartData.Labels(ComplexityCrapPoints)" /><OmniLegend Items="@(new[] { L["Crap"].Value, L["AvgCyclomatic"].Value })" /></OmniChart>
                            </OmniCard>
                        }
                    </OmniTileGrid>
                }
        }
        else
        {
                @* Column headers own filtering; the grid's own MD button is the only export. *@
                 <AetheusDataGrid ShowFooterBar="true" @ref="_findingsGrid" Data="@_findings" Count="@_findingCount" TItem="AnalysisFindingDto" LoadData="LoadFindingsAsync" ExportRead="@ReadFindingsAsync" ExportName="@L["AnalysisFindings"]" RowClick="OpenFinding" AllowSorting="true" AllowFiltering="true" FilterMode="OmniDataGridFilterMode.Simple" PageSize="25" class="analysis-table aetheus-clickable-rows aetheus-grid-fullheight" AllowColumnResize="true" Virtualize="@AetheusGrid.RemoteVirtualization" VirtualData="@(() => new OmniDataGridResult<AnalysisFindingDto>(_findings, _findingCount))" FullHeight="true" VirtualizationOverscanCount="3">
                    <Columns>
                        @* The one definition of a findings list, shared with the Gate tab of a
                           run. *@
                        <AnalysisFindingColumns Defaults="@_findingDefaults" />
                    </Columns>
                </AetheusDataGrid>
        }
        </OmniStack>
    </OmniStack>
}
