@if (Project is null)
{
    <AetheusLoader />
}
else
{
    <UrlSyncedTabs Slugs="@TabSlugs" Class="project-overview-tabs">
        <Tabs>
            <OmniTabsItem Key="overview" Title="@L["Overview"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("dashboard"))" /></Icon><ChildContent>
                @if (ShowGettingStarted)
                {
                    <OnboardingStepList Title="@L["ProjectGettingStartedTitle"]"
                        Description="@GettingStartedDescription"
                        Steps="@GettingStartedSteps" />
                }

                @* Missing pipeline requirements are identified above the project cards with their
                   dependent pipelines and a provisioning action. *@
                @if (_unmet.Count > 0 && !_unmetDismissed)
                {
                    <OmniAlert Severity="OmniSeverity.Warning" Class="omni-u-mb-md unmet-requirements-alert" data-testid="unmet-requirements">
                        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Small">
                            @* A project that is never deployed can dismiss this warning for good,
                               until its list of missing libraries and vaults changes. *@
                            <div class="unmet-requirements-head">
                                <strong>@string.Format(L["UnmetRequirementsTitle"], _unmet.SelectMany(item => item.Pipelines).Distinct().Count())</strong>
                                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@DismissUnmetAsync" Class="unmet-requirements-dismiss"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@L["IgnoreMessage"]</span></ChildContent></OmniButton>
                            </div>
                            @foreach (var item in _unmet)
                            {
                                <span>
                                    <code>@item.Name</code>
                                    · @(item.Kind == "vault" ? L["Vault"] : L["VariableLibrary"])
                                    · @string.Join(", ", item.Pipelines)
                                </span>
                            }
                            @if (Permissions.CanWrite(ResourceType.Project, Project.Id))
                            {
                                @* The button and its explanation wrap instead of overlapping. *@
                                <div class="unmet-requirements-actions">
                                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ProvisionUnmetAsync" Class="@(_provisioningUnmet ? "btn-busy" : null)" Busy="@(_provisioningUnmet)"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["PipelineSetupProvision"]</span></ChildContent></OmniButton>
                                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 unmet-requirements-hint">@L["PipelineSetupProvisionHint"]</OmniText>
                                </div>
                            }
                            @if (_unmetError is not null)
                            {
                                <span class="omni-u-text-danger">@_unmetError</span>
                            }
                        </OmniStack>
                    </OmniAlert>
                }
                @* Two balanced cards: "Information" (description, status, dates, tags) on the left,
                   "Repository" (git source, branch, last git activity) on the right. *@
                <OmniTileGrid Columns="2" Gap="OmniSpacing.Large">
                        @* Both card headers occupy one control-height row so their details align. *@
                        <OmniCard Class="overview-info-card">
                            <HeaderContent>
                                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="overview-card-heading">
                                    <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Information"]</OmniText>
                                </OmniStack>
                            </HeaderContent>
                            <ChildContent>
                            @* OE labelled lines, each with its icon (OmniDescriptionItem.Icon). *@
                            <OmniDescriptionList>
                                @if (!string.IsNullOrWhiteSpace(Project.Description))
                                {
                                    <OmniDescriptionItem Term="@L["Description"]"><Icon><OmniIcon Name="OmniIconName.TextAlignLeft" /></Icon><ChildContent>@Project.Description</ChildContent></OmniDescriptionItem>
                                }
                                @* Status and grade share a row, followed by dates and tags for
                                   compact project information. *@
                                <OmniDescriptionItem Term="@($"{L["Status"]} · {L["AnalysisGrade"]}")">
                                    <Icon><OmniIcon Name="OmniIconName.Broadcast" /></Icon>
                                    <ChildContent>
                                        @* Status and grade retain distinct spacing. *@
                                        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small" Class="project-status-grade">
                                        <OmniBadge Fill="OmniFill.Solid" Tone="@(Project.Status == ProjectStatus.Active ? OmniTone.Success : OmniTone.Neutral)">@L[Project.Status.ToString()]</OmniBadge>
                                        @* The latest candidate grade links to its Gate tab;
                                           projects without a graded run link to quality. *@
                                        @if (Project.LatestGateGradeRunId is { } gradeRunId)
                                        {
                                            <a href="@($"/pipelines/runs/{gradeRunId}?projectId={Project.Id}&tab=gate")" class="project-grade-run-link"
                                                title="@string.Format(L["ProjectGradeLatestCandidate"], gradeRunId)">
                                                <GradeBadge Value="@Project.LatestGateGrade" />
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@($"/projects/{Project.Id}/quality")"
                                                title="@L["AnalysisGlobalGrade"]">
                                                <GradeBadge Value="@Project.LatestGateGrade" />
                                            </a>
                                        }
                                        </OmniStack>
                                    </ChildContent>
                                </OmniDescriptionItem>
                                <OmniDescriptionItem Term="@($"{L["Created"]} · {L["Updated"]}")">
                                    <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
                                    <ChildContent>@Project.CreatedAt.ToString("g") · @Project.UpdatedAt.ToString("g")</ChildContent>
                                </OmniDescriptionItem>
                                @if (Project.Tags.Count > 0)
                                {
                                    <OmniDescriptionItem Term="@L["Tags"]">
                                        <Icon><OmniIcon Name="OmniIconName.Tag" /></Icon>
                                        <ChildContent>
                                            @foreach (var tag in Project.Tags)
                                            {
                                                <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@tag</OmniBadge>
                                            }
                                        </ChildContent>
                                    </OmniDescriptionItem>
                                }
                            </OmniDescriptionList>
                            </ChildContent>
                        </OmniCard>
                        <OmniCard Class="overview-info-card">
                            <HeaderContent>
                                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="overview-card-heading">
                                    <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Repository"]</OmniText>
                                    @if (Permissions.CanWrite(ResourceType.Project, Project.Id))
                                    {
                                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="AddGitRepository" title="@L["AddGitRepository"]"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Add"]</span></ChildContent></OmniButton>
                                    }
                                </OmniStack>
                            </HeaderContent>
                            <ChildContent>
                            @if (string.IsNullOrWhiteSpace(Project.RepositoryUrl) && _primaryGitRepository is null)
                            {
                                <EmptyState Icon="commit" Description="@L["NoRepository"]" />
                            }
                            else
                            {
                                <OmniDescriptionList>
                                    @if (_primaryGitRepository is not null)
                                    {
                                        <OmniDescriptionItem Term="@L["RepositoryName"]">
                                            <Icon><OmniIcon Name="OmniIconName.FolderOpen" /></Icon>
                                            <ChildContent><a class="pipeline-name-link" href="@($"/git-repositories/{_primaryGitRepository.Id}")">@_primaryGitRepository.Name</a></ChildContent>
                                        </OmniDescriptionItem>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(RepositoryDisplayUrl))
                                    {
                                        <OmniDescriptionItem Term="@L["RepositoryUrl"]">
                                            <Icon><OmniIcon Name="OmniIconName.Link" /></Icon>
                                            @* The clone address, read-only in OE's copyable field,
                                               so a long URL stays inside the card (the field
                                               scrolls, the page does not) and the Copy button
                                               welded to its end puts it on the clipboard. *@
                                            <ChildContent>
                                                <OmniTextBox Value="@RepositoryDisplayUrl" ReadOnly="true" ShowCopy="true"
                                                             Id="project-overview-clone-url" ValueExpression="@(() => RepositoryDisplayUrl)"
                                                             aria-label="@L["RepositoryUrl"]" Class="overview-clone-url" />
                                            </ChildContent>
                                        </OmniDescriptionItem>
                                    }
                                    @* Branch and latest activity share a repository row. *@
                                    @if (!string.IsNullOrWhiteSpace(RepositoryDisplayBranch) || Project.LastGitUpdateAt.HasValue)
                                    {
                                        <OmniDescriptionItem Term="@RepositoryActivityLabel">
                                            <Icon><OmniIcon Name="OmniIconName.Graph" /></Icon>
                                            <ChildContent><span title="@(Project.LastGitUpdateAt?.ToString("F"))">@RepositoryActivityValue</span></ChildContent>
                                        </OmniDescriptionItem>
                                    }
                                </OmniDescriptionList>
                            }
                            </ChildContent>
                        </OmniCard>
                </OmniTileGrid>

                <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-2xl omni-u-mb-sm">@L["ProjectSections"]</OmniHeading>
                <div class="project-section-grid-scroll omni-u-mb-lg" role="region" aria-label="@L["ProjectSections"]" tabindex="0">
                    <OmniTileGrid Columns="6" Class="project-section-grid">
                        @* No Overview tile (it is the page being read), tiles wrap with the width. *@
                        @foreach (var navItem in ProjectNavigationCatalog.VisibleItems(Permissions, Project.Id).Where(item => item.Slug != "overview"))
                        {
                            var isPipeline = navItem.Slug == "pipelines";
                            var isCurrent = false;
                            @* The tile is itself the link to the section (OmniCard.Href), not wrapped in one. *@
                            <OmniCard Href="@(navItem.Href(Project.Id))"
                                      Class="@($"project-section-tile{(isCurrent ? " project-section-tile-current" : string.Empty)}")"
                                      aria-current="@(isCurrent ? "page" : null)">
                                <div class="project-section-tile-content">
                                    <div class="project-section-tile-heading">
                                        <OmniIcon Name="@MaterialIconMap.Resolve(navItem.Icon)" />
                                        <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L[navItem.LabelKey]</OmniText>
                                    </div>
                                    @* Only while something runs; a finished run is read on the Pipelines page. *@
                                    @if (isPipeline && LatestRunStatus is PipelineStatus.Running or PipelineStatus.Pending or PipelineStatus.WaitingForApproval)
                                    {
                                        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Info">@L.Localize(PipelineStatus.Running)</OmniBadge>
                                    }
                                </div>
                            </OmniCard>
                        }
                    </OmniTileGrid>
                </div>

                @* F-bis: coverage + LOC of the run behind the most recent release (shown only when real data exists) *@
                @if (_lastReleaseMetrics is { } metrics)
                {
                    <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-2xl omni-u-mb-sm">@L["LastReleaseMetrics"]</OmniHeading>
                    <OmniCard Class="omni-u-p-md">
                        <OmniRow Gap="OmniSpacing.ExtraLarge" Align="OmniAlignment.Center">
                            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                                <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral" title="@metrics.Version"><Icon><OmniIcon Name="OmniIconName.CheckCircle" /></Icon><ChildContent>@ReleaseHelper.ShortVersion(metrics.Version)</ChildContent></OmniBadge>
                                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0" title="@metrics.When.ToString("F")">@RelativeTime.FormatAgo(L, metrics.When)</OmniText>
                            </OmniStack>
                            @if (metrics.CoverageLineRate is { } cov)
                            {
                                <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.ExtraLarge">
                                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@L["Coverage"]</OmniText>
                                    <OmniHeading Level="OmniHeadingLevel.H5" Class="@($"{CoverageColorClass(cov)} omni-u-m-0")">@($"{cov * 100:F1}%")</OmniHeading>
                                </OmniStack>
                            }
                            @if (metrics.LinesOfCode is { } loc)
                            {
                                <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.ExtraLarge">
                                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@L["LinesOfCode"]</OmniText>
                                    <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@loc.ToString("N0")</OmniHeading>
                                </OmniStack>
                            }
                        </OmniRow>
                    </OmniCard>
                }

                @* The two tiles take the dashboard tiles' size (R-3: OE cards of one OmniTileGrid). *@
                <OmniTileGrid Columns="2" Gap="OmniSpacing.Large" Class="omni-u-mt-2xl dashboard-tile-row project-overview-recent-row">
                        <OmniCard Class="dashboard-tile project-overview-recent-card">
                            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                                <OmniIcon Name="OmniIconName.GitCommit" />
                                <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["RecentCommits"]</OmniHeading>
                            </OmniStack>

                            <AetheusDataGrid Data="@_recentCommits" TItem="RecentCommitView" PageSize="20" Virtualize="@(_recentCommits.Count > 20)"
                IsLoading="@_loadingRecentCommits" EmptyText="@L["NoRecentCommits"]"
                                    RowClick="@OnRecentCommitClick" class="aetheus-clickable-rows project-overview-recent-grid">
                                <Columns>
                                    <OmniDataGridColumn Frozen="true" TItem="RecentCommitView" Property="ShortSha" Title="@L["Commit"]" Width="6rem" Filterable="true" >
                                        <Template Context="commit">
                                            <a href="@CommitHref(commit)" title="@commit.RepositoryName" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@commit.ShortSha</a>
                                        </Template>
                                    </OmniDataGridColumn>
                                    <OmniDataGridColumn TItem="RecentCommitView" Property="BranchName" Title="@L["Branch"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" />
                                    <OmniDataGridColumn TItem="RecentCommitView" Property="Message" Truncate="true" Title="@L["Message"]" MinWidth="8rem" Filterable="true" />
                                    <OmniDataGridColumn TItem="RecentCommitView" Property="AuthorDate" Title="@L["Date"]" Width="6.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" >
                                        <Template Context="commit">
                                            <span title="@commit.AuthorDate.ToString("F")">@RelativeTime.FormatAgo(L, commit.AuthorDate)</span>
                                        </Template>
                                    </OmniDataGridColumn>
                                </Columns>
                            </AetheusDataGrid>
                        </OmniCard>
                        <OmniCard Class="dashboard-tile project-overview-recent-card">
                            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                                <OmniIcon Name="OmniIconName.Reset" />
                                <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["RecentPipelines"]</OmniHeading>
                            </OmniStack>
                            <PipelineRunsGrid Items="@_recentPipelineRuns" Compact="true"
                                IsLoading="@_loadingRecentPipelines" MaxGroups="@RecentItemLimit"
                                CssClass="project-overview-recent-grid"
                                EmptyTitleKey="NoRecentPipelines" EmptyDescriptionKey="NoRecentPipelines" />
                        </OmniCard>
                </OmniTileGrid>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="readme" Title="@L["Readme"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("description"))" /></Icon><ChildContent>
                <section class="project-readme-panel">
                    @if (!string.IsNullOrWhiteSpace(_readmeBranch))
                    {
                        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-md">
                            <OmniText Element="OmniTextElement.Strong" Class="omni-u-text-muted omni-u-m-0">@L["DefaultBranch"]</OmniText>
                            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@_readmeBranch</OmniBadge>
                        </OmniStack>
                    }
                    @if (string.IsNullOrEmpty(_readmeHtml))
                    {
                        <EmptyState Icon="description" Title="@L["NoProjectReadme"]"
                            Description="@L["NoProjectReadmeHint"]" />
                    }
                    else
                    {
                        @* nosemgrep: aetheus.razor.markupstring-dynamic - Markdig pipeline with DisableHtml, raw HTML is dropped *@
                        <article class="readme-rendered project-readme-content">@((MarkupString)_readmeHtml)</article>
                    }
                </section>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="changelog" Title="@L["Changelog"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("history"))" /></Icon><ChildContent>
                @if (_changelog.Count == 0)
                {
                    <EmptyState Icon="history" Title="@L["NoProjectChangelog"]"
                        Description="@L["NoProjectChangelogHint"]" />
                }
                else
                {
                    <OmniTimeline Class="omni-u-mt-sm project-activity-timeline project-changelog-timeline" Label="@L["Changelog"]">
                            @foreach (var release in _changelog)
                            {
                                var when = release.PublishedAt ?? release.DetectedAt;
                                <OmniTimelineItem>
                                        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Small" Class="project-changelog-entry">
                                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0"
                                                title="@when.ToString("F")">@RelativeTime.FormatAgo(L, when)</OmniText>
                                            <OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                                                @* The c-/vc- names shortened, the whole value
                                                   copyable, name and tag linked to the release. *@
                                                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0"><ShortId Value="@release.Version" Href="@($"/releases/{release.Id}")" /></OmniText>
                                                <ReleaseStatusBadge Status="@release.Status" />
                                                @if (!string.IsNullOrWhiteSpace(release.TagName))
                                                {
                                                    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral"><ShortId Value="@release.TagName" Href="@($"/releases/{release.Id}")" Copyable="false" /></OmniBadge>
                                                }
                                            </OmniRow>
                                            <OmniText Element="OmniTextElement.Paragraph" Class="project-changelog-copy omni-u-m-0">@release.Changelog</OmniText>
                                        </OmniStack>
                                </OmniTimelineItem>
                            }
                    </OmniTimeline>
                }
            </ChildContent></OmniTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}
