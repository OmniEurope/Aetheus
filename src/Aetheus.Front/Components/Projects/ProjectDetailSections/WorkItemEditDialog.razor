@inherits Aetheus.Front.Components.Shared.EntityEditDialogBase

<OmniTemplateForm TModel="EditModel" Model="@_model" OnValidSubmit="@SubmitAsync">
    <OmniDataAnnotationsValidator Localizer="@L" />
    <OmniRow Gap="OmniSpacing.Large">
        <OmniColumn Span="12">
            <OmniFormField For="oe-pages-projects-projectdetailsections-workitemeditdialog-1" Class="omni-u-w-100"><LabelContent>@L["Title"]</LabelContent><ChildContent>
                <OmniTextBox @bind-Value="_model.Title" Id="oe-pages-projects-projectdetailsections-workitemeditdialog-1" />
            </ChildContent></OmniFormField>
            <ValidationMessage For="@(() => _model.Title)" />
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="4">
            <OmniFormField Label="@L["Type"]" Class="omni-u-w-100" For="oe-formfield-pages-projects-projectdetailsections-workitemeditdialog-1">
                <OmniDropDown Id="oe-formfield-pages-projects-projectdetailsections-workitemeditdialog-1" @bind-Value="_model.Type" Options="@_types" />
            </OmniFormField>
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="4">
            <OmniFormField Label="@L["Status"]" Class="omni-u-w-100" For="oe-formfield-pages-projects-projectdetailsections-workitemeditdialog-2">
                <OmniDropDown Id="oe-formfield-pages-projects-projectdetailsections-workitemeditdialog-2" @bind-Value="_model.Status" Options="@_statuses" />
            </OmniFormField>
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="4">
            <OmniFormField For="oe-pages-projects-projectdetailsections-workitemeditdialog-numeric-1"><LabelContent>@L["Priority"]</LabelContent><ChildContent><OmniNumeric @bind-Value="_model.Priority" Minimum="0" Maximum="4" Id="oe-pages-projects-projectdetailsections-workitemeditdialog-numeric-1" /></ChildContent></OmniFormField>
        </OmniColumn>
        <OmniColumn Span="12">
            <OmniFormField For="oe-pages-projects-projectdetailsections-workitemeditdialog-5" Class="omni-u-w-100"><LabelContent>@L["Description"]</LabelContent><ChildContent>
                <OmniTextArea @bind-Value="_model.Description" Rows="3" Id="oe-pages-projects-projectdetailsections-workitemeditdialog-5" />
            </ChildContent></OmniFormField>
        </OmniColumn>
        <OmniColumn Span="12">
            <OmniFormField For="oe-pages-projects-projectdetailsections-workitemeditdialog-6" Help="@L["TagsHint"]" Class="omni-u-w-100"><LabelContent>@L["Tags"]</LabelContent><ChildContent>
                <OmniTextBox @bind-Value="_model.TagsCsv" Placeholder="@L["PlaceholderTags"]" Id="oe-pages-projects-projectdetailsections-workitemeditdialog-6" />
            </ChildContent></OmniFormField>
        </OmniColumn>
    </OmniRow>
    <DialogFooter OnCancel="@Cancel">
        <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><OmniIcon Name="@MaterialIconMap.Resolve((IsEdit ? "save" : "add"))" /> <span>@(IsEdit ? L["Save"] : L["Create"])</span></OmniButton>
    </DialogFooter>
</OmniTemplateForm>
