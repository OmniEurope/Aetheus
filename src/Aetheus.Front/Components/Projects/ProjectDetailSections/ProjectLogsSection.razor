@inherits ProjectPagedSectionBase<TaskLogDto>
@if (_result is null)
{
    <AetheusLoader />
}
else
{
    @* The breadcrumb supplies the title; the virtualized log grid sends header filters to its
       endpoint. *@
    <AetheusDataGrid FullHeight="true" @ref="_grid" Data="@_result.Items" TItem="TaskLogDto"
        Count="@_result.TotalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync" ExportRead="@ReadExportAsync" ShowFooterBar="true"
        PageSize="25" EmptyText="@L["NoLogs"]" RowClick="@OpenEntryAsync"
        Virtualize="@AetheusGrid.RemoteVirtualization"
        VirtualData="@(() => new OmniDataGridResult<TaskLogDto>(_result.Items, _result.TotalCount))">
        <EmptyTemplate>
            <EmptyState Icon="article" Title="@L["NoLogs"]" />
        </EmptyTemplate>
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="TaskLogDto" Property="Timestamp" Title="@L["Time"]" FormatString="{0:G}" Width="180px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" />
            <OmniDataGridColumn TItem="TaskLogDto" Property="Level" Title="@L["Level"]" Width="100px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@LevelText" >
                <Template Context="log">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@GetLevelBadge(log.Level)">@L[log.Level.ToString()]</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="TaskLogDto" Property="Message" Truncate="true" Title="@L["Message"]" MinWidth="18rem" Filterable="true">
                <Template Context="log">
                    <OmniAnsiText Text="@log.Message" />
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
}
