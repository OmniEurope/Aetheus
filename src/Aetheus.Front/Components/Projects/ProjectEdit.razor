@page "/projects/new"
@page "/projects/{Id:int}"

<PageTitle>@L["NewProject"] - Aetheus</PageTitle>

@if (_isNew)
{
    <OmniPageHeader Title="@L["NewProject"]" ShowBack="true" Subtitle="@Breadcrumb.Subtitle()">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("folder")" /></Icon>
    </OmniPageHeader>

    <div class="form-narrow"><OmniTemplateForm TModel="ProjectModel" Model="@_model" OnValidSubmit="@OnSubmit">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniRow Gap="OmniSpacing.Large">
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField For="oe-pages-projects-projectedit-1"><LabelContent>@L["Name"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_model.Name" Id="oe-pages-projects-projectedit-1" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </ChildContent></OmniFormField>
                    <OmniFormField For="oe-pages-projects-projectedit-2"><LabelContent>@L["Description"]</LabelContent><ChildContent>
                        <OmniTextArea @bind-Value="_model.Description" Rows="3" Id="oe-pages-projects-projectedit-2" />
                    </ChildContent></OmniFormField>
                </OmniStack>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField For="oe-pages-projects-projectedit-3" Class="omni-u-w-100"><LabelContent>@L["RepositoryUrl"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_model.RepositoryUrl"
                            Placeholder="@L["PlaceholderRepositoryUrl"]"
                            Class="project-repo-url-input" Id="oe-pages-projects-projectedit-3" />
                    </ChildContent></OmniFormField>
                    <OmniFormField For="oe-pages-projects-projectedit-4"><LabelContent>@L["DefaultBranch"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_model.DefaultBranch"
                            Placeholder="main" Id="oe-pages-projects-projectedit-4" />
                    </ChildContent></OmniFormField>
                </OmniStack>
            </OmniColumn>
        </OmniRow>

        <OmniFormField For="oe-pages-projects-projectedit-5" Class="omni-u-mt-lg omni-u-w-100"><LabelContent>@L["TagsCommaSeparated"]</LabelContent><ChildContent>
            <OmniTextBox @bind-Value="_model.TagsRaw" Id="oe-pages-projects-projectedit-5" />
        </ChildContent></OmniFormField>

        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Class="omni-u-mt-lg">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
        </OmniStack>
    </OmniTemplateForm></div>
}
