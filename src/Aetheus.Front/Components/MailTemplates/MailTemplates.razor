@page "/admin/mail-templates"

<PageTitle>@L["MailTemplates"] - Aetheus</PageTitle>

@* One main action (Save); restoring the default sits in the action menu. The test mail is the editor's own
   « Envoyer un essai » button: the draft goes to the server, which renders it and sends it to the signed-in
   administrator's address. *@
<OmniPageHeader Title="@L["MailTemplates"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("mail")" /></Icon>
    <ActionsContent>
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SaveAsync" Busy="@_saving" Disabled="@(!CanSave)" Class="mail-template-save"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
        <OmniOverflowMenu Label="@L["MoreActions"]" Disabled="@(_template is null || !_template.IsCustomized)" Class="mail-template-more">
            <OmniMenuItem OnClick="@ResetAsync"><Icon><OmniIcon Name="OmniIconName.Restore" /></Icon><ChildContent>@L["MailTemplateRestoreDefault"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    </ActionsContent>
</OmniPageHeader>

<OmniStack>
@* Owner decision 2026-10-28: a site Admin chooses between the platform's templates and one organization's own
   versions; an organization's administrator chooses among its organizations (hidden when it has one). *@
<AdministrationOrganizationSwitcher PermissionKey="@PermissionKeys.OrganizationMailTemplatesManage" OfferAll="@Auth.IsAdmin" AllLabelKey="MailTemplatesPlatform"
                                    ShowWithOneOrganization="@Auth.IsAdmin" Changed="@OnOrganizationChangedAsync" />
<OmniRow Gap="OmniSpacing.Large">
    <OmniColumn Span="12" MediumSpan="6">
        <OmniFormField Label="@L["MailTemplateKind"]" For="mail-template-kind" Help="@L["MailTemplateKindHelp"]" Class="omni-u-w-100">
            <OmniDropDown Id="mail-template-kind" Value="@_kind" ValueChanged="@((MailTemplateKind kind) => SelectAsync(kind, _language))"
                          ValueExpression="@(() => _kind)" Options="@_kinds" Class="omni-u-w-100" />
        </OmniFormField>
    </OmniColumn>
    <OmniColumn Span="12" MediumSpan="6">
        <OmniFormField Label="@L["MailTemplateLanguage"]" For="mail-template-language" Help="@L["MailTemplateLanguageHelp"]" Class="omni-u-w-100">
            <OmniDropDown Id="mail-template-language" Value="@_language" ValueChanged="@((string language) => SelectAsync(_kind, language))"
                          ValueExpression="@(() => _language)" Options="@_languages" Class="omni-u-w-100" />
        </OmniFormField>
    </OmniColumn>
</OmniRow>

@if (_loading && _template is null)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else if (_template is null)
{
    <OmniAlert Severity="OmniSeverity.Danger">
        @L["LoadFailed"]
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => SelectAsync(_kind, _language))"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["Retry"]</span></ChildContent></OmniButton>
    </OmniAlert>
}
else
{
    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="mail-template-state">
        <OmniBadge Icon="@(BadgeIcon.Of(_template.IsCustomized ? OmniIconName.Edit : OmniIconName.Document))" Fill="OmniFill.Tonal" Tone="@(_template.IsCustomized ? OmniTone.Info : OmniTone.Neutral)">@(_template.IsCustomized ? L["MailTemplateCustomized"] : L["MailTemplateDefault"])</OmniBadge>
        @if (StateText is { } state)
        {
            <OmniText Element="OmniTextElement.Span">@state</OmniText>
        }
    </OmniStack>

    <OmniMailTemplateEditor Id="mail-template-editor" @bind-Value="_body" @bind-Subject="_subject"
                            Variables="@_variables" Theme="@_theme" Label="@L["MailTemplateEditorLabel"]" Rows="16"
                            Disabled="@_loading" OnSendTest="@SendTestAsync" OnSendTestError="@OnSendTestError" />
}
</OmniStack>
