@page "/settings"
@page "/settings/{Tab}"

<PageTitle>@L["Settings"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["Settings"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("settings")" /></Icon>
</OmniPageHeader>

<OmniTabs Value="@TabNames[_selectedTabIndex]" ValueChanged="@OnTabChange">
        @* Each settings tab has an icon; display name is not editable here. *@
        <OmniTabsItem Key="appearance" Title="@L["Appearance"]"><Icon><OmniIcon Name="OmniIconName.Palette" /></Icon><ChildContent>
            @* Share stored appearance values with the user-menu Theme window through
               OE's OmniAppearanceState (bound, so the content width row Aetheus does not apply stays
               hidden). OE lays out full-width appearance settings, while language has
               a separate section. *@
            <div class="omni-u-mt-sm">
                <OmniSettingsSection Title="@L["AppearanceLook"]" Description="@L["AppearanceLookHint"]">
                    <OmniAppearanceSettings Appearance="Appearance.Appearance" AppearanceChanged="Appearance.SetAppearanceAsync"
                                            Preset="Appearance.Preset" PresetChanged="Appearance.SetPresetAsync"
                                            Palette="Appearance.Palette" PaletteChanged="Appearance.SetPaletteAsync"
                                            Font="Appearance.Font" FontChanged="Appearance.SetFontAsync"
                                            TextSizeLevel="Appearance.TextSizeLevel" TextSizeLevelChanged="Appearance.SetTextSizeLevelAsync"
                                            Density="Appearance.Density" DensityChanged="Appearance.SetDensityAsync"
                                            ControlSizeLevel="Appearance.ControlSizeLevel" ControlSizeLevelChanged="Appearance.SetControlSizeLevelAsync"
                                            BackdropMotion="Appearance.BackdropMotion" BackdropMotionChanged="Appearance.SetBackdropMotionAsync" />
                </OmniSettingsSection>
                <OmniSettingsSection Title="@L["Language"]">
                    <OmniSettingsTile Title="@L["Language"]">
                        <Icon><OmniIcon Name="OmniIconName.Globe" /></Icon>
                        <ChildContent>
                            <OmniDropDown Id="oe-formfield-pages-settings-settings-3" TValue="string" Value="@_language" ValueExpression="@(() => _language)" ValueChanged="@(value => OnLanguageChangedAsync(value))" Options="@(_languages.ToOptions(item => (string)item.Value, item => item.Label))" Label="@L["Language"]" Class="settings-appearance-select" />
                        </ChildContent>
                    </OmniSettingsTile>
                </OmniSettingsSection>
            </div>
        </ChildContent></OmniTabsItem>

        <OmniTabsItem Key="notifications" Title="@L["NotificationPreferences"]"><Icon><OmniIcon Name="OmniIconName.Bell" /></Icon><ChildContent>
            @* The notification panel supplies its own sections for event preferences and followed
               projects. *@
            <div class="omni-u-mt-sm">
                <Aetheus.Front.Components.Notifications.NotificationPreferencesPanel />
            </div>
        </ChildContent></OmniTabsItem>

        <OmniTabsItem Key="security" Title="@L["Security"]"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent>
            <OmniCard Class="omni-u-mt-sm">
                <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.Large" Class="settings-form">
                    <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["TwoFactorAuth"]</OmniHeading>

                    @if (_totpEnabled)
                    {
                        <OmniAlert Severity="OmniSeverity.Success">
                            <OmniIcon Name="OmniIconName.ShieldCheck" /> @L["TotpEnabled"]
                        </OmniAlert>
                        <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.Small">
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["TotpDisableHint"]</OmniText>
                            <OmniFormField Label="@L["Password"]" For="oe-formfield-pages-settings-settings-4">
                                <OmniPassword Id="oe-formfield-pages-settings-settings-4" @bind-Value="_disablePassword" Class="omni-u-w-100" />
                            </OmniFormField>
                            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@DisableTotp" Class="@("btn-fit" + (_totpBusy ? " btn-busy" : null))" Busy="@(_totpBusy)" title="@L["Disable2FA"]"><OmniIcon Name="OmniIconName.LockOpen" /> <span>@L["Disable"]</span></OmniButton>
                        </OmniStack>
                    }
                    else if (_totpSetup is not null)
                    {
                        <OmniAlert Severity="OmniSeverity.Info">
                            @L["TotpScanQR"]
                        </OmniAlert>
                        <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.Small" Align="OmniAlignment.Start">
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["TotpManualKey"]: <span class="omni-u-mono">@_totpSetup.SharedKey</span></OmniText>
                            <OmniFormField Label="@L["TotpVerifyCode"]" For="oe-formfield-pages-settings-settings-5">
                                <OmniTextBox Id="oe-formfield-pages-settings-settings-5" @bind-Value="_verifyCode" maxlength="6" Class="omni-u-w-100" />
                            </OmniFormField>
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@VerifyTotp" Class="@("btn-fit" + (_totpBusy ? " btn-busy" : null))" Busy="@(_totpBusy)"><OmniIcon Name="OmniIconName.Check" /> <span>@L["Verify"]</span></OmniButton>
                        </OmniStack>
                        @if (_totpSetup.RecoveryCodes.Count > 0)
                        {
                            <OmniAlert Severity="OmniSeverity.Warning">
                                @L["TotpSaveRecoveryCodes"]
                            </OmniAlert>
                            <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.XSmall" Class="recovery-codes">
                                @foreach (var rc in _totpSetup.RecoveryCodes)
                                {
                                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-mono">@rc</OmniText>
                                }
                            </OmniStack>
                        }
                    }
                    else
                    {
                        <OmniAlert Severity="OmniSeverity.Warning">
                            @L["TotpNotEnabled"]
                        </OmniAlert>
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SetupTotp" Class="@("btn-fit" + (_totpBusy ? " btn-busy" : null))" Busy="@(_totpBusy)" title="@L["Enable2FA"]"><OmniIcon Name="OmniIconName.ShieldCheck" /> <span>@L["Enable"]</span></OmniButton>
                    }
                </OmniStack>
            </OmniCard>

            <OmniCard Class="omni-u-mt-sm">
                <OmniTemplateForm TModel="PasswordChangeModel" Model="@_pwModel" OnValidSubmit="@ChangePassword">
                    <OmniDataAnnotationsValidator Localizer="@L" />
                    <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.Large" Class="settings-form">
                        <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["ChangePassword"]</OmniHeading>
                        <OmniFormField Label="@L["CurrentPassword"]" For="CurrentPassword">
                            <OmniPassword @bind-Value="_pwModel.CurrentPassword" Id="CurrentPassword" Class="omni-u-w-100" />
                            <ValidationMessage For="@(() => _pwModel.CurrentPassword)" />
                        </OmniFormField>
                        <OmniFormField Label="@L["NewPassword"]" For="NewPassword">
                            <OmniPassword @bind-Value="_pwModel.NewPassword" Id="NewPassword" Class="omni-u-w-100" />
                            <ValidationMessage For="@(() => _pwModel.NewPassword)" />
                        </OmniFormField>
                        <OmniFormField Label="@L["ConfirmPassword"]" For="ConfirmPassword">
                            <OmniPassword @bind-Value="_pwModel.ConfirmPassword" Id="ConfirmPassword" Class="omni-u-w-100" />
                            <ValidationMessage For="@(() => _pwModel.ConfirmPassword)" />
                        </OmniFormField>
                        <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@("btn-fit" + (_pwBusy ? " btn-busy" : null))" Busy="@(_pwBusy)"><OmniIcon Name="OmniIconName.LockKey" /> <span>@L["ChangePassword"]</span></OmniButton>
                    </OmniStack>
                </OmniTemplateForm>
            </OmniCard>
        </ChildContent></OmniTabsItem>

        <OmniTabsItem Key="tokens" Title="@L["PersonalAccessTokens"]"><Icon><OmniIcon Name="OmniIconName.Key" /></Icon><ChildContent>
            @if (_selectedTabIndex == 3)
            {
                <OmniCard Class="omni-u-mt-sm">
                    <PersonalAccessTokens />
                </OmniCard>
            }
        </ChildContent></OmniTabsItem>

        <OmniTabsItem Key="about" Title="@L["About"]"><Icon><OmniIcon Name="OmniIconName.Info" /></Icon><ChildContent>
            @* OE labelled lines, each with its icon (OmniDescriptionItem.Icon), as in a project
               overview's Information and Repository cards. *@
            <OmniCard Class="omni-u-mt-sm">
                <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0 omni-u-mb-md">@L["AboutAetheus"]</OmniHeading>
                <OmniDescriptionList>
                    <OmniDescriptionItem Label="@L["Version"]"><Icon><OmniIcon Name="OmniIconName.Tag" /></Icon><ChildContent>v@_version</ChildContent></OmniDescriptionItem>
                    <OmniDescriptionItem Label="@L["Username"]"><Icon><OmniIcon Name="OmniIconName.User" /></Icon><ChildContent>@_displayName</ChildContent></OmniDescriptionItem>
                    <OmniDescriptionItem Label="@L["Role"]"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent>@_userRole</ChildContent></OmniDescriptionItem>
                </OmniDescriptionList>
            </OmniCard>
        </ChildContent></OmniTabsItem>
</OmniTabs>

