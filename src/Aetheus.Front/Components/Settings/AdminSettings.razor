@inject GridExportContext ExportContext
@page "/admin/settings"

<PageTitle>@L["PlatformSettings"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["PlatformSettings"]" ShowBack="true" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("tune")" /></Icon>
</OmniPageHeader>

<UrlSyncedTabs Slugs="@(new[] { "general", "quality-gates", "secrets", "tokens" })">
    <Tabs>
        <OmniTabsItem Key="general" Title="@L["General"]">
            <OmniCard Class="omni-u-mt-sm">
                @foreach (var setting in _settings)
                {
                    <OmniRow Gap="OmniSpacing.Large" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                        <OmniColumn Span="12" MediumSpan="4">
                            <OmniLabel For="@($"platform-setting-{setting.Key}")">@L[setting.Key]</OmniLabel>
                        </OmniColumn>
                        <OmniColumn Span="12" MediumSpan="6">
                            <OmniTextBox Id="@($"platform-setting-{setting.Key}")" Value="@_editBuffer[setting.Key]"
                                ValueChanged="@(value => _editBuffer[setting.Key] = value)"
                                ValueExpression="@(() => setting.Value)" Class="omni-u-w-100" />
                        </OmniColumn>
                        <OmniColumn Span="12" MediumSpan="2">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => SaveSetting(setting.Key))" Class="@(_savingKeys.Contains(setting.Key) ? "btn-busy" : null)" Busy="@(_savingKeys.Contains(setting.Key))"><OmniIcon Name="OmniIconName.Save" /> <span>@L["Save"]</span></OmniButton>
                        </OmniColumn>
                    </OmniRow>
                }
            </OmniCard>
        </OmniTabsItem>

        <OmniTabsItem Key="quality-gates" Title="@L["QualityGates"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("rule"))" /></Icon><ChildContent>
            <QualityGatePolicyEditor Scope="AnalysisPolicyScope.Global" CanEdit="true" />
        </ChildContent></OmniTabsItem>

        <OmniTabsItem Key="secrets" Title="@L["Secrets"]">
            <OmniCard Class="omni-u-mt-sm">
                <OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.End" Class="omni-u-mb-lg">
                    <OmniFormField Label="@L["Key"]" For="oe-formfield-pages-settings-adminsettings-1">
                        <OmniTextBox Id="oe-formfield-pages-settings-adminsettings-1" @bind-Value="_newSecretKey" />
                    </OmniFormField>
                    <OmniFormField Label="@L["Value"]" For="oe-formfield-pages-settings-adminsettings-2">
                        <OmniPassword Id="oe-formfield-pages-settings-adminsettings-2" @bind-Value="_newSecretValue" />
                    </OmniFormField>
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@AddSecret"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Add"]</span></OmniButton>
                </OmniRow>

                <OmniDataGrid FillAvailableHeight="true" Items="@_secrets" ExportTitle="@ExportContext.Title(L["Secrets"])" ExportFields="@ExportContext.Fields()" TItem="SecretDto" EmptyText="@L["NoRecords"]" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
                    <Columns>
                        <OmniDataGridColumn Frozen="true" TItem="SecretDto" Property="Key" Title="@L["Key"]" Filterable="true" />
                        <OmniDataGridColumn TItem="SecretDto" Title="@L["Value"]" Width="12.5rem" Sortable="false">
                            <Template Context="secret">
                                <OmniText Element="OmniTextElement.Paragraph">--------</OmniText>
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="SecretDto" Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
                        <OmniDataGridColumn TItem="SecretDto" Title="" Width="6.25rem" Sortable="false">
                            <Template Context="secret">
                                <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteSecret(secret.Id))" title="@L["DeleteSecret"]" Label="@L["DeleteSecret"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                            </Template>
                        </OmniDataGridColumn>
                    </Columns>
                </OmniDataGrid>
            </OmniCard>
        </OmniTabsItem>

        <OmniTabsItem Key="tokens" Title="@L["RegistrationTokens"]">
            <OmniCard Class="omni-u-mt-sm">
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@GenerateToken" Class="omni-u-mb-lg" title="@L["GenerateToken"]"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Generate"]</span></OmniButton>

                <OmniDataGrid @ref="_tokensGrid" ExportMarkdown="false" FillAvailableHeight="true" Items="@_tokens" TItem="RegistrationTokenDto" KeyOf="@(row => row.Id)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" EmptyText="@L["NoRecords"]" Class="aetheus-grid-fullheight" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
                    <Columns>
                        <OmniDataGridColumn Frozen="true" TItem="RegistrationTokenDto" Property="Token" Title="@L["Token"]" Filterable="true">
                            <Template Context="t">
                                @if (_revealedTokens.Contains(t.Id))
                                {
                                    <code class="token-code">@t.Token</code>
                                }
                                else
                                {
                                    <code class="token-code">----------------</code>
                                }
                                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ToggleTokenReveal(t.Id))" title="@(_revealedTokens.Contains(t.Id) ? L["HideToken"].Value : L["ShowToken"].Value)" Label="@(_revealedTokens.Contains(t.Id) ? L["HideToken"].Value : L["ShowToken"].Value)"><OmniIcon Name="@MaterialIconMap.Resolve((_revealedTokens.Contains(t.Id) ? "visibility_off" : "visibility"))" /></OmniButton>
                                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => CopyToken(t.Token))" title="@L["CopyToken"]" Label="@L["CopyToken"]"><OmniIcon Name="OmniIconName.Copy" /></OmniButton>
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="RegistrationTokenDto" Property="IsUsed" Title="@L["Used"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@UsedText">
                            <Template Context="t">
                                <OmniBadge Fill="OmniFill.Solid" Tone="@(t.IsUsed ? OmniTone.Neutral : OmniTone.Success)">@(t.IsUsed ? L["Used"].Value : L["Available"].Value)</OmniBadge>
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="RegistrationTokenDto" Property="ExpiresAt" Title="@L["Expires"]" FormatString="{0:g}" Width="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
                    </Columns>
                </OmniDataGrid>
            </OmniCard>
        </OmniTabsItem>
    </Tabs>
</UrlSyncedTabs>
