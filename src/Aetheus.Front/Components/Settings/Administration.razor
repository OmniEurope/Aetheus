@page "/admin"

<PageTitle>@L["Administration"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["Administration"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("admin_panel_settings")" /></Icon>
</OmniPageHeader>

@* Group administration tiles by purpose and keep one entry per administration menu destination
   with matching icon and title. *@
@* R-14: the groups are separated by this stack's gap, each title stays with its tiles in a smaller one. *@
<OmniStack Gap="OmniSpacing.Large">
@foreach (var group in Shown)
{
    <OmniStack Gap="OmniSpacing.Small">
    <OmniHeading Level="OmniHeadingLevel.H5">@L[group.TitleKey]</OmniHeading>
    @* R1-20: OE navigation tiles in an OE tile grid (same size, the whole tile one link). *@
    <OmniTileGrid Columns="4" Gap="OmniSpacing.Small">
        @foreach (var tile in group.Tiles)
        {
            <OmniNavTile Href="@tile.Href" Title="@L[tile.TitleKey]" Description="@L[tile.DescriptionKey]">
                <Icon><OmniIcon Name="@MaterialIconMap.Resolve(tile.Icon)" /></Icon>
            </OmniNavTile>
        }
    </OmniTileGrid>
    </OmniStack>
}
</OmniStack>
