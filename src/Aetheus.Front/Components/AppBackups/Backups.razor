@page "/backups"
@using Microsoft.AspNetCore.Components.Sections

@if (!ProjectId.HasValue)
{
    <PageTitle>@L["Backups"] - Aetheus</PageTitle>
    <OmniPageHeader Title="@L["Backups"]" Subtitle="@Breadcrumb.Subtitle()">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("backup")" /></Icon>
        <ActionsContent>
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@NewPolicy"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
        </ActionsContent>
    </OmniPageHeader>
}
else
{
    @* Inside a project the main action sits in the project header, on the title line. *@
    <SectionContent SectionName="@PageHeaderActions.SectionName">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@NewPolicy"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
    </SectionContent>
}

<OmniStack Class="page-fill-body">
<OmniText Element="OmniTextElement.Paragraph">@L["BackupPageDescription"]</OmniText>

<OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
    <OmniTextBox aria-label="@L["Search"]" @bind-Value="_policySearch" @bind-Value:after="ResetPoliciesAsync"
        Placeholder="@L["Search"]" Class="pipeline-list-search" />
</OmniStack>

@if (_form is not null)
{
    <OmniCard>
        <OmniTemplateForm TModel="PolicyForm" Model="@_form" OnValidSubmit="@SaveAsync">
            <OmniDataAnnotationsValidator Localizer="@L" />
            <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Large">
                <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@(_form.Id == 0 ? L["BackupNewPolicy"] : L["BackupEditPolicy"])</OmniHeading>
                <OmniRow Gap="OmniSpacing.Large" Align="OmniAlignment.Start">
                    <OmniFormField For="oe-pages-backups-backups-1"><LabelContent>@L["BackupName"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_form.Name" maxlength="120" Id="oe-pages-backups-backups-1" />
                        <ValidationMessage For="@(() => _form.Name)" />
                    </ChildContent></OmniFormField>
                    @if (!ProjectId.HasValue)
                    {
                        <OmniFormField Label="@L["Project"]" For="oe-formfield-pages-backups-backups-1">
                            <OmniDropDown Id="oe-formfield-pages-backups-backups-1" TValue="int" @bind-Value="_form.ProjectId" Options="@(_projects.ToOptions(item => (int)item.Id, item => item.Name))" Disabled="@(_form.Id != 0)" />
                            <ValidationMessage For="@(() => _form.ProjectId)" />
                        </OmniFormField>
                    }
                    <OmniFormField Label="@L["Server"]" For="oe-formfield-pages-backups-backups-2">
                        <OmniDropDown Id="oe-formfield-pages-backups-backups-2" TValue="int" @bind-Value="_form.ServerId" Options="@(_servers.ToOptions(item => (int)item.Id, item => item.Name))" Disabled="@(_form.Id != 0)" />
                        <ValidationMessage For="@(() => _form.ServerId)" />
                    </OmniFormField>
                    <OmniFormField Label="@L["BackupEngine"]" For="oe-formfield-pages-backups-backups-3">
                        <OmniDropDown Id="oe-formfield-pages-backups-backups-3" TValue="BackupDbEngine" @bind-Value="_form.DbEngine" Options="@(_engineOptions.ToOptions(item => (BackupDbEngine)item.Value, item => item.Text))" />
                    </OmniFormField>
                </OmniRow>

                @if (_form.DbEngine != BackupDbEngine.None)
                {
                    <OmniRow Gap="OmniSpacing.Large" Align="OmniAlignment.Start">
                        <OmniFormField For="oe-pages-backups-backups-5"><LabelContent>@L["BackupDbHost"]</LabelContent><ChildContent>
                            <OmniTextBox @bind-Value="_form.DbHost" maxlength="255" Id="oe-pages-backups-backups-5" />
                        </ChildContent></OmniFormField>
                        <OmniFormField For="oe-pages-backups-backups-numeric-1"><LabelContent>@L["BackupDbPort"]</LabelContent><ChildContent><OmniNumeric TValue="int?" @bind-Value="_form.DbPort" Minimum="1" Maximum="65535" Id="oe-pages-backups-backups-numeric-1" /></ChildContent></OmniFormField>
                        <OmniFormField For="oe-pages-backups-backups-7"><LabelContent>@L["BackupDbName"]</LabelContent><ChildContent>
                            <OmniTextBox @bind-Value="_form.DbName" maxlength="120" Id="oe-pages-backups-backups-7" />
                        </ChildContent></OmniFormField>
                        <OmniFormField For="oe-pages-backups-backups-8"><LabelContent>@L["BackupDbUser"]</LabelContent><ChildContent>
                            <OmniTextBox @bind-Value="_form.DbUser" maxlength="120" Id="oe-pages-backups-backups-8" />
                        </ChildContent></OmniFormField>
                        <OmniFormField Label="@(_form.Id == 0 ? L["BackupDbPassword"] : L["BackupDbPasswordKeep"])" For="oe-formfield-pages-backups-backups-4">
                            <OmniPassword Id="oe-formfield-pages-backups-backups-4" @bind-Value="_form.DbPassword" />
                        </OmniFormField>
                    </OmniRow>
                }

                <OmniFormField For="oe-pages-backups-backups-10"><LabelContent>@L["BackupFilePaths"]</LabelContent><ChildContent>
                    <OmniTextArea @bind-Value="_form.FilePathsText" Rows="3" Id="oe-pages-backups-backups-10" />
                </ChildContent></OmniFormField>

                <OmniRow Gap="OmniSpacing.Large" Align="OmniAlignment.Start">
                    <OmniFormField For="oe-pages-backups-backups-11"><LabelContent>@L["BackupScheduleCron"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_form.ScheduleCron" maxlength="120" Id="oe-pages-backups-backups-11" />
                        <ValidationMessage For="@(() => _form.ScheduleCron)" />
                    </ChildContent></OmniFormField>
                    <OmniFormField For="oe-pages-backups-backups-numeric-2"><LabelContent>@L["BackupRetention"]</LabelContent><ChildContent><OmniNumeric TValue="int" @bind-Value="_form.RetentionCount" Minimum="1" Maximum="365" Id="oe-pages-backups-backups-numeric-2" /></ChildContent></OmniFormField>
                    <OmniFormField For="oe-pages-backups-backups-13"><LabelContent>@L["BackupRestoreCheckCron"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_form.RestoreCheckCron" maxlength="120" Id="oe-pages-backups-backups-13" />
                    </ChildContent></OmniFormField>
                    @if (_form.Id != 0)
                    {
                        <OmniSwitch @bind-Value="_form.Enabled">@L["BackupEnabled"]</OmniSwitch>
                    }
                </OmniRow>

                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small">
                    <OmniButton Busy="@_saving" ButtonType="OmniButtonType.Submit" Variant="OmniButtonVariant.Primary"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@CancelForm"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@L["GoBack"]</span></ChildContent></OmniButton>
                </OmniStack>
            </OmniStack>
        </OmniTemplateForm>
    </OmniCard>
}

<AetheusDataGrid @ref="_policyGrid" RowClick="@(policy => EditPolicy(policy))" Data="@_policies" TItem="BackupPolicyDto"
    Count="@_policiesTotalCount" IsLoading="@_loading" LoadData="@OnLoadPoliciesAsync" ExportRead="@ReadPoliciesExportAsync"
    PageSize="25" Density="OmniDensity.Compact" FullHeight="true"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<BackupPolicyDto>(_policies, _policiesTotalCount))">
    <EmptyTemplate>
        <EmptyState Icon="backup" Title="@L["BackupEmptyTitle"]" Description="@L["BackupEmptyDescription"]" />
    </EmptyTemplate>
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="BackupPolicyDto" Property="Name" Title="@L["BackupName"]" Filterable="true" />
        @if (!ProjectId.HasValue)
        {
            <OmniDataGridColumn TItem="BackupPolicyDto" Key="ProjectName" ExportValue="@ProjectExport" Title="@L["Project"]" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_projectNames" FilterSearchable="true" >
                <Template Context="p"><EntityNameLink Kind="EntityNameKind.Project" Id="p.ProjectId" Name="@ProjectName(p.ProjectId)" /></Template>
            </OmniDataGridColumn>
        }
        <OmniDataGridColumn TItem="BackupPolicyDto" Key="ServerName" ExportValue="@ServerExport" Title="@L["Server"]" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_serverNames" FilterSearchable="true" >
            <Template Context="p"><EntityNameLink Kind="EntityNameKind.Server" Id="p.ServerId" Name="@ServerName(p.ServerId)" /></Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="BackupPolicyDto" Property="DbEngine" Title="@L["BackupEngine"]" Width="120px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@EngineText" >
            <Template Context="p">@L.Localize(p.DbEngine)</Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="BackupPolicyDto" Property="ScheduleCron" Title="@L["BackupScheduleCron"]" Width="140px" Filterable="true" />
        <OmniDataGridColumn TItem="BackupPolicyDto" Property="RetentionCount" Title="@L["BackupRetention"]" Width="110px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="BackupPolicyDto" Property="LastRunAt" Title="@L["BackupLastRun"]" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" >
            <Template Context="p">@(p.LastRunAt?.ToString("g") ?? L["BackupNever"])</Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="BackupPolicyDto" Property="Enabled" Title="@L["BackupEnabled"]" Width="110px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@EnabledText" >
            <Template Context="p">
                <OmniBadge Icon="@(BadgeIcon.ForState(p.Enabled ? OmniTone.Success : OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="@(p.Enabled ? OmniTone.Success : OmniTone.Neutral)">@(p.Enabled ? L["BackupEnabledYes"] : L["BackupEnabledNo"])</OmniBadge>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="BackupPolicyDto" Title="@L["Actions"]" Sortable="false" Filterable="false" >
            <Template Context="p">
                <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => RunNowAsync(p))" title="@L["BackupRunNow"]" Label="@L["BackupRunNow"]"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon></OmniButton>
                    <OmniOverflowMenu Label="@L["MoreActions"]">
                        <OmniMenuItem OnClick="@(() => ShowRunsAsync(p))"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent>@L["BackupRuns"]</ChildContent></OmniMenuItem>
                        <OmniMenuItem OnClick="@(() => EditPolicy(p))"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent>@L["Edit"]</ChildContent></OmniMenuItem>
                        <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => DeletePolicyAsync(p))"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["Delete"]</ChildContent></OmniMenuItem>
                    </OmniOverflowMenu>
                </OmniStack>
                </span>
            </Template>
        </OmniDataGridColumn>
    </Columns>
</AetheusDataGrid>

@if (_runsFor is not null)
{
    <OmniHeading Level="OmniHeadingLevel.H5">@string.Format(L["BackupRunsFor"], _runsFor.Name)</OmniHeading>
    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
        <OmniTextBox aria-label="@L["Search"]" @bind-Value="_runsSearch" @bind-Value:after="ResetRunsAsync"
            Placeholder="@L["Search"]" Class="pipeline-list-search" />
    </OmniStack>
    <AetheusDataGrid @ref="_runsGrid" Data="@_runs" TItem="BackupRunDto"
        Count="@_runsTotalCount" IsLoading="@_runsLoading" LoadData="@OnLoadRunsAsync" ExportRead="@ReadRunsExportAsync" ExportName="@L["BackupRuns"]"
        Density="OmniDensity.Compact" PageSize="10"
        Virtualize="@AetheusGrid.RemoteVirtualization"
        VirtualData="@(() => new OmniDataGridResult<BackupRunDto>(_runs, _runsTotalCount))">
        <EmptyTemplate>
            <EmptyState Icon="history" Title="@L["BackupNoRuns"]" Description="@L["BackupNoRunsDescription"]" />
        </EmptyTemplate>
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="BackupRunDto" Property="StartedAt" Title="@L["BackupStartedAt"]" Width="170px" FormatString="{0:g}" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" />
            <OmniDataGridColumn TItem="BackupRunDto" Property="Status" Title="@L["BackupStatus"]" Width="120px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@RunStatusText" >
                <Template Context="r"><OmniBadge Icon="@(BadgeIcon.ForState(RunStatusStyle(r.Status)))" Fill="OmniFill.Solid" Tone="@RunStatusStyle(r.Status)">@L.Localize(r.Status)</OmniBadge></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="BackupRunDto" Property="RestoreCheckStatus" Title="@L["BackupRestoreCheck"]" Width="150px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@RestoreText" >
                <Template Context="r"><OmniBadge Icon="@(BadgeIcon.ForState(RestoreStyle(r.RestoreCheckStatus)))" Fill="OmniFill.Solid" Tone="@RestoreStyle(r.RestoreCheckStatus)">@RestoreLabel(r.RestoreCheckStatus)</OmniBadge></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="BackupRunDto" Property="SizeBytes" Title="@L["BackupSize"]" Width="110px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
            <OmniDataGridColumn TItem="BackupRunDto" Property="Message" Truncate="true" Title="@L["BackupMessage"]" Filterable="true" />
        </Columns>
    </AetheusDataGrid>
}
</OmniStack>
