@page "/environments/new"
@page "/environments/{Id:int}"

<PageTitle>@(_isNew ? L["NewEnvironment"] : _detail?.Name ?? L["Environment"]) - Aetheus</PageTitle>

<OmniPageHeader Title="@(_isNew ? L["NewEnvironment"] : _detail?.Name ?? "")" ShowBack="true" BackHref="@LocalReturnUrl.Validated(ReturnUrl)" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("layers")" /></Icon>
    <Badges>
        @if (!_isNew && _detail is not null)
        {
            <OmniBadge Icon="@(BadgeIcon.For(TypeStyle(_detail.Type)))" Fill="OmniFill.Solid" Tone="@TypeStyle(_detail.Type)">@L.Localize(_detail.Type)</OmniBadge>
            <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@string.Format(L["ServersCount"], _detail.Servers.Count)</NumberBadge>
        }
    </Badges>
    <ActionsContent>
        @if (!_isNew)
        {
            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@OnDelete"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent><span>@L["Delete"]</span></ChildContent></OmniButton>
        }
    </ActionsContent>
</OmniPageHeader>

@if (!_isNew && _notFound)
{
    <OmniAlert Severity="OmniSeverity.Warning">@L["EnvironmentNotFound"]</OmniAlert>
}
else if (!_isNew && _loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger">@L["LoadFailed"]</OmniAlert>
}
else if (!_isNew && _detail is null)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else
{
    <OmniStack>
    <OmniTemplateForm TModel="EnvironmentModel" Model="@_model" OnValidSubmit="@OnSubmit">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniStack>
        @if (_isNew)
        {
            @* R-69: a plain card like the dashboard's, its title an H5 beside an icon of the usual size. *@
            <OmniCard data-testid="environment-copy-source">
                <OmniRow Gap="OmniSpacing.Large" Align="OmniAlignment.Center">
                    <OmniColumn Span="12" MediumSpan="5">
                        <OmniStack Gap="OmniSpacing.XSmall">
                            <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                                <OmniIcon Name="OmniIconName.Copy" Class="omni-u-text-accent" />
                                <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["StartFromExistingEnvironment"]</OmniHeading>
                            </OmniStack>
                            <OmniText Element="OmniTextElement.Paragraph" Class="environment-copy-source__hint">
                                @L["StartFromExistingEnvironmentHint"]
                            </OmniText>
                        </OmniStack>
                    </OmniColumn>
                    <OmniColumn Span="12" MediumSpan="7">
                        <OmniFormField Label="@L["SourceEnvironment"]" Class="omni-u-w-100" For="oe-formfield-pages-environments-environmentedit-1">
                            <OmniDropDown Id="oe-formfield-pages-environments-environmentedit-1" TValue="int?" Options="@CopySourceOptions"
                                Value="@_sourceEnvironmentId" ValueChanged="@(value => OnSourceEnvironmentChanged(value))"
                                ValueExpression="@(() => _sourceEnvironmentId)"
                                AllowEmpty="true" Filterable="true"
                                Placeholder="@L["CreateEnvironmentFromScratch"]" Class="omni-u-w-100" />
                        </OmniFormField>
                    </OmniColumn>
                </OmniRow>
            </OmniCard>
        }
        <OmniRow Gap="OmniSpacing.Large">
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField Label="@L["Name"]" For="Name">
                        <OmniTextBox @bind-Value="_model.Name"

                            Id="Name" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </OmniFormField>
                    <OmniFormField Label="@L["Description"]" For="Description">
                        <OmniTextArea @bind-Value="_model.Description"

                            Id="Description" Rows="3" />
                    </OmniFormField>
                    <OmniFormField Label="@L["Type"]" For="oe-formfield-pages-environments-environmentedit-4">
                        <OmniDropDown Id="oe-formfield-pages-environments-environmentedit-4" TValue="EnvironmentType" Options="@(_typeOptions.ToOptions(item => (EnvironmentType)item.Value, item => item.Text))" @bind-Value="_model.Type" />
                    </OmniFormField>
                </OmniStack>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniFormField Label="@L["Project"]" For="oe-formfield-pages-environments-environmentedit-5">
                        <OmniDropDown Id="oe-formfield-pages-environments-environmentedit-5" TValue="int?" Options="@(_projects.ToOptions(item => (int?)item.Id, item => item.Name))"
                            @bind-Value="_model.ProjectId" AllowEmpty="true" Placeholder="@L["NoProject"]" />
                    </OmniFormField>
                    <OmniSwitch @bind-Value="_model.RequireApproval">@L["RequireApproval"]</OmniSwitch>

                    @if (_model.RequireApproval)
                    {
                        <OmniFormField For="oe-pages-environments-environmentedit-numeric-1"><LabelContent>@L["ApprovalTimeoutMinutes"]</LabelContent><ChildContent><OmniNumeric TValue="int" @bind-Value="_model.ApprovalTimeoutMinutes" Minimum="1" Maximum="10080" Id="oe-pages-environments-environmentedit-numeric-1" /></ChildContent></OmniFormField>
                        <OmniFormField Label="@L["ApprovalInstructions"]" Help="@L["ApprovalInstructionsHelp"]" Id="ApprovalInstructionsField" For="ApprovalInstructions">
                            <OmniTextArea @bind-Value="_model.ApprovalInstructions"

                                Id="ApprovalInstructions" Rows="2" AriaDescribedBy="ApprovalInstructionsField-help-content" />
                        </OmniFormField>
                    }
                    <OmniSwitch @bind-Value="_model.DastEnabled">@L["DastEnabled"]</OmniSwitch>
                    @if (_model.DastEnabled)
                    {
                        <OmniSwitch @bind-Value="_model.DastIsEphemeral">@L["DastEphemeral"]</OmniSwitch>
                        <OmniSwitch @bind-Value="_model.DastContainsRealData">@L["DastContainsRealData"]</OmniSwitch>
                        <OmniFormField Label="@L["DastAllowedHosts"]" Help="@L["DastAllowedHostsHelp"]" Id="DastAllowedHostsField" For="DastAllowedHosts">
                            <OmniTextArea @bind-Value="_model.DastAllowedHosts"

                                Id="DastAllowedHosts" AriaDescribedBy="DastAllowedHostsField-help-content" Rows="3" Placeholder="@L["PlaceholderAllowedHosts"]" />
                        </OmniFormField>
                    }
                </OmniStack>
            </OmniColumn>
        </OmniRow>

        <OmniHeading Level="OmniHeadingLevel.H5">@L["Servers"]</OmniHeading>
        <OmniMultiSelect aria-label="@L["Servers"]" TValue="int"
                         Value="@_model.ServerIds"
                         ValueChanged="@(values => _model.ServerIds = values)"
                         ValueExpression="@(() => _model.ServerIds)"
                         Options="@_servers.Select(server => new OmniOption<int>(server.Id, server.Name)).ToArray()"
                         Filterable="true"
                         Placeholder="@L["SelectServers"]"
                         Class="omni-u-w-100" />

        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_isNew ? "add" : "save"))" /></Icon><ChildContent><span>@(_isNew ? L["Create"] : L["Save"])</span></ChildContent></OmniButton>
        </OmniStack>
        </OmniStack>
    </OmniTemplateForm>
    @* R-18: only a production environment carries the database's expand/contract tracking. *@
    @if (!_isNew && _detail is { Type: EnvironmentType.Production } production)
    {
        <EnvironmentSchemaTracking EnvironmentId="@production.Id" />
    }
    </OmniStack>
}
