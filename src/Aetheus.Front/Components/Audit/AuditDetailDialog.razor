<OmniStack>
    @* Server-verified hash-chain integrity for this entry (never an optimistic default).
       Recette R-116: while it is verified, OE's busy veil lies over the card, no loader beside the wording. *@
    <OmniCard Class="@(_verifying ? "omni-busy" : null)" aria-busy="@(_verifying ? "true" : "false")">
        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            @if (_verifying)
            {
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["AuditVerifying"]</OmniText>
            }
            else if (_verification is null)
            {
                <OmniIcon Name="OmniIconName.Question" Class="omni-u-text-muted" />
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["AuditIntegrityUnavailable"]</OmniText>
            }
            else if (_verification.IsValid)
            {
                <OmniIcon Name="OmniIconName.ShieldCheck" Class="omni-u-text-success" />
                <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Success))" Fill="OmniFill.Solid" Tone="OmniTone.Success">@L["AuditChainIntact"]</OmniBadge>
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">
                    @string.Format(L["AuditVerifiedThrough"], _verification.TotalEntries)
                </OmniText>
            }
            else
            {
                <OmniIcon Name="OmniIconName.ShieldSlash" Class="omni-u-text-danger" />
                <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Danger))" Fill="OmniFill.Solid" Tone="OmniTone.Danger">@L["AuditChainBroken"]</OmniBadge>
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">
                    @string.Format(L["AuditBreakAt"], _verification.FirstInvalidId)
                </OmniText>
            }
        </OmniStack>
    </OmniCard>

    @* Structured facts: actor, action, target, time. *@
    <OmniStack Gap="OmniSpacing.Small">
        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.User" Class="run-tile-icon" /> @L["Actor"]</OmniText>
            <OmniText Element="OmniTextElement.Paragraph">@Log.Username</OmniText>
        </OmniStack>
        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Lightning" Class="run-tile-icon" /> @L["Action"]</OmniText>
            <OmniBadge Icon="@(BadgeIcon.For(ActionBadge))" Fill="OmniFill.Solid" Tone="@ActionBadge">@ActionLabel</OmniBadge>
        </OmniStack>
        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Target" Class="run-tile-icon" /> @L["Target"]</OmniText>
            <OmniText Element="OmniTextElement.Paragraph" Class="text-mono">@Log.EntityType@(Log.EntityId.HasValue ? $" #{Log.EntityId}" : string.Empty)</OmniText>
        </OmniStack>
        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted"><OmniIcon Name="OmniIconName.Timer" Class="run-tile-icon" /> @L["Timestamp"]</OmniText>
            <OmniText Element="OmniTextElement.Paragraph">@Log.Timestamp.ToString("G")</OmniText>
        </OmniStack>
    </OmniStack>

    @if (!string.IsNullOrWhiteSpace(Log.Details))
    {
        <OmniCodeBlock Code="@FormattedDetails" Title="@L["Details"]" Wrap="true" Class="code-block-bounded code-block-tall" />
    }

    <DialogFooter CancelText="@L["Close"]" OnCancel="Close">
        <SecondaryContent>
            @if (!string.IsNullOrWhiteSpace(Log.Details))
            {
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="CopyAsync" title="@L["Copy"]" Label="@L["Copy"]"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon></OmniButton>
            }
        </SecondaryContent>
    </DialogFooter>
</OmniStack>
