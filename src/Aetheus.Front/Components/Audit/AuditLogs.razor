@page "/admin/audit"
@page "/audit"

<PageTitle>@L["AuditLogs"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["AuditLogs"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("policy")" /></Icon>
    <Badges>
        <HelpLink PageKey="audit" />
    </Badges>
    <ActionsContent>
        @if (_chainResult is not null)
        {
            <NumberBadge Fill="OmniFill.Solid" Tone="@(_chainResult.IsValid ? OmniTone.Success : OmniTone.Danger)">@(_chainResult.IsValid ? string.Format(L["AuditChainIntactCount"], _chainResult.TotalEntries) : string.Format(L["AuditBreakAt"], _chainResult.FirstInvalidId))</NumberBadge>
        }
        else if (_chainChecked)
        {
            <OmniBadge Icon="@(BadgeIcon.ForState(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L["AuditIntegrityUnavailable"]</OmniBadge>
        }
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@VerifyChainAsync" Class="@(_verifyingChain ? "btn-busy" : null)" Busy="@(_verifyingChain)"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent><span>@L["AuditVerifyChain"]</span></ChildContent></OmniButton>
        @* No Refresh, new entries arrive over the admin hub. *@
    </ActionsContent>
</OmniPageHeader>
<AetheusDataGrid @ref="_grid" TItem="AuditLogDto" RowClick="@(log => ShowDetailsDialogAsync(log))" Data="@_logs" Count="@_count" LoadData="@LoadData" ExportRead="@ReadExportAsync"
    PageSize="20" AllowSorting="true" IsLoading="@_loading" Density="OmniDensity.Compact" FullHeight="true"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<AuditLogDto>(_logs, _count))">
    <Columns>
        @* Send all column header filters, including the date range, to the server. *@
        <OmniDataGridColumn Frozen="true" TItem="AuditLogDto" Property="Timestamp" Title="@L["Timestamp"]" Width="180px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" >
            <Template Context="log">
                <span title="@log.Timestamp.ToString("F")">@RelativeTime.FormatAgo(L, log.Timestamp)</span>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="AuditLogDto" Property="Username" Title="@L["User"]" Filterable="true" />
        <OmniDataGridColumn TItem="AuditLogDto" Property="Action" Title="@L["Action"]" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_actionOptions" FormatFilterValue="@ActionText" FilterSearchable="true" >
            <Template Context="log">
                <OmniBadge Icon="@(BadgeIcon.For(AuditActionPresentation.Badge(log.Action)))" Fill="OmniFill.Solid" Tone="@AuditActionPresentation.Badge(log.Action)">@ActionText(log.Action)</OmniBadge>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="AuditLogDto" Property="EntityType" Title="@L["EntityType"]" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_entityOptions" FilterSearchable="true" />
        <OmniDataGridColumn TItem="AuditLogDto" Property="EntityId" Title="@L["ID"]" Width="80px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="AuditLogDto" Title="@L["Actions"]" Sortable="false" Filterable="false">
            <Template Context="log">
                <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ShowDetailsDialogAsync(log))" title="@L["ViewDetails"]" Label="@L["ViewDetails"]"><Icon><OmniIcon Name="OmniIconName.Eye" /></Icon></OmniButton>
                @if (!string.IsNullOrWhiteSpace(log.Details))
                {
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => CopyDetailsAsync(log.Details))" title="@L["CopyDetails"]" Label="@L["CopyDetails"]"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon></OmniButton>
                }
                </span>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="AuditLogDto" Property="Details" Truncate="true" Title="@L["Details"]" Filterable="true" />
    </Columns>
</AetheusDataGrid>
