@* Recette R2-052: what a grade is made of, domain by domain and measure by measure (observed value, its
   letter, how far the next letter is). It was drawn only on the project's Quality page; a run's Quality
   tab showed a B over "0 findings" and nothing else, because a measure is often a metric (coverage,
   duplication, complexity, a dependency cycle) with no finding behind it. Both pages now draw this. *@
@if (Grade is not null)
{
    @if (ShowLimitingDomain && Grade.LimitingDomain is { } limiting && Grade.Completeness != AnalysisGradeCompleteness.Incomplete)
    {
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-mb-sm analysis-grade-limiting">@L["AnalysisLimitingDomain"]: @DomainLabel(L, limiting)</OmniText>
    }
    @* Recette R-176: two wide columns, one line per measure (label, value, grade); a domain with nothing
       to show is a compact muted line after the cards. *@
    <div class="analysis-grade-domains">
        @foreach (var domain in Domains.Where(HasDetails))
        {
            <section class="analysis-grade-domain">
                <div class="analysis-grade-domain-heading">
                    <span>@domain.Label</span>
                    <GradeBadge Value="@domain.Grade" />
                </div>
                <div class="analysis-grade-domain-state">
                    @DomainState(domain)
                </div>
                @foreach (var measure in domain.Measures)
                {
                    <div class="analysis-grade-measure">
                        <span class="analysis-grade-measure-label" title="@($"{MeasureLabel(measure.Key)} ({measure.Key})")">@MeasureLabel(measure.Key)</span>
                        <span class="analysis-grade-value">@MeasureText(measure)</span>
                        <GradeBadge Value="@measure.Grade" />
                        @if (measure.DistanceToNextGrade.HasValue && measure.NextGrade.HasValue)
                        {
                            <small class="analysis-grade-measure-hint">@L["AnalysisDistanceToGrade", measure.DistanceToNextGrade.Value.ToString("0.##"), measure.NextGrade]</small>
                        }
                        @* Recette R2-119: a weighted score says what it is made of, the open findings by
                           severity and the weight of each. *@
                        @if (measure.FindingCounts is { } counts)
                        {
                            <small class="analysis-grade-measure-hint">@FindingCountsText(counts)</small>
                            @if (counts.Critical > 0)
                            {
                                <small class="analysis-grade-measure-hint">@L["AnalysisCriticalFindingNotDeliverable"]</small>
                            }
                        }
                    </div>
                }
                @if (domain.CrapScore.HasValue)
                {
                    <div class="analysis-grade-measure" title="@L["AnalysisCrapExplanation"]">
                        <span class="analysis-grade-measure-label">@L["AnalysisCrapAverage"]</span>
                        <span class="analysis-grade-value">@domain.CrapScore.Value.ToString("0.0")</span>
                        <strong aria-label="@L["AnalysisAdvisory"]">–</strong>
                    </div>
                }
            </section>
        }
    </div>
    @foreach (var domain in Domains.Where(domain => !HasDetails(domain)))
    {
        <div class="analysis-grade-domain-empty">
            <span class="analysis-grade-measure-label">@domain.Label</span>
            <span class="analysis-grade-domain-state">@DomainState(domain)</span>
            <GradeBadge Value="@domain.Grade" />
        </div>
    }
}
