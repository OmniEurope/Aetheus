@* Show domain and measure breakdowns on both project and run Quality pages. Metrics such as
   coverage or complexity can affect a grade without producing findings. *@
@if (GateRow && (Grade is not null || GateGrade is not null))
{
    @* R1-38: one block, one style. The Gate grade first, then code quality and tests, security and
       architecture, each domain followed by its measures; every line explains its criterion in a tooltip
       and opens its detail on a click. *@
    <OmniAccordion Multiple="true" Level="OmniHeadingLevel.H4" Class="analysis-grade-block" data-testid="analysis-grade-block">
        <AnalysisGradeRow Kind="gate" TestId="grade-row-gate" Label="@L["GateGrade"]" Tooltip="@L["AnalysisCriterionGate"]"
                          Grade="@GateGrade">
            <Hints>
                @if (GateCause is { } cause)
                {
                    @* Mockup R1-37: the cause reads under the label, not in the value column. *@
                    <small class="analysis-grade-measure-hint" data-testid="grade-row-gate-cause">@L["GateGradeSetBy"] @cause</small>
                }
                @* A letter on part of its measures does not qualify the release (sealed candidate contract, owner
                   decision of 2026-10-25): its deployment then asks for the extra approval. *@
                @if (IsPartialGrade(Grade))
                {
                    <small class="analysis-grade-measure-hint" data-testid="grade-row-gate-partial">@L["GateGradePartialNotQualifying"]</small>
                }
            </Hints>
            <Details>
                <p>@L["AnalysisCriterionGate"]</p>
                @if (Grade?.LimitingDomain is { } limiting)
                {
                    <p>@string.Format(L["AnalysisGradeLimitingDomain"], DomainLabel(L, limiting))</p>
                }
                @if (Grade?.EvaluatedAt is { } evaluatedAt)
                {
                    <p>@string.Format(L["AnalysisGradeEvaluatedOn"], evaluatedAt.ToLocalTime().ToString("g"))</p>
                }
            </Details>
        </AnalysisGradeRow>
        @foreach (var domain in BlockDomains)
        {
            <AnalysisGradeRow Kind="domain" TestId="grade-row-domain" Label="@domain.Label" Tooltip="@L[domain.CriterionKey]"
                              Value="@NoGradeText(domain)"
                              Grade="@domain.Grade" Limiting="@IsLimiting(domain)">
                <Hints>
                    @* Recette R-17: a domain the gate does not require is shown but does not set the Gate grade
                       (a coverage graded E beside a Gate grade A). The generic templates require every domain
                       (R-73, R-74): this stays for a pipeline that chose otherwise. *@
                    @if (!domain.Required)
                    {
                        <small class="analysis-grade-measure-hint" data-testid="grade-row-domain-not-required">@L["GateDomainNotRequired"]</small>
                    }
                </Hints>
                <Details>
                    <p>@L[domain.CriterionKey]</p>
                    @if (domain.EvaluatedAt is { } evaluatedAt)
                    {
                        <p>@string.Format(L["AnalysisGradeEvaluatedOn"], evaluatedAt.ToLocalTime().ToString("g"))</p>
                    }
                </Details>
            </AnalysisGradeRow>
            @foreach (var measure in ShownMeasures(domain.Measures))
            {
                <AnalysisGradeRow Kind="measure" TestId="grade-row-measure" Label="@MeasureLabel(measure.Key)" Tooltip="@MeasureCriterion(measure.Key)"
                                  Value="@MeasureValue(measure)" Grade="@measure.Grade">
                    <Hints>
                        @if (ShowDistance(measure))
                        {
                            <small class="analysis-grade-measure-hint">@L["AnalysisDistanceToGrade", measure.DistanceToNextGrade!.Value.ToString("0.##"), measure.NextGrade!]</small>
                        }
                        @if (measure.FindingCounts is { Critical: > 0 })
                        {
                            <small class="analysis-grade-measure-hint">@L["AnalysisCriticalFindingNotDeliverable"]</small>
                        }
                        @* Recette R-73, R-74: a required measure nobody observed says so and names the step that
                           should have published its evidence; the grade is the one of the measures observed. *@
                        @if (IsMissing(measure) && MissingHint(measure) is { } missing)
                        {
                            <small class="analysis-grade-measure-hint" data-testid="grade-row-measure-missing">@missing</small>
                        }
                        @* Run #2958: a rule the grading validator rejected is an F; its line says why. *@
                        @if (measure.Rejection is { } rejection)
                        {
                            <small class="analysis-grade-measure-hint" data-testid="grade-row-measure-rejected">@rejection</small>
                        }
                        @* A rule the pipeline itself marks as not required does not set the grade; an A beside a B line is that. *@
                        @if (!measure.Required)
                        {
                            <small class="analysis-grade-measure-hint" data-testid="grade-row-measure-not-counted">@L["GradeMeasureNotCounted"]</small>
                        }
                    </Hints>
                    <Details>
                        <p>@MeasureCriterion(measure.Key)</p>
                        @if (IsMissing(measure))
                        {
                            <p data-testid="grade-row-measure-missing-detail">@L["GradeMeasureMissingDetail"]</p>
                        }
                        @if (ThresholdText(measure) is { } thresholds)
                        {
                            <p>@string.Format(L[measure.Direction == AnalysisMetricDirection.LowerIsBetter ? "AnalysisGradeThresholdsLower" : "AnalysisGradeThresholdsHigher"], thresholds)</p>
                        }
                        <p>@string.Format(L["AnalysisGradeMeasuredValue"], MeasureValue(measure))</p>
                    </Details>
                </AnalysisGradeRow>
            }
            @if (domain.CrapScore.HasValue)
            {
                <AnalysisGradeRow Kind="measure" TestId="grade-row-crap" Label="@L["AnalysisCrapAverage"]" Tooltip="@L["AnalysisCrapExplanation"]"
                                  Value="@domain.CrapScore.Value.ToString("0.0")">
                    <Details><p>@L["AnalysisCrapExplanation"]</p></Details>
                </AnalysisGradeRow>
            }
        }
    </OmniAccordion>
}
else if (Grade is not null)
{
    @* Use two columns with one line per measure and compact empty domains. Bold each domain title
       that determines the overall grade. *@
    @* R-3: the domains are OE cards of one OmniTileGrid (same width, same height, nothing spills). *@
    <OmniTileGrid Columns="2">
        @foreach (var domain in Domains.Where(HasDetails))
        {
            <OmniCard Class="analysis-grade-domain">
                <div class="analysis-grade-domain-heading">
                    <span class="@(IsLimiting(domain) ? "analysis-grade-domain-limiting" : null)">@domain.Label</span>
                    <GradeBadge Value="@domain.Grade" />
                </div>
                @if (NoGradeText(domain) is { } state)
                {
                    <div class="analysis-grade-domain-state">@state</div>
                }
                @foreach (var measure in ShownMeasures(domain.Measures))
                {
                    <div class="analysis-grade-measure">
                        <span class="analysis-grade-measure-label" title="@MeasureLabel(measure.Key)">@MeasureLabel(measure.Key)</span>
                        <span class="analysis-grade-value">@MeasureValue(measure)</span>
                        <GradeBadge Value="@measure.Grade" />
                        @if (ShowDistance(measure))
                        {
                            <small class="analysis-grade-measure-hint">@L["AnalysisDistanceToGrade", measure.DistanceToNextGrade!.Value.ToString("0.##"), measure.NextGrade!]</small>
                        }
                        @if (measure.FindingCounts is { Critical: > 0 })
                        {
                            <small class="analysis-grade-measure-hint">@L["AnalysisCriticalFindingNotDeliverable"]</small>
                        }
                        @if (IsMissing(measure) && MissingHint(measure) is { } missing)
                        {
                            <small class="analysis-grade-measure-hint" data-testid="grade-row-measure-missing">@missing</small>
                        }
                        @* Run #2958: a rule the grading validator rejected is an F; its line says why. *@
                        @if (measure.Rejection is { } rejection)
                        {
                            <small class="analysis-grade-measure-hint" data-testid="grade-row-measure-rejected">@rejection</small>
                        }
                        @if (!measure.Required)
                        {
                            <small class="analysis-grade-measure-hint" data-testid="grade-row-measure-not-counted">@L["GradeMeasureNotCounted"]</small>
                        }
                    </div>
                }
                @if (domain.CrapScore.HasValue)
                {
                    <div class="analysis-grade-measure" title="@L["AnalysisCrapExplanation"]">
                        <span class="analysis-grade-measure-label">@L["AnalysisCrapAverage"]</span>
                        <span class="analysis-grade-value">@domain.CrapScore.Value.ToString("0.0")</span>
                        <strong aria-label="@L["AnalysisAdvisory"]">–</strong>
                    </div>
                }
            </OmniCard>
        }
    </OmniTileGrid>
    @foreach (var domain in Domains.Where(domain => !HasDetails(domain)))
    {
        <div class="analysis-grade-domain-empty">
            <span class="analysis-grade-measure-label @(IsLimiting(domain) ? "analysis-grade-domain-limiting" : null)">@domain.Label</span>
            <span class="analysis-grade-domain-state">@NoGradeText(domain)</span>
            <GradeBadge Value="@domain.Grade" />
        </div>
    }
}
