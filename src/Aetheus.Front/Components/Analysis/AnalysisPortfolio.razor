@page "/analysis"
@inject Aetheus.Front.Components.Shared.BreadcrumbService Breadcrumb

<PageTitle>@L["AnalysisPortfolio"] - Aetheus</PageTitle>

@* Omit empty ChildContent so the mobile header has no empty section to toggle. *@
<OmniPageHeader Title="@L["AnalysisPortfolio"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("shield")" /></Icon>
</OmniPageHeader>

@* Separate project tiles and pipeline runs into tabs; filter the grid through its column headers. *@
<UrlSyncedTabs Slugs="@(new[] { "projects", "runs" })" Class="analysis-portfolio-tabs" RenderAllPanels="true">
    <Tabs>
<OmniTabsItem Key="projects" Title="@L["Projects"]"><Icon><OmniIcon Name="OmniIconName.Folder" /></Icon><ChildContent>
@if (_projectSummaries.Count == 0)
{
    <EmptyState Icon="shield" Title="@L["NoRecords"]" />
}
else
{
    @* R-5: the project tiles are OE tiles of one OmniTileGrid (same width, same height, nothing spills). *@
    <OmniTileGrid Columns="3" Class="analysis-portfolio-projects" role="group" aria-label="@L["Projects"]">
        @foreach (var project in _projectSummaries)
        {
            <OmniCard Class="analysis-portfolio-project-card">
                <div class="analysis-portfolio-project-heading">
                    <div>
                        <OmniLink Href="@($"projects/{project.ProjectId}/quality")"
                                    Class="analysis-portfolio-project-name">@project.ProjectName</OmniLink>
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0 analysis-portfolio-organization">
                            @project.OrganizationName
                        </OmniText>
                    </div>
                    @* The shared grade badge renders a neutral dash when the project has no grade. *@
                    <GradeBadge Value="@project.Grade?.OverallGrade" Title="@L["AnalysisGlobalGrade"]"
                                Class="analysis-portfolio-grade" />
                </div>
                @* Each count is a solid, coloured badge: reports and open findings blue, new
                   green, critical red, high orange. *@
                <div class="analysis-portfolio-project-metrics">
                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Info">@($"{project.ReportCount} {L["AnalysisReports"]}")</NumberBadge>
                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Info">@($"{project.OpenCount} {L["AnalysisOpenFindings"]}")</NumberBadge>
                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Success">@($"{project.NewCount} {L["New"]}")</NumberBadge>
                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Danger">@($"{project.CriticalCount} {L["Critical"]}")</NumberBadge>
                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Warning">@($"{project.HighCount} {L["High"]}")</NumberBadge>
                </div>
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">
                    @L["AnalysisLastRun"]: @(project.LastAnalysisAt?.ToString("g") ?? L["Never"])
                </OmniText>
            </OmniCard>
        }
    </OmniTileGrid>
}
</ChildContent></OmniTabsItem>
<OmniTabsItem Key="runs" Title="@L["Runs"]"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent>
@* Virtualization fetches rows from the server as the list scrolls. *@
<AetheusDataGrid FullHeight="true" @ref="_grid" Data="@_rows" Count="@_count" TItem="AnalysisPortfolioRowDto"
                LoadData="LoadDataAsync" ExportRead="@ReadExportAsync" RowClick="OpenRun" AllowSorting="true"
                AllowFiltering="true" FilterMode="OmniDataGridFilterMode.Simple"
                Virtualize="@AetheusGrid.RemoteVirtualization"
                VirtualData="@(() => new OmniDataGridResult<AnalysisPortfolioRowDto>(_rows, _count))"
                PageSize="25" Density="OmniDensity.Compact" class="analysis-table aetheus-clickable-rows aetheus-grid-fullheight" AllowColumnResize="true" VirtualizationOverscanCount="3">
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="AnalysisPortfolioRowDto" Property="PipelineRunId" Title="@L["PipelineRun"]" Width="7rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" ><Template Context="item">@if (item.PipelineRunId.HasValue) { <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><OmniLink Href="@($"pipelines/runs/{item.PipelineRunId}")">@($"#{item.PipelineRunId}")</OmniLink></span> }</Template></OmniDataGridColumn>
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="OrganizationName" Title="@L["Organization"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.Organizations" FilterSearchable="true" ><Template Context="item"><EntityNameLink Kind="EntityNameKind.Organization" Id="item.OrganizationId" Name="@item.OrganizationName" /></Template></OmniDataGridColumn>
        <OmniDataGridColumn Class="omni-data-grid__cell--text" TItem="AnalysisPortfolioRowDto" Property="ProjectName" Title="@L["Project"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.Projects" FilterSearchable="true" ><Template Context="item">@* SITE-FUNC-HOME-CAPABILITY-001: the link goes to the project, not to the run the row opens. *@<span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><OmniLink Href="@($"projects/{item.ProjectId}/quality")">@item.ProjectName</OmniLink></span></Template></OmniDataGridColumn>
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="PipelineName" Title="@L["Pipeline"]" Filterable="true" ><Template Context="item"><EntityNameLink Kind="EntityNameKind.Pipeline" Id="item.PipelineId" Name="@item.PipelineName" /></Template></OmniDataGridColumn>
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="Category" Title="@L["Posture"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@CategoryText" ><Template Context="item"><OmniBadge Icon="@(BadgeIcon.For(PostureStyle(item.Category)))" Fill="OmniFill.Solid" Tone="@PostureStyle(item.Category)">@Posture(item.Category)</OmniBadge></Template></OmniDataGridColumn>
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="ScannerName" Title="@L["AnalysisScanner"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.Scanners" FilterSearchable="true" />
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="GateStatus" Title="@L["AnalysisGateTab"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@GateText" ><Template Context="item"><OmniBadge Icon="@(BadgeIcon.ForState(GateStyle(item.GateStatus)))" Fill="OmniFill.Solid" Tone="@GateStyle(item.GateStatus)">@(item.GateStatus is { } gate ? L.Localize(gate) : L["NotAvailable"])</OmniBadge></Template></OmniDataGridColumn>
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="Grade" Title="@L["AnalysisGrade"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@GradeText" ><Template Context="item"><GradeBadge Value="@item.Grade" /></Template></OmniDataGridColumn>
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="FindingCount" Title="@L["AnalysisFindings"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="NewFindingCount" Title="@L["New"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="BranchName" Title="@L["Branch"]" Filterable="true" />
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="CommitHash" Title="@L["Commit"]" Filterable="true" ><Template Context="item">@if (string.IsNullOrWhiteSpace(item.CommitHash)) { <span class="analysis-commit">-</span> } else { <ShortId Value="@item.CommitHash" Href="@CommitHref(item)" Copyable="false" Class="analysis-commit" /> }</Template></OmniDataGridColumn>
        <OmniDataGridColumn TItem="AnalysisPortfolioRowDto" Property="CompletedAt" Title="@L["Date"]" FormatString="{0:g}" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" />
    </Columns>
</AetheusDataGrid>
</ChildContent></OmniTabsItem>
    </Tabs>
</UrlSyncedTabs>
