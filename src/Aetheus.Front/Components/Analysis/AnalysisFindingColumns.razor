@* SPDX-License-Identifier: EUPL-1.2 *@
@* Recette R-502: the one definition of a findings list. The project's Quality page (every finding of
   the project, read from the server page by page) and the Gate tab of a pipeline run (the findings of
   that run, already in memory) both put these columns in their grid, so a finding reads the same
   wherever it is listed: identifier, severity, category, rule, title over its message, location,
   status, "new", who owns it, when it was last seen, and the button that opens it. *@
<OmniDataGridColumn Frozen="true" TItem="AnalysisFindingDto" Property="Id" Title="ID" Width="6rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators">
    <Template Context="finding"><OmniLink Href="@FindingHref(finding.Id, RunId)">@($"#{finding.Id}")</OmniLink></Template>
</OmniDataGridColumn>
<OmniDataGridColumn TItem="AnalysisFindingDto" Property="Severity" ExportValue="@SeverityExport" Title="@L["Severity"]" Width="8rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@SeverityText" DefaultFilterValue="@Defaults?.Severity">
    <Template Context="finding"><OmniBadge Fill="OmniFill.Solid" Tone="@AnalysisPresentation.SeverityBadge(finding.Severity)">@L.Localize(finding.Severity)</OmniBadge></Template>
</OmniDataGridColumn>
<OmniDataGridColumn TItem="AnalysisFindingDto" Property="Category" ExportValue="@CategoryExport" Title="@L["Category"]" Width="9rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@CategoryText">
    <Template Context="finding">@L.Localize(finding.Category)</Template>
</OmniDataGridColumn>
<OmniDataGridColumn TItem="AnalysisFindingDto" Property="RuleId" Title="@L["AnalysisRule"]" Width="12rem" Filterable="true" />
<OmniDataGridColumn TItem="AnalysisFindingDto" Property="Title" Title="@L["Title"]" MinWidth="18rem" Filterable="true">
    @* Recette R2-053: one line in the fixed-height row, the message behind it on hover. Over two lines,
       the second one was cut by the row and neither could be read. *@
    <Template Context="finding">
        <a href="@FindingHref(finding.Id, RunId)" class="pipeline-name-link analysis-finding-grid-title" title="@TitleTooltip(finding)">@finding.Title</a>
    </Template>
</OmniDataGridColumn>
@* The location is the latest occurrence's: a list read from the server cannot sort or filter on it. *@
<OmniDataGridColumn TItem="AnalysisFindingDto" Key="Location" Property="LatestOccurrence.FilePath" ExportValue="@LocationExport" Title="@L["AnalysisExactLocation"]" Width="19rem" Sortable="@LocalData" Filterable="@LocalData">
    <Template Context="finding">
        @if (string.IsNullOrWhiteSpace(finding.LatestOccurrence?.FilePath))
        {
            <span class="analysis-finding-location-unavailable">@L["AnalysisLocationUnavailable"]</span>
        }
        else
        {
            @* Recette R2-053: path:line on one line, cut at its start so the file name stays visible;
               the whole location on hover. *@
            <code class="analysis-finding-location" title="@LocationText(finding.LatestOccurrence)"><bdi>@LocationText(finding.LatestOccurrence)</bdi></code>
        }
    </Template>
</OmniDataGridColumn>
@if (ShowStatus)
{
    <OmniDataGridColumn TItem="AnalysisFindingDto" Property="Status" ExportValue="@StatusExport" Title="@L["Status"]" Width="8rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText" DefaultFilterValue="@Defaults?.Status">
        <Template Context="finding"><OmniBadge Fill="OmniFill.Solid" Tone="@AnalysisPresentation.FindingStatusBadge(finding.Status)">@L.Localize(finding.Status)</OmniBadge></Template>
    </OmniDataGridColumn>
}
@* Recette R-221: the "New" shortcut filters on this column, so it is a filter the user can see and lift. *@
<OmniDataGridColumn TItem="AnalysisFindingDto" Key="@FindingColumnDefaults.IsNewColumn" Property="LatestOccurrence.IsNew" ExportValue="@IsNewExport" Title="@L["AnalysisGateNewBadge"]" Width="6rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@YesNoText" DefaultFilterValue="@Defaults?.IsNew">
    <Template Context="finding">@if (finding.LatestOccurrence?.IsNew == true) { <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@L["AnalysisGateNewBadge"]</OmniBadge> }</Template>
</OmniDataGridColumn>
@if (ShowOwnership)
{
    <OmniDataGridColumn TItem="AnalysisFindingDto" Property="Responsible" Title="@L["AnalysisResponsible"]" Width="10rem" Filterable="true" />
    <OmniDataGridColumn TItem="AnalysisFindingDto" Property="LastSeenAt" Title="@L["LastSeen"]" Width="10rem" FormatString="{0:g}" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
}
<OmniDataGridColumn TItem="AnalysisFindingDto" Key="Actions" Title="@L["Actions"]" Width="@(CanRevertDecisions ? "6.5rem" : "4rem")" Sortable="false">
    @* R-499 (2026-09-30): opening the finding is the main action of its row, blue. The click stays on
       the button so a grid that also opens the row on a click does not navigate twice. *@
    @* Recette R2-027: a decided finding shown with its status can be reopened from its row. *@
    <Template Context="finding"><span @onclick:stopPropagation="true" class="analysis-finding-row-actions"><OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => Open(finding))" title="@L["AnalysisGateOpenFinding"]"><OmniIcon Name="OmniIconName.OpenExternal" /></OmniButton>@if (CanRevertDecisions && AnalysisFindingDecisionRevert.CanRevert(finding.Status))
        {
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => RevertDecision.InvokeAsync(finding))" title="@L["AnalysisRevertDecision"]" Label="@L["AnalysisRevertDecision"]" Class="analysis-finding-revert-decision"><OmniIcon Name="OmniIconName.ArrowUUpLeft" /></OmniButton>
        }</span></Template>
</OmniDataGridColumn>
