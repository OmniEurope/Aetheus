@* SPDX-License-Identifier: EUPL-1.2 *@
@inject GridExportContext ExportContext
@page "/analysis/findings/{Id:int}"

<PageTitle>@L["AnalysisFindingDetail"] - Aetheus</PageTitle>

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else if (_finding is null)
{
    <EmptyState Icon="search_off" Title="@L["NotFound"]" Description="@L["AnalysisFindingNotFound"]" />
}
else
{
    <OmniPageHeader Title="@_finding.Title" ShowBack="true" Subtitle="@Breadcrumb.Subtitle()">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("policy")" /></Icon>
        <Badges>
            <OmniBadge Fill="OmniFill.Solid" Tone="@SeverityStyle(_finding.Severity)">@L[$"AnalysisSeverity{_finding.Severity}"]</OmniBadge>
            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@L[$"AnalysisFindingStatus{_finding.Status}"]</OmniBadge>
        </Badges>
        <Actions>
            @if (_canWrite)
            {
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="CreateTicketAsync" Disabled="@(_creatingTicket || _createdTicketId.HasValue)"><OmniIcon Name="OmniIconName.Add" /> <span>@(_createdTicketId.HasValue ? $"{L["AnalysisTicket"]} #{_createdTicketId}" : L["AnalysisCreateTicket"])</span></OmniButton>
            }
        </Actions>
    </OmniPageHeader>

    <UrlSyncedTabs Slugs="@(new[] { "overview", "prompt", "occurrences", "decisions" })" class="analysis-finding-tabs">
        <Tabs>
            <OmniTabsItem Key="overview" Title="@L["Overview"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("dashboard"))" /></Icon><ChildContent>
                <OmniCard Class="analysis-finding-summary-card">
                    @* Recette R-339: the icon sits on the middle of the title it marks, not at the top
                       of the title and the message together. *@
                    <div class="analysis-finding-problem">
                        <div>
                            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                                <OmniIcon Name="OmniIconName.Error" />
                                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["AnalysisProblemSummary"]</OmniText>
                            </OmniStack>
                            <p>@_finding.Message</p>
                        </div>
                    </div>
                    @if (ShownOccurrence is { } source)
                    {
                        <OmniCard Class="omni-u-mt-md analysis-source-card">
                            <div class="analysis-source-heading">
                                <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["AnalysisExactLocation"]</OmniHeading>
                            </div>
                            @if (string.IsNullOrWhiteSpace(source.FilePath))
                            {
                                <div class="analysis-source-location analysis-source-location-unavailable">@L["AnalysisLocationUnavailable"]</div>
                            }
                            else
                            {
                                @* Recette R-433: the path, the line in a badge, "Open the file" as a standard
                                   button, and under them the passage of the file in question. *@
                                <div class="analysis-source-location">
                                    <OmniIcon Name="OmniIconName.Document" />
                                    <code>@source.FilePath</code>
                                    @if (source.StartLine is not null)
                                    {
                                        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Info">@($"{L["Line"]} {LocationRange(source)}")</OmniBadge>
                                    }
                                    @if (HasNavigableFile(source))
                                    {
                                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenSourceFile(source))" Class="analysis-source-open"><OmniIcon Name="OmniIconName.OpenExternal" /> <span>@L["AnalysisOpenSourceFile"]</span></OmniButton>
                                    }
                                </div>
                                @if (_excerpt is { } excerpt)
                                {
                                    @* Recette R-433: the passage keeps the file's own line numbers (OE FirstLineNumber). *@
                                    <OmniCodeViewer Code="@excerpt.Code" Title="@ExcerptTitle(excerpt)" FirstLineNumber="@excerpt.FirstLine"
                                                    HighlightedLines="@excerpt.HighlightedLines" ShowWrapToggle="false" Class="omni-u-mt-sm" />
                                }
                            }
                            <div class="analysis-source-metadata">
                                <div><span>@L["Symbol"]</span><strong>@(source.Symbol ?? L["NotAvailable"])</strong></div>
                                <div><span>@L["AnalysisTool"]</span><strong>@(string.IsNullOrWhiteSpace(source.ToolName) ? L["NotAvailable"] : source.ToolName)</strong></div>
                                <div><span>@L["Branch"]</span><strong>
                                    @if (BranchHref(source) is { } branchHref)
                                    {
                                        <OmniLink Href="@branchHref">@source.BranchName</OmniLink>
                                    }
                                    else
                                    {
                                        @(source.BranchName ?? L["NotAvailable"])
                                    }
                                </strong></div>
                                <div><span>@L["Commit"]</span><strong class="analysis-source-commit">
                                    @if (string.IsNullOrWhiteSpace(source.CommitHash))
                                    {
                                        @L["NotAvailable"]
                                    }
                                    else
                                    {
                                        <ShortId Value="@source.CommitHash" Href="@CommitHref(source)" />
                                    }
                                </strong></div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(source.Message)
                                && !string.Equals(source.Message, _finding.Message, StringComparison.Ordinal))
                            {
                                <OmniCodeBlock Code="@source.Message" Title="@L["AnalysisScannerMessage"]" Wrap="true" Class="omni-u-mt-md analysis-source-excerpt code-block-bounded" />
                            }
                            <div class="analysis-source-links">
                                <span>@L["Report"] #@source.AnalysisReportId</span>
                                @if (source.PipelineRunId.HasValue)
                                {
                                    <OmniLink Href="@($"pipelines/runs/{source.PipelineRunId}")">@($"{L["PipelineRun"]} #{source.PipelineRunId}")</OmniLink>
                                }
                            </div>
                        </OmniCard>
                    }
                    <OmniRow Gap="OmniSpacing.Large" Class="omni-u-mt-md">
                        <OmniColumn Span="12" MediumSpan="6"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["AnalysisRule"]</OmniText><OmniText Element="OmniTextElement.Paragraph">@_finding.RuleId</OmniText></OmniColumn>
                        <OmniColumn Span="12" MediumSpan="6"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">CWE</OmniText><OmniText Element="OmniTextElement.Paragraph">@(_finding.Cwe ?? L["NotAvailable"])</OmniText></OmniColumn>
                        <OmniColumn Span="12" MediumSpan="6"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["FirstSeen"]</OmniText><OmniText Element="OmniTextElement.Paragraph">@_finding.FirstSeenAt.ToString("g")</OmniText></OmniColumn>
                        <OmniColumn Span="12" MediumSpan="6"><OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["LastSeen"]</OmniText><OmniText Element="OmniTextElement.Paragraph">@_finding.LastSeenAt.ToString("g")</OmniText></OmniColumn>
                    </OmniRow>
                    @if (!string.IsNullOrWhiteSpace(_finding.HelpUri))
                    {
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="OpenHelp" Class="omni-u-mt-md"><OmniIcon Name="OmniIconName.OpenExternal" /> <span>@L["Documentation"]</span></OmniButton>
                    }
                </OmniCard>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="prompt" Title="@L["AnalysisAiPromptTab"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("auto_awesome"))" /></Icon><ChildContent>
                <OmniCard Class="analysis-finding-prompt omni-u-p-md">
                    <div class="analysis-finding-prompt-heading">
                        <div>
                            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["AnalysisAiPrompt"]</OmniHeading>
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["AnalysisAiPromptDescription"]</OmniText>
                        </div>
                        <OmniRow Gap="OmniSpacing.Small">
                            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="CopyPromptAsync"><OmniIcon Name="OmniIconName.Copy" /> <span>@L["CopyAiPrompt"]</span></OmniButton>
                            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="DownloadPromptAsync" title="@L["DownloadMarkdown"]"><OmniIcon Name="OmniIconName.Download" /> <span>@L["Download"]</span></OmniButton>
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="TogglePromptPreview"><OmniIcon Name="@MaterialIconMap.Resolve((_showPromptPreview ? "code" : "visibility"))" /> <span>@(_showPromptPreview ? L["AnalysisPromptSource"] : L["AnalysisPromptPreview"])</span></OmniButton>
                        </OmniRow>
                    </div>
                    @if (_showPromptPreview)
                    {
                        <div class="markdown-content analysis-finding-prompt-preview">@((MarkupString)PromptHtml)</div>
                    }
                    else
                    {
                        <pre class="analysis-finding-prompt-source">@PromptMarkdown</pre>
                    }
                </OmniCard>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="occurrences" Title="@L["AnalysisOccurrences"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("history"))" /></Icon><ChildContent>
                <OmniDataGrid Items="@_occurrences" ExportTitle="@ExportContext.Title(L["AnalysisOccurrences"])" ExportFields="@ExportContext.Fields()" TItem="AnalysisFindingOccurrenceDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" FillAvailableHeight="true" Class="analysis-table aetheus-grid-fullheight">
                    <Columns><OmniDataGridColumn Frozen="true" TItem="AnalysisFindingOccurrenceDto" Property="AnalysisReportId" Title="@L["AnalysisReports"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators"><Template Context="item">@if (item.PipelineRunId.HasValue) { <OmniLink Href="@($"pipelines/runs/{item.PipelineRunId}")">@($"#{item.AnalysisReportId}")</OmniLink> } else { @($"#{item.AnalysisReportId}") }</Template></OmniDataGridColumn><OmniDataGridColumn TItem="AnalysisFindingOccurrenceDto" Property="ToolName" Title="@L["AnalysisTool"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" /><OmniDataGridColumn TItem="AnalysisFindingOccurrenceDto" Property="FilePath" Title="@L["File"]" Filterable="true" /><OmniDataGridColumn TItem="AnalysisFindingOccurrenceDto" Property="StartLine" Title="@L["Line"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" /><OmniDataGridColumn TItem="AnalysisFindingOccurrenceDto" Property="BranchName" Title="@L["Branch"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" /><OmniDataGridColumn TItem="AnalysisFindingOccurrenceDto" Property="CommitHash" Title="@L["Commit"]" Filterable="true" /><OmniDataGridColumn TItem="AnalysisFindingOccurrenceDto" Property="IsNew" Title="@L["New"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@YesNoText"><Template Context="item">@YesNoText(item.IsNew.ToString())</Template></OmniDataGridColumn><OmniDataGridColumn TItem="AnalysisFindingOccurrenceDto" Property="CreatedAt" Title="@L["Date"]" FormatString="{0:g}" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" /></Columns>
                </OmniDataGrid>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="decisions" Title="@L["AnalysisDecision"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("gavel"))" /></Icon><ChildContent>
                @if (_canAdmin)
                {
                    <OmniCard Class="analysis-decision-card">
                        <div class="analysis-decision-heading">
                            <span class="analysis-decision-icon"><OmniIcon Name="OmniIconName.Gavel" /></span>
                            <div>
                                <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["AnalysisDecision"]</OmniHeading>
                                <OmniText Element="OmniTextElement.Paragraph" Class="analysis-decision-help">@L["AnalysisDecisionHelp"]</OmniText>
                            </div>
                        </div>
                        <div class="analysis-decision-form"><OmniTemplateForm TModel="DecisionFormModel" Model="@_decision" OnValidSubmit="@SaveDecisionAsync">
                            <OmniDataAnnotationsValidator Localizer="@L" />
                            <div class="analysis-decision-layout">
                                <section class="analysis-decision-outcome">
                                    <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["AnalysisDecisionChooseOutcome"]</OmniText>
                                    <div class="analysis-decision-choices">
                                        @foreach (var status in _decisionStatuses)
                                        {
                                            var selected = _decision.Status == status;
                                            <div class="@($"analysis-decision-choice{(selected ? " is-selected" : string.Empty)}")">
                                                <OmniButton Variant="@(selected ? DecisionStatusStyle(status) : OmniButtonVariant.Ghost)" OnClick="@(() => SelectDecisionStatus(status))" ButtonType="OmniButtonType.Button"><OmniIcon Name="@MaterialIconMap.Resolve(DecisionStatusIcon(status))" /> <span>@DecisionStatusText(status)</span></OmniButton>
                                                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@DecisionStatusDescription(status)</OmniText>
                                            </div>
                                        }
                                    </div>
                                </section>
                                <section class="analysis-decision-details">
                                    <div>
                                        <OmniFormField Label="@L["Reason"]" For="DecisionReason">
                                            <OmniTextArea Id="DecisionReason" @bind-Value="_decision.Reason" Rows="5" Placeholder="@L["AnalysisDecisionReasonPlaceholder"]" />
                                        </OmniFormField>
                                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="analysis-decision-field-hint omni-u-m-0">@L["AnalysisDecisionReasonHint"]</OmniText>
                                        <ValidationMessage For="@(() => _decision.Reason)" />
                                    </div>
                                    <div>
                                        <OmniFormField Label="@L["ExpiresAt"]" For="oe-formfield-pages-analysis-analysisfindingdetail-2">
                                    <OmniDateTimePicker Id="oe-formfield-pages-analysis-analysisfindingdetail-2" @bind-Value="_decision.ExpiresAt" />
                                        </OmniFormField>
                                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="analysis-decision-field-hint omni-u-m-0">@L["AnalysisDecisionExpirationHint"]</OmniText>
                                    </div>
                                </section>
                            </div>
                            <div class="analysis-decision-actions">
                                <div class="analysis-decision-selected">
                                    <span>@L["AnalysisDecisionSelected"]</span>
                                    <strong>@DecisionStatusText(_decision.Status)</strong>
                                </div>
                                @* Recette R2-027: the decision in force can be reverted, the finding is open again. *@
                                @if (HasRevertibleDecision)
                                {
                                    <OmniButton Variant="OmniButtonVariant.Secondary" Busy="@_reverting" OnClick="@RevertDecisionAsync" Class="analysis-decision-revert" title="@L["AnalysisRevertDecision"]"><OmniIcon Name="OmniIconName.ArrowUUpLeft" /> <span>@L["AnalysisReopenFindingButton"]</span></OmniButton>
                                }
                                <OmniButton Variant="OmniButtonVariant.Primary" Disabled="@_saving" ButtonType="OmniButtonType.Submit"><OmniIcon Name="OmniIconName.Save" /> <span>@L["AnalysisSaveDecision"]</span></OmniButton>
                            </div>
                        </OmniTemplateForm></div>
                    </OmniCard>
                }
                <OmniHeading Level="OmniHeadingLevel.H5" Class="@(_canAdmin ? "omni-u-mt-lg" : "omni-u-m-0 omni-u-mb-md")">@L["AnalysisDecisionHistory"]</OmniHeading>
                <OmniDataGrid FillAvailableHeight="true" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" Items="@_decisions" ExportTitle="@ExportContext.Title()" ExportFields="@ExportContext.Fields()" TItem="AnalysisFindingDecisionDto" EmptyText="@L["NoRecords"]" Class="analysis-table aetheus-grid-fullheight">
                    <Columns><OmniDataGridColumn Frozen="true" TItem="AnalysisFindingDecisionDto" Property="Status" Title="@L["Status"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText"><Template Context="item"><OmniBadge Fill="OmniFill.Solid" Tone="@DecisionStatusBadgeStyle(item.Status)">@DecisionStatusText(item.Status)</OmniBadge></Template></OmniDataGridColumn><OmniDataGridColumn TItem="AnalysisFindingDecisionDto" Property="Reason" Title="@L["Reason"]" Filterable="true" /><OmniDataGridColumn TItem="AnalysisFindingDecisionDto" Property="CreatedByUsername" Title="@L["CreatedBy"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" /><OmniDataGridColumn TItem="AnalysisFindingDecisionDto" Property="CreatedAt" Title="@L["Date"]" FormatString="{0:g}" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" /><OmniDataGridColumn TItem="AnalysisFindingDecisionDto" Property="ExpiresAt" Title="@L["ExpiresAt"]" FormatString="{0:g}" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" /></Columns>
                </OmniDataGrid>
            </ChildContent></OmniTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}
