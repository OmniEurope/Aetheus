@page "/git-repositories"
@using Microsoft.AspNetCore.Components.Sections

<PageTitle>@L["GitRepositories"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["GitRepositories"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("commit")" /></Icon>
    <Badges>
        <HelpLink PageKey="git-repositories" />
    </Badges>
    <ActionsContent>
        @* Repository hub events keep the list current. *@
        @if (ShowsExternalTab)
        {
            @* The external repository panel fills its actions (Sync now, menu) in the page header (R-109). *@
            <SectionOutlet SectionName="@PageHeaderActions.SectionName" />
        }
        else
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ShowCreateDialog" Disabled="@(!_projectFilter.HasValue || !_canWrite)" title="@(!_canWrite ? L["InsufficientPermissions"] : "")"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
        }
    </ActionsContent>
</OmniPageHeader>

@* Inside a project the project is known and the grid's header filters search, so neither the
   project picker nor the search box show there. *@
@if (!ProjectId.HasValue)
{
<div class="pipeline-list-toolbar">
    <OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
        <OmniTextBox aria-label="@L["Search"]" Placeholder="@L["Search"]" @bind-Value="_search" @bind-Value:after="ResetAndReloadAsync"
            Class="pipeline-list-search" />
        <OmniDropDown aria-label="@L["SelectProject"]" TValue="int?" Options="@(_projects.ToOptions(item => (int?)item.Id, item => item.Name))"
            Placeholder="@L["SelectProject"]" AllowEmpty="true" @bind-Value="_projectFilter" @bind-Value:after="@(() => OnProjectFilterChanged(new object()))" />
        @if (_projectFilter.HasValue)
        {
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@ClearFilters"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@L["ClearFilters"]</span></ChildContent></OmniButton>
        }
    </OmniRow>
</div>
}

@* Project Git views separate internal and external sources through URL-synchronized tabs. *@
@if (_projectFilter.HasValue)
{
    <UrlSyncedTabs Slugs="@RepositoryTabSlugs" @bind-SelectedIndex="_repositoryTab" class="git-repository-tabs">
        <Tabs>
            <OmniTabsItem Key="internal" Title="@L["InternalRepositories"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("commit")" /></Icon></OmniTabsItem>
            <OmniTabsItem Key="external" Title="@L["ExternalRepo"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("open_in_new")" /></Icon></OmniTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}

@if (ShowsExternalTab && _projectFilter is { } externalProjectId)
{
    <section id="external-repository" class="git-external-repository-panel">
        <Aetheus.Front.Components.Projects.ProjectDetailSections.ProjectExternalRepoSection ProjectId="@externalProjectId" />
    </section>
}
else
{
@* Keep the grid mounted while loading. Replacing an empty grid with a spinner causes the grid to
   fire LoadData again every time the grid is recreated, producing an infinite reload loop. *@
<AetheusDataGrid @ref="_grid" TItem="GitLightRepoDto" Data="@_repos"
    Count="@_totalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync" ExportRead="@ReadExportAsync" PageSize="20"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<GitLightRepoDto>(_repos, _totalCount))"
    EmptyText="@L["NoRepositoriesFound"]" class="@GitGridClass" FullHeight="true"
    RowClick="@(r => Nav.NavigateTo($"git-repositories/{r.Id}?projectId={r.ProjectId}"))">
        <Columns>
            <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="GitLightRepoDto" Property="Name" Title="@L["Name"]" Filterable="true" >
                <Template Context="r">
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                        <a href="@($"git-repositories/{r.Id}?projectId={r.ProjectId}")" class="pipeline-name-link" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@r.Name</a>
                    </OmniStack>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn Class="omni-data-grid__cell--text" TItem="GitLightRepoDto" Property="ProjectName" Title="@L["Project"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_projectNames" FilterSearchable="true" >
                <Template Context="r">
                    <a href="@($"projects/{r.ProjectId}")" class="pipeline-name-link" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@r.ProjectName</a>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="GitLightRepoDto" Property="Description" Truncate="true" Title="@L["Description"]" Width="auto" Filterable="true" />
            <OmniDataGridColumn TItem="GitLightRepoDto" Property="DefaultBranch" Title="@L["DefaultBranch"]" Width="130px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.DefaultBranches" FilterSearchable="true" >
                <Template Context="r">
                    <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.GitFork))" Fill="OmniFill.Solid" Tone="OmniTone.Accent">@r.DefaultBranch</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="GitLightRepoDto" Key="IsEmpty" ExportValue="@StatusExport" Title="@L["Status"]" Width="100px" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@EmptyText" >
                <Template Context="r">
                    @if (r.IsEmpty)
                    {
                        <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Warning))" Fill="OmniFill.Solid" Tone="OmniTone.Warning">@L["Empty"]</OmniBadge>
                    }
                    else
                    {
                        <OmniBadge Icon="@(BadgeIcon.ForState(OmniTone.Success))" Fill="OmniFill.Solid" Tone="OmniTone.Success">@L["Active"]</OmniBadge>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="GitLightRepoDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:g}" Width="160px" Filterable="true" />
            <OmniDataGridColumn TItem="GitLightRepoDto" Property="LastPushAt" Title="@L["LastPush"]" FormatString="{0:g}" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" />
            <OmniDataGridColumn TItem="GitLightRepoDto" Title="@L["Actions"]" Sortable="false" TextAlign="OmniAlignment.End" Filterable="false" >
                <Template Context="r">
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        @* Open is the row's primary action. *@
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => Nav.NavigateTo($"git-repositories/{r.Id}?projectId={r.ProjectId}"))" title="@L["View"]" Label="@L["View"]"><Icon><OmniIcon Name="OmniIconName.Eye" /></Icon></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteRepo(r))" Disabled="@(!_canWrite)" title="@L["Delete"]" Label="@L["Delete"]"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton>
                    </span>
                </Template>
            </OmniDataGridColumn>
        </Columns>
</AetheusDataGrid>

@if (!_loading && _totalCount == 0)
{
    <EmptyState Icon="commit" Title="@(ExternalRepositoryUrl is null ? L["NoRepositoriesFound"] : L["ExternalRepositoryOnly"])"
        Description="@(ExternalRepositoryUrl is not null ? L["ExternalRepositoryOnlyHint"] : _projectFilter.HasValue ? L["EmptyRepositoriesHint"] : L["SelectProjectToCreateRepository"])">
        <ActionContent>
            @* A project built from an external repository says so and links to it. *@
            @if (ExternalRepositoryUrl is { } externalUrl)
            {
                <OmniLink Href="@externalUrl" NewTab="true" Class="git-external-repository-link">@externalUrl</OmniLink>
            }
            else if (_projectFilter.HasValue && _canWrite)
            {
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ShowCreateDialog"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
            }
        </ActionContent>
    </EmptyState>
}

}
