<OmniTemplateForm TModel="CreateInternalPullRequestRequest" Model="@_request" OnValidSubmit="@Submit">
    <OmniDataAnnotationsValidator Localizer="@L" />
    <OmniStack Gap="OmniSpacing.Large">
        <OmniFormField For="oe-pages-git-gitprcreatedialog-1"><LabelContent>@L["Title"]</LabelContent><ChildContent>
            <OmniTextBox @bind-Value="_request.Title" Id="oe-pages-git-gitprcreatedialog-1" />
        </ChildContent></OmniFormField>
        <ValidationMessage For="@(() => _request.Title)" />

        <OmniFormField Label="@L["SourceBranch"]" For="oe-formfield-pages-git-gitprcreatedialog-1">
            <OmniDropDown Id="oe-formfield-pages-git-gitprcreatedialog-1" TValue="string" Options="@((Branches.Select(b => b.Name)).ToOptions(item => (string)item, item => item))" @bind-Value="_request.SourceBranch" />
        </OmniFormField>
        <ValidationMessage For="@(() => _request.SourceBranch)" />

        <OmniFormField Label="@L["TargetBranch"]" For="oe-formfield-pages-git-gitprcreatedialog-2">
            <OmniDropDown Id="oe-formfield-pages-git-gitprcreatedialog-2" TValue="string" Options="@((Branches.Select(b => b.Name)).ToOptions(item => (string)item, item => item))" @bind-Value="_request.TargetBranch" />
        </OmniFormField>
        <ValidationMessage For="@(() => _request.TargetBranch)" />

        <OmniFormField For="oe-pages-git-gitprcreatedialog-4"><LabelContent>@L["Description"]</LabelContent><ChildContent>
            <OmniTextArea @bind-Value="_request.Description" Rows="4" Id="oe-pages-git-gitprcreatedialog-4" />
        </ChildContent></OmniFormField>

        <DialogFooter OnCancel="@Cancel">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_submitting ? "btn-busy" : null)" Busy="@(_submitting)"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
        </DialogFooter>
    </OmniStack>
</OmniTemplateForm>
