@* The runs that used the release after its creation, and what its build consumed. Both are kept
   apart from the Source card (creation) and the Deliverables (what it ships). *@
<OmniTileGrid Columns="2" Gap="OmniSpacing.Large">
        <OmniCard>
            <div class="detail-panel-title">
                <OmniIcon Name="OmniIconName.RocketLaunch" Class="run-tile-icon omni-u-text-accent" />
                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["ReleaseUses"]</OmniText>
            </div>
            @if (Provenance.Uses.Count == 0)
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["ReleaseUsesEmpty"]</OmniText>
            }
            @foreach (var use in Provenance.Uses)
            {
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row release-provenance-row">
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="release-provenance-row">
                        <a href="/pipelines/@use.Run.PipelineId" class="detail-value-link">@use.Run.PipelineName</a>
                        <a href="/pipelines/runs/@use.Run.RunId" class="detail-value-link">#@use.Run.RunId</a>
                    </OmniStack>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                        <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L.Localize(use.Kind)</OmniBadge>
                        <PipelineRunStatusBadge Status="use.Run.Status" />
                    </OmniStack>
                </OmniStack>
            }
        </OmniCard>
        <OmniCard>
            <div class="detail-panel-title">
                <OmniIcon Name="OmniIconName.Download" Class="run-tile-icon omni-u-text-accent" />
                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["ReleaseBuildInputs"]</OmniText>
            </div>
            <OmniText Element="OmniTextElement.Small" Class="omni-u-text-muted">@L["ReleaseInputArtifacts"]</OmniText>
            @if (Provenance.ArtifactInputs.Count == 0)
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["ReleaseInputArtifactsEmpty"]</OmniText>
            }
            @foreach (var input in Provenance.ArtifactInputs)
            {
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row release-provenance-row">
                    <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.None" Class="release-provenance-cell">
                        @if (input.ArtifactId is { } artifactId)
                        {
                            <a href="/artifacts/@artifactId" class="detail-value-link"><OmniIcon Name="OmniIconName.Archive" Class="run-tile-icon omni-u-text-accent" /> @input.ArtifactName</a>
                        }
                        else
                        {
                            <OmniText Element="OmniTextElement.Paragraph" title="@L["ReleaseInputArtifactPurged"]">@input.ArtifactName</OmniText>
                        }
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">
                            @if (!string.IsNullOrEmpty(input.Sha256))
                            {
                                <ShortId Value="@input.Sha256" Href="@(input.ArtifactId is { } digestArtifactId ? $"/artifacts/{digestArtifactId}" : null)" Copyable="false" Class="text-mono" />
                            }
                            @L["ReleaseInputFromRun"] <a href="/pipelines/runs/@input.SourcePipelineRunId" class="detail-value-link">#@input.SourcePipelineRunId</a>
                            @if (input.SourceReleaseId is { } sourceReleaseId)
                            {
                                <span> · </span><ShortId Value="@input.SourceReleaseVersion" Href="@($"/releases/{sourceReleaseId}")" Copyable="false" />
                            }
                        </OmniText>
                    </OmniStack>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="release-provenance-row">
                        <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral" title="@input.StepName">@L.Localize(input.Kind)</OmniBadge>
                        @if (input.IsDeliverable)
                        {
                            <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Accent))" Fill="OmniFill.Solid" Tone="OmniTone.Accent">@L["ReleaseInputIsDeliverable"]</OmniBadge>
                        }
                    </OmniStack>
                </OmniStack>
            }
            <OmniText Element="OmniTextElement.Caption" Class="omni-u-text-muted omni-u-mt-md">@L["ReleaseInputPackages"]</OmniText>
            @if (Provenance.Packages.Count == 0)
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["ReleaseInputPackagesEmpty"]</OmniText>
            }
            else if (Provenance.PackageTotalCount > Provenance.Packages.Count)
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["ReleaseInputPackagesTruncated", Provenance.Packages.Count, Provenance.PackageTotalCount]</OmniText>
            }
            @foreach (var package in Provenance.Packages)
            {
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row release-provenance-row">
                    <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.None" Class="release-provenance-cell">
                        <OmniText Element="OmniTextElement.Paragraph"><OmniIcon Name="OmniIconName.Package" Class="run-tile-icon" /> @package.Name <span class="text-mono">@package.Version</span></OmniText>
                        @if (!string.IsNullOrEmpty(package.PackageUrl))
                        {
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted text-mono release-provenance-id">@package.PackageUrl</OmniText>
                        }
                    </OmniStack>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                        @if (package.IsDirect)
                        {
                            <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L["ReleaseInputPackageDirect"]</OmniBadge>
                        }
                        <a href="/pipelines/runs/@package.PipelineRunId" class="detail-value-link" title="@L["ReleaseInputPackageSbomRun"]">#@package.PipelineRunId</a>
                    </OmniStack>
                </OmniStack>
            }
        </OmniCard>
</OmniTileGrid>
