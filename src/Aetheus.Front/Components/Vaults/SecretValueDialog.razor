<OmniStack Gap="OmniSpacing.Large">
    <OmniFormField Label="@L["NewValue"]" For="secret-value-input">
        @* Use OmniPassword IgnorePasswordManagers for masked secret input. Generate applies the
           key recipe by default and offers alternatives through its menu. *@
        <div class="secret-value-row">
            <div @onkeydown="@OnKeyDown" class="secret-value-row__field"><OmniPassword @bind-Value="_value" Id="secret-value-input" IgnorePasswordManagers="true"
                                                     RevealLabel="@L["ShowValue"]" HideLabel="@L["HideValue"]" aria-label="@L["NewValue"]" /></div>
            <OmniSplitButton Text="@L["Generate"]" Variant="OmniButtonVariant.Primary"
                             OnClick="@GenerateForKey" MenuLabel="@L["SecretGenerateOptions"]" title="@GenerateHint"><Icon><OmniIcon Name="OmniIconName.Sparkle" /></Icon><ChildContent>
                @foreach (var choice in SecretGenerationChoices.All)
                {
                    <OmniMenuItem OnClick="@(() => GenerateWith(choice))">@L[choice.LabelKey]</OmniMenuItem>
                }
            </ChildContent></OmniSplitButton>
        </div>
    </OmniFormField>
    <DialogFooter OnCancel="@(() => Dialog.Close())">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@Save" Disabled="@string.IsNullOrWhiteSpace(_value)"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
    </DialogFooter>
</OmniStack>
