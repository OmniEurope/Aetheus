@inject GridExportContext ExportContext
@* Recette R-287: the name the secret had at each version, when it changed and who changed it; never a value. No
   change-type column (R-286), the date in local time. *@
<OmniDataGrid Items="@Versions" ExportTitle="@ExportContext.Title(L["Versions"])" ExportFields="@ExportContext.Fields()" TItem="VaultSecretVersionDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="VaultSecretVersionDto" Property="Version" Title="#" Width="4.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="VaultSecretVersionDto" Property="Key" Title="@L["Key"]" Filterable="true" />
        @* Empty for versions written before the author was recorded (R-287). *@
        <OmniDataGridColumn TItem="VaultSecretVersionDto" Property="ChangedBy" Title="@L["Author"]" Width="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" />
        <OmniDataGridColumn TItem="VaultSecretVersionDto" Property="ChangedAt" Value="@LocalChangedAt" Title="@L["Date"]" Width="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true">
            <Template Context="v">
                @* Versions written before the date was recorded have none (0001-01-01): nothing rather than year 1. *@
                @(v.ChangedAt.Year > 2000 ? v.ChangedAt.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture) : string.Empty)
            </Template>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>
<DialogFooter CancelText="@L["Close"]" OnCancel="@Close" />
