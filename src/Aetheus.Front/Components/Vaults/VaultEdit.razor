@inject GridExportContext ExportContext
@page "/vaults/new"
@page "/vaults/{Id:int}"

<PageTitle>@(_isNew ? L["NewVault"] : _detail?.Name ?? L["Vault"]) - Aetheus</PageTitle>

@* Keep vault Edit and Delete in the menu and omit empty header content to avoid a useless mobile
   toggle. *@
<OmniPageHeader Title="@(_isNew ? L["NewVault"] : _detail?.Name ?? "")" ShowBack="true" BackHref="@LocalReturnUrl.Validated(ReturnUrl)" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("lock")" /></Icon>
</OmniPageHeader>

@if (!_isNew && _detail is null)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else
{
    @if (_isNew || _editingProperties)
    {
    <OmniTemplateForm TModel="VaultModel" Model="@_model" OnValidSubmit="@OnSubmit">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniRow Gap="OmniSpacing.Large">
            <OmniColumn Span="12" MediumSpan="6">
                <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.Large">
                    <OmniFormField For="vault-name">
                        <LabelContent>@L["Name"]</LabelContent>
                        <ChildContent>
                            <OmniTextBox Id="vault-name" @bind-Value="_model.Name" />
                            <ValidationMessage For="@(() => _model.Name)" />
                        </ChildContent>
                    </OmniFormField>
                    <OmniFormField For="vault-description">
                        <LabelContent>@L["Description"]</LabelContent>
                        <ChildContent>
                            <OmniTextArea Id="vault-description" @bind-Value="_model.Description" Rows="3" />
                        </ChildContent>
                    </OmniFormField>
                </OmniStack>
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OwnerTypeSelector Projects="@_projects"
                    @bind-ProjectId="_model.ProjectId"
                    @bind-EnvironmentId="_model.EnvironmentId"
                    @bind-ProjectServerId="_model.ProjectServerId" />
            </OmniColumn>
        </OmniRow>

        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Class="omni-u-mt-lg">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><OmniIcon Name="@MaterialIconMap.Resolve((_isNew ? "add" : "save"))" /> <span>@(_isNew ? L["Create"] : L["Save"])</span></OmniButton>
            @if (!_isNew)
            {
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@CancelPropertiesEdit"><OmniIcon Name="OmniIconName.Close" /> <span>@L["Cancel"]</span></OmniButton>
            }
        </OmniStack>
    </OmniTemplateForm>
    }

    @if (!_isNew && _detail is not null)
    {
        <OmniHeading Level="OmniHeadingLevel.H5" Class="@(_editingProperties ? "omni-u-mt-2xl omni-u-mb-sm" : "omni-u-mb-sm")">@L["Secrets"]</OmniHeading>

        <OmniTemplateForm TModel="NewSecretModel" Model="@_newSecret" OnValidSubmit="@((EditContext context) => AddSecret((NewSecretModel)context.Model))">
        <OmniDataAnnotationsValidator Localizer="@L" />
        @* Align secret input controls on one row with validation below them. Use a masked text
           field that password managers do not treat as a login credential. *@
        <div class="vault-add-row">
            <OmniTextBox @bind-Value="_newSecret.Key" Placeholder="@L["Key"]" Autocomplete="off"
                         aria-label="@L["Key"]" Class="vault-add-row__key" />
            <OmniPassword Id="vault-new-secret-value" @bind-Value="_newSecret.Value" Placeholder="@L["Value"]" IgnorePasswordManagers="true"
                          RevealLabel="@L["ShowValue"]" HideLabel="@L["HideValue"]" aria-label="@L["Value"]" />
            @* Generate uses the approved blue STD-BTN exception beside Add. Its main click uses
               the key recipe and its menu offers alternative generators. *@
            <OmniSplitButton Text="@L["Generate"]" Variant="OmniButtonVariant.Primary"
                             OnClick="@GenerateNewSecretValue" MenuLabel="@L["SecretGenerateOptions"]" title="@GenerateHint(_newSecret.Key)"><Icon><OmniIcon Name="OmniIconName.Sparkle" /></Icon><ChildContent>
                @foreach (var choice in SecretGenerationChoices.All)
                {
                    <OmniMenuItem OnClick="@(() => GenerateNewSecretValueWith(choice))">@L[choice.LabelKey]</OmniMenuItem>
                }
            </ChildContent></OmniSplitButton>
            <OmniDatePicker @bind-Value="NewSecretExpiryDate" aria-label="@L["ExpiresAt"]" Placeholder="@L["ExpiresAt"]" />
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Add"]</span></OmniButton>
            <div class="pipeline-list-spacer"></div>
            <OmniOverflowMenu Label="@L["Tools"]">
                <OmniMenuItem OnClick="@EditProperties"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent>@L["Edit"]</ChildContent></OmniMenuItem>
                <OmniMenuItem OnClick="@OnDelete"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["Delete"]</ChildContent></OmniMenuItem>
                <OmniMenuItem OnClick="@ExportKeys"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent>@L["ExportKeys"]</ChildContent></OmniMenuItem>
                <OmniMenuItem OnClick="@ImportSecrets"><Icon><OmniIcon Name="OmniIconName.Upload" /></Icon><ChildContent>@L["Import"]</ChildContent></OmniMenuItem>
            </OmniOverflowMenu>
        </div>
        <div class="vault-add-row__messages omni-u-mb-md">
            <ValidationMessage For="@(() => _newSecret.Key)" />
            <ValidationMessage For="@(() => _newSecret.Value)" />
        </div>
        </OmniTemplateForm>

        <OmniDataGrid FillAvailableHeight="true" Items="@_detail.Secrets" ExportTitle="@ExportContext.Title(L["Secrets"])" ExportFields="@ExportContext.Fields()" TItem="VaultSecretDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
            <Columns>
                <OmniDataGridColumn Frozen="true" TItem="VaultSecretDto" Property="Key" Title="@L["Key"]" Filterable="true">
                    <Template Context="secret">
                        @* Use the approved blue STD-BTN exception for each key copy button. *@
                        <span class="library-cell">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => CopyKey(secret.Key))" Class="library-copy-btn"
                                        title="@L["CopyKey"]" Label="@L["CopyKey"]"><OmniIcon Name="OmniIconName.Copy" /></OmniButton>
                            <span class="clickable-cell" role="button" tabindex="0"
                                  @onclick="@(() => UpdateSecret(secret))"
                                  @onkeydown="@(e => OnSecretCellKeyDown(e, secret))">@secret.Key</span>
                        </span>
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="VaultSecretDto" Title="@L["Value"]" Width="12.5rem" Sortable="false">
                    <Template Context="secret">
                        @* Copy values without rendering them, with server-side auditing. Place the
                           approved blue copy action before the value for alignment. *@
                        <span class="library-cell">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => CopySecretValue(secret))" Class="library-copy-btn"
                                        title="@L["CopyValue"]" Label="@L["CopyValue"]"><OmniIcon Name="OmniIconName.Copy" /></OmniButton>
                            <span class="clickable-cell" role="button" tabindex="0"
                                  @onclick="@(() => UpdateSecret(secret))"
                                  @onkeydown="@(e => OnSecretCellKeyDown(e, secret))">••••••••</span>
                        </span>
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="VaultSecretDto" Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
                <OmniDataGridColumn TItem="VaultSecretDto" Property="ExpiresAt" Title="@L["ExpiresAt"]" Width="10rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange">
                    <Template Context="secret">
                        @if (secret.ExpiresAt.HasValue)
                        {
                            var badge = GetExpiryBadge(secret.ExpiresAt.Value);
                            <OmniBadge Fill="OmniFill.Solid" Tone="@badge">@secret.ExpiresAt.Value.ToString("d")</OmniBadge>
                        }
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="VaultSecretDto" Title="@L["Versions"]" ExportValue="@VersionsExport" Width="5.625rem" TextAlign="OmniDataGridTextAlign.Center" Sortable="false">
                    <Template Context="secret">
                        <CountBadge Value="@secret.VersionCount" Variant="OmniTone.Neutral" />
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="VaultSecretDto" Title="" Width="15rem" Sortable="false" TextAlign="OmniDataGridTextAlign.End">
                    <Template Context="secret">
                        @* Use filled actions: blue copy, secondary history and edit, and orange
                           rotation under the approved STD-BTN exceptions. *@
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => CopyKeyReference(secret.Key))" title="@L["CopyKeyReference"]" Label="@L["CopyKeyReference"]"><OmniIcon Name="OmniIconName.Copy" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ShowVersions(secret))" title="@L["History"]" Label="@L["History"]"><OmniIcon Name="OmniIconName.Reset" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => UpdateSecret(secret))" title="@L["Edit"]" Label="@L["Edit"]"><OmniIcon Name="OmniIconName.Edit" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Warning" OnClick="@(() => RotateSecret(secret))" title="@L["Rotate"]" Label="@L["Rotate"]"><OmniIcon Name="OmniIconName.Sync" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteSecret(secret.Id))" title="@L["Delete"]" Label="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                    </Template>
                </OmniDataGridColumn>
            </Columns>
        </OmniDataGrid>
    }
}
