@namespace Aetheus.Front.Components.Users
<div class="role-assignment-picker">
    @if (SelectedLabels.Count > 0)
    {
        <div class="role-assignment-selected" aria-label="@L["SelectedRoles"]">
            @foreach (var label in SelectedLabels.Take(6))
            {
                <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.IdentificationBadge))" Fill="OmniFill.Solid" Tone="OmniTone.Accent">@label</OmniBadge>
            }
            @if (SelectedLabels.Count > 6)
            {
                <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@($"+{SelectedLabels.Count - 6}")</NumberBadge>
            }
        </div>
    }

    @if (OrganizationScoped && _organizations.Count > 1)
    {
        @* R-47: a role other than Admin is held for one organization; the choice shows only when there is one to make. *@
        <OmniDropDown TValue="int" Id="role-assignment-organization" Label="@L["Organization"]"
            Options="@(_organizations.ToOptions(item => item.Id, item => item.Name))"
            @bind-Value:get="_organizationId" @bind-Value:set="OnOrganizationChangedAsync" Disabled="@Disabled" Class="role-assignment-organization" />
    }
    else if (OrganizationScoped && _organizationsLoaded && _organizations.Count == 0)
    {
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">@L["RoleAssignmentNoOrganization"]</OmniText>
    }

    <div class="role-assignment-toolbar">
        <OmniTextBox Value="@_search" ValueChanged="OnSearchInputAsync"
            Placeholder="@L["SearchRoles"]" aria-label="@L["SearchRoles"]"
            Class="role-assignment-search"  ValueExpression="@(() => _search)"/>
        <OmniSwitch TValue="bool" Value="@_assignedOnly" ValueExpression="@(() => _assignedOnly)" ValueChanged="@OnAssignedOnlyChanged" Class="role-assignment-filter">@L["AssignedRolesOnly"]</OmniSwitch>
        @if (!string.IsNullOrWhiteSpace(_search))
        {
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@ClearSearchAsync"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@L["ClearFilters"]</span></ChildContent></OmniButton>
        }
        <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@string.Format(L["SelectedRolesCount"], SelectedLabels.Count)</NumberBadge>
    </div>

    <div class="role-assignment-grid">
        <AetheusDataGrid @ref="_grid" TItem="RoleDto" Data="@_roles" Count="@_totalCount"
            PageSize="25" IsLoading="@_loading" LoadData="@LoadDataAsync" ExportMarkdown="false"
            Density="OmniDensity.Compact" AllowSorting="true" AllowFiltering="true"
            FilterMode="OmniDataGridFilterMode.Simple" EmptyText="@L["NoRecords"]"
            Virtualize="@AetheusGrid.RemoteVirtualization"
            VirtualData="@(() => new OmniDataGridResult<RoleDto>(_roles, _totalCount))">
            <Columns>
                <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="RoleDto" Property="Name" Title="@L["Role"]" Filterable="true" >
                    <Template Context="role">
                        @{ var isSelected = IsSelected(role.Name); }
                        <OmniCheckBox TValue="bool" Value="isSelected" ValueExpression="@(() => isSelected)" ValueChanged="@(selected => OnRoleToggledAsync(role.Name, selected))" Class="role-assignment-toggle" Disabled="@(Disabled || !CanToggle(role.Name))">@role.Name</OmniCheckBox>
                        @{ var description = RoleDescriptions.Localize(role, L); }
                        @if (!string.IsNullOrWhiteSpace(description))
                        {
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted role-assignment-description">
                                @description
                            </OmniText>
                        }
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="RoleDto" Property="PermissionCount"
                    Title="@L["Permissions"]" Width="145px" Filterable="false">
                    <Template Context="role">
                        @if (_assignedOnly || InitialRoles.Count > 0)
                        {
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">-</OmniText>
                        }
                        else
                        {
                            <CountBadge Value="@role.PermissionCount" Variant="OmniTone.Neutral" />
                        }
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="RoleDto" Property="UserCount"
                    Title="@L["Users"]" Width="120px" Filterable="false">
                    <Template Context="role">
                        @if (_assignedOnly || InitialRoles.Count > 0)
                        {
                            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">-</OmniText>
                        }
                        else
                        {
                            @role.UserCount
                        }
                    </Template>
                </OmniDataGridColumn>
            </Columns>
        </AetheusDataGrid>
    </div>
</div>
