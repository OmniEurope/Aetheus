@inject GridExportContext ExportContext
@page "/admin/users/{Id:int}"
@page "/users/{Id:int}"

<PageTitle>@(_user?.Username ?? L["User"]) - Aetheus</PageTitle>

<div class="iam-page iam-detail-page">
<OmniPageHeader Title="@(_user?.Username ?? "")" ShowBack="true" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("person")" /></Icon>
    <Badges>
        @if (_user is not null)
        {
            <OmniBadge Icon="@(BadgeIcon.ForState(_user.IsActive ? OmniTone.Success : OmniTone.Danger))" Fill="OmniFill.Solid" Tone="@(_user.IsActive ? OmniTone.Success : OmniTone.Danger)">@(_user.IsActive ? L["Active"] : L["Inactive"])</OmniBadge>
        }
    </Badges>
    <ActionsContent>
        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@OnDelete"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent><span>@L["Delete"]</span></ChildContent></OmniButton>
    </ActionsContent>
</OmniPageHeader>

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Large" Class="omni-u-mt-lg" />
}
else
{
    <UrlSyncedTabs Change="@OnTabChanged" Slugs="@(new[] { "general", "roles", "organizations", "security", "pipelines", "audit" })">
        <Tabs>
            <OmniTabsItem Key="general" Title="@L["General"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("tune")" /></Icon><ChildContent>
                <OmniCard Class="iam-detail-card">
                <div class="form-narrow"><OmniTemplateForm TModel="UserModel" Model="@_model" OnValidSubmit="@OnSubmit">
                    <OmniDataAnnotationsValidator Localizer="@L" />
                    <OmniStack Gap="OmniSpacing.Large">
                        <OmniFormField For="oe-pages-users-useredit-4"><LabelContent>@L["Username"]</LabelContent><ChildContent>
                            <OmniTextBox @bind-Value="_model.Username" Id="oe-pages-users-useredit-4" />
                            <ValidationMessage For="@(() => _model.Username)" />
                        </ChildContent></OmniFormField>
                        <OmniFormField For="oe-pages-users-useredit-5"><LabelContent>@L["Email"]</LabelContent><ChildContent>
                            <OmniTextBox @bind-Value="_model.Email" Id="oe-pages-users-useredit-5" />
                            <ValidationMessage For="@(() => _model.Email)" />
                        </ChildContent></OmniFormField>
                        <OmniSwitch TValue="bool" Value="@_model.IsActive" ValueExpression="@(() => _model.IsActive)" ValueChanged="@OnActiveChangedAsync" Class="@(_savingFlags ? "iam-autosave-busy" : null)">@L["Active"]</OmniSwitch>
                        <OmniSwitch TValue="bool" Value="@_model.MustChangePassword" ValueExpression="@(() => _model.MustChangePassword)" ValueChanged="@OnMustChangePasswordChangedAsync" Class="@(_savingFlags ? "iam-autosave-busy" : null)">@L["MustChangePassword"]</OmniSwitch>
                    </OmniStack>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Class="omni-u-mt-lg">
                        <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
                    </OmniStack>
                </OmniTemplateForm></div>
                </OmniCard>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="roles" Title="@L["Roles"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("admin_panel_settings")" /></Icon><ChildContent>
                @* R-14: the two cards are separated by this stack's gap, not by a margin of their own. *@
                <OmniStack>
                <OmniCard Class="@("iam-detail-card iam-role-assignment-card" + (_savingRoles ? " iam-autosave-busy" : ""))">
                    <RoleAssignmentPicker SelectedRoles="@_model.Roles"
                        SelectedRolesChanged="@OnRolesChangedAsync"
                        SelectedOrganizationRoles="@_model.OrganizationRoles"
                        SelectedOrganizationRolesChanged="@OnOrganizationRolesChangedAsync" Disabled="@_savingRoles" />
                </OmniCard>


                <OmniCard Class="iam-detail-card">
                    @* R-14: the title and the grid are separated by this stack's gap, not by a margin. *@
                    <OmniStack>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                        <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["EffectivePermissions"]</OmniText>
                        @* No Refresh, a change to users, roles or organizations reloads them. *@
                    </OmniStack>
                    @if (_effectivePermissions is not null)
                    {
                        @if (_effectivePermissions.Count == 0)
                        {
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["NoPermissionsAssigned"]</OmniText>
                        }
                        else
                        {
                            <OmniDataGrid @ref="_permissionsGrid" ExportTitle="@ExportContext.Title(L["EffectivePermissions"])" ExportFields="@ExportContext.Fields()" FillAvailableHeight="true" TItem="EffectivePermissionDto" Items="@_effectivePermissions" KeyOf="@PermissionKey" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
                                <Columns>
                                    <OmniDataGridColumn Frozen="true" TItem="EffectivePermissionDto" Property="ResourceType" Title="@L["ResourceType"]" Width="10rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" FormatFilterValue="@PlainText">
                                        <Template Context="perm">
                                            <OmniText Element="OmniTextElement.Paragraph">@L[perm.ResourceType.ToString()]</OmniText>
                                        </Template>
                                    </OmniDataGridColumn>
                                    <OmniDataGridColumn TItem="EffectivePermissionDto" Property="Permission" Title="@L["Permission"]" Width="7.5rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@PlainText">
                                        <Template Context="perm">
                                            <OmniBadge Icon="@(BadgeIcon.For(GetPermissionBadgeStyle(perm.Permission)))" Fill="OmniFill.Solid" Tone="@GetPermissionBadgeStyle(perm.Permission)">@L[perm.Permission.ToString()]</OmniBadge>
                                        </Template>
                                    </OmniDataGridColumn>
                                    <OmniDataGridColumn TItem="EffectivePermissionDto" Property="GrantedByRole"
 Title="@L["GrantedByRole"]" Width="9.375rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" />
                                </Columns>
                            </OmniDataGrid>
                        }
                    }
                    </OmniStack>
                </OmniCard>
                </OmniStack>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="organizations" Title="@L["Organizations"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("apartment")" /></Icon><ChildContent>
                <OmniCard Class="iam-detail-card">
                @if (_loadingOrgs)
                {
                    <AetheusLoader />
                }
                else
                {
                    @* R-14: the add row and the grid are separated by this stack's gap, not by margins. *@
                    <OmniStack>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Align="OmniAlignment.End" Gap="OmniSpacing.Small">
                        <OmniFormField Label="@L["Organization"]" For="oe-formfield-pages-users-useredit-1">
                            <OmniDropDown Id="oe-formfield-pages-users-useredit-1" TValue="int?" Options="@(_availableOrgs.ToOptions(item => (int?)item.Id, item => item.Name))"
                                @bind-Value="_selectedOrgId" Filterable="true" AllowEmpty="true" Placeholder="@L["SelectOrganization"]" />
                        </OmniFormField>
                        <OmniFormField Label="@L["Role"]" For="oe-formfield-pages-users-useredit-2">
                            <OmniDropDown Id="oe-formfield-pages-users-useredit-2" TValue="OrganizationRole" Options="@(_orgRoleOptions.ToOptions(item => (OrganizationRole)item.Value, item => item.Text))" @bind-Value="_newOrgRole" />
                        </OmniFormField>
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OnAddOrg" Disabled="@(_selectedOrgId is null)" Class="@(_addingOrg ? "btn-busy" : null)" Busy="@(_addingOrg)"><Icon><OmniIcon Name="OmniIconName.UserPlus" /></Icon><ChildContent><span>@L["AddToOrganization"]</span></ChildContent></OmniButton>
                    </OmniStack>
                    @if (_userOrgs.Count == 0)
                    {
                        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["NoOrganizations"]</OmniText>
                    }
                    else
                    {
                        <OmniDataGrid FillAvailableHeight="true" TItem="UserOrganizationDto" ExportTitle="@ExportContext.Title(L["Organizations"])" ExportFields="@ExportContext.Fields()" Items="@_userOrgs"
                            OnRowClick="@(args => Nav.NavigateTo($"/admin/organizations/{args.Item.OrganizationId}"))" Class="aetheus-clickable-rows" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
                            <Columns>
                                <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="UserOrganizationDto" Property="Name" Title="@L["Organization"]" Filterable="true">
                                    <Template Context="o">
                                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><OmniLink Href="@($"/admin/organizations/{o.OrganizationId}")">@o.Name</OmniLink></span>
                                    </Template>
                                </OmniDataGridColumn>
                                <OmniDataGridColumn TItem="UserOrganizationDto" Property="Slug" Title="@L["Slug"]" Filterable="true" />
                                <OmniDataGridColumn TItem="UserOrganizationDto" Property="Role" Title="@L["Role"]" Width="11.25rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@OrgRoleText">
                                    <Template Context="o">
                                        <OmniDropDown aria-label="@L["Role"]" TValue="OrganizationRole" Value="@o.Role" ValueExpression="@(() => o.Role)" Options="@(_orgRoleOptions.ToOptions(item => (OrganizationRole)item.Value, item => item.Text))"
                                            ValueChanged="@(args => OnChangeOrgRole(o, (OrganizationRole)args!))" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" />
                                    </Template>
                                </OmniDataGridColumn>
                                <OmniDataGridColumn TItem="UserOrganizationDto" Title="@L["Actions"]" Width="5rem" TextAlign="OmniAlignment.Center" Sortable="false">
                                    <Template Context="o">
                                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => OnRemoveOrg(o))" title="@L["Remove"]"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton></span>
                                    </Template>
                                </OmniDataGridColumn>
                            </Columns>
                        </OmniDataGrid>
                    }
                    </OmniStack>
                }
                </OmniCard>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="security" Title="@L["Security"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("security")" /></Icon><ChildContent>
                @* R-5: the security panels are OE tiles of one OmniTileGrid (same width, same height). *@
                <OmniTileGrid Columns="2">
                <OmniCard Class="iam-detail-card">
                    <OmniText Element="OmniTextElement.Title" Class="omni-u-mb-sm">@L["ChangePassword"]</OmniText>
                    <OmniTemplateForm TModel="PasswordChangeModel" Model="@_passwordChange"
                        OnValidSubmit="@((EditContext context) => OnChangePassword((PasswordChangeModel)context.Model))"
                        OnInvalidSubmit="@OnInvalidPasswordSubmit">
                    <OmniDataAnnotationsValidator Localizer="@L" />
                    <OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Gap="OmniSpacing.Small" Align="OmniAlignment.End">
                        <OmniFormField For="oe-pages-users-useredit-8"><LabelContent>@L["NewPassword"]</LabelContent><ChildContent>
                            <OmniPassword @bind-Value="_passwordChange.NewPassword" Id="oe-pages-users-useredit-8" />
                            <ValidationMessage For="@(() => _passwordChange.NewPassword)" />
                        </ChildContent></OmniFormField>
                        <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_changingPassword ? "btn-busy" : null)" Busy="@(_changingPassword)"><Icon><OmniIcon Name="OmniIconName.LockKey" /></Icon><ChildContent><span>@L["ChangePassword"]</span></ChildContent></OmniButton>
                    </OmniStack>
                    </OmniTemplateForm>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.XSmall" Class="omni-u-mt-sm">
                        <OmniIcon Name="@MaterialIconMap.Resolve(PasswordMeetsRules ? "check_circle" : "info")" Class="@(PasswordMeetsRules ? "omni-u-text-success" : "omni-u-text-muted")" />
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="@(PasswordMeetsRules ? "omni-u-text-success" : "omni-u-text-muted")">@L["PasswordMinLength"]</OmniText>
                    </OmniStack>
                    @* R-14: or let the person choose it, from a new link sent to their address. *@
                    <OmniStack Gap="OmniSpacing.Small" Class="omni-u-mt-sm user-password-link">
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@L["SendPasswordLinkHelp"]</OmniText>
                        <div>
                            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@OnSendPasswordLink" Class="@("user-send-password-link" + (_sendingLink ? " btn-busy" : null))" Busy="@(_sendingLink)"><Icon><OmniIcon Name="OmniIconName.PaperPlaneRight" /></Icon><ChildContent><span>@L["SendPasswordLink"]</span></ChildContent></OmniButton>
                        </div>
                        @if (_linkResult is { } linkResult)
                        {
                            <PasswordLinkMailAlert Result="@linkResult" />
                        }
                        @if (!string.IsNullOrEmpty(_linkError))
                        {
                            <OmniAlert Severity="OmniSeverity.Danger" Class="user-password-link-error"><ChildContent>@_linkError</ChildContent></OmniAlert>
                        }
                    </OmniStack>
                </OmniCard>

                @if (_user is not null)
                {
                    <OmniCard Class="iam-detail-card">
                        <OmniText Element="OmniTextElement.Title" Class="omni-u-mb-sm">@L["Information"]</OmniText>
                        <OmniStack Gap="OmniSpacing.Small">
                            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small">
                                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted detail-label">@L["TotpEnabled"]</OmniText>
                                <OmniBadge Icon="@(BadgeIcon.ForState(_user.TotpEnabled ? OmniTone.Success : OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="@(_user.TotpEnabled ? OmniTone.Success : OmniTone.Neutral)">@(_user.TotpEnabled ? L["Enabled"] : L["Disabled"])</OmniBadge>
                            </OmniStack>
                            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small">
                                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted detail-label">@L["Created"]</OmniText>
                                <OmniText Element="OmniTextElement.Paragraph">@_user.CreatedAt.ToString("g")</OmniText>
                            </OmniStack>
                            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small">
                                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted detail-label">@L["LastModified"]</OmniText>
                                <OmniText Element="OmniTextElement.Paragraph">@_user.UpdatedAt.ToString("g")</OmniText>
                            </OmniStack>
                        </OmniStack>
                    </OmniCard>
                }
                </OmniTileGrid>
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="pipelines" Title="@L["OwnedPipelines"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("account_tree")" /></Icon><ChildContent>
                @if (_user is not null)
                {
                    <UserOwnedPipelines Username="@_user.Username" />
                }
            </ChildContent></OmniTabsItem>

            <OmniTabsItem Key="audit" Title="@L["AuditTrail"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("history")" /></Icon><ChildContent>
                <EntityAuditTrail EntityType="User" EntityId="@Id!.Value" />
            </ChildContent></OmniTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}
</div>
