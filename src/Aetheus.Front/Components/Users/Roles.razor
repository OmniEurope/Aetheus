@page "/admin/roles"

<PageTitle>@L["Roles"] - Aetheus</PageTitle>

<div class="iam-page iam-list-page">
    <OmniPageHeader Title="@L["Roles"]" Class="iam-page-header" Subtitle="@Breadcrumb.Subtitle(L["RBACManagement"])">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("admin_panel_settings")" /></Icon>
        <Badges>
        </Badges>
        <Actions>
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OnCreate" title="@L["NewRole"]"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
        </Actions>
    </OmniPageHeader>

    <AdminIdentityNav ActiveSection="roles" />

    @* PLAN-003 lot 15 / D28: the grid is only rendered for an admin. The shared wrapper asks for
       its first page as soon as it renders, so leaving it in the markup for a visitor the guard is
       redirecting away would fetch the role list on their behalf. *@
    @if (Auth.IsAdmin)
    {
    <div class="iam-grid-surface">
        <AetheusDataGrid @ref="_grid" TItem="RoleDto" Data="@_roles" Count="@_totalCount"
                LoadData="@LoadDataAsync" ExportRead="@ReadExportAsync" PageSize="20" IsLoading="@_loading"
                Virtualize="@AetheusGrid.RemoteVirtualization"
                VirtualData="@(() => new OmniDataGridResult<RoleDto>(_roles, _totalCount))"
                FullHeight="true" RowClick="@OnRowClick">
            <Columns>
                <OmniDataGridColumn Frozen="true" TItem="RoleDto" Property="Name" Title="@L["Name"]" MinWidth="180px" Filterable="true" >
                    <Template Context="role">
                        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Medium">
                            <a href="/admin/roles/@role.Id" class="server-name-link" @onclick:stopPropagation="true">@role.Name</a>
                        </OmniStack>
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="RoleDto" Property="Description" Title="@L["Description"]" MinWidth="240px" Filterable="true" >
                    <Template Context="role">@LocalizeDescription(role)</Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="RoleDto" Property="PermissionCount" Title="@L["Permissions"]" Width="150px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" FilterOperator="OmniDataGridFilterOperator.Equals" >
                    <Template Context="role"><CountBadge Value="@role.PermissionCount" Variant="OmniTone.Neutral" /></Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="RoleDto" Property="UserCount" Title="@L["Users"]" Width="130px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" FilterOperator="OmniDataGridFilterOperator.Equals" />
                <OmniDataGridColumn TItem="RoleDto" Title="@L["Actions"]" Width="120px" Sortable="false" Filterable="false" >
                    <Template Context="role">
                        <span @onclick:stopPropagation="true">
                            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OnClone(role))" title="@L["CloneRole"]"><OmniIcon Name="OmniIconName.Copy" /></OmniButton>
                            @if (role.Name != "Admin")
                            {
                                <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => OnDelete(role))" title="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                            }
                        </span>
                    </Template>
                </OmniDataGridColumn>
            </Columns>
        </AetheusDataGrid>
    </div>
    }
</div>
