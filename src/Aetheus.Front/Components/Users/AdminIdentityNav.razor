@namespace Aetheus.Front.Components.Users
@* The section links, then the one search of the three sections on their right. A section shows its
   result count in brackets only when it has at least one. *@
<div class="iam-section-bar">
    <nav class="iam-section-nav" aria-label="@L["Administration"]">
        <a href="/admin/users" class="@LinkClass(AdminIdentitySearch.UsersSection)" aria-current="@AriaCurrent(AdminIdentitySearch.UsersSection)">
            <OmniIcon Name="OmniIconName.Users" />
            <span>@LinkText(L["Users"], AdminIdentitySearch.UsersSection)</span>
        </a>
        <a href="/admin/organizations" class="@LinkClass(AdminIdentitySearch.OrganizationsSection)" aria-current="@AriaCurrent(AdminIdentitySearch.OrganizationsSection)">
            <OmniIcon Name="OmniIconName.Buildings" />
            <span>@LinkText(L["Organizations"], AdminIdentitySearch.OrganizationsSection)</span>
        </a>
        <a href="/admin/roles" class="@LinkClass(AdminIdentitySearch.RolesSection)" aria-current="@AriaCurrent(AdminIdentitySearch.RolesSection)">
            <OmniIcon Name="OmniIconName.ShieldCheck" />
            <span>@LinkText(L["Roles"], AdminIdentitySearch.RolesSection)</span>
        </a>
    </nav>
    <OmniTextBox Value="@Search.Term" ValueChanged="OnTermChangedAsync" ValueExpression="@(() => Search.Term)"
                 Debounce="@(TimeSpan.FromMilliseconds(300))" Placeholder="@L["Search"]" aria-label="@L["Search"]"
                 Class="iam-section-search" />
</div>
