@namespace Aetheus.Front.Components.Users
@* R-7: the Users, Organizations and Roles pages as three OE tabs, each tab its own route. The tabs hold no
   panel content (the page below is the content of the selected tab): selecting a tab navigates, and the side
   menu, which follows the URL, highlights the same entry (R-20). An organization's administrator sees the tabs
   its permissions open, and the organization switcher when it administers several (owner decision 2026-10-28). *@
<OmniTabs Value="@ActiveSection" ValueChanged="OnTabChanged" Label="@L["Administration"]" Class="iam-section-tabs">
    @if (Shows(UsersSection))
    {
        <OmniTabsItem Key="@UsersSection" Title="@L["Users"]"><Icon><OmniIcon Name="OmniIconName.Users" /></Icon></OmniTabsItem>
    }
    @if (Shows(OrganizationsSection))
    {
        <OmniTabsItem Key="@OrganizationsSection" Title="@L["Organizations"]"><Icon><OmniIcon Name="OmniIconName.Buildings" /></Icon></OmniTabsItem>
    }
    @if (Shows(RolesSection))
    {
        <OmniTabsItem Key="@RolesSection" Title="@L["Roles"]"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon></OmniTabsItem>
    }
</OmniTabs>
<AdministrationOrganizationSwitcher PermissionKey="@SwitcherKey" Changed="@OrganizationChanged" />
