@namespace Aetheus.Front.Components.Users

<OmniCard Class="iam-detail-card">
    <AetheusDataGrid TItem="AuditLogDto" RowClick="@(log => ShowDetailsAsync(log))" Data="@_logs" Count="@_count"
        LoadData="@LoadDataAsync" ExportRead="@ReadExportAsync" PageSize="25" IsLoading="@_loading"
        AllowSorting="true" Density="OmniDensity.Compact"
        Virtualize="@AetheusGrid.RemoteVirtualization"
        VirtualData="@(() => new OmniDataGridResult<AuditLogDto>(_logs, _count))">
        <Columns>
            @* The header filters are sent to the audit endpoint, the timestamp as a range. *@
            <OmniDataGridColumn Frozen="true" TItem="AuditLogDto" Property="Timestamp" Title="@L["Timestamp"]" Width="180px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" >
                <Template Context="log">
                    <span title="@log.Timestamp.ToString("F")">@RelativeTime.FormatAgo(L, log.Timestamp)</span>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AuditLogDto" Property="Username" Title="@L["User"]" Width="150px" Filterable="true" />
            <OmniDataGridColumn TItem="AuditLogDto" Property="Action" Title="@L["Action"]" Width="220px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_actionOptions" FormatFilterValue="@ActionFilterText" FilterSearchable="true" >
                <Template Context="log">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@GetActionBadge(log.Action)">@ActionText(log.Action)</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AuditLogDto" Property="Details" Title="@L["Details"]" Filterable="true" />
            <OmniDataGridColumn TItem="AuditLogDto" Title="@L["Actions"]" Width="150px" Sortable="false" Filterable="false">
                <Template Context="log">
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ShowDetailsAsync(log))" title="@L["ViewDetails"]" Label="@L["ViewDetails"]"><OmniIcon Name="OmniIconName.Eye" /></OmniButton>
                    </span>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
</OmniCard>
