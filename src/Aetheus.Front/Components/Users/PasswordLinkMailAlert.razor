@* R-14: what became of a set-password mail (welcome or new link), said as it happened: a mail that did not
   leave is a warning or an error with the server's reason, never a success. *@
<OmniAlert Severity="@Severity" Class="@CssClass" Live="@(Result.Status != WelcomeMailStatus.Sent)">
    <ChildContent>@Text</ChildContent>
</OmniAlert>
