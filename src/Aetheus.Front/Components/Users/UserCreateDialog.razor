<OmniTemplateForm TModel="UserModel" Model="@_model" OnValidSubmit="@OnSubmit">
    <OmniDataAnnotationsValidator Localizer="@L" />
    <OmniStack Gap="OmniSpacing.Large">
        <OmniFormField For="oe-pages-users-usercreatedialog-1"><LabelContent>@L["Username"]</LabelContent><ChildContent>
            <OmniTextBox @bind-Value="_model.Username" aria-label="@L["Username"]" Id="oe-pages-users-usercreatedialog-1" />
            <ValidationMessage For="@(() => _model.Username)" />
        </ChildContent></OmniFormField>

        <OmniFormField For="oe-pages-users-usercreatedialog-2"><LabelContent>@L["Email"]</LabelContent><ChildContent>
            <OmniTextBox @bind-Value="_model.Email" aria-label="@L["Email"]" Id="oe-pages-users-usercreatedialog-2" />
            <ValidationMessage For="@(() => _model.Email)" />
        </ChildContent></OmniFormField>

        @* OE removed OmniFormField.Helper: the validation message sits right under the field, as the
           helper slot drew it, without the stack gap between them. *@
        <div>
            <OmniFormField Label="@L["Password"]" For="Password">
                <ChildContent>
                    @if (_showPassword)
                    {
                        <OmniTextBox @bind-Value="_model.Password" Id="Password" aria-label="@L["Password"]" />
                    }
                    else
                    {
                        @* One reveal control only : the dialog's own toggle, because generating a
                           password must show it; OmniPassword's built-in eye is turned off. *@
                        <OmniPassword @bind-Value="_model.Password" Id="Password" aria-label="@L["Password"]" Revealable="false" />
                    }
                </ChildContent>
                <EndContent>
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ToggleShowPassword" ButtonType="OmniButtonType.Button" title="@(_showPassword ? L["HidePassword"] : L["ShowPassword"])" Label="@(_showPassword ? L["HidePassword"] : L["ShowPassword"])"><OmniIcon Name="@MaterialIconMap.Resolve((_showPassword ? "visibility_off" : "visibility"))" /></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@GeneratePassword" title="@L["GeneratePassword"]" Label="@L["GeneratePassword"]"><OmniIcon Name="OmniIconName.Sync" /></OmniButton>
                </EndContent>
            </OmniFormField>
            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        <div>
            <RoleAssignmentPicker @bind-SelectedRoles="_model.Roles" InitialRoles="@AvailableRoles" />
        </div>

        <OmniCheckBox @bind-Value="_model.MustChangePassword">@L["MustChangePassword"]</OmniCheckBox>

        @if (!string.IsNullOrEmpty(_error))
        {
            <OmniAlert Severity="OmniSeverity.Danger"><Icon><OmniIcon Name="OmniIconName.Error" /></Icon><ChildContent>@_error</ChildContent></OmniAlert>
        }

        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Justify="OmniJustification.End" Class="omni-u-mt-sm">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><OmniIcon Name="OmniIconName.UserPlus" /> <span>@L["Create"]</span></OmniButton>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@Cancel"><OmniIcon Name="OmniIconName.Close" /> <span>@L["Cancel"]</span></OmniButton>
        </OmniStack>
    </OmniStack>
</OmniTemplateForm>
