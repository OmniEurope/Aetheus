@page "/alerts"

<PageTitle>@L["Alerts"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["Alerts"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("notifications")" /></Icon>
    <Badges>
        <HelpLink PageKey="alerts" />
    </Badges>
    <Actions>
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenCreateDialogAsync"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
    </Actions>
</OmniPageHeader>

@if (_recent.Count > 0)
{
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="omni-u-mb-sm" Gap="OmniSpacing.Large">
        <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["RecentAlerts"] (@_recent.Count)</OmniHeading>
        @* Recette R-405: the section's action sits in its action menu, named after what it does: it empties
           this session's list of recent alerts (and the unread count), it does not mark them read. *@
        <OmniOverflowMenu Label="@L["MoreActions"]">
            <OmniMenuItem OnClick="@(() => AlertNotify.ClearRecent())"><Icon><OmniIcon Name="OmniIconName.Broom" /></Icon><ChildContent>@L["ClearRecentAlerts"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    </OmniStack>
    @* Recette R-198: never a pager; the list keeps at most AlertNotificationService.MaxRecent (50) alerts. *@
    @* Recette R-227: a fired alert has no id; its trigger instant tells the rows apart for the bold new-row mark. *@
    <AetheusDataGrid @ref="_recentGrid" ExportName="@L["RecentAlerts"]" Data="@_recent" TItem="AlertTriggeredDto" PageSize="50" Virtualize="@(_recent.Count > 50)" KeyProperty="TriggeredAt" class="omni-u-mb-2xl">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="AlertTriggeredDto" Property="TriggeredAt" Title="@L["TriggeredAt"]" Width="170px" FormatString="{0:g}" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" />
            <OmniDataGridColumn TItem="AlertTriggeredDto" Property="Severity" Title="@L["Severity"]" Width="120px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@SeverityText" >
                <Template Context="a"><OmniBadge Fill="OmniFill.Solid" Tone="@RecentSeverityBadge(a.Severity)">@a.Severity</OmniBadge></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AlertTriggeredDto" Property="ServerName" Title="@L["Server"]" Width="170px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" />
            <OmniDataGridColumn TItem="AlertTriggeredDto" Property="Message" Title="@L["AlertMessage"]" Filterable="true" />
        </Columns>
    </AetheusDataGrid>
}

<OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mb-sm">@L["AlertRules"]</OmniHeading>
@* Recette R-198 (rule R-049): the rules scroll in a virtualized full-height grid, no pager. *@
<AetheusDataGrid @ref="_rulesGrid" ExportName="@L["AlertRules"]" FullHeight="true" Virtualize="true" Data="@_alerts" TItem="AlertRuleDto" IsLoading="@_loading" class="aetheus-grid-fullheight">
        <EmptyTemplate>
            <EmptyState Icon="notifications_off" Title="@L["NoAlerts"]" Description="@L["NoAlertsDescription"]" />
        </EmptyTemplate>
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="AlertRuleDto" Property="Name" Title="@L["AlertName"]" MinWidth="10rem" Filterable="true" />
            <OmniDataGridColumn TItem="AlertRuleDto" Property="Severity" Title="@L["Severity"]" Width="130px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@SeverityText" >
                <Template Context="alert">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@GetSeverityBadgeStyle(alert.Severity)">@L.Localize(alert.Severity)</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AlertRuleDto" Property="Metric" Title="@L["Metric"]" Width="130px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@MetricText" >
                <Template Context="alert">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@GetMetricBadgeStyle(alert.Metric)">@L.Localize(alert.Metric)</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AlertRuleDto" Title="@L["Threshold"]" ExportValue="@ThresholdExport" Width="140px" Filterable="false" >
                <Template Context="alert">
                    @alert.Operator @AlertThresholdUnit.Format(alert.Metric, alert.Threshold)
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AlertRuleDto" Property="SustainedSeconds" Title="@L["SustainedSeconds"]" Width="140px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
            <OmniDataGridColumn TItem="AlertRuleDto" Property="IsEnabled" Title="@L["Status"]" Width="110px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@EnabledText" >
                <Template Context="alert">
                    @if (alert.IsEnabled)
                    {
                        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Success">@L["Active"]</OmniBadge>
                    }
                    else
                    {
                        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L["Disabled"]</OmniBadge>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AlertRuleDto" Property="LastTriggeredAt" Title="@L["LastTriggered"]" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" >
                <Template Context="alert">
                    @if (alert.LastTriggeredAt.HasValue)
                    {
                        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Danger">@alert.LastTriggeredAt.Value.ToString("g")</OmniBadge>
                    }
                    else
                    {
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">-</OmniText>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AlertRuleDto" Title="@L["Actions"]" MinWidth="14rem" Sortable="false" Filterable="false" >
                <Template Context="alert">
                    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenEditDialogAsync(alert))" title="@L["Edit"]" Label="@L["Edit"]"><OmniIcon Name="OmniIconName.Edit" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteAlert(alert.Id))" title="@L["Delete"]" Label="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                    </OmniStack>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
