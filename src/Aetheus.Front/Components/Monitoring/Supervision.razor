@page "/monitoring"
@inherits EntityLiveListBase
@inject Aetheus.Front.Components.Shared.BreadcrumbService Breadcrumb

@* Show monitored applications across projects with status, online audience and the latest received
   event. *@
<PageTitle>@L["Supervision"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["Supervision"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("monitor_heart")" /></Icon>
    <Badges>
        <HelpLink PageKey="supervision" />
    </Badges>
</OmniPageHeader>


<OmniStack Class="page-fill-body">
@if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger">
        @L["GridLoadFailed"]
    </OmniAlert>
}
else
{
    @* Everything at a glance, all applications together, above their list. *@
    @if (_summary is not null)
    {
        <OmniTileGrid Columns="4" Gap="OmniSpacing.Small" Class="supervision-totals">
            <OmniStatTile Value="@Number(_summary.TotalCount)" Title="@L["MonitoredApps"]" Detail="@AppsDetail" />
            @if (_summary.Audience is { } audience)
            {
                <OmniStatTile Value="@Number(audience.OnlineVisitors)" Title="@L["CurrentVisitors"]" />
                <OmniStatTile Value="@Number(audience.VisitorsToday)" Title="@L["UniqueVisitorsToday"]" />
                <OmniStatTile Value="@Number(audience.VisitorsThisWeek)" Title="@L["UniqueVisitorsThisWeek"]" />
                <OmniStatTile Value="@Number(audience.VisitorsThisMonth)" Title="@L["UniqueVisitorsThisMonth"]" />
                <OmniStatTile Value="@Number(audience.SessionsThisMonth)" Title="@L["SessionsThisMonth"]" />
                <OmniStatTile Value="@Number(audience.PageViewsThisMonth)" Title="@L["PageViewsThisMonth"]" />
            }
        </OmniTileGrid>
        @if (_summary.Audience is { ApplicationCount: > 1 })
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="supervision-totals-note">@L["SupervisionAudienceNote"]</OmniText>
        }
    }
    <SupervisionProjectsGrid Applications="@_summary?.Applications" Storage="@_storage" StorageFailed="@_storageFailed"
        IsLoading="@(_summary is null || _storageLoading)" ShowReclaimLink="@Auth.IsAdmin" />
    @if (Auth.IsAdmin)
    {
        <ReclaimSpaceView />
    }
}
</OmniStack>
