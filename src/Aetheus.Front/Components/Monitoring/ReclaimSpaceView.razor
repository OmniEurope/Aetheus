@* Offer administrator-confirmed VACUUM FULL per purged table to return disk space, refusing while
   pipelines run. *@
<div id="reclaim-space">
<OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-xl omni-u-mb-sm">@L["ReclaimSpace"]
    <OmniTooltip Text="@L["ReclaimSpaceHelp"]" Focusable="true" MaxWidth="OmniTooltipWidth.Wide">
        <span role="img" aria-label="@L["ReclaimSpaceHelp"]" data-testid="reclaim-space-help"><OmniIcon Name="OmniIconName.Question" aria-hidden="true" /></span>
    </OmniTooltip>
</OmniHeading>
@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else if (_loadFailed || _status is null)
{
    <EmptyState Icon="error" Title="@L["LoadFailed"]" />
}
else
{
    @if (_status.ActivePipelineRuns > 0)
    {
        <OmniAlert Severity="OmniSeverity.Warning" Class="omni-u-mb-md" data-testid="reclaim-space-busy">@string.Format(System.Globalization.CultureInfo.CurrentCulture, L["ReclaimSpacePipelinesRunning"], _status.ActivePipelineRuns)</OmniAlert>
    }
    @if (_status.RunningTable is { } running)
    {
        <OmniAlert Severity="OmniSeverity.Info" Class="omni-u-mb-md" data-testid="reclaim-space-running">@string.Format(System.Globalization.CultureInfo.CurrentCulture, L["ReclaimSpaceRunning"], running)</OmniAlert>
    }
    <AetheusDataGrid Data="@_status.Tables" TItem="ReclaimSpaceTableDto" KeyProperty="Table" Virtualize="true" class="omni-u-mb-sm reclaim-space-grid">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="ReclaimSpaceTableDto" Property="Table" Title="@L["AppDatabaseTable"]">
                <Template Context="table"><code>@table.Table</code></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ReclaimSpaceTableDto" Property="Bytes" Title="@L["Size"]" Width="9rem" TextAlign="OmniAlignment.End" Filterable="false">
                <Template Context="table">@Megabytes(table.Bytes)</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ReclaimSpaceTableDto" Title="@L["Actions"]" Width="6rem" Sortable="false" Filterable="false">
                <Template Context="table">
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ReclaimAsync(table.Table))" Disabled="@(!CanStart)"
                        title="@L["ReclaimSpaceAction"]" aria-label="@L["ReclaimSpaceAction"]" data-testid="reclaim-space-start"><Icon><OmniIcon Name="OmniIconName.Broom" /></Icon></OmniButton>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
    @if (_status.History.Count > 0)
    {
        <AetheusDataGrid Data="@_status.History" TItem="ReclaimSpaceResultDto" ExportName="@L["History"]" KeyProperty="" Virtualize="true" class="omni-u-mb-sm reclaim-space-history">
            <Columns>
                <OmniDataGridColumn TItem="ReclaimSpaceResultDto" Property="StartedAt" Title="@L["ReclaimSpaceStartedAt"]" Width="10rem" Filterable="false">
                    <Template Context="result">@result.StartedAt.ToString("g", System.Globalization.CultureInfo.CurrentCulture)</Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="ReclaimSpaceResultDto" Property="Table" Title="@L["AppDatabaseTable"]">
                    <Template Context="result"><code>@result.Table</code></Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="ReclaimSpaceResultDto" Property="BytesBefore" Title="@L["ReclaimSpaceBefore"]" Width="8rem" TextAlign="OmniAlignment.End" Filterable="false">
                    <Template Context="result">@Megabytes(result.BytesBefore)</Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="ReclaimSpaceResultDto" Property="BytesAfter" Title="@L["ReclaimSpaceAfter"]" Width="8rem" TextAlign="OmniAlignment.End" Filterable="false">
                    <Template Context="result"><span data-testid="reclaim-space-after">@Megabytes(result.BytesAfter)</span></Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="ReclaimSpaceResultDto" Property="Succeeded" Title="@L["Status"]" Width="9rem" Filterable="false">
                    <Template Context="result"><OmniBadge Width="OmniBadgeWidth.Medium" Tone="@ResultTone(result)" Fill="OmniFill.Tonal">@ResultText(result)</OmniBadge></Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="ReclaimSpaceResultDto" Property="RequestedBy" Title="@L["ReclaimSpaceRequestedBy"]" Width="9rem" />
            </Columns>
        </AetheusDataGrid>
    }
}
</div>
