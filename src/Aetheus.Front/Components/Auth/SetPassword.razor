@page "/login/set-password"

<PageTitle>@L["PasswordSetupTitle"] - Aetheus</PageTitle>

@* R-14: the page of the welcome mail's link. Under /login, so a signed-out visitor stays on it; the
   token is read from the address fragment, which the browser never sends to a server. *@
<OmniLoginShell Title="@L["PasswordSetupTitle"]" Class="login-container">
    <Logo>
        <img src="aetheus-icon.svg" alt="Aetheus" class="login-logo-img" />
    </Logo>
    <ChildContent>
        @if (_token is null)
        {
            <OmniAlert Severity="OmniSeverity.Danger" Class="password-setup-invalid"><Icon><OmniIcon Name="OmniIconName.Error" /></Icon><ChildContent>
                @L["PasswordSetupInvalidLink"]
            </ChildContent></OmniAlert>
        }
        else
        {
            <OmniTemplateForm TModel="PasswordSetupModel" Model="@_model" OnValidSubmit="@OnSubmit">
                <OmniDataAnnotationsValidator Localizer="@L" />
                <OmniStack Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["PasswordSetupIntro"]</OmniText>
                    <OmniFormField Label="@L["NewPassword"]" For="NewPassword" Required="true">
                        <ChildContent>
                            <OmniPassword @bind-Value="_model.NewPassword" Id="NewPassword" aria-label="@L["NewPassword"]"
                                          RevealLabel="@L["ShowPassword"]" HideLabel="@L["HidePassword"]" />
                            <ValidationMessage For="@(() => _model.NewPassword)" />
                        </ChildContent>
                    </OmniFormField>
                    <OmniFormField Label="@L["ConfirmPassword"]" For="ConfirmPassword" Required="true">
                        <ChildContent>
                            <OmniPassword @bind-Value="_model.ConfirmPassword" Id="ConfirmPassword" aria-label="@L["ConfirmPassword"]"
                                          RevealLabel="@L["ShowPassword"]" HideLabel="@L["HidePassword"]" />
                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </ChildContent>
                    </OmniFormField>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <OmniAlert Severity="OmniSeverity.Danger" Class="password-setup-error"><Icon><OmniIcon Name="OmniIconName.Error" /></Icon><ChildContent>@_error</ChildContent></OmniAlert>
                    }

                    <OmniStack Orientation="OmniOrientation.Horizontal" Justify="OmniJustification.End" Gap="OmniSpacing.Small">
                        <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)" Label="@L["Save"]"><Icon><OmniIcon Name="OmniIconName.LockKey" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
                    </OmniStack>
                </OmniStack>
            </OmniTemplateForm>
        }
    </ChildContent>
    <FooterContent>
        <OmniLink Href="/login" Class="password-setup-login-link">@L["Login"]</OmniLink>
    </FooterContent>
</OmniLoginShell>
