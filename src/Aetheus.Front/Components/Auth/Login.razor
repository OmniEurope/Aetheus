@page "/login"

<PageTitle>@L["Login"] - Aetheus</PageTitle>

@* The package's sign-in layout (logo, card, footer). `login-container` keeps the shared login and
   change-password rules (field widths) and the E2E selectors on the same element. *@
<OmniLoginShell Title="@L["Login"]" Class="login-container">
    <Logo>
        <img src="aetheus-icon.svg" alt="Aetheus" class="login-logo-img" />
    </Logo>
    <ChildContent>
        <OmniStack>
        @if (_isPublicDemo)
        {
            @* The demo account in two read-only fields, each with OE's Copy button welded to its
               end, and a button that writes both into the sign-in form below. *@
            <OmniAlert Severity="OmniSeverity.Info" Class="public-demo-account"><Icon><OmniIcon Name="OmniIconName.Info" /></Icon><ChildContent>
                <OmniStack Gap="OmniSpacing.Small">
                    <OmniText Element="OmniTextElement.Strong">@L["PublicDemo"]</OmniText>
                    @* The demo data is reset every evening (recette R-61): said once, under the title. *@
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="public-demo-reset-notice">@L["PublicDemoResetNotice"]</OmniText>
                    <OmniFormField Label="@L["LoginEmail"]" For="public-demo-email">
                        <OmniTextBox Value="@DemoEmail" ReadOnly="true" ShowCopy="true" CopyIconOnly="true" OnCopy="@OnDemoValueCopied"
                                     Id="public-demo-email" ValueExpression="@(() => DemoEmail)" />
                    </OmniFormField>
                    <OmniFormField Label="@L["Password"]" For="public-demo-password">
                        <OmniTextBox Value="@DemoPassword" ReadOnly="true" ShowCopy="true" CopyIconOnly="true" OnCopy="@OnDemoValueCopied"
                                     Id="public-demo-password" ValueExpression="@(() => DemoPassword)" />
                    </OmniFormField>
                    <OmniStack Orientation="OmniOrientation.Horizontal" Justify="OmniJustification.End" Gap="OmniSpacing.Small">
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@FillWithPublicDemoAccount" Class="public-demo-fill"><Icon><OmniIcon Name="OmniIconName.ArrowLineDown" /></Icon><ChildContent><span>@L["PublicDemoFillForm"]</span></ChildContent></OmniButton>
                    </OmniStack>
                </OmniStack>
            </ChildContent></OmniAlert>
        }

        @* Signing in saves nothing, so leaving the page never asks (the forgotten password link is
           a navigation of this very page). *@
        <OmniTemplateForm TModel="LoginModel" Model="@_model" OnValidSubmit="@OnSubmit" GuardUnsavedChanges="false">
            <OmniDataAnnotationsValidator Localizer="@L" />
            <OmniStack Gap="OmniSpacing.Large">
                @* PLAN-003 P3-2: people sign in by e-mail address. *@
                <OmniFormField Label="@L["LoginEmail"]" For="Email">
                    <OmniTextBox @bind-Value="_model.Email" Type="OmniTextBoxType.Email" Autocomplete="username"
                                 Id="Email" aria-label="@L["LoginEmail"]" />
                    <OmniRequiredValidator TValue="string" For="@(() => _model.Email)" Message="@L["EmailRequired"]" />
                </OmniFormField>
                <OmniFormField Label="@L["Password"]" For="Password">
                    <ChildContent>
                        @* Use the password field built-in reveal control without a duplicate
                           toggle. *@
                        <OmniPassword @bind-Value="_model.Password" Id="Password" aria-label="@L["Password"]"
                                      RevealLabel="@L["ShowPassword"]" HideLabel="@L["HidePassword"]" />
                        <OmniRequiredValidator TValue="string" For="@(() => _model.Password)" Message="@L["PasswordRequired"]" />
                    </ChildContent>
                </OmniFormField>

                @if (_totpRequired)
                {
                    @if (_useRecoveryCode)
                    {
                        <OmniFormField For="oe-pages-auth-login-3"><LabelContent>@L["TotpRecoveryCode"]</LabelContent><ChildContent>
                            <OmniTextBox @bind-Value="_model.RecoveryCode"
                                           maxlength="20" aria-label="@L["TotpRecoveryCode"]"
                                           Placeholder="@L["TotpRecoveryCodePlaceholder"]" Autocomplete="off" Id="oe-pages-auth-login-3" />
                        </ChildContent></OmniFormField>
                    }
                    else
                    {
                        <OmniFormField For="oe-pages-auth-login-4"><LabelContent>@L["TotpCode"]</LabelContent><ChildContent>
                            <OmniTextBox @bind-Value="_model.TotpCode"
                                           maxlength="10" aria-label="@L["TotpCode"]"
                                           Placeholder="@L["TotpCodePlaceholder"]" Autocomplete="off" Id="oe-pages-auth-login-4" />
                        </ChildContent></OmniFormField>
                    }
                    @* STD-BTN: switching the kind of code is a minor action of the form; Login stays its only blue. *@
                    <div class="totp-mode-toggle">
                        <OmniButton Variant="OmniButtonVariant.Ghost" OnClick="@ToggleRecoveryCode" ButtonType="OmniButtonType.Button"> <span>@(_useRecoveryCode ? L["TotpUseAuthenticatorCode"] : L["TotpUseRecoveryCode"])</span></OmniButton>
                    </div>
                }

                <OmniCheckBox @bind-Value="_model.RememberMe">@L["RememberMe"]</OmniCheckBox>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <OmniAlert Severity="OmniSeverity.Danger"><Icon><OmniIcon Name="OmniIconName.Error" /></Icon><ChildContent>
                        @_error
                    </ChildContent></OmniAlert>
                }

                @* Login is the single form button, aligned at the row end; forgotten password is a
                   footer link. *@
                <OmniStack Orientation="OmniOrientation.Horizontal" Justify="OmniJustification.End"
                           Gap="OmniSpacing.Small">
                    <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_loading ? "btn-busy" : null)" Busy="@(_loading)" Label="@L["Login"]"><Icon><OmniIcon Name="OmniIconName.SignIn" /></Icon><ChildContent><span>@L["Login"]</span></ChildContent></OmniButton>
                </OmniStack>
            </OmniStack>
        </OmniTemplateForm>
        </OmniStack>
    </ChildContent>
    <FooterContent>
        <OmniStack>
        @* A real link: the hint is the page's state in its address (?forgot=true), so the link toggles
           it, the browser's back button closes it, and the form keeps what was typed. *@
        <OmniLink Href="@ForgotPasswordHref" Class="login-forgot-link"
                  aria-expanded="@(Forgot ? "true" : "false")" aria-controls="login-forgot-hint">@L["ForgotPassword"]</OmniLink>
        @if (Forgot)
        {
            @* R-14 (owner decision 2026-10-28): the person asks for a one-hour link at their address. The
               answer is the same whether an account holds it or not. *@
            <div id="login-forgot-hint" class="login-forgot">
            @if (_resetRequested)
            {
                <OmniAlert Severity="OmniSeverity.Info" Class="login-forgot-sent" Live="true"><Icon><OmniIcon Name="OmniIconName.Info" /></Icon><ChildContent>
                    @L["ForgotPasswordSent"]
                </ChildContent></OmniAlert>
            }
            else
            {
                <OmniTemplateForm TModel="ForgotPasswordModel" Model="@_forgot" OnValidSubmit="@OnForgotSubmit" GuardUnsavedChanges="false">
                    <OmniDataAnnotationsValidator Localizer="@L" />
                    <OmniStack Gap="OmniSpacing.Small">
                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@L["ForgotPasswordHint"]</OmniText>
                        <OmniFormField Label="@L["LoginEmail"]" For="ForgotEmail">
                            <OmniTextBox @bind-Value="_forgot.Email" Type="OmniTextBoxType.Email" Autocomplete="username" Id="ForgotEmail" />
                            <ValidationMessage For="@(() => _forgot.Email)" />
                        </OmniFormField>
                        @if (!string.IsNullOrEmpty(_forgotError))
                        {
                            <OmniAlert Severity="OmniSeverity.Warning" Class="login-forgot-error"><ChildContent>@_forgotError</ChildContent></OmniAlert>
                        }
                        <OmniStack Orientation="OmniOrientation.Horizontal" Justify="OmniJustification.End" Gap="OmniSpacing.Small">
                            <OmniButton Variant="OmniButtonVariant.Secondary" ButtonType="OmniButtonType.Submit" Class="@("login-forgot-submit" + (_forgotBusy ? " btn-busy" : null))" Busy="@(_forgotBusy)"><Icon><OmniIcon Name="OmniIconName.PaperPlaneRight" /></Icon><ChildContent><span>@L["ForgotPasswordSend"]</span></ChildContent></OmniButton>
                        </OmniStack>
                    </OmniStack>
                </OmniTemplateForm>
            }
            </div>
        }
        </OmniStack>
    </FooterContent>
</OmniLoginShell>
