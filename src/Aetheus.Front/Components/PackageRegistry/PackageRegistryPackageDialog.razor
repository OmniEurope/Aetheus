@if (_package is not null)
{
    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-mb-md">
        @L.Localize(_package.Kind) · @_package.Name
    </OmniText>
    @* R-58: per-package anonymous reading, saved as soon as it changes; publication stays admin-only. *@
    <OmniSettingsTile Title="@L["AnonymousDownload"]" Description="@L["AnonymousDownloadDescription"]" Class="omni-u-mb-md">
        <OmniSwitch Value="@_package.AllowAnonymousDownload" ValueExpression="@(() => _package.AllowAnonymousDownload)"
                    ValueChanged="@((bool value) => SetAnonymousDownloadAsync(value))" Disabled="@_savingAnonymousDownload"
                    aria-label="@L["AnonymousDownload"]" />
    </OmniSettingsTile>
}
    <AetheusDataGrid @ref="_grid" IsLoading="@_loading" Data="@_package?.Versions" TItem="PackageRegistryVersionDto" Virtualize="true"
                  KeyProperty="Id" NewRowHighlight="@NewRowHighlight">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="PackageRegistryVersionDto" Property="Version" Title="@L["Version"]" Filterable="true">
                <Template Context="v"><span class="text-mono">@v.Version</span></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PackageRegistryVersionDto" Property="SizeBytes" Title="@L["Size"]" Width="6.25rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators">
                <Template Context="v">@DisplayFormatting.Size(v.SizeBytes)</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PackageRegistryVersionDto" Property="PublishedBy" Title="@L["PublishedBy"]" Width="8.75rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" />
            <OmniDataGridColumn TItem="PackageRegistryVersionDto" Property="CreatedAt" Title="@L["PublishedAt"]" Width="9.375rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true">
                <Template Context="v">@v.CreatedAt.ToString("g")</Template>
            </OmniDataGridColumn>
            @* The listed state is this column's value, so it filters on listed / unlisted. *@
            <OmniDataGridColumn TItem="PackageRegistryVersionDto" Property="IsListed" Title="@L["Status"]" Width="8.125rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@ListedText">
                <Template Context="v">
                    @* Warning orange: exception chosen by the user (R1-18), recorded in ButtonRoleColourGuardTests. *@
                    <OmniButton Variant="OmniButtonVariant.Warning" OnClick="@(() => ToggleListedAsync(v))" title="@(v.IsListed ? L["Unlist"] : L["Relist"])" Label="@(v.IsListed ? L["Unlist"] : L["Relist"])"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((v.IsListed ? "visibility_off" : "visibility"))" /></Icon></OmniButton>
                </Template>
            </OmniDataGridColumn>
            @* Deprecation is per version; the registry keeps serving it and flags it in the npm and NuGet feeds. *@
            <OmniDataGridColumn TItem="PackageRegistryVersionDto" Property="IsDeprecated" Title="@L["Deprecation"]" Width="9.375rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@DeprecatedText">
                <Template Context="v">
                    @if (v.IsDeprecated)
                    {
                        <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Warning))" Fill="OmniFill.Solid" Tone="OmniTone.Warning">@L["PackageVersionDeprecated"]</OmniBadge>
                    }
                    @* Warning orange: exception chosen by the user (R1-18), recorded in ButtonRoleColourGuardTests. *@
                    <OmniButton Variant="OmniButtonVariant.Warning" OnClick="@(() => ToggleDeprecatedAsync(v))" title="@(v.IsDeprecated ? L["Undeprecate"] : L["Deprecate"])" Label="@(v.IsDeprecated ? L["Undeprecate"] : L["Deprecate"])"><Icon><OmniIcon Name="OmniIconName.Warning" /></Icon></OmniButton>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>

<DialogFooter CancelText="@L["Close"]" OnCancel="@Close" />
