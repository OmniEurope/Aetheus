@inherits Aetheus.Front.Components.Shared.RealtimeAdminGridPageBase<PackageRegistryPackageDto>
@page "/admin/package-registry"

<PageTitle>@L["PackageRegistry"] - Aetheus</PageTitle>

@if (Auth.IsAdmin)
{
<OmniPageHeader Title="@L["PackageRegistry"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("deployed_code")" /></Icon>
    <ActionsContent>
    </ActionsContent>
</OmniPageHeader>

@* Tabs choose what the grid lists (all packages, or one type); the last tab shows the source addresses. *@
<UrlSyncedTabs Slugs="@TabSlugs" SelectedIndex="@_tab" SelectedIndexChanged="@OnTabChangedAsync">
    <Tabs>
        <OmniTabsItem Key="all" Title="@L["All"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("apps")" /></Icon></OmniTabsItem>
        <OmniTabsItem Key="nuget" Title="NuGet"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("deployed_code")" /></Icon></OmniTabsItem>
        <OmniTabsItem Key="npm" Title="npm"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("inventory_2")" /></Icon></OmniTabsItem>
        <OmniTabsItem Key="maven" Title="Maven"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("layers")" /></Icon></OmniTabsItem>
        <OmniTabsItem Key="addresses" Title="@L["PackageRegistryAddresses"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("link")" /></Icon></OmniTabsItem>
    </Tabs>
</UrlSyncedTabs>

@if (ShowsAddresses)
{
    <div class="package-registry-addresses">
        <OmniHeading Level="OmniHeadingLevel.H5">NuGet</OmniHeading>
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-mb-sm">@L["RegistryNuGetHelp"]</OmniText>
        <code class="text-mono">/api/packages/nuget/v3/index.json</code>
        <OmniHeading Level="OmniHeadingLevel.H5">npm</OmniHeading>
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-mb-sm">@L["RegistryNpmHelp"]</OmniText>
        <code class="text-mono">/api/packages/npm/</code>
        <OmniHeading Level="OmniHeadingLevel.H5">Maven</OmniHeading>
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-mb-sm">@L["RegistryMavenHelp"]</OmniText>
        <code class="text-mono">/api/packages/maven/</code>
    </div>
}
else
{
<AetheusDataGrid @ref="_grid" Data="@_packages" TItem="PackageRegistryPackageDto" RowClick="@(p => OpenPackageAsync(p))"
    Count="@_totalCount" IsLoading="@_loading" LoadData="@LoadDataAsync" ExportRead="@ReadExportAsync" PageSize="20"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<PackageRegistryPackageDto>(_packages, _totalCount))"
 FullHeight="true">
    <EmptyTemplate>
        <EmptyState Icon="deployed_code" Title="@L["NoRegistryPackages"]"
            Description="@L["NoRegistryPackagesDescription"]" />
    </EmptyTemplate>
    <Columns>
        @* The type column is useless once the tab fixes the type. *@
        <OmniDataGridColumn Frozen="true" TItem="PackageRegistryPackageDto" Property="Kind" Title="@L["Type"]" Width="120px" Visible="@(_kind is null)" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@KindText" >
            <Template Context="p"><PackageRegistryKindBadge Kind="@p.Kind" /></Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn Class="omni-data-grid__cell--text" TItem="PackageRegistryPackageDto" Property="Name" Title="@L["Name"]" Filterable="true" >
            <Template Context="p"><span class="text-mono">@p.Name</span></Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn Class="omni-data-grid__cell--text" TItem="PackageRegistryPackageDto" Property="LatestVersion" Title="@L["Version"]" Filterable="true" >
            <Template Context="p"><span class="text-mono">@(p.LatestVersion ?? "-")</span></Template>
        </OmniDataGridColumn>
        @* R-58: whether the package can be read without a token; toggled in the package dialog. *@
        <OmniDataGridColumn TItem="PackageRegistryPackageDto" Property="AllowAnonymousDownload" Title="@L["PackageAccess"]" Width="140px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@AccessText">
            <Template Context="p">
                @if (p.AllowAnonymousDownload)
                {
                    <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Info))" Fill="OmniFill.Solid" Tone="OmniTone.Info">@L["AnonymousDownloadAllowed"]</OmniBadge>
                }
                else
                {
                    <span class="omni-u-text-muted">@L["AnonymousDownloadOff"]</span>
                }
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="PackageRegistryPackageDto" Property="TotalSizeBytes" Title="@L["Size"]" Width="110px" Filterable="false" >
            <Template Context="p">@DisplayFormatting.Size(p.TotalSizeBytes)</Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="PackageRegistryPackageDto" Property="UpdatedAt" Title="@L["UpdatedAt"]" Width="160px" Filterable="true" >
            <Template Context="p">@p.UpdatedAt.ToString("d")</Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="PackageRegistryPackageDto" Title="@L["Actions"]" Width="90px" TextAlign="OmniAlignment.Center" Sortable="false" Filterable="false" >
            <Template Context="p">
                <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenPackageAsync(p))" title="@L["ViewDetails"]" Label="@L["ViewDetails"]"><Icon><OmniIcon Name="OmniIconName.Eye" /></Icon></OmniButton>
                </span>
            </Template>
        </OmniDataGridColumn>
    </Columns>
</AetheusDataGrid>
}
}
