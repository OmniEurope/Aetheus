@namespace Aetheus.Front.Components.Shared
@typeparam TItem
@inject IStringLocalizer<AppStrings> L

@if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger" Class="grid-load-alert">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center"
                   Justify="OmniJustification.Between" Gap="OmniSpacing.Small">
            <OmniText>@L["GridLoadFailed"]</OmniText>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="RetryAsync">
                <OmniIcon Name="OmniIconName.Refresh" /> @L["Retry"]
            </OmniButton>
        </OmniStack>
    </OmniAlert>
}

@* Recette R-285: an Aetheus page starts and ends inline edits with its own buttons (it fills the edit
   fields first); the grid's built-in edit column doubled them and edited with empty fields. *@
<div class="aetheus-grid-host">
    @* Recette R-432: OE draws its loading bar between the headers and the first row for every load, on the
       table alone: every request the grid makes (first load included, a page, a sort, a filter, a block of
       rows) and every load the page runs itself, signalled through Busy. The rows already there stay. *@
    <OmniDataGrid @ref="Grid" TItem="TItem"
                  Items="@EffectiveItems" Load="@EffectiveLoad" Count="@EffectiveCount"
                  ShowLoadingBar="true" Busy="@EffectiveBusy"
                  Page="@_currentPage" PageChanged="OnPageChangedAsync" PageSize="@PageSize"
                  ScrollMode="@(EffectiveVirtualize ? OmniDataGridScrollMode.Virtual : OmniDataGridScrollMode.Paged)" AllowSorting="@AllowSorting"
                  Filterable="@AllowFiltering" FilterMode="@FilterMode" ShowHeaderFilterMenu="@ShowHeaderFilterMenu"
                  AllowAlternatingRows="@AllowAlternatingRows" HighlightRowOnHover="true"
                  AllowColumnResize="@AllowColumnResize"
                  VirtualizationOverscanCount="@VirtualizationOverscanCount"
                  EstimatedRowHeight="@AetheusGrid.RowHeightPixels"
                  Responsive="false" Density="@Density"
                  EmptyText="@EffectiveEmptyText" EmptyContent="@VisibleEmptyTemplate"
                  OnRowClick="@EffectiveRowClick" OnRowUpdate="@RowUpdate" RowRender="@RowRender"
                  EditMode="@EditMode" ShowEditColumn="false" FillAvailableHeight="@FullHeight" VirtualBlockSize="@PageSize"
                  KeyOf="@EffectiveKeyOf" NewRowHighlight="@NewRowHighlight"
                  ShowFooterBar="@Exports" FooterBarExport="OmniDataGridBarExport.End"
                  ExportMarkdown="@ExportMarkdown" ExportCsv="false" ExportExcel="false" ExportPdf="false"
                  ExportTitle="@EffectiveExportTitle"
                  ExportFields="@EffectiveExportFields" ExportFileName="@EffectiveExportFileName" ExportVariants="@ExportVariants" ExportLoad="@EffectiveExportLoad"
                  OnExportError="@EffectiveExportError"
                  Class="@GridCssClass" @attributes="OtherAttributes">
        <Columns>@Columns</Columns>
    </OmniDataGrid>
</div>
