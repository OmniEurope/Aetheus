@namespace Aetheus.Front.Components.Shared
@if (DisplayRuns.Count > 0)
{
    <div class="pipeline-run-history" aria-label="@L["RecentRunsColumn"]">
        @foreach (var run in DisplayRuns)
        {
            var title = RunTitle(run);
            <a href="@RunHref(run.Id)"
               class="pipeline-run-dot pipeline-run-dot-@run.Status.ToString().ToLowerInvariant()"
               title="@title" aria-label="@title" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"></a>
        }
    </div>
}
else
{
    <OmniText Tone="OmniTextTone.Muted" Class="pipeline-history-empty">@L["NoRuns"]</OmniText>
}
