@inject GridExportContext ExportContext
@namespace Aetheus.Front.Components.Shared
@* Share the monitored-application rows between dashboard and supervision so visibility, status and
   last-event details remain consistent. *@
@* Pass page-owned loading through Busy so the table keeps its headers and existing rows while data
   loads instead of announcing an empty result prematurely. *@
<div class="aetheus-grid-host">
<OmniDataGrid @ref="_grid" ExportTitle="@ExportContext.Title(L["MonitoredApps"])" ExportFields="@ExportContext.Fields()" Items="@(Applications ?? Array.Empty<MonitoredAppStatusDto>())" TItem="MonitoredAppStatusDto" KeyOf="@(row => row.Id)" NewRowHighlight="@NewRowHighlight"
    ShowLoadingBar="true" Busy="@IsLoading"
    EmptyText="@L["NoMonitoredApps"].Value" OnRowClick="@(args => Nav.NavigateTo(AppHref(args.Item)))"
    Class="dashboard-clickable-grid" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
    <EmptyContent>
        <EmptyState Icon="monitor_heart" Title="@L["NoMonitoredApps"]" />
    </EmptyContent>
    <Columns>
        <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="MonitoredAppStatusDto" Property="Name" Title="@L["Name"]" Filterable="true">
            <Template Context="app">
                <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    <OmniLink Href="@AppHref(app)">@app.Name</OmniLink>
                </span>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="MonitoredAppStatusDto" Property="CurrentStatus" Title="@L["Status"]" Width="9rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText">
            <Template Context="app">
                <OmniBadge Width="OmniBadgeWidth.Medium" Fill="OmniFill.Solid" Tone="@HealthBadge(app.CurrentStatus)">@L[$"AppHealth{app.CurrentStatus}"]</OmniBadge>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="MonitoredAppStatusDto" Property="OnlineVisitorCount" Title="@L["CurrentVisitors"]" Width="11rem"
            Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators"
            Visible="@(Applications?.Any(app => app.OnlineVisitorCount.HasValue) == true)">
            <Template Context="app">
                @if (app.OnlineVisitorCount is int onlineVisitors)
                {
                    <span title="@L["OnlineUsersAvailable"]">@onlineVisitors</span>
                }
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="MonitoredAppStatusDto" Property="ProjectName" Title="@L["Project"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" />
        <OmniDataGridColumn TItem="MonitoredAppStatusDto" Property="LastStatusChangeAt" Title="@L["Since"]" FormatString="{0:g}" Width="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" />
    </Columns>
</OmniDataGrid>
</div>
