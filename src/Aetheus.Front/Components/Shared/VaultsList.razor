@namespace Aetheus.Front.Components.Shared
@inherits EntityLiveListBase
@using Microsoft.AspNetCore.Components.Sections
@* Recette R-218/R-221: the create action sits on the title line (the host's page header), and the
   column header filters replace the search row. *@
@if (IsGlobal || IsProjectScope)
{
    <SectionContent SectionName="@PipelinesList.HeaderActionsSection">
        @if (IsGlobal)
        {
            <HelpLink PageKey="vaults" />
        }
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@NewVault" Disabled="@(!_canWrite)" title="@(!_canWrite ? L["InsufficientPermissions"] : "")"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
    </SectionContent>
}

<AetheusDataGrid @ref="_grid" TItem="VaultDto" Data="@_vaults"
    Count="@_totalCount" PageSize="20" IsLoading="@_loading" LoadData="@OnLoadData" ExportRead="@ReadExportAsync"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<VaultDto>(_vaults, _totalCount))"
    RowClick="@(v => Nav.NavigateTo($"/vaults/{v.Id}"))"
    EmptyText="@L["NoVaultsFound"]" FullHeight="true">
    <EmptyTemplate>
        <EmptyState Icon="lock" Title="@L["NoVaultsFound"]" Description="@L["EmptyVaultsHint"]">
            <ActionContent>
                @if (_canWrite && (IsGlobal || IsProjectScope))
                {
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@NewVault" title="@L["NewVault"]"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
                }
            </ActionContent>
        </EmptyState>
    </EmptyTemplate>
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="VaultDto" Property="Name" Title="@L["Name"]" MinWidth="10rem" Filterable="true" >
            <Template Context="vault">
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                    <a href="/vaults/@vault.Id" class="pipeline-name-link">@vault.Name</a>
                    @if (!Permissions.CanWrite(ResourceType.Vault, vault.Id))
                    {
                        <OmniIcon Name="OmniIconName.Eye" Class="omni-u-text-muted icon-xs-app" title="@L["Read"]" />
                    }
                </OmniStack>
            </Template>
        </OmniDataGridColumn>
        @* PLAN-003 lot 25: the owning project is a column of its own, sortable, instead of a caption
           squeezed under the name where it was truncated on every row. *@
        @if (!IsProjectScope)
        {
            <OmniDataGridColumn TItem="VaultDto" Property="ProjectName" Title="@L["Project"]" MinWidth="8rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.ProjectNames" FilterSearchable="true" />
        }
        <OmniDataGridColumn TItem="VaultDto" Property="Description" Title="@L["Description"]" MinWidth="10rem" Filterable="true" />
        <OmniDataGridColumn TItem="VaultDto" Property="SecretCount" Title="@L["Secrets"]" Width="100px" TextAlign="OmniDataGridTextAlign.Center" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="VaultDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:g}" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
        <OmniDataGridColumn TItem="VaultDto" Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
    </Columns>
</AetheusDataGrid>
