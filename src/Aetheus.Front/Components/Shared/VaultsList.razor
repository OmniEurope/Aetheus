@namespace Aetheus.Front.Components.Shared
@inherits EntityLiveListBase
@using Microsoft.AspNetCore.Components.Sections
@* Place Create in the host's page header and filter through column headers so the list shares the
   surrounding page structure. *@
@if (IsGlobal || IsProjectScope)
{
    <SectionContent SectionName="@PageHeaderActions.SectionName">
        @if (IsGlobal)
        {
            <HelpLink PageKey="vaults" />
        }
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@NewVault" Disabled="@(!_canWrite)" title="@(!_canWrite ? L["InsufficientPermissions"] : "")"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
    </SectionContent>
}

<AetheusDataGrid @ref="_grid" TItem="VaultDto" Data="@_vaults"
    Count="@_totalCount" PageSize="20" IsLoading="@_loading" LoadData="@OnLoadData" ExportRead="@ReadExportAsync"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<VaultDto>(_vaults, _totalCount))"
    RowClick="@(v => Nav.NavigateTo(VaultHref(v.Id)))"
    EmptyText="@L["NoVaultsFound"]" FullHeight="true">
    <EmptyTemplate>
        <EmptyState Icon="lock" Title="@L["NoVaultsFound"]" Description="@L["EmptyVaultsHint"]">
            <ActionContent>
                @if (_canWrite && (IsGlobal || IsProjectScope))
                {
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@NewVault" title="@L["NewVault"]"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
                }
            </ActionContent>
        </EmptyState>
    </EmptyTemplate>
    <Columns>
        <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="VaultDto" Property="Name" Title="@L["Name"]" Filterable="true" >
            <Template Context="vault">
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                    <a href="@VaultHref(vault.Id)" class="pipeline-name-link" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@vault.Name</a>
                    @if (!Permissions.CanWrite(ResourceType.Vault, vault.Id))
                    {
                        <OmniIcon Name="OmniIconName.Eye" Class="omni-u-text-muted icon-xs-app" title="@L["Read"]" />
                    }
                </OmniStack>
            </Template>
        </OmniDataGridColumn>
        @* Give the owning project a dedicated sortable column so its name remains readable. *@
        @if (!IsProjectScope)
        {
            <OmniDataGridColumn TItem="VaultDto" Property="ProjectName" Title="@L["Project"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.ProjectNames" FilterSearchable="true" />
        }
        <OmniDataGridColumn TItem="VaultDto" Property="Description" Truncate="true" Title="@L["Description"]" MinWidth="10rem" Filterable="true" />
        <OmniDataGridColumn TItem="VaultDto" Title="@L["UsedBy"]" Sortable="false" Filterable="false" ExportValue="@(vault => string.Join(", ", UsersOf(vault.Id)?.Select(user => user.Name) ?? []))">
            <Template Context="vault">
                <ResourceUsageSummary Users="@UsersOf(vault.Id)" Loaded="@_usageLoaded" />
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="VaultDto" Property="SecretCount" Title="@L["Secrets"]" Width="100px" TextAlign="OmniAlignment.Center" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="VaultDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:g}" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
        <OmniDataGridColumn TItem="VaultDto" Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
    </Columns>
</AetheusDataGrid>
