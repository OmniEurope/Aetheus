@namespace Aetheus.Front.Components.Shared
@using Microsoft.AspNetCore.Components.Sections
@* Use the grid's Project filter and the host's page-header actions so release lists need no
   separate toolbar; project synchronization remains on the project's release page. *@
@if (IsProjectScope)
{
    @* The sync action sits on the title line of the project header. *@
    <SectionContent SectionName="@PipelinesList.HeaderActionsSection">
        @if (_canAdminProject)
        {
            @* Sync stays the main action; fixing the next version, an administrator's choice, is in the menu. *@
            <OmniSplitButton Variant="OmniButtonVariant.Primary" Text="" Label="@L["SyncReleases"]" OnClick="@SyncReleases" Disabled="@(!_canWrite)" Busy="@(_syncing)" title="@L["SyncReleases"]">
                <Icon><OmniIcon Name="OmniIconName.Sync" /></Icon>
                <ChildContent>
                    <OmniMenuItem OnClick="@SetNextVersion"><Icon><OmniIcon Name="OmniIconName.Tag" /></Icon><ChildContent>@L["SetNextVersion"]</ChildContent></OmniMenuItem>
                </ChildContent>
            </OmniSplitButton>
        }
        else
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SyncReleases" Disabled="@(!_canWrite)" Class="@(_syncing ? "btn-busy" : null)" Busy="@(_syncing)" title="@L["SyncReleases"]"><OmniIcon Name="OmniIconName.Sync" /></OmniButton>
        }
    </SectionContent>
}
<AetheusDataGrid @ref="_grid" TItem="ReleaseDto" Data="@_releases"
    Count="@_totalCount" IsLoading="@_loading" LoadData="@OnLoadData" ExportRead="@ReadExportAsync" PageSize="20"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<ReleaseDto>(_releases, _totalCount))"
    RowClick="@(r => Nav.NavigateTo($"/releases/{r.Id}"))"
    EmptyText="@L["NoReleasesFound"]" FullHeight="true" class="pipeline-list-grid">
    <EmptyTemplate>
        <EmptyState Icon="new_releases" Title="@L["NoReleasesFound"]" Description="@L["EmptyReleasesHint"]" />
    </EmptyTemplate>
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="ReleaseDto" Property="Version" Title="@L["Version"]" MinWidth="10rem" Filterable="true" >
            <Template Context="r">
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                    <ShortId Value="@r.Version" Href="@($"/releases/{r.Id}")" Copyable="false" Class="release-version" />
                </OmniStack>
            </Template>
        </OmniDataGridColumn>
        @if (!IsProjectScope)
        {
            <OmniDataGridColumn TItem="ReleaseDto" Property="ProjectName" Title="@L["Project"]" MinWidth="10rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.ProjectNames" FilterSearchable="true" />
        }
        <OmniDataGridColumn TItem="ReleaseDto" Property="BranchName" Title="@L["Branch"]" Width="150px" Filterable="true" />
        <OmniDataGridColumn TItem="ReleaseDto" Property="Status" Title="@L["Status"]" Width="130px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText" >
            <Template Context="r">
                <ReleaseStatusBadge Status="@r.Status" />
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ReleaseDto" Property="AssuranceGrade" Title="@L["AssuranceGrade"]" Width="130px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@GradeText" >
            <Template Context="r">
                @if (r.AssuranceGrade is { } grade)
                {
                    <GradeBadge Value="@grade" Title="@L["AssuranceGrade"]" />
                }
                else
                {
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0"
                        title="@L["ReleaseNotQualifiedHint"]">@L["ReleaseNotQualified"]</OmniText>
                }
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ReleaseDto" Property="PublishedAt" Title="@L["ReleaseDate"]" Width="160px" SortOrder="OmniDataGridSortOrder.Descending" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" >
            <Template Context="r">
                @if (r.PublishedAt.HasValue)
                {
                    @r.PublishedAt.Value.ToString("g")
                }
                else
                {
                    <span class="omni-u-text-muted">-</span>
                }
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ReleaseDto" Property="SourcePipelineName" Title="@L["Pipeline"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.SourcePipelineNames" FilterSearchable="true" >
            <Template Context="r">
                @if (r.SourcePipelineId.HasValue && !string.IsNullOrWhiteSpace(r.SourcePipelineName))
                {
                    <a href="@PipelineHref(r)" class="pipeline-name-link" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        @r.SourcePipelineName
                    </a>
                }
                else
                {
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">-</OmniText>
                }
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ReleaseDto" Title="@L["Artifact"]" ExportValue="@ArtifactExport" Width="140px" Sortable="false" Filterable="false" >
            <Template Context="r">
                @* One line per release. A single artifact keeps its name; several read as a count
                   that opens the release, which lists them. *@
                @if (r.Artifacts.Count == 1)
                {
                    <a href="/artifacts/@r.Artifacts[0].Id" class="pipeline-name-link" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@r.Artifacts[0].Name</a>
                }
                else if (r.Artifacts.Count > 1)
                {
                    <a href="/releases/@r.Id" class="pipeline-name-link" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@string.Format(L["ArtifactsCount"], r.Artifacts.Count)</a>
                }
            </Template>
        </OmniDataGridColumn>
        @if (!IsServerScope)
        {
            <OmniDataGridColumn TItem="ReleaseDto" Title="" Width="200px" Sortable="false" TextAlign="OmniDataGridTextAlign.End" Filterable="false" >
                <Template Context="r">
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    @if (r.Status == ReleaseStatus.Detected)
                    {
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => TriggerBuild(r))" Disabled="@(!_canWrite)" title="@L["TriggerBuild"]"><OmniIcon Name="OmniIconName.RocketLaunch" /></OmniButton>
                    }
                    else if (r.Status == ReleaseStatus.Published)
                    {
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => PromoteRelease(r))" Disabled="@(!_canWrite)" title="@L["Promote"]"><OmniIcon Name="OmniIconName.Upgrade" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => RollbackRelease(r))" Disabled="@(!_canWrite)" title="@L["Rollback"]"><OmniIcon Name="OmniIconName.ArrowUUpLeft" /></OmniButton>
                    }
                    else if (r.Status == ReleaseStatus.Archived)
                    {
                        @* Decision D2: the archived release kept its commit; run a complete pipeline from it. *@
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => RelaunchFromCommit(r))" Disabled="@(!_canWrite || !ReleaseRelaunch.CanRelaunch(r.Status, r.CommitHash))" title="@(ReleaseRelaunch.CanRelaunch(r.Status, r.CommitHash) ? L["RelaunchFromCommit"] : L["RelaunchFromCommitUnavailable"])"><OmniIcon Name="OmniIconName.Play" /></OmniButton>
                    }
                    @* STD-BTN detection 11: the status action (and Rollback) visible, the other actions in the menu. *@
                    @if (r.RevertPipelineId is not null || r.IsPreviousDeployment || r.PipelineRunId.HasValue)
                    {
                        <OmniOverflowMenu Label="@L["MoreActions"]">
                            @if (r.RevertPipelineId is not null)
                            {
                                <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => RollbackToPreviousColour(r))" Disabled="@(!_canWrite)" title="@L["RevertToPrevious"]"><Icon><OmniIcon Name="OmniIconName.ArrowUUpLeft" /></Icon><ChildContent>@L["RevertToPrevious"]</ChildContent></OmniMenuItem>
                            }
                            @if (r.IsPreviousDeployment)
                            {
                                <OmniMenuItem OnClick="@(() => RedeployRelease(r))" Disabled="@(!_canWrite || r.RedeployPipelineId is null)" title="@(r.RedeployPipelineId is null ? L["RedeployUnavailable"] : L["Redeploy"])"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent>@L["Redeploy"]</ChildContent></OmniMenuItem>
                            }
                            @if (r.PipelineRunId.HasValue)
                            {
                                <OmniMenuItem OnClick="@(() => Nav.NavigateTo($"/pipelines/runs/{r.PipelineRunId}"))" title="@L["ViewRun"]"><Icon><OmniIcon Name="OmniIconName.Eye" /></Icon><ChildContent>@L["ViewRun"]</ChildContent></OmniMenuItem>
                            }
                        </OmniOverflowMenu>
                    }
                    </span>
                </Template>
            </OmniDataGridColumn>
        }
    </Columns>
</AetheusDataGrid>
