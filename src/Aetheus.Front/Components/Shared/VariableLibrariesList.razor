@namespace Aetheus.Front.Components.Shared
@using Microsoft.AspNetCore.Components.Sections
@* Place Create in the host's page header and filter through column headers so the list shares the
   surrounding page structure. *@
@if (IsGlobal || IsProjectScope)
{
    <SectionContent SectionName="@PageHeaderActions.SectionName">
        @if (IsGlobal)
        {
            <HelpLink PageKey="variable-libraries" />
        }
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@NewLibrary" Disabled="@(!_canWrite)" title="@(!_canWrite ? L["InsufficientPermissions"] : "")"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
    </SectionContent>
}

<AetheusDataGrid @ref="_grid" TItem="VariableLibraryDto" Data="@_libraries"
    Count="@_totalCount" PageSize="20" IsLoading="@_loading" LoadData="@OnLoadData" ExportRead="@ReadExportAsync"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<VariableLibraryDto>(_libraries, _totalCount))"
    RowClick="@(lib => Nav.NavigateTo(LibraryHref(lib.Id)))"
    EmptyText="@L["NoVariableLibrariesFound"]" FullHeight="true">
    <EmptyTemplate>
        <EmptyState Icon="data_object" Title="@L["NoVariableLibrariesFound"]" Description="@L["EmptyLibrariesHint"]">
            <ActionContent>
                @if (_canWrite && (IsGlobal || IsProjectScope))
                {
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@NewLibrary" title="@L["NewVariableLibrary"]"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
                }
            </ActionContent>
        </EmptyState>
    </EmptyTemplate>
    <Columns>
        <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="VariableLibraryDto" Property="Name" Title="@L["Name"]" Filterable="true" >
            <Template Context="lib">
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                    <a href="@LibraryHref(lib.Id)" class="pipeline-name-link" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@lib.Name</a>
                </OmniStack>
            </Template>
        </OmniDataGridColumn>
        @* Give the owning project a dedicated column so its name remains readable and sortable. *@
        @if (!IsProjectScope)
        {
            <OmniDataGridColumn TItem="VariableLibraryDto" Property="ProjectName" Title="@L["Project"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.ProjectNames" FilterSearchable="true" >
                <Template Context="lib"><EntityNameLink Kind="EntityNameKind.Project" Id="lib.ProjectId" Name="@lib.ProjectName" /></Template>
            </OmniDataGridColumn>
        }
        <OmniDataGridColumn TItem="VariableLibraryDto" Property="Description" Truncate="true" Title="@L["Description"]" MinWidth="10rem" Filterable="true" />
        <OmniDataGridColumn TItem="VariableLibraryDto" Title="@L["UsedBy"]" Sortable="false" Filterable="false" ExportValue="@(lib => string.Join(", ", UsersOf(lib.Id)?.Select(user => user.Name) ?? []))">
            <Template Context="lib">
                <ResourceUsageSummary Users="@UsersOf(lib.Id)" Loaded="@_usageLoaded" />
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="VariableLibraryDto" Property="EntryCount" Title="@L["Entries"]" Width="100px" TextAlign="OmniAlignment.Center" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        <OmniDataGridColumn TItem="VariableLibraryDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:g}" Width="160px" Filterable="true" />
        <OmniDataGridColumn TItem="VariableLibraryDto" Property="UpdatedAt" Title="@L["Updated"]" FormatString="{0:g}" Width="160px" Filterable="true" />
    </Columns>
</AetheusDataGrid>
