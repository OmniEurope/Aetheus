@namespace Aetheus.Front.Components.Shared
@* Not a loading level: a small running-task indicator (the task list, the task follower) or the realtime catch-up
   card. Waiting for data is veiled at one of the three levels (splash, content area, component), never with this
   loader. Same plane as the veils; AnimatedMark plays its keyframes while reduced-motion settings hold it still. *@
<OmniLogoLoader AnimatedMark="true" Size="Size" Label="@L["Loading"]" Class="@CssClass">
    <AetheusMark />
</OmniLogoLoader>
