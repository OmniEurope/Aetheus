@namespace Aetheus.Front.Components.Shared
@* Report registry claims and actual listeners separately so an unregistered process cannot make an
   occupied port appear free. *@
<OmniStack Gap="OmniSpacing.Large">
    <OmniText Element="OmniTextElement.Paragraph">@L["PortCheckHint"]</OmniText>

    @if (ServerId is null)
    {
        <OmniFormField Label="@L["Server"]" For="port-check-server" Required="true" Class="omni-u-w-100">
            <OmniDropDown Id="port-check-server" name="port-check-server" TValue="int?" Options="@(_servers.ToOptions(item => (int?)item.Id, item => item.Name))" @bind-Value="_selectedServerId" Filterable="true"
                Placeholder="@L["Server"]" Class="w-100" />
        </OmniFormField>
    }

    <OmniFormField Label="@L["PortsToCheck"]" For="port-check-ports" Required="true" Class="omni-u-w-100">
        <OmniTextBox Id="port-check-ports" @bind-Value="_portsInput" maxlength="300" Class="w-100"
            Placeholder="10041, 10042" />
    </OmniFormField>

    @if (_error is not null)
    {
        <OmniAlert Severity="OmniSeverity.Warning"><Icon><OmniIcon name="OmniIconName.Warning" /></Icon><ChildContent>@_error</ChildContent></OmniAlert>
    }

    @* A handful of ports is a verdict list, not a table: no sorting, filtering or paging would ever
       be used on four rows, so this stays a plain stack rather than a data grid. *@
    @if (_result is not null)
    {
        <OmniStack Gap="OmniSpacing.Small">
            <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Medium">
                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@_result.ServerName</OmniText>
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@ScanCaption</OmniText>
                @if (_result.ObservationAvailable)
                {
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@RefreshScanAsync" Disabled="@_busy" Class="@(_scanning ? "btn-busy" : null)" Busy="@(_scanning)"><Icon><OmniIcon name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["PortScanRefresh"]</span></ChildContent></OmniButton>
                }
            </OmniStack>

            @foreach (var entry in _result.Entries)
            {
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Medium">
                    <PortVerdictBadge Entry="@entry" />
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@entry.Port</OmniText>

                    @* The verdict is the sentence; this is only where the claim comes from, when there
                       is one, and what the last scan saw. *@
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@DetailText(entry)</OmniText>
                </OmniStack>
            }
        </OmniStack>
    }

    <DialogFooter OnCancel="@(() => Dialog.Close())">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@CheckAsync" Disabled="@(_scanning || EffectiveServerId is null)" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><Icon><OmniIcon name="OmniIconName.Check" /></Icon><ChildContent><span>@L["CheckPorts"]</span></ChildContent></OmniButton>
    </DialogFooter>
</OmniStack>
