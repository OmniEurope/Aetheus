@namespace Aetheus.Front.Components.Shared
@inherits AppWebAnalyticsSummaryViewBase
@using Aetheus.Front.Resources
@using Microsoft.Extensions.Localization

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else if (_loadFailed)
{
    <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.Medium" Align="OmniAlignment.Start">
        <OmniAlert Severity="OmniSeverity.Danger">@L["LoadFailed"]</OmniAlert>
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@RetryAsync"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Retry"]</span></OmniButton>
    </OmniStack>
}
else if (_summary is null)
{
    <EmptyState Icon="groups" Title="@L["NoWebAnalyticsDataYet"]" />
}
else
{
    <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.Large">
        @* Compact tiles, a third of the row from the small breakpoint (half before). *@
        <OmniRow Gap="OmniSpacing.Medium">
            @foreach (var tile in SummaryTiles)
            {
                <OmniColumn Span="12" SmallSpan="4" LargeSpan="3">
                    <OmniStatTile Class="web-analytics-summary-tile" Value="@tile.Value" Label="@tile.Label" />
                </OmniColumn>
            }
        </OmniRow>

        @* Show audience storage beside its ingestion budget so the amount and limit can be
           compared in one place. *@

        @if (_summary.Daily.Count > 0)
        {
            @* One shared count axis; the line is the unique visitors of each UTC day, the columns
               the pages viewed that same day. *@
            <OmniCard>
                <OmniHeading Level="OmniHeadingLevel.H5">@L["AudienceDailyTitle"]</OmniHeading>
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-mb-sm omni-u-text-muted web-analytics-chart-caption">
                    @L["AudienceDailyCaption"]
                </OmniText>
                @* Bound chart height so a long daily series remains readable without occupying an
                   oversized card. *@
                <OmniChart Title="@L["AudienceDailyTitle"]" Description="@L["AudienceDailyCaption"]" AspectRatio="5">
                    <OmniLineSeries Data="@DailyVisitorPoints" ColorIndex="0"
                                      Title="@L["UniqueVisitorsPerDay"]" />
                    @* Add per-day markers so each hover identifies its date and value instead of
                       only the series title. *@
                    <OmniMarkers Data="@DailyVisitorPoints" ColorIndex="0" />
                    <OmniColumnSeries Data="@DailyPageViewPoints" ColorIndex="1"
                                        Title="@L["PageViewsPerDay"]" />
                    <OmniValueAxis Minimum="0" Maximum="@AudienceAxisMaximum" TickCount="5" />
                    <OmniAxisTitle Text="@L["AudienceDailyValueAxis"]" Vertical="true" />
                    <OmniAxisTitle Text="@L["AudienceDailyCategoryAxis"]" />
                    <OmniCategoryAxis Labels="@OmniChartData.Labels(DailyVisitorPoints)" />
                    <OmniLegend />
                </OmniChart>
            </OmniCard>
        }
    </OmniStack>
}
