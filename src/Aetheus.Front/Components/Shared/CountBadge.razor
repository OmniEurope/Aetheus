@namespace Aetheus.Front.Components.Shared
@* Hide zero counters centrally so empty lists do not consume extra badge space and callers share
   the same rule. *@
@if (Value > 0)
{
    <OmniBadge Fill="OmniFill.Solid" Tone="@OmniVariant" Class="@Class">@DisplayText</OmniBadge>
}
