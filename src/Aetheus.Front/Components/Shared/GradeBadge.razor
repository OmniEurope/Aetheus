@namespace Aetheus.Front.Components.Shared

@* Render grades through one shared badge so colour meaning stays consistent; keep a neutral dash
   for missing grades so card rows do not shift. *@
@if (Value is { } grade)
{
    <OmniBadge Fill="OmniFill.Solid" Tone="@VariantFor(grade)" Class="@($"grade-badge grade-badge--{grade.ToString().ToLowerInvariant()} {Class}")" title="@Title">
        @grade.ToString()
    </OmniBadge>
}
else
{
    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral" Class="@($"grade-badge {Class}")" title="@Title">-</OmniBadge>
}

