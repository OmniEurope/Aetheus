@namespace Aetheus.Front.Components.Shared

@* A one-letter grade is a badge without icon, filled with the colour of its grade (recette R-59 as the user
   corrected it, R-107, R2-050). Every grade goes through this one component so the colour meaning stays the
   same everywhere; a missing grade keeps a neutral dash so card rows do not shift. *@
@if (Value is { } grade)
{
    <OmniBadge Fill="OmniFill.Solid" Tone="@VariantFor(grade)" Class="@($"grade-badge grade-badge--{grade.ToString().ToLowerInvariant()} {Class}".TrimEnd())" title="@Title">@grade.ToString()</OmniBadge>
}
else
{
    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral" Class="@($"grade-badge grade-badge--none {Class}".TrimEnd())" title="@Title">-</OmniBadge>
}
