@namespace Aetheus.Front.Components.Shared

@* The one place a pipeline run status is drawn as a badge (recette R-37): tone and icon come from
   PipelineHelper, the text is the localized status name. Every run list, tile and panel uses this
   component so a status reads the same wherever it appears. A status without an icon (an unknown
   value) keeps the text-only badge. *@
@if (PipelineHelper.GetRunIcon(Status) is { } statusIcon)
{
    <OmniBadge Width="Width" Fill="Fill" Tone="@PipelineHelper.GetRunBadge(Status)" @attributes="AdditionalAttributes">
        <Icon><OmniIcon Name="statusIcon" /></Icon>
        <ChildContent>@L.Localize(Status)</ChildContent>
    </OmniBadge>
}
else
{
    <OmniBadge Width="Width" Fill="Fill" Tone="@PipelineHelper.GetRunBadge(Status)" @attributes="AdditionalAttributes">@L.Localize(Status)</OmniBadge>
}
