@namespace Aetheus.Front.Components.Shared
@* A count and the status it counts ("20 Up"): a number badge, so no icon, on a phone too (recette R-44,
   user rule of 2026-10-25). The status name stays the tooltip; zero counts are omitted. *@
@if (Count > 0)
{
    <NumberBadge Fill="OmniFill.Solid" Tone="@Tone" Class="@CssClass" title="@Label" data-testid="status-count-badge">
        <span class="status-count-badge__count">@CountText</span> <span class="status-count-badge__label">@Label</span>
    </NumberBadge>
}
