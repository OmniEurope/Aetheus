@namespace Aetheus.Front.Components.Shared
@* Use the labelled back action for page bodies while OmniPageHeader owns its header arrow; the
   product's STD-BTN exception keeps this navigation action blue. *@
<OmniButton Variant="OmniButtonVariant.Primary" Size="@Size"
            OnClick="@(_ => GoBackAsync())" title="@Title" Label="@Title">
    <OmniIcon Name="OmniIconName.ArrowLeft" /> @Text
</OmniButton>
