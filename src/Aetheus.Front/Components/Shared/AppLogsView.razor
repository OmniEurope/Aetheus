@namespace Aetheus.Front.Components.Shared
@* ADR-021 phase 3: OTLP log viewer for a monitored app.
   Recette R-358: the log is the common grid (AetheusDataGrid), full height and remotely virtualized:
   it reads the log from the API block by block as it scrolls, and its column sorts and header filters
   travel with each request, so they apply to the whole log of the app and not to the loaded rows.
   Recette R2-011: no level dropdown nor search box above the grid (the Severity, Message and Attributes
   columns filter), and the export is the grid's own bar under the table (Markdown and CSV), which reads
   every line the column filters select through ExportLoad.
   R-181: no Refresh button, the grid refreshes on the AppTelemetryChanged push of the app's project. *@
@if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger" Class="omni-u-mb-sm">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["LoadFailed"]</OmniText>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@RetryAsync"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Retry"]</span></OmniButton>
        </OmniStack>
    </OmniAlert>
}
<AetheusDataGrid @ref="_grid" TItem="AppLogEntryDto" Data="@_items" Count="@_total" IsLoading="@_loading"
    LoadData="@LoadDataAsync" PageSize="50" Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<AppLogEntryDto>(_items, _total))"
    FullHeight="true" ShowFooterBar="true"
    ExportTitle="@ExportTitle" ExportFields="@ExportFields" ExportFileName="@ExportFileName"
    ExportLoad="@LoadExportPageAsync" OnExportError="@OnExportFailed">
    <EmptyTemplate>
        @* A failed call is not "no logs yet": the alert above says so and this stays empty. *@
        @if (!_loadFailed)
        {
            <EmptyState Icon="terminal" Title="@L["NoLogsYet"]" />
        }
    </EmptyTemplate>
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="AppLogEntryDto" Property="Timestamp" Title="@L["Timestamp"]" FormatString="{0:G}" Width="11.25rem"
            Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" />
        <OmniDataGridColumn TItem="AppLogEntryDto" Key="Severity" Property="SeverityNumber" Title="@L["Severity"]" Width="8rem" ExportValue="@_severityExport"
            Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@SeverityClasses" FormatFilterValue="@_severityFilterLabel">
            <Template Context="entry">
                <OmniBadge Fill="OmniFill.Solid" Tone="@SeverityBadge(entry.SeverityNumber)">@SeverityLabel(entry)</OmniBadge>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="AppLogEntryDto" Property="Body" Title="@L["Message"]" MinWidth="20rem" Filterable="true" ExportValue="@MessageExport">
            <Template Context="entry">
                @{ var message = LogMessageTemplate.Render(entry.Body, entry.AttributesJson); }
                <span class="app-log-cell-text" title="@message">@message</span>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="AppLogEntryDto" Property="AttributesJson" Title="@L["LogAttributes"]" MinWidth="14rem"
            Sortable="false" Filterable="true">
            <Template Context="entry">
                <span class="app-log-cell-text app-log-attributes" title="@entry.AttributesJson">@entry.AttributesJson</span>
            </Template>
        </OmniDataGridColumn>
    </Columns>
</AetheusDataGrid>
