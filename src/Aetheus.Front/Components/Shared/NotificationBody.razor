@namespace Aetheus.Front.Components.Shared
@* Clamp notification detail to four lines while preserving its title so toasts remain compact;
   show full text and correlation context only when content actually overflows. *@
<div class="notification-body">
    <div @ref="_text" class="notification-body-text" data-testid="notification-body-text">@Detail</div>
    @if (_clamped)
    {
        <span @onclick:stopPropagation="true">
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="OpenAsync"
                        Class="notification-body-more">
                <Icon><OmniIcon Name="OmniIconName.ChevronDown" /></Icon><ChildContent>@L["ShowMore"]</ChildContent>
            </OmniButton>
        </span>
    }
    @if (LogsHref is not null)
    {
        <a href="@LogsHref" class="notification-log-link" @onclick:stopPropagation="true">@L["Logs"]</a>
    }
</div>
