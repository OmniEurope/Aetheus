@namespace Aetheus.Front.Components.Shared
@using Microsoft.Extensions.Localization
@using Aetheus.Front.Resources
@inject IStringLocalizer<AppStrings> L
@inject ApiClient Api

<OmniStack Gap="OmniSpacing.Medium">
    <fieldset class="owner-type-field">
        <legend>@L["OwnerType"]</legend>
        <div class="owner-type-options" role="radiogroup" aria-label="@L["OwnerType"]">
            <label><input type="radio" name="@_radioGroupName" value="Global" checked="@(_kind == OwnerKind.Global)" @onchange="@(() => OnKindChanged(OwnerKind.Global))" /> <span>@L["Global"]</span></label>
            <label><input type="radio" name="@_radioGroupName" value="Project" checked="@(_kind == OwnerKind.Project)" @onchange="@(() => OnKindChanged(OwnerKind.Project))" /> <span>@L["Project"]</span></label>
            <label><input type="radio" name="@_radioGroupName" value="Environment" checked="@(_kind == OwnerKind.Environment)" @onchange="@(() => OnKindChanged(OwnerKind.Environment))" /> <span>@L["Environment"]</span></label>
            <label><input type="radio" name="@_radioGroupName" value="ProjectServer" checked="@(_kind == OwnerKind.ProjectServer)" @onchange="@(() => OnKindChanged(OwnerKind.ProjectServer))" /> <span>@L["Server"]</span></label>
        </div>
    </fieldset>

    @if (_kind is OwnerKind.Project or OwnerKind.Environment or OwnerKind.ProjectServer)
    {
        @* SITE-FUNC-OWNER-001: the context project of an environment or server owner is _selectedProjectId;
           ProjectId is only the Project owner and stays null for the two scoped kinds. *@
        <OmniFormField For="owner-project">
            <LabelContent>@L["Project"]</LabelContent>
            <ChildContent>
            <OmniDropDown TValue="int?" Id="owner-project" Options="@ProjectOptions"
                          Value="@_selectedProjectId" ValueChanged="@(value => OnProjectChanged(value))"
                          ValueExpression="@(() => _selectedProjectId)" AllowEmpty="true"
                          Placeholder="@L["SelectProject"]" />
            </ChildContent>
        </OmniFormField>
    }

    @if (_kind == OwnerKind.Environment && _selectedProjectId is > 0)
    {
        <OmniFormField For="owner-environment">
            <LabelContent>@L["Environment"]</LabelContent>
            <ChildContent>
            <OmniDropDown TValue="int?" Id="owner-environment" Options="@EnvironmentOptions"
                          Value="@EnvironmentId" ValueChanged="@(value => OnEnvironmentChanged(value))"
                          ValueExpression="@(() => EnvironmentId)" AllowEmpty="true"
                          Placeholder="@L["SelectEnvironment"]" />
            </ChildContent>
        </OmniFormField>
    }

    @if (_kind == OwnerKind.ProjectServer && _selectedProjectId is > 0)
    {
        <OmniFormField For="owner-server">
            <LabelContent>@L["Server"]</LabelContent>
            <ChildContent>
            <OmniDropDown TValue="int?" Id="owner-server" Options="@ServerOptions"
                          Value="@ProjectServerId" ValueChanged="@(value => OnProjectServerChanged(value))"
                          ValueExpression="@(() => ProjectServerId)" AllowEmpty="true"
                          Placeholder="@L["SelectServer"]" />
            </ChildContent>
        </OmniFormField>
    }
</OmniStack>
