@namespace Aetheus.Front.Components.Shared
@inherits AppWebAnalyticsSummaryViewBase
@* Show the month's top pages in their own telemetry sub-tab while sharing the application's
   web-analytics summary as the data source. *@

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else if (_loadFailed)
{
    <OmniStack Orientation="OmniStackOrientation.Vertical" Gap="OmniSpacing.Medium" Align="OmniAlignment.Start">
        <OmniAlert Severity="OmniSeverity.Danger">@L["LoadFailed"]</OmniAlert>
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@RetryAsync"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Retry"]</span></OmniButton>
    </OmniStack>
}
else if (_summary is null)
{
    <EmptyState Icon="groups" Title="@L["NoWebAnalyticsDataYet"]" />
}
else
{
    @* Virtualize the month's routes across the available page height so the backend-bounded list
       remains usable without an additional capped card. *@
    <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mb-sm">@L["TopPagesThisMonth"]</OmniHeading>
    <AetheusDataGrid Data="@_summary.TopPages" TItem="AppWebAnalyticsPageDto" KeyProperty="Route"
                     Virtualize="true" FullHeight="true" PageSize="50" VirtualizationOverscanCount="3"
                     EmptyText="@L["NoWebAnalyticsDataYet"]">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="AppWebAnalyticsPageDto"
                                Property="Route" Title="@L["Route"]" Filterable="true" />
            <OmniDataGridColumn TItem="AppWebAnalyticsPageDto"
                                Property="PageViews" Title="@L["PageViews"]" Width="10rem" Filterable="true"
                                FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
        </Columns>
    </AetheusDataGrid>
}
