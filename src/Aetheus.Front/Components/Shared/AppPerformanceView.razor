@namespace Aetheus.Front.Components.Shared
@* Show the route summary before individual timings and load the metric explorer only on demand so
   the overview stays focused and inexpensive. *@
@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else if (_loadFailed)
{
    <EmptyState Icon="error" Title="@L["LoadFailed"]" />
}
else if (_report is null || _report.MeasuredAt is null)
{
    <EmptyState Icon="speed" Title="@L["AppPerformanceNoData"]" Description="@L["AppPerformanceNoDataHint"]" />
}
else
{
    @* Use equal-height responsive tiles so the summary remains readable on phones; show the last
       export time with its measurement window to make freshness explicit. *@
    <OmniTileGrid Columns="4" Class="omni-u-mb-md">
        <OmniStatTile Class="app-performance-tile" Value="@LastSentText" Title="@L["AppPerformanceLastSent"]" Detail="@WindowText" data-testid="app-performance-window" />
        <OmniStatTile Class="app-performance-tile" Value="@RoutesCountText" Title="@L["AppPerformanceRoutes"]" />
        <OmniStatTile Class="app-performance-tile" Value="@TotalRequestsText" Title="@L["AppPerformanceRequests"]" />
        <OmniStatTile Class="app-performance-tile" Value="@SlowestP95Text" Title="@L["AppPerformanceSlowestRoute"]" Detail="@SlowestRouteText" />
    </OmniTileGrid>

    @* Export the displayed measurement context and every filtered route through the grid's footer
       so the file remains interpretable outside the page. *@
    <AetheusDataGrid Data="@_report.Routes" TItem="AppRouteTimingDto" KeyProperty="Route" Virtualize="true" EmptyText="@L["PerformanceNoSamples"]" class="omni-u-mb-lg"
                     ShowFooterBar="true" ExportTitle="@ExportTitle"
                     ExportFields="@ExportFields" ExportFileName="@ExportFileName">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="AppRouteTimingDto" Property="Method" Title="@L["Method"]" Width="6rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" />
            <OmniDataGridColumn TItem="AppRouteTimingDto" Property="Route" Title="@L["Route"]" Filterable="true" >
                <Template Context="route"><code>@route.Route</code></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AppRouteTimingDto" Property="Count" Title="@L["PerformanceCalls"]" Width="6rem" TextAlign="OmniAlignment.End" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" />
            <OmniDataGridColumn TItem="AppRouteTimingDto" Property="P50Ms" Title="@L["PerformanceP50"]" ExportValue="@P50Export" Width="6rem" TextAlign="OmniAlignment.End" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" >
                <Template Context="route">@Milliseconds(route.P50Ms)</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AppRouteTimingDto" Property="P95Ms" Title="@L["PerformanceP95"]" ExportValue="@P95Export" Width="6rem" TextAlign="OmniAlignment.End" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" >
                <Template Context="route">
                    @* A percentile taken on too few calls is the maximum; it reads as an order of
                       magnitude. *@
                    @if (IsOrderOfMagnitude(route, P95MinimumCalls))
                    {
                        <OmniText Tone="OmniTextTone.Muted" title="@FewCallsHint(P95MinimumCalls)" data-testid="app-performance-few-calls">@Milliseconds(route.P95Ms)</OmniText>
                    }
                    else
                    {
                        @Milliseconds(route.P95Ms)
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AppRouteTimingDto" Property="P99Ms" Title="@L["PerformanceP99"]" ExportValue="@P99Export" Width="6rem" TextAlign="OmniAlignment.End" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" >
                <Template Context="route">
                    @if (IsOrderOfMagnitude(route, P99MinimumCalls))
                    {
                        <OmniText Tone="OmniTextTone.Muted" title="@FewCallsHint(P99MinimumCalls)" data-testid="app-performance-few-calls">@Milliseconds(route.P99Ms)</OmniText>
                    }
                    else
                    {
                        @Milliseconds(route.P99Ms)
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="AppRouteTimingDto" Property="MaxMs" Title="@L["Maximum"]" ExportValue="@MaxExport" Width="6rem" TextAlign="OmniAlignment.End" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" >
                <Template Context="route">@Milliseconds(route.MaxMs)</Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
}

@* The explorer is rendered only once opened: its metric list is not read for a reader who never asks. *@
<OmniFieldset Collapsible="true" @bind-Expanded="_explorerExpanded" Class="omni-u-mt-md">
    <Legend>@L["AppPerformanceExplore"]</Legend>
    <ChildContent>
        @if (_explorerExpanded)
        {
            <AppMetricsView AppId="AppId" />
        }
    </ChildContent>
</OmniFieldset>
