<OmniTemplateForm TModel="OrganizationFormModel" Model="@_model" OnValidSubmit="@OnSubmit">
    <OmniDataAnnotationsValidator Localizer="@L" />
    <OmniStack Gap="OmniSpacing.Large">
        <OmniFormField For="oe-pages-organizations-organizationdialog-1"><LabelContent>@L["Name"]</LabelContent><ChildContent>
            <OmniTextBox @bind-Value="_model.Name" aria-label="@L["Name"]" Id="oe-pages-organizations-organizationdialog-1" />
        </ChildContent></OmniFormField>
        <OmniFormField For="oe-pages-organizations-organizationdialog-2"><LabelContent>@L["Slug"]</LabelContent><ChildContent>
            <OmniTextBox @bind-Value="_model.Slug" aria-label="@L["Slug"]" Id="oe-pages-organizations-organizationdialog-2" />
        </ChildContent></OmniFormField>
        <OmniFormField For="oe-pages-organizations-organizationdialog-3"><LabelContent>@L["Description"]</LabelContent><ChildContent>
            <OmniTextArea @bind-Value="_model.Description" Rows="3" aria-label="@L["Description"]" Id="oe-pages-organizations-organizationdialog-3" />
        </ChildContent></OmniFormField>
        <ValidationSummary />

        @if (!string.IsNullOrEmpty(_error))
        {
            <OmniAlert Severity="OmniSeverity.Danger"><Icon><OmniIcon Name="OmniIconName.Error" /></Icon><ChildContent>@_error</ChildContent></OmniAlert>
        }

        <DialogFooter OnCancel="@Cancel">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_saving ? "btn-busy" : null)" Busy="@(_saving)"><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@L["Save"]</span></ChildContent></OmniButton>
        </DialogFooter>
    </OmniStack>
</OmniTemplateForm>
