@page "/tasks/{TaskId:int}"

<PageTitle>@($"{L["Task"]} #{TaskId}") - Aetheus</PageTitle>

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Large" />
}
else if (_task is null)
{
    <OmniPageHeader Title="@($"{L["Task"]} #{TaskId}")" ShowBack="true" Subtitle="@Breadcrumb.Subtitle()">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("task_alt")" /></Icon>
    </OmniPageHeader>
    <OmniAlert Severity="OmniSeverity.Warning">@L["TaskNotFound"]</OmniAlert>
}
else
{
    <OmniPageHeader Title="@($"{L["Task"]} #{_task.Id}")" ShowBack="true" Subtitle="@Breadcrumb.Subtitle()">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("task_alt")" /></Icon>
        <Badges>
            <OmniBadge Icon="@(BadgeIcon.ForState(TaskListView.GetTaskBadge(_task.Status)))" Fill="OmniFill.Solid" Tone="@TaskListView.GetTaskBadge(_task.Status)">@L.Localize(_task.Status)</OmniBadge>
            @if (!string.IsNullOrWhiteSpace(_task.FailureCode))
            {
                <OmniBadge Fill="OmniFill.Solid" Tone="@TaskListView.GetFailureBadge(_task.FailureCode)"><Icon><OmniIcon Name="@TaskListView.GetFailureIcon(_task.FailureCode)" /></Icon><ChildContent>@L[_task.FailureCode]</ChildContent></OmniBadge>
            }
        </Badges>
        <ActionsContent>
            @if (CanCancel)
            {
                <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@CancelTaskAsync"><Icon><OmniIcon Name="OmniIconName.Prohibit" /></Icon><ChildContent><span>@L["CancelTask"]</span></ChildContent></OmniButton>
            }
        </ActionsContent>
    </OmniPageHeader>

    <OmniStack>
    @if (!string.IsNullOrWhiteSpace(_task.FailureReason))
    {
        <OmniAlert Severity="OmniSeverity.Danger">
            <strong>@L["FailureReason"]</strong>: @_task.FailureReason
        </OmniAlert>
    }

    @* R-5: the two panels are OE tiles of one OmniTileGrid (same width, same height). *@
    <OmniTileGrid Columns="2" Gap="OmniSpacing.Large">
            <OmniCard>
                <div class="detail-panel-title">
                    <OmniIcon Name="OmniIconName.Info"Class="run-tile-icon omni-u-text-accent" />
                    <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Details"]</OmniText>
                </div>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["Name"]</OmniText>
                    <OmniText Element="OmniTextElement.Paragraph">@_task.Name</OmniText>
                </OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["Server"]</OmniText>
                    <a href="@($"/servers/{_task.ServerId}/overview")" class="detail-value-link">@_task.ServerName</a>
                </OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["Source"]</OmniText>
                    @if (_task.PipelineRunId is { } pipelineRunId)
                    {
                        <a href="@($"/pipelines/runs/{pipelineRunId}")" class="detail-value-link">@($"{L["PipelineRun"]} #{pipelineRunId}")</a>
                    }
                    else
                    {
                        <span>@($"{L["Server"]}: {_task.ServerName}")</span>
                    }
                </OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["Executor"]</OmniText>
                    <OmniText Element="OmniTextElement.Paragraph">@L.Localize(_task.Executor)</OmniText>
                </OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["TimeoutSeconds"]</OmniText>
                    <OmniText Element="OmniTextElement.Paragraph">@_task.TimeoutSeconds</OmniText>
                </OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["Exit"]</OmniText>
                    <OmniText Element="OmniTextElement.Paragraph">@(_task.ExitCode?.ToString() ?? "-")</OmniText>
                </OmniStack>
            </OmniCard>
            <OmniCard>
                <div class="detail-panel-title">
                    <OmniIcon Name="OmniIconName.Timer"Class="run-tile-icon omni-u-text-accent" />
                    <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Duration"]</OmniText>
                </div>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["Created"]</OmniText>
                    <OmniText Element="OmniTextElement.Paragraph">@_task.CreatedAt.ToString("g")</OmniText>
                </OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["Started"]</OmniText>
                    <OmniText Element="OmniTextElement.Paragraph">@FormatDate(_task.StartedAt)</OmniText>
                </OmniStack>
                <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Class="detail-row" Gap="OmniSpacing.Large">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["Completed"]</OmniText>
                    <OmniText Element="OmniTextElement.Paragraph">@FormatDate(_task.CompletedAt)</OmniText>
                </OmniStack>
            </OmniCard>
    </OmniTileGrid>

    @if (!string.IsNullOrWhiteSpace(_task.Command))
    {
        <OmniCodeBlock Code="@_task.Command" Title="@L["Command"]" Wrap="true" Class="code-block-bounded code-block-tall" />
    }

    <OmniCard>
        <div class="detail-panel-title">
            <OmniIcon Name="OmniIconName.Document" Class="run-tile-icon omni-u-text-accent" />
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Logs"]</OmniText>
        </div>
        @* While the agent has not finished, the lines arrive as it writes them and a moving bar
           says the task is still running. *@
        @if (InFlight)
        {
            <OmniProgressBar Indeterminate="true" ShowValue="true" Label="@L["TaskInProgress"]" ValueText="@L["TaskInProgress"]" Class="task-log-live omni-u-mb-sm" />
        }
        <div class="task-log-viewer">
            @if (_logs.Count == 0)
            {
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["NoLogsAvailable"]</OmniText>
            }
            else
            {
                @foreach (var log in _logs)
                {
                    <div class="log-entry log-level-@log.Level.ToString().ToLowerInvariant()">
                        <span class="log-timestamp">[@log.Timestamp.ToString("HH:mm:ss")]</span>
                        <span>[@L.Localize(log.Level)]</span> <OmniAnsiText Text="@log.Message" />
                    </div>
                }
            }
        </div>
    </OmniCard>
    </OmniStack>
}
