@page "/admin/plugins"
@page "/plugins"

<PageTitle>@L["Plugins"] - Aetheus</PageTitle>

@if (_authorized)
{
    <OmniPageHeader Title="@L["Plugins"]" Subtitle="@Breadcrumb.Subtitle()">
        <Icon><OmniIcon Name="@MaterialIconMap.Resolve("extension")" /></Icon>
        <Badges>
            <HelpLink PageKey="plugins" />
        </Badges>
        <Actions>
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenRegisterDialog"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Register"]</span></OmniButton>
        </Actions>
    </OmniPageHeader>

    <OmniTextBox aria-label="@L["Search"]" Placeholder="@L["Search"]" @bind-Value="_search" @bind-Value:after="OnSearchChangedAsync"
        Class="pipeline-list-search omni-u-mb-sm" />

    <AetheusDataGrid FullHeight="true" @ref="_grid" Data="@_plugins" TItem="PluginRegistrationDto"
        Count="@_totalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync" ExportRead="@ReadExportAsync"
        PageSize="25" EmptyText="@L["NoRecords"]" class="aetheus-grid-fullheight"
        Virtualize="@AetheusGrid.RemoteVirtualization"
        VirtualData="@(() => new OmniDataGridResult<PluginRegistrationDto>(_plugins, _totalCount))">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="PluginRegistrationDto" Property="Name" Title="@L["PluginName"]" Filterable="true" />
            <OmniDataGridColumn TItem="PluginRegistrationDto" Property="Version" Title="@L["Version"]" Width="100px" Filterable="true" />
            <OmniDataGridColumn TItem="PluginRegistrationDto" Property="Type" Title="@L["PluginType"]" Width="120px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@TypeText" >
                <Template Context="plugin">@TypeText(plugin.Type.ToString())</Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PluginRegistrationDto" Property="Author" Title="@L["Author"]" Width="150px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.Authors" FilterSearchable="true" />
            <OmniDataGridColumn TItem="PluginRegistrationDto" Property="Status" Title="@L["Status"]" Width="130px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText" >
                <Template Context="plugin">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@GetStatusBadgeStyle(plugin.Status)">@L.Localize(plugin.Status)</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="PluginRegistrationDto" Property="CreatedAt" Title="@L["Created"]" FormatString="{0:g}" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" />
            <OmniDataGridColumn TItem="PluginRegistrationDto" Title="@L["Actions"]" Width="160px" Sortable="false" Filterable="false" >
                <Template Context="plugin">
                    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => TogglePlugin(plugin))" title="@L["Edit"]"><OmniIcon Name="OmniIconName.Edit" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => UnregisterPlugin(plugin.Id))" title="@L["Unregister"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                    </OmniStack>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </AetheusDataGrid>
}
