<div>
    @* R-41: the code block draws the ANSI colours itself (OmniCodeBlock.AnsiMode, Render by default since OE 1.9.0);
       Message stays as stored for the Copy and Markdown buttons and the grid export. *@
    <OmniCodeBlock Code="@Message" Title="@L["Message"]" Wrap="true" Class="code-block-bounded code-block-tall" />
    @if (!string.IsNullOrWhiteSpace(Exception))
    {
        <OmniCodeBlock Code="@Exception" Title="@(DetailsTitle ?? L["ExceptionDetails"])" Wrap="true" Class="omni-u-mt-md code-block-bounded code-block-tall" />
    }
    <DialogFooter CancelText="@L["Close"]" OnCancel="Close">
        <SecondaryContent>
            @* One main action, the other copy in its menu (R-39, one main action per zone). *@
            <OmniSplitButton Text="@L["Copy"]" Variant="OmniButtonVariant.Primary" OnClick="CopyAsync" Class="log-entry-copy">
                <Icon><OmniIcon Name="OmniIconName.Copy" /></Icon>
                <ChildContent>
                    <OmniMenuItem OnClick="CopyMarkdownAsync" Class="log-entry-copy-markdown">@L["CopyAsMarkdown"]</OmniMenuItem>
                </ChildContent>
            </OmniSplitButton>
        </SecondaryContent>
    </DialogFooter>
</div>
