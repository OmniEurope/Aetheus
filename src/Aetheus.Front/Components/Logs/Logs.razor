@page "/logs"
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>@L["LiveLogs"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["LiveLogs"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("terminal")" /></Icon>
    <Badges>
        <HelpLink PageKey="logs" />
    </Badges>
    <ActionsContent>
        @if (_hubConnection?.State == HubConnectionState.Connected)
        {
            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Success">@L["Connected"]</OmniBadge>
        }
    </ActionsContent>
    <MenuContent>
        <OmniMenuItem OnClick="@(() => _logs.Clear())"><Icon><OmniIcon Name="OmniIconName.Broom" /></Icon><ChildContent>@L["Clear"]</ChildContent></OmniMenuItem>
        @if (Auth.IsAdmin && _currentWatchId.HasValue)
        {
            <OmniMenuItem OnClick="@ToggleUnmasked"><Icon><OmniIcon Name="@(_showUnmasked ? OmniIconName.EyeSlash : OmniIconName.Eye)" /></Icon><ChildContent>@(_showUnmasked ? L["ShowMasked"] : L["ShowUnmasked"])</ChildContent></OmniMenuItem>
        }
    </MenuContent>
</OmniPageHeader>

@* The title alone at the top; under it, what the page is for and the task to follow. *@
<OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-mb-md">@L["LiveLogsDescription"]</OmniText>
<OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.End" Gap="OmniSpacing.Small" Class="live-logs-watch omni-u-mb-md">
    <OmniFormField For="live-logs-task-id"><LabelContent>@L["TaskId"]</LabelContent><ChildContent>
        <OmniNumeric @bind-Value="_taskIdFilter" Id="live-logs-task-id" Minimum="1" TValue="int?" />
    </ChildContent></OmniFormField>
    @* Keep Watch enabled while the number field commits on blur so that the same click can start
       watching. Empty input performs no action. *@
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@StartWatching"><Icon><OmniIcon Name="OmniIconName.Eye" /></Icon><ChildContent><span>@L["Watch"]</span></ChildContent></OmniButton>
</OmniStack>

<div class="live-log-panel" @ref="_logContainer">
    @if (_logs.Count == 0)
    {
        @if (_currentWatchId.HasValue)
        {
            <EmptyState Icon="terminal" Title="@L["NoLogEntriesYet"]" Description="@L["WaitingForLogEntries"]" />
        }
        else
        {
            <EmptyState Icon="manage_search" Title="@L["SelectTaskToWatch"]" Description="@L["SelectTaskToWatchDescription"]" />
        }
    }
    else
    {
        @foreach (var log in _logs)
        {
            <div class="log-entry log-level-@log.Level.ToString().ToLowerInvariant()">
                <span class="log-timestamp">[@log.Timestamp.ToString("HH:mm:ss.fff")]</span>
                <span class="log-task-id">[Task#@log.TaskId]</span>
                @* R-41: a line with ANSI sequences is drawn by OmniAnsiText (its masked values are not accented). *@
                @if (AnsiLine.HasSequences(log.Message))
                {
                    <span>[@log.Level]</span> <OmniAnsiText Text="@log.Message" />
                }
                else
                {
                    @* nosemgrep: aetheus.razor.markupstring-dynamic - HighlightMasked HTML-encodes the message first *@
                    <span>[@log.Level]</span> @((MarkupString)HighlightMasked(log.Message))
                }
            </div>
        }
    }
</div>


