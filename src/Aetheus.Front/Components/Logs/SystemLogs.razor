@page "/admin/system-logs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject Aetheus.Front.Components.Shared.BreadcrumbService Breadcrumb

<PageTitle>@L["SystemLogs"]</PageTitle>

<OmniPageHeader Title="@L["SystemLogs"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("description")" /></Icon>
    <ActionsContent>
        @* Recette R-109 (rule 1 of R-30): Download, the main action, in the page header; the other actions in its menu. *@
        @if (!string.IsNullOrWhiteSpace(_selectedFile))
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="OnDownloadAsync" Class="@(_isDownloading ? "btn-busy" : null)" Busy="@(_isDownloading)"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L["Download"]</span></ChildContent></OmniButton>
        }
    </ActionsContent>
    <MenuContent>
        <OmniMenuItem Tone="OmniTone.Danger" OnClick="OnPurgeAsync" title="@L["PurgeLogs"]"><Icon><OmniIcon Name="OmniIconName.Broom" /></Icon><ChildContent>@L["Purge"]</ChildContent></OmniMenuItem>
    </MenuContent>
</OmniPageHeader>

<OmniStack Class="page-fill-body">
<OmniCard>
    <OmniRow Gap="OmniSpacing.Large" Align="OmniAlignment.End">
        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.XSmall">
                <OmniLabel For="ddFile">@L["LogFile"]</OmniLabel>
            <OmniDropDown Id="ddFile" TValue="string" @bind-Value="_selectedFile"
                            Options="@(_fileNames.ToOptions(item => (string)item, item => item))" name="ddFile"
                            AllowEmpty="true" Placeholder="@L["AllFiles"]"
                            @bind-Value:after="OnFilterChangedAsync"
                            Class="w-rem-16" />
        </OmniStack>

        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.XSmall">
                <OmniLabel For="ddLevel">@L["LogLevel"]</OmniLabel>
            <OmniDropDown Id="ddLevel" TValue="string" @bind-Value="_selectedLevel"
                            Options="@(_levelOptions.ToOptions(item => item.Value, item => item.Text))" name="ddLevel"
                            AllowEmpty="true" Placeholder="@L["AllLevels"]"
                            @bind-Value:after="OnFilterChangedAsync"
                            Class="w-rem-10" />
        </OmniStack>

        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.XSmall">
                <OmniLabel For="dtFrom">@L["DateFrom"]</OmniLabel>
                <OmniDateTimePicker @bind-Value="_dateFrom" Id="dtFrom"
                                    @bind-Value:after="OnFilterChangedAsync"
                                    Class="w-rem-12-5" />
        </OmniStack>

        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.XSmall">
                <OmniLabel For="dtTo">@L["DateTo"]</OmniLabel>
                <OmniDateTimePicker @bind-Value="_dateTo" Id="dtTo"
                                    @bind-Value:after="OnFilterChangedAsync"
                                    Class="w-rem-12-5" />
        </OmniStack>

        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.XSmall">
                <OmniLabel For="txtSearch">@L["Search"]</OmniLabel>
            <OmniTextBox Value="@_searchText" Id="txtSearch"
                           Placeholder="@L["SearchLogs"]"
                           ValueChanged="OnSearchTextChanged"
                           Class="w-rem-16"  ValueExpression="@(() => _searchText)"/>
        </OmniStack>

        @* No Refresh and no polling toggle, the page follows the log files live. *@
    </OmniRow>
</OmniCard>

@if (_loadFailed)
{
    <OmniAlert Severity="OmniSeverity.Danger">@L["LoadFailed"]</OmniAlert>
}
@* Fetch virtualized log blocks with bar filters, sort and column filters applied by the API to the
   entire log. *@
<AetheusDataGrid ShowFooterBar="true" @ref="_grid" TItem="SystemLogEntryDto" Data="@_items" Count="@_total" IsLoading="@_loading"
                 LoadData="@LoadDataAsync" ExportRead="@ReadExportAsync" PageSize="50" Virtualize="@AetheusGrid.RemoteVirtualization"
                 VirtualData="@(() => new OmniDataGridResult<SystemLogEntryDto>(_items, _total))"
                 FullHeight="true" RowClick="@OnRowClick">
    <EmptyTemplate>
        @if (!_loadFailed)
        {
            <EmptyState Icon="search_off" Title="@L["NoLogsAvailable"]" />
        }
    </EmptyTemplate>
    <Columns>
            <OmniDataGridColumn Frozen="true" TItem="SystemLogEntryDto" Property="Timestamp"
                                Title="@L["Timestamp"]" Width="11.25rem" Filterable="true"
                                FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true"
                                FormatString="@DateDisplay.PreciseFormatString" />
            <OmniDataGridColumn TItem="SystemLogEntryDto" Property="Level"
                                Title="@L["LogLevel"]" Width="7.5rem" Filterable="true"
                                FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@LevelsArray" FormatFilterValue="@LevelText">
                <Template Context="entry">
                    <OmniBadge Icon="@(BadgeIcon.ForState(GetBadgeStyle(entry.Level)))" Fill="OmniFill.Solid"
                                 Tone="@GetBadgeStyle(entry.Level)">@LevelText(entry.Level)</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="SystemLogEntryDto" Property="Category"
                                Title="@L["Category"]" Width="16.25rem" Filterable="true" />
            <OmniDataGridColumn TItem="SystemLogEntryDto" Property="Message" Truncate="true"
                                Title="@L["Message"]" Filterable="true">
                <Template Context="entry">
                    <span title="@entry.Message" class="log-message-cell">
                        @(entry.Message.Length > 300 ? entry.Message[..300] + "…" : entry.Message)
                    </span>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="SystemLogEntryDto" Property="CorrelationId"
                                Title="@L["CorrelationId"]" Width="10.625rem" Filterable="true">
                <Template Context="entry">
                    @if (!string.IsNullOrWhiteSpace(entry.CorrelationId))
                    {
                        <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.XSmall" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <span class="correlation-id-text">@entry.CorrelationId</span>
                            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OnCopyCorrelationIdAsync(entry.CorrelationId!))" title="@L["CopyCorrelationId"]"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon></OmniButton>
                        </OmniStack>
                    }
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="SystemLogEntryDto" Title="" Width="5.75rem"
                                Sortable="false" TextAlign="OmniAlignment.Center">
                <Template Context="entry">
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <OmniButton Variant="@(string.IsNullOrWhiteSpace(entry.Exception) ? OmniButtonVariant.Ghost : OmniButtonVariant.Danger)" OnClick="@(() => ShowMessageDialogAsync(entry))" title="@L["ViewMessage"]"><Icon><OmniIcon Name="OmniIconName.Eye" /></Icon></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OnCopyMessageAsync(entry.Message))" title="@L["CopyMessage"]"><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon></OmniButton>
                    </span>
                </Template>
            </OmniDataGridColumn>
    </Columns>
</AetheusDataGrid>
</OmniStack>
