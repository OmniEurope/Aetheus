@* R3-58 (ADR-051), R1-5 (ADR-055): choose the components an agent update installs on the host. Only the closed
   whitelist of AgentEnableableCapabilities is offered, one card per component; one primary action (it only
   updates the agent when nothing is chosen), Cancel in the footer. *@
<OmniStack Gap="OmniSpacing.Large" Class="agent-capabilities-dialog">
    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">
        @string.Format(L["EnableAgentCapabilitiesIntro"], Server.Name)
    </OmniText>

    @if (!AgentCanEnable)
    {
        <OmniAlert Severity="OmniSeverity.Warning" Class="agent-capabilities-agent-old">
            @L["EnableAgentCapabilitiesAgentOld"]
        </OmniAlert>
    }

    <OmniFormField For="agent-capabilities" Label="@L["EnableAgentCapabilitiesField"]"
                   Help="@L["EnableAgentCapabilitiesHelp"]" Class="omni-u-w-100">
        <OmniSelectableCardGroup TValue="string" TSelection="IReadOnlyList<string>" Id="agent-capabilities"
                                 Multiple="true" Columns="1" Disabled="@(!AgentCanEnable)" @bind-Value="_selected">
            @foreach (var option in Options)
            {
                var granted = IsGranted(option.Token);
                <OmniSelectableCard @key="option.Token" Choice="@option.Token"
                                    Title="@L[option.TitleKey]"
                                    Description="@(granted ? L["EnableAgentCapabilitiesAlreadyGranted"] : L[option.HintKey])"
                                    Disabled="@granted">
                    <Icon><OmniIcon Name="@option.Icon" /></Icon>
                </OmniSelectableCard>
            }
        </OmniSelectableCardGroup>
    </OmniFormField>

    <OmniAlert Severity="OmniSeverity.Info" Class="agent-capabilities-restart">
        @L["EnableAgentCapabilitiesRestart"]
    </OmniAlert>

    <DialogFooter OnCancel="@Cancel">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SubmitAsync" Disabled="@(!CanSubmit)" Busy="@_busy"
                    Class="agent-capabilities-submit">
            <Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L[SubmitKey]</span></ChildContent>
        </OmniButton>
    </DialogFooter>
</OmniStack>
