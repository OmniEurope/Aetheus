@* R3-58 (ADR-051): choose the privileges an agent update grants on the host. Only the closed whitelist
   of AgentEnableableCapabilities is offered; one primary action, Cancel in the footer. *@
<OmniStack Gap="OmniSpacing.Large" Class="agent-capabilities-dialog">
    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">
        @string.Format(L["EnableAgentCapabilitiesIntro"], Server.Name)
    </OmniText>

    @if (!AgentCanEnable)
    {
        <OmniAlert Severity="OmniSeverity.Warning" Class="agent-capabilities-agent-old">
            @L["EnableAgentCapabilitiesAgentOld"]
        </OmniAlert>
    }

    <OmniFormField For="agent-capabilities" Label="@L["EnableAgentCapabilitiesField"]" Required="true"
                   Help="@L["EnableAgentCapabilitiesHelp"]" Class="omni-u-w-100">
        <OmniSelectableCardGroup TValue="string" TSelection="IReadOnlyList<string>" Id="agent-capabilities"
                                 Multiple="true" Disabled="@(!AgentCanEnable)" @bind-Value="_selected">
            <OmniSelectableCard Choice="@AgentEnableableCapabilities.PatchManage"
                                Title="@L["WizardModulePatchManagement"]"
                                Description="@(PatchManageGranted ? L["EnableAgentCapabilitiesAlreadyGranted"] : L["WizardModulePatchManagementHint"])"
                                Disabled="@PatchManageGranted">
                <Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon>
            </OmniSelectableCard>
        </OmniSelectableCardGroup>
    </OmniFormField>

    <OmniAlert Severity="OmniSeverity.Info" Class="agent-capabilities-restart">
        @L["EnableAgentCapabilitiesRestart"]
    </OmniAlert>

    <DialogFooter OnCancel="@Cancel" CancelText="@L["Cancel"]">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SubmitAsync" Disabled="@(!CanSubmit)" Busy="@_busy"
                    Class="agent-capabilities-submit">
            <OmniIcon Name="OmniIconName.Download" /> <span>@L["EnableAgentCapabilitiesSubmit"]</span>
        </OmniButton>
    </DialogFooter>
</OmniStack>
