@* PLAN-010 lot 1: what the backend's external probe found for an offline server. *@

@if (Visible)
{
    <span class="server-reachability" title="@Detail">
        <OmniBadge Fill="OmniFill.Tonal" Tone="@Tone">@L.Localize(Effective)</OmniBadge>
    </span>
    @if (ShowDetail)
    {
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="server-reachability-detail">@Detail</OmniText>
    }
}
