@using Microsoft.AspNetCore.Components.Sections
@inject GridExportContext ExportContext

@* Recette R-29: the page's main action sits in the page header, on the title line. *@
@if (CanEdit && _firewall is { Installed: true, StatusKnown: true })
{
    <SectionContent SectionName="@PageHeaderActions.SectionName">
        @if (_firewall.Active)
        {
            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => ToggleAsync(false))" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><Icon><OmniIcon Name="OmniIconName.ShieldWarning" /></Icon><ChildContent><span>@L["FirewallDisable"]</span></ChildContent></OmniButton>
        }
        else
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => ToggleAsync(true))" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent><span>@L["FirewallEnable"]</span></ChildContent></OmniButton>
        }
    </SectionContent>
}

<OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Large">
    <ServerTaskFollower @ref="_follower" ServerId="@ServerId" SettleOnHeartbeat="true" OnSettled="@(() => LoadAsync(live: true))" />
    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
        <OmniIcon Name="OmniIconName.ShieldCheck" />
        @if (_firewall is not null && _firewall.Installed)
        {
            <OmniBadge Icon="@(BadgeIcon.ForState(!_firewall.StatusKnown ? OmniTone.Warning : _firewall.Active ? OmniTone.Success : OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="@(!_firewall.StatusKnown ? OmniTone.Warning : _firewall.Active ? OmniTone.Success : OmniTone.Neutral)">@(!_firewall.StatusKnown ? L["FirewallStatusUnknown"] : _firewall.Active ? L["FirewallActive"] : L["FirewallInactive"])</OmniBadge>
        }
    </OmniStack>

    @if (_loading)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
    }
    else if (_firewall is null || !_firewall.Installed)
    {
        <EmptyState Icon="gpp_bad" Title="@L["FirewallNotInstalledTitle"]" Description="@L["FirewallNotInstalledDescription"]" />
    }
    else if (!_firewall.StatusKnown)
    {
        <OmniAlert Severity="OmniSeverity.Warning">
            @(string.IsNullOrWhiteSpace(_firewall.CollectionDiagnostics)
                ? L["FirewallStatusUnknownHint"]
                : _firewall.CollectionDiagnostics)
        </OmniAlert>
    }
    else
    {
        @if (!CanManage)
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["FirewallManageDisabledHint"]</OmniText>
        }

        @if (CanEdit)
        {
            <OmniCard>
                <OmniTemplateForm TModel="NewRuleModel" Model="@_rule" OnValidSubmit="@((EditContext context) => SubmitRuleAsync((NewRuleModel)context.Model))">
                    <OmniDataAnnotationsValidator Localizer="@L" />
                    <OmniRow Gap="OmniSpacing.Large" Align="OmniAlignment.End">
                        <OmniFormField For="oe-pages-servers-serverdetailsections-serverfirewallsection-numeric-1"><LabelContent>@L["FirewallPort"]</LabelContent><ChildContent><OmniNumeric TValue="int" @bind-Value="_rule.Port" Minimum="1" Maximum="65535" Id="oe-pages-servers-serverdetailsections-serverfirewallsection-numeric-1" /></ChildContent></OmniFormField>
                        <OmniFormField Label="@L["FirewallProtocol"]" For="oe-formfield-pages-servers-serverdetailsections-serverfirewallsection-1">
                            <OmniDropDown Id="oe-formfield-pages-servers-serverdetailsections-serverfirewallsection-1" TValue="string" @bind-Value="_rule.Protocol" Options="@(Protocols.ToOptions(item => (string)item, item => item))" />
                        </OmniFormField>
                        <OmniFormField For="oe-pages-servers-serverdetailsections-serverfirewallsection-3"><LabelContent>@L["FirewallSource"]</LabelContent><ChildContent>
                            <OmniTextBox @bind-Value="_rule.Source" maxlength="64" Id="oe-pages-servers-serverdetailsections-serverfirewallsection-3" />
                        </ChildContent></OmniFormField>
                        @* One submit, the rule's action chosen beside it (user decision, 2026-10-17). *@
                        <OmniFormField For="oe-pages-servers-serverdetailsections-serverfirewallsection-action"><LabelContent>@L["FirewallActionColumn"]</LabelContent><ChildContent>
                            <OmniSelectBar TValue="FirewallRuleAction" @bind-Value="_rule.Action" Options="@RuleActionOptions" Id="oe-pages-servers-serverdetailsections-serverfirewallsection-action">
                                <IconTemplate Context="action"><OmniIcon Name="@RuleActionIcon(action)" /></IconTemplate>
                            </OmniSelectBar>
                        </ChildContent></OmniFormField>
                        <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["FirewallAddRule"]</span></ChildContent></OmniButton>
                    </OmniRow>
                </OmniTemplateForm>
            </OmniCard>
        }

        <OmniDataGrid @ref="_grid" ExportTitle="@ExportContext.Title(L["Rules"])" ExportFields="@ExportContext.Fields()" FillAvailableHeight="true" Items="@_firewall.Rules" TItem="FirewallRuleDto" KeyOf="@(row => row.Raw)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
            <EmptyContent>
                <EmptyState Icon="rule" Title="@L["FirewallNoRulesTitle"]" Description="@L["FirewallNoRulesDescription"]" />
            </EmptyContent>
            <Columns>
                <OmniDataGridColumn Frozen="true" TItem="FirewallRuleDto" Property="Port" Title="@L["FirewallPort"]" Width="6.25rem"  Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators"/>
                <OmniDataGridColumn TItem="FirewallRuleDto" Property="Protocol" Title="@L["FirewallProtocol"]" Width="6.25rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" />
                <OmniDataGridColumn TItem="FirewallRuleDto" Property="Action" Title="@L["FirewallActionColumn"]" Width="6.875rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@ActionText">
                    <Template Context="r">
                        <OmniBadge Icon="@(BadgeIcon.For(r.Action == "allow" ? OmniTone.Success : OmniTone.Danger))" Fill="OmniFill.Solid" Tone="@(r.Action == "allow" ? OmniTone.Success : OmniTone.Danger)">@LocalizeAction(r.Action)</OmniBadge>
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="FirewallRuleDto" Property="Source" Title="@L["FirewallSource"]"  Filterable="true"/>
                <OmniDataGridColumn TItem="FirewallRuleDto" Title="@L["Actions"]" Sortable="false">
                    <Template Context="r">
                        @if (CanEdit && IsDeletable(r))
                        {
                            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteRuleAsync(r))" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)" title="@L["Delete"]" Label="@L["Delete"]"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton>
                        }
                    </Template>
                </OmniDataGridColumn>
            </Columns>
        </OmniDataGrid>
    }
</OmniStack>
