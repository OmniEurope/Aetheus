@inject GridExportContext ExportContext
@inherits ServerActionSectionBase

<AgentOfflineNotice Server="@Server" />

@* --- Status bar --- *@
<OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-lg">
    <OmniBadge Fill="OmniFill.Solid" Tone="@(Certbot.IsInstalled ? OmniTone.Success : OmniTone.Neutral)">@(Certbot.IsInstalled ? L["Installed"] : L["NotInstalled"])</OmniBadge>
    @if (!string.IsNullOrEmpty(Certbot.Version))
    {
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">v@(Certbot.Version)</OmniText>
    }
    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@string.Format(L["CertificateCount"], Certbot.Certificates.Count)</OmniBadge>
    @if (Certbot.IsInstalled)
    {
        <OmniBadge Fill="OmniFill.Solid" Tone="@RenewalCheckStyle" data-testid="certbot-renewal-check">@RenewalCheckText</OmniBadge>
    }
    <div class="blade-content-spacer"></div>

    @* Recette R3-41: Create is the zone's one visible action; the maintenance actions sit in the
       "More actions" menu with the conditions their buttons had. *@
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenCreateDialog" Disabled="@(AgentOffline || !Certbot.IsInstalled || _actionRunning)" title="@L["NewCertificate"]"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
    <OmniOverflowMenu Label="@L["MoreActions"]">
        <OmniMenuItem Disabled="@(AgentOffline || !Certbot.IsInstalled || _actionRunning)" title="@L["CertbotNormalizeTitle"]" OnClick="@(() => ShowConfirm(L["CertbotNormalize"], L["ConfirmCertbotNormalize"], () => ExecuteActionAsync(CertbotAction.Normalize), L["CertbotNormalize"]))"><Icon><OmniIcon Name="OmniIconName.Swap" /></Icon><ChildContent>@L["CertbotNormalize"]</ChildContent></OmniMenuItem>
        <OmniMenuItem Disabled="@(AgentOffline || !Certbot.IsInstalled || _actionRunning)" title="@L["CertbotRenewalCheckTitle"]" OnClick="@(() => ExecuteActionAsync(CertbotAction.RenewalCheck))"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent>@L["CertbotRenewalCheck"]</ChildContent></OmniMenuItem>
        <OmniMenuItem Disabled="@(AgentOffline || !Certbot.IsInstalled || _actionRunning)" title="@L["RenewAll"]" OnClick="@(() => ShowConfirm(L["RenewAllCerts"], L["ConfirmRenewAllCerts"], () => ExecuteActionAsync(CertbotAction.RenewAll), L["Renew"]))"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["RenewAll"]</ChildContent></OmniMenuItem>
    </OmniOverflowMenu>
</OmniRow>

@* A server whose certbot helper is older than this release (or has no version marker) is told to update the agent. *@
@if (Certbot.IsInstalled && Certbot.HelperVersion < CertbotHelperVersion.Current)
{
    <OmniAlert Severity="OmniSeverity.Warning" Class="omni-u-mb-lg certbot-helper-outdated">@string.Format(L["CertbotHelperOutdated"], Certbot.HelperVersion, CertbotHelperVersion.Current)</OmniAlert>
}

@* Recette R3-56: a failed rehearsal names each certificate that failed it and certbot's reason. *@
@if (Certbot is { IsInstalled: true, RenewalCheckSucceeded: false })
{
    <OmniAlert Severity="OmniSeverity.Danger" Title="@L["CertbotRenewalCheckFailuresTitle"]" Class="omni-u-mb-lg certbot-renewal-failures">
        @if (Certbot.RenewalCheckFailures.Count == 0)
        {
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0 certbot-renewal-failures-unnamed">@L["CertbotRenewalCheckNoReason"]</OmniText>
        }
        else
        {
            <OmniStack Gap="OmniSpacing.XSmall">
                @foreach (var failure in Certbot.RenewalCheckFailures)
                {
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0 certbot-renewal-failure">@string.Format(L["CertbotRenewalFailureLine"], failure.Name, failure.Reason.Length > 0 ? failure.Reason : L["CertbotRenewalFailureNoReason"].Value)</OmniText>
                }
            </OmniStack>
        }
    </OmniAlert>
}

<ServerTaskFollower @ref="_follower" ServerId="@ServerId" NamePrefix="Certbot" />

<UrlSyncedTabs Slugs="@(new[] { "certificates", "relations" })">
    <Tabs>
        @* --- Certificates tab --- *@
        <OmniTabsItem Key="certificates" Title="@L["Certificates"]">
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                <CountBadge Value="@FilteredCertificates.Count" Variant="OmniTone.Accent" />
                <OmniTextBox aria-label="@L["FilterCertificates"]" @bind-Value="_certSearch" Placeholder="@L["FilterCertificates"]" />
            </OmniStack>
            <OmniDataGrid @ref="_grid" ExportTitle="@ExportContext.Title(L["Certificates"])" ExportFields="@ExportContext.Fields()" FillAvailableHeight="true" Items="@FilteredCertificates" TItem="CertbotCertificateDto" KeyOf="@(row => row.Name)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="CertbotCertificateDto" Property="Name" Title="@L["CertName"]" Width="12.5rem" Filterable="true" />
                    <OmniDataGridColumn TItem="CertbotCertificateDto" Title="@L["Domains"]" Sortable="false">
                        <Template Context="c">
                            @string.Join(", ", c.Domains)
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="CertbotCertificateDto" Property="ExpiryDate" Title="@L["Expiry"]" Width="11.25rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange">
                        <Template Context="c">
                            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@c.ExpiryDate.ToString("d")</OmniText>
                                @if (IsExpiringSoon(c))
                                {
                                    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Warning">@L["ExpiringSoon"]</OmniBadge>
                                }
                            </OmniStack>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="CertbotCertificateDto" Property="RenewalConvention" Title="@L["CertbotRenewal"]" Width="12.5rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@ConventionFilterText">
                        <Template Context="c">
                            <OmniBadge Fill="OmniFill.Solid" Tone="@ConventionStyle(c)" title="@ConventionDetail(c)" data-testid="certbot-convention">@ConventionText(c)</OmniBadge>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="CertbotCertificateDto" Title="@L["Actions"]" Width="9rem" Sortable="false">
                        <Template Context="c">
                            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => ExecuteActionAsync(CertbotAction.Renew, c.Name))" title="@L["Renew"]" Label="@L["Renew"]"><OmniIcon Name="OmniIconName.Refresh" /></OmniButton>
                                <OmniOverflowMenu Label="@L["MoreActions"]">
                                    <OmniMenuItem Tone="OmniTone.Danger" Disabled="@AgentOffline" OnClick="@(() => ShowDestructiveConfirm(L["RevokeCert"], string.Format(L["ConfirmRevokeCert"], c.Name),
                                            () => ExecuteActionAsync(CertbotAction.RevokeAndDelete, c.Name), L["Revoke"].Value))"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["Revoke"]</ChildContent></OmniMenuItem>
                                </OmniOverflowMenu>
                            </OmniStack>
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>
        </OmniTabsItem>

        @* --- Relations tab --- *@
        <OmniTabsItem Key="relations" Title="@L["Relations"]">
            <ModuleLinksTab ServerId="ServerId" SourceType="ModuleLinkType.Certbot" Resources="@CertbotResourceNames" />
        </OmniTabsItem>
    </Tabs>
</UrlSyncedTabs>
