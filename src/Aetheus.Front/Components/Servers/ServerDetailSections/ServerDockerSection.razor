<OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Class="omni-u-mb-md docker-toolbar" Gap="OmniSpacing.Small">
    <div class="blade-content-spacer"></div>
    @if (CanAdmin)
    {
        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@OpenPruneDialogAsync" Class="@(_pruning ? "btn-busy" : null)" Busy="@(_pruning)"><OmniIcon Name="OmniIconName.Broom" /> <span>@L["DockerPrune"]</span></OmniButton>
    }
    @* R-181: no Refresh button and no 10-second polling toggle. The inventory (Server.Docker) is rewritten from every agent heartbeat
       pushed on the servers hub (ServerDetailLoader), so the tabs follow the host by themselves. *@
</OmniStack>

@* TabRenderMode.Client keeps every tab alive: switching tabs must not destroy an open shell or a
   half-edited compose file, and a SignalR result arriving on an inactive tab must still land. *@
<UrlSyncedTabs RenderAllPanels="true" Slugs="@(new[] { "containers", "images", "compose", "networks", "volumes", "relations" })">
    <Tabs>
        <OmniTabsItem Key="containers" Title="@L["Containers"]">
            @* Four SignalR channels (inspect, exec, env, ls) come back through the parent, hence the @ref. *@
            <DockerContainersTab @ref="_containersTab" @key="ServerId" Server="@Server" ServerId="@ServerId" CanAdmin="@CanAdmin"
                InitialLoaded="@_dockerInitialLoaded" />
        </OmniTabsItem>

        <OmniTabsItem Key="images" Title="@L["DockerImages"]">
            <DockerImagesTab @key="ServerId" ServerId="@ServerId" CanAdmin="@CanAdmin" Images="@Server.Docker.Images" />
        </OmniTabsItem>

        <OmniTabsItem Key="compose" Title="@L["DockerCompose"]">
            @* The compose file arrives over SignalR on the parent's connection, hence the @ref. *@
            <DockerComposeTab @ref="_composeTab" @key="ServerId" ServerId="@ServerId" CanAdmin="@CanAdmin" Stacks="@Server.Docker.ComposeStacks" />
        </OmniTabsItem>

        <OmniTabsItem Key="networks" Title="@L["DockerNetworks"]">
            <DockerNetworksTab @key="ServerId" Networks="@Server.Docker.Networks" />
        </OmniTabsItem>

        <OmniTabsItem Key="volumes" Title="@L["DockerVolumes"]">
            @* Extracted: the tab owns its own filter state, the parent owns the inventory.
               @key on ServerId so switching server resets that state instead of leaking it. *@
            <DockerVolumesTab @key="ServerId" Volumes="@Server.Docker.Volumes" />
        </OmniTabsItem>

        @* --- Relations tab --- *@
        <OmniTabsItem Key="relations" Title="@L["Relations"]">
            <DockerRelationsGraph Docker="@Server.Docker" />
        </OmniTabsItem>
    </Tabs>
</UrlSyncedTabs>
