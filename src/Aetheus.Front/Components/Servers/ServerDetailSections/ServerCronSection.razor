@inject GridExportContext ExportContext
@inherits ServerActionSectionBase
@using Microsoft.AspNetCore.Components.Sections

<AgentOfflineNotice Server="@Server" />

@* Recette R-29: the page's main action sits in the page header, on the title line. *@
<SectionContent SectionName="@PageHeaderActions.SectionName">
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenCreateDialog())" Disabled="@(AgentOffline || !Cron.IsInstalled || _actionRunning)"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Create"]</span></ChildContent></OmniButton>
</SectionContent>

@* --- Status bar --- *@
<OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-lg">
    <OmniBadge Fill="OmniFill.Solid" Tone="@(Cron.IsInstalled ? OmniTone.Success : OmniTone.Neutral)">@(Cron.IsInstalled ? L["Installed"] : L["NotInstalled"])</OmniBadge>
    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@string.Format(L["CronJobCount"], Cron.Jobs.Count)</OmniBadge>
</OmniRow>

<ServerTaskFollower @ref="_follower" ServerId="@ServerId" NamePrefix="Cron" />

<OmniTabs>
        <OmniTabsItem Title="@L["CronJobs"]">
            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                <CountBadge Value="@FilteredJobs.Count" Variant="OmniTone.Accent" />
                <OmniTextBox aria-label="@L["FilterCronJobs"]" @bind-Value="_jobSearch" Placeholder="@L["FilterCronJobs"]" />
            </OmniStack>
            <OmniDataGrid @ref="_grid" ExportTitle="@ExportContext.Title(L["CronJobs"])" ExportFields="@ExportContext.Fields()" Items="@FilteredJobs" TItem="CronJobDto" KeyOf="@(row => row.Id)" NewRowHighlight="@(TimeSpan.FromSeconds(5))"
                AllowGrouping="true" ShowGroupPanel="true" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight"
                OnRowClick="@(args => OpenFromRowAsync(args.Item))">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="CronJobDto" Property="User" Title="@L["User"]" Width="8.75rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" />
                    <OmniDataGridColumn TItem="CronJobDto" Property="Schedule" Title="@L["Schedule"]" Width="10rem" Filterable="true">
                        <Template Context="j">
                            <code>@j.Schedule</code>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="CronJobDto" Property="Command" Truncate="true" Title="@L["Command"]" Filterable="true">
                        <Template Context="j">
                            <code>@j.Command</code>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="CronJobDto" Property="Source" Title="@L["Source"]" Width="11.25rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" />
                    <OmniDataGridColumn TItem="CronJobDto" Title="@L["Actions"]" Width="10rem" Sortable="false" Filterable="false">
                        <Template Context="j">
                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OpenEditDialog(j))" title="@L["Edit"]" Disabled="@(AgentOffline || j.IsSystem)"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon></OmniButton>
                                <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => ShowDestructiveConfirm(L["DeleteCronJob"], string.Format(L["ConfirmDeleteCronJob"], j.Id),
                                        () => DeleteJobAsync(j), L["Delete"].Value))" title="@L["Delete"]" Disabled="@(AgentOffline || j.IsSystem)"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton>
                            </OmniStack>
                            </span>
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>
        </OmniTabsItem>
</OmniTabs>
