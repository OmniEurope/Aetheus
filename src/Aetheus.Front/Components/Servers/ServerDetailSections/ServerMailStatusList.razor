@* Recette R2-090: the mail page opens on its state, one list, each line green or red; every red line
   carries what fixes it (R1-9); all green, a test message proves delivery end to end. The other tools stay
   below, secondary. *@
@using Microsoft.AspNetCore.Components.Sections
@* Recette R1-13: while tasks of this page run, one banner at the top names them; it goes when the last ends. *@
@if (_running.Count > 0)
{
    <MailTaskBanner Labels="@RunningLabels" Since="@RunningSince" />
}
@* Recette R1-12: the mail actions are a "..." menu in the page header, beside Réinstaller. *@
@if (CanManage)
{
    <SectionContent SectionName="@ServerMailReinstall.HeaderMenuSection">
        <OmniOverflowMenu Label="@L["MoreActions"]" Class="mail-actions-menu">
            <OmniMenuItem OnClick="@RestartOpenDkimAsync" Disabled="@IsBusy(MailTaskKind.OpenDkim)"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["MailRestartOpenDkim"]</ChildContent></OmniMenuItem>
            <OmniMenuItem OnClick="@RunServerCheckAsync" Disabled="@IsBusy(MailTaskKind.ServerCheck)"><Icon><OmniIcon Name="OmniIconName.ListChecks" /></Icon><ChildContent>@L["MailRunServerCheck"]</ChildContent></OmniMenuItem>
            @if (FirstRed is not null)
            {
                <OmniMenuItem OnClick="@SendTestAsync" Disabled="@IsBusy(MailTaskKind.DeliveryTest)"><Icon><OmniIcon Name="OmniIconName.PaperPlaneRight" /></Icon><ChildContent>@L["MailSendTest"]</ChildContent></OmniMenuItem>
            }
            <OmniMenuItem OnClick="@MeasureUsageAsync" Disabled="@IsBusy(MailTaskKind.Usage)"><Icon><OmniIcon Name="OmniIconName.ChartBarHorizontal" /></Icon><ChildContent>@L["MailMeasureUsage"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    </SectionContent>
}
<OmniCard Class="omni-u-mb-lg mail-status">
    <OmniStack Gap="OmniSpacing.Medium">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["MailStatusTitle"]</OmniHeading>
            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@(Mail.IsManagedByAetheus ? L["MailManagedByAetheus"] : L["MailAdoptedStack"])</OmniBadge>
            @if (!string.IsNullOrEmpty(Mail.Hostname))
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@L["Hostname"] : @Mail.Hostname</OmniText>
            }
            @if (_diagnostics is not null)
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@string.Format(L["MailDnsCheckedAt"], _diagnostics.CheckedAt.ToString("g"))</OmniText>
            }
        </OmniStack>

        @if (CanManage && Mail.HelperVersion < CurrentHelperVersion)
        {
            <OmniAlert Severity="OmniSeverity.Warning" Class="mail-helper-outdated">@string.Format(L["MailHelperOutdated"], Mail.HelperVersion)</OmniAlert>
        }

        @if (_loading && _diagnostics is null)
        {
            <AetheusLoader Size="OmniControlSize.Small" />
        }
        @if (_diagnostics is not null)
        {
            <OmniStack Gap="OmniSpacing.XSmall" Class="mail-status-lines">
                @foreach (var item in StatusItems)
                {
                    <MailCheckLine Label="@MailUiText.DiagnosticLabel(L, item.Key)" IsOk="@(item.Verdict == MailCheckVerdict.Ok)"
                                   Detail="@LineDetail(item)" />
                    @if (item.Verdict != MailCheckVerdict.Ok)
                    {
                        <MailStatusFix Item="@item" Hostname="@Mail.Hostname" CanManage="@CanManage" StartServicesBusy="@IsBusy(MailTaskKind.StartServices)"
                                       ObtainCertificateBusy="@IsBusy(MailTaskKind.ObtainCertificate)" InstallCertificateBusy="@IsBusy(MailTaskKind.InstallCertificate)"
                                       OnStartServices="@StartServicesAsync" OnObtainCertificate="@ObtainCertificateAsync"
                                       OnInstallCertificate="@InstallCertificateAsync" />
                    }
                }
            </OmniStack>
            @* Recette R1-11: the step-by-step help to publish the records, folded, once a mail domain is checked. *@
            @if (HelpDomain is { } helpDomain)
            {
                <MailDnsHelp Domain="@helpDomain" />
            }
            @if (FirstRed is null && StatusItems.Count > 0)
            {
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center" Gap="OmniSpacing.Small" Class="mail-status-all-green">
                    <OmniText Element="OmniTextElement.Paragraph" Tone="OmniTextTone.Success" Class="omni-u-m-0">@L["MailStatusAllGreen"]</OmniText>
                    @if (CanManage)
                    {
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SendTestAsync" Busy="@IsBusy(MailTaskKind.DeliveryTest)"><OmniIcon Name="OmniIconName.PaperPlaneRight" /> <span>@L["MailSendTest"]</span></OmniButton>
                    }
                </OmniStack>
            }
        }

        @* Recette R1-7: a failed action task (services, OpenDKIM, certificate) says so, with its last log line. *@
        @if (_failure is not null)
        {
            <OmniAlert Severity="OmniSeverity.Danger" Class="mail-task-failed">@_failure</OmniAlert>
        }

        @if (_delivery is not null)
        {
            <OmniAlert Severity="@(_delivery.IsSent ? OmniSeverity.Success : OmniSeverity.Danger)">
                @(_delivery.IsSent
                    ? string.Format(L["MailDeliverySent"], _delivery.QueueId)
                    : string.Format(L["MailDeliveryFailed"], _delivery.Status, _delivery.Detail))
            </OmniAlert>
        }

        @if (_checks.Count > 0)
        {
            <OmniStack Gap="OmniSpacing.XSmall" Class="mail-server-checks">
                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["MailServerChecks"]</OmniText>
                @foreach (var check in _checks)
                {
                    <MailCheckLine Label="@check.Component" IsOk="@check.IsOk" Detail="@check.Detail" />
                }
            </OmniStack>
        }

        @if (CanManage)
        {
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center" Gap="OmniSpacing.Small" Class="mail-status-tools">
                <OmniSplitButton Variant="OmniButtonVariant.Secondary" Text="@L["Postfix"]" Busy="@IsBusy(MailTaskKind.Postfix)" OnClick="@(() => ServiceActionAsync("postfix", "restart"))"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent>
                    <OmniMenuItem OnClick="@(() => ServiceActionAsync("postfix", "start"))"><OmniIcon Name="OmniIconName.Play" /> <span>@L["Start"]</span></OmniMenuItem>
                    <OmniMenuItem OnClick="@(() => ServiceActionAsync("postfix", "stop"))"><OmniIcon Name="@MaterialIconMap.Resolve("stop")" /> <span>@L["Stop"]</span></OmniMenuItem>
                    <OmniMenuItem OnClick="@(() => ServiceActionAsync("postfix", "restart"))"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Restart"]</span></OmniMenuItem>
                    <OmniMenuItem OnClick="@(() => ServiceActionAsync("postfix", "reload"))"><OmniIcon Name="@MaterialIconMap.Resolve("sync")" /> <span>@L["Reload"]</span></OmniMenuItem>
                </ChildContent></OmniSplitButton>
                <OmniSplitButton Variant="OmniButtonVariant.Secondary" Text="@L["Dovecot"]" Busy="@IsBusy(MailTaskKind.Dovecot)" OnClick="@(() => ServiceActionAsync("dovecot", "restart"))"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent>
                    <OmniMenuItem OnClick="@(() => ServiceActionAsync("dovecot", "start"))"><OmniIcon Name="OmniIconName.Play" /> <span>@L["Start"]</span></OmniMenuItem>
                    <OmniMenuItem OnClick="@(() => ServiceActionAsync("dovecot", "stop"))"><OmniIcon Name="@MaterialIconMap.Resolve("stop")" /> <span>@L["Stop"]</span></OmniMenuItem>
                    <OmniMenuItem OnClick="@(() => ServiceActionAsync("dovecot", "restart"))"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Restart"]</span></OmniMenuItem>
                    <OmniMenuItem OnClick="@(() => ServiceActionAsync("dovecot", "reload"))"><OmniIcon Name="@MaterialIconMap.Resolve("sync")" /> <span>@L["Reload"]</span></OmniMenuItem>
                </ChildContent></OmniSplitButton>
            </OmniStack>
        }

        @if (Mail.Diagnostics.Count > 0)
        {
            <OmniStack Gap="OmniSpacing.XSmall" Class="mail-collector-findings">
                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["MailCollectorFindings"]</OmniText>
                @foreach (var finding in Mail.Diagnostics)
                {
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@MailUiText.Finding(L, finding)</OmniText>
                }
            </OmniStack>
        }
    </OmniStack>
</OmniCard>
