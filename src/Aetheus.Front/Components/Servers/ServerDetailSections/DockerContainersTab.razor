@inject GridExportContext ExportContext
@* Containers tab of the Docker section: the grid, the per-project bulk actions, and the five
   detail panels (logs, inspect, shell, env, file browser). Markup moved verbatim from the parent. *@
<OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Class="omni-u-mb-sm" Gap="OmniSpacing.Small">
    <CountBadge Value="@FilteredContainers.Count" Variant="OmniTone.Accent" />
    <OmniTextBox aria-label="@L["FilterContainers"]" @bind-Value="_containerSearch" Placeholder="@L["FilterContainers"]" Class="docker-search" />
</OmniStack>
@if (!InitialLoaded && FilteredContainers.Count == 0)
{
    <div class="docker-skeleton">
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
    </div>
}
else
{
    @if (BulkProjectOptions.Count > 0)
    {
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small" Class="omni-u-mb-sm docker-bulk-actions">
            <label for="docker-bulk-project">@L["Project"]</label>
            <OmniDropDown aria-label="@L["Project"]" TValue="string" Id="docker-bulk-project" Options="@BulkProjectOptions"
                AllowEmpty="true" Placeholder="@L["Project"]" @bind-Value="_bulkProject" />
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => ProjectBulkActionAsync(SelectedBulkProject!, DockerContainerAction.Start))"
                title="@L["StartAll"]" Disabled="@(AgentOffline || SelectedBulkProject is null)"><OmniIcon Name="OmniIconName.Play" /> <span>@L["Start"]</span></OmniButton>
            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => ProjectBulkActionAsync(SelectedBulkProject!, DockerContainerAction.Stop))"
                title="@L["StopAll"]" Disabled="@(AgentOffline || SelectedBulkProject is null)"><OmniIcon Name="OmniIconName.Stop" /> <span>@L["StopAll"]</span></OmniButton>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ProjectBulkActionAsync(SelectedBulkProject!, DockerContainerAction.Restart))"
                title="@L["RestartAll"]" Disabled="@(AgentOffline || SelectedBulkProject is null)"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Restart"]</span></OmniButton>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenProjectZoom(SelectedBulkProject!))" title="@L["ZoomProject"]" Disabled="@(SelectedBulkProject is null)"><OmniIcon Name="OmniIconName.MagnifyingGlassPlus" /> <span>@L["ZoomProject"]</span></OmniButton>
        </OmniStack>
    }
<OmniDataGrid @ref="_grid" Items="@FilteredContainers" ExportTitle="@ExportContext.Title(L["Containers"])" ExportFields="@ExportContext.Fields()" TItem="DockerContainerDto" KeyOf="@(row => row.ContainerId)" NewRowHighlight="@(TimeSpan.FromSeconds(5))"
    AllowGrouping="true" ShowGroupPanel="true" @bind-Groups="_containerGroups" GroupLabel="@ContainerGroupLabel"
    AllGroupsExpanded="@_allContainerGroupsExpanded"
    RowRender="@OnContainerRowRender" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="DockerContainerDto" Property="Project" Title="@L["Project"]" Width="8.75rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" />
        <OmniDataGridColumn TItem="DockerContainerDto" Property="Name" Title="@L["Name"]" Filterable="true" Width="11.25rem">
            <Template Context="c">
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.XSmall">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@GetContainerBadge(c.State)">@c.State</OmniBadge>
                    <span title="@c.ContainerId">
                        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@c.Name</OmniText>
                    </span>
                </OmniStack>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="DockerContainerDto" Property="Image" Title="@L["Image"]" Filterable="true" />
        <OmniDataGridColumn TItem="DockerContainerDto" Property="Status" Title="@L["Status"]" Width="11.25rem" Filterable="true" />
        <OmniDataGridColumn TItem="DockerContainerDto" Property="CpuPercent" Title="@L["CPU"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" Width="5rem">
            <Template Context="c">
                @(c.CpuPercent.ToString("F1"))%
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="DockerContainerDto" Property="MemoryUsageMb" Title="@L["Memory"]" Filterable="true" FilterType="OmniDataGridColumnFilterType.Number" FilterOperators="@GridFilterText.NumberOperators" Width="10rem">
            <Template Context="c">
                <OmniStack Gap="OmniSpacing.XSmall">
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@(c.MemoryUsageMb.ToString("F0")) / @(c.MemoryLimitMb.ToString("F0")) MB</OmniText>
                    <OmniProgressBar Value="@c.MemoryUsageMb" Maximum="@(c.MemoryLimitMb > 0 ? c.MemoryLimitMb : 1)"
                        ShowValue="false" Class="@GetMemoryBarClass(c)" />
                </OmniStack>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="DockerContainerDto" Property="Ports" Title="@L["Ports"]" Width="12.5rem" Filterable="true" />
        <OmniDataGridColumn TItem="DockerContainerDto" Title="@L["Actions"]" MinWidth="56rem" Sortable="false" Filterable="false">
            <Template Context="c">
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall" Class="docker-row-actions">
                    @if (c.State == "running")
                    {
                        <OmniButton Variant="OmniButtonVariant.Danger" Disabled="@AgentOffline" OnClick="@(() => DockerActionAsync(c.ContainerId, DockerContainerAction.Stop))"
                            title="@L["Stop"]" Class="@((_dockerActionTarget == c.ContainerId) ? "btn-busy" : null)" Busy="@((_dockerActionTarget == c.ContainerId))" Label="@L["Stop"]"><OmniIcon Name="OmniIconName.Stop" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@AgentOffline" OnClick="@(() => DockerActionAsync(c.ContainerId, DockerContainerAction.Restart))"
                            title="@L["Restart"]" Class="@((_dockerActionTarget == c.ContainerId) ? "btn-busy" : null)" Busy="@((_dockerActionTarget == c.ContainerId))" Label="@L["Restart"]"><OmniIcon Name="OmniIconName.Refresh" /></OmniButton>
                    }
                    else
                    {
                        <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@AgentOffline" OnClick="@(() => DockerActionAsync(c.ContainerId, DockerContainerAction.Start))"
                            title="@L["Start"]" Class="@((_dockerActionTarget == c.ContainerId) ? "btn-busy" : null)" Busy="@((_dockerActionTarget == c.ContainerId))" Label="@L["Start"]"><OmniIcon Name="OmniIconName.Play" /></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Danger" Disabled="@AgentOffline" OnClick="@(() => ConfirmRemoveContainerAsync(c.ContainerId, c.Name))"
                            title="@L["Delete"]" Class="@((_dockerActionTarget == c.ContainerId) ? "btn-busy" : null)" Busy="@((_dockerActionTarget == c.ContainerId))" Label="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                    }
                    <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@AgentOffline" OnClick="@(() => ToggleLogsAsync(c.ContainerId))" title="@L["ViewLogs"]" Label="@L["ViewLogs"]"><OmniIcon Name="OmniIconName.Document" /></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@AgentOffline" OnClick="@(() => OpenResourceLimitsDialog(c.ContainerId))" title="@L["ResourceLimits"]" Label="@L["ResourceLimits"]"><OmniIcon Name="OmniIconName.Sliders" /></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@AgentOffline" OnClick="@(() => RequestInspectAsync(c.ContainerId))" title="@L["DockerInspect"]" Label="@L["DockerInspect"]"><OmniIcon Name="OmniIconName.Info" /></OmniButton>
                    @if (c.State == "running")
                    {
                        @* Eight actions crowd a row; the three "open a panel" actions of a running container
                           go behind "…". *@
                        <OmniOverflowMenu Label="@L["MoreActions"]" Disabled="@AgentOffline">
                            @if (CanAdmin)
                            {
                                <OmniMenuItem OnClick="@(() => OpenShell(c.ContainerId, c.Name))"><Icon><OmniIcon Name="OmniIconName.TerminalWindow" /></Icon><ChildContent>@L["DockerShell"]</ChildContent></OmniMenuItem>
                            }
                            <OmniMenuItem OnClick="@(() => RequestEnvVarsAsync(c.ContainerId, c.Name))"><Icon><OmniIcon Name="OmniIconName.Key" /></Icon><ChildContent>@L["DockerEnvVars"]</ChildContent></OmniMenuItem>
                            <OmniMenuItem OnClick="@(() => OpenFileBrowserAsync(c.ContainerId, c.Name))"><Icon><OmniIcon Name="OmniIconName.FolderOpen" /></Icon><ChildContent>@L["DockerFileBrowser"]</ChildContent></OmniMenuItem>
                        </OmniOverflowMenu>
                    }
                </OmniStack>
            </Template>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>
}

@if (_logsContainerId is not null)
{
    <OmniCard Class="omni-u-mt-md">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Class="omni-u-mb-sm" Gap="OmniSpacing.Small">
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["DockerLogs"] - @_logsContainerId[..Math.Min(12, _logsContainerId.Length)]</OmniText>
            <div class="flex-spacer"></div>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => { _logsContainerId = null; _logsContent = null; })" title="@L["Close"]"><OmniIcon Name="OmniIconName.Close" /></OmniButton>
        </OmniStack>
        @if (_logsContent is null)
        {
            <AetheusLoader Size="OmniControlSize.Small" />
        }
        else
        {
            @* R-516: OE's code block, its copy button at the end of its title. *@
            <OmniCodeBlock Code="@_logsContent" Title="@L["Logs"]" Wrap="true" Class="docker-logs code-block-bounded" />
        }
    </OmniCard>
}

@if (_inspectContainerId is not null)
{
    <OmniCard Class="omni-u-mt-md docker-panel-fadein">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Class="omni-u-mb-sm" Gap="OmniSpacing.Small">
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["DockerInspect"] - @_inspectContainerId[..Math.Min(12, _inspectContainerId.Length)]</OmniText>
            <div class="flex-spacer"></div>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => { _inspectContainerId = null; _inspectContent = null; })" title="@L["Close"]"><OmniIcon Name="OmniIconName.Close" /></OmniButton>
        </OmniStack>
        @if (_inspectContent is null)
        {
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["WaitingResult"]</OmniText>
        }
        else
        {
            @* The block's own copy button replaces the panel's (R-516). *@
            <OmniCodeBlock Code="@_inspectContent" Title="@L["Output"]" Language="json" Wrap="true" Class="docker-logs code-block-bounded" />
        }
    </OmniCard>
}

@if (_shellContainerId is not null)
{
    <OmniCard Class="omni-u-mt-md docker-panel-fadein">
        <OmniStack Gap="OmniSpacing.Small">
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Large">
                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["DockerShell"] - @_shellContainerName</OmniText>
                <div class="flex-spacer"></div>
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => { _shellContainerId = null; _shellOutput = string.Empty; })" title="@L["Close"]"><OmniIcon Name="OmniIconName.Close" /></OmniButton>
            </OmniStack>
            <OmniCodeBlock Code="@_shellOutput" Title="@L["Output"]" Wrap="true" Class="docker-logs docker-shell-output code-block-bounded" />
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                <div @onkeydown="OnShellKeyDown">
                    <OmniTextBox aria-label="@L["EnterCommand"]" @bind-Value="_shellCommand" Placeholder="@L["EnterCommand"]" Class="docker-shell-input" />
                </div>
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SendShellCommandAsync" Disabled="@(AgentOffline || string.IsNullOrWhiteSpace(_shellCommand))" title="@L["Send"]"><OmniIcon Name="OmniIconName.PaperPlaneRight" /></OmniButton>
            </OmniStack>
        </OmniStack>
    </OmniCard>
}

@if (_envContainerId is not null)
{
    <OmniCard Class="omni-u-mt-md docker-panel-fadein">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Class="omni-u-mb-sm" Gap="OmniSpacing.Small">
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["DockerEnvVars"] - @_envContainerName</OmniText>
            <div class="flex-spacer"></div>
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => { _envContainerId = null; _envContent = null; })" title="@L["Close"]"><OmniIcon Name="OmniIconName.Close" /></OmniButton>
        </OmniStack>
        @if (_envContent is null)
        {
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["WaitingResult"]</OmniText>
        }
        else
        {
            <OmniDataGrid Items="@ParseEnvVars(_envContent)" ExportMarkdown="false" TItem="DockerEnvVarDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="DockerEnvVarDto" Property="Key" Title="@L["Key"]" Filterable="true" />
                    <OmniDataGridColumn TItem="DockerEnvVarDto" Property="Value" Title="@L["Value"]" Filterable="true" />
                </Columns>
            </OmniDataGrid>
        }
    </OmniCard>
}

@if (_browseContainerId is not null)
{
    <OmniCard Class="omni-u-mt-md docker-panel-fadein">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Class="omni-u-mb-sm" Gap="OmniSpacing.Small">
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["DockerFileBrowser"] - @_browseContainerName</OmniText>
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@_browsePath</OmniText>
            <div class="flex-spacer"></div>
            @if (_browsePath != "/")
            {
                <OmniButton Variant="OmniButtonVariant.Primary" Disabled="@AgentOffline" OnClick="@BrowseParentAsync" title="@L["MoveUp"]"><OmniIcon Name="OmniIconName.Upgrade" /></OmniButton>
            }
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => { _browseContainerId = null; _browseContent = null; })" title="@L["Close"]"><OmniIcon Name="OmniIconName.Close" /></OmniButton>
        </OmniStack>
        @if (_browseContent is null)
        {
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted">@L["WaitingResult"]</OmniText>
        }
        else
        {
            <OmniCodeBlock Code="@_browseContent" Title="@L["Output"]" Wrap="true" Class="docker-logs code-block-bounded" />
        }
    </OmniCard>
}
