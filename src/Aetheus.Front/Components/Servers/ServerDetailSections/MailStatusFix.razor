@* Under every red line of the mail status, what fixes it: what the record is and why it matters,
   an action Aetheus can run or the exact DNS record to publish (to copy), and the effect of the
   change. The line turns green on a later heartbeat. *@
<OmniCard Class="mail-status-fix" data-key="@Item.Key">
    <OmniStack Gap="OmniSpacing.Small">
        @if (WhatItIs is { } what)
        {
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0 mail-fix-what">@what</OmniText>
        }
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@Explanation</OmniText>
        @if (ShowsRecord)
        {
            <OmniCodeBlock Title="@($"{Item.RecordType} {Item.RecordName}")" Code="@Item.RecordValue" Wrap="true" />
        }
        @if (Effect is { } effect)
        {
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0 mail-fix-effect">@effect</OmniText>
        }
        @if (CacheNote is { } cache)
        {
            <OmniText Element="OmniTextElement.Paragraph" Tone="OmniTextTone.Muted" Class="omni-u-m-0 mail-fix-cache">@cache</OmniText>
        }
        @if (Kind == FixKind.Services && CanManage)
        {
            <OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Gap="OmniSpacing.Small">
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OnStartServices" Busy="@StartServicesBusy"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent><span>@L["MailStartServices"]</span></ChildContent></OmniButton>
            </OmniStack>
        }
        else if (Kind == FixKind.Certificate && CanManage && HostnameKnown)
        {
            @* Both mail-certificate actions use primary blue buttons. *@
            <OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Gap="OmniSpacing.Small">
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OnObtainCertificate" Busy="@ObtainCertificateBusy" Disabled="@InstallCertificateBusy"><Icon><OmniIcon Name="OmniIconName.ShieldCheck" /></Icon><ChildContent><span>@L["MailObtainCertificate"]</span></ChildContent></OmniButton>
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OnInstallCertificate" Busy="@InstallCertificateBusy" Disabled="@ObtainCertificateBusy"><Icon><OmniIcon Name="OmniIconName.Monitor" /></Icon><ChildContent><span>@L["MailInstallCertificate"]</span></ChildContent></OmniButton>
            </OmniStack>
        }
        @if (Kind == FixKind.Dns)
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@L["MailFixRecheck"]</OmniText>
        }
    </OmniStack>
</OmniCard>
