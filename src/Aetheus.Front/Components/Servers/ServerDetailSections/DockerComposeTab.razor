@inject GridExportContext ExportContext
@* Compose tab of the Docker section: the stack grid and the inline compose-file editor. The editor
   content arrives asynchronously over SignalR, so the parent forwards task output here. *@
<OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Class="omni-u-mb-md" Gap="OmniSpacing.Small">
    <CountBadge Value="@FilteredCompose.Count" Variant="OmniTone.Accent" />
    <OmniTextBox aria-label="@L["FilterStacks"]" @bind-Value="_composeSearch" Placeholder="@L["FilterStacks"]" Class="docker-search" />
</OmniStack>
<ServerTaskFollower @ref="_follower" ServerId="@ServerId" NamePrefix="Docker" />
<OmniDataGrid @ref="_grid" ExportTitle="@ExportContext.Title(L["DockerCompose"])" ExportFields="@ExportContext.Fields()" Items="@FilteredCompose" TItem="DockerComposeStackDto" KeyOf="@(row => row.Name)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight"
    OnRowClick="@(args => OpenComposeEditorAsync(args.Item.Name))">
    @* Recette R3-35: clicking a stack opens its compose file; the buttons of the row keep their own action. *@
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="DockerComposeStackDto" Property="Name" Title="@L["Stack"]" Filterable="true" />
        <OmniDataGridColumn TItem="DockerComposeStackDto" Property="Status" Title="@L["Status"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" />
        <OmniDataGridColumn TItem="DockerComposeStackDto" Title="@L["Services"]" Width="7.5rem" Sortable="false">
            <Template Context="s">
                @s.RunningCount / @s.TotalCount
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="DockerComposeStackDto" Property="ConfigFile" Title="@L["Config"]" Filterable="true" />
        <OmniDataGridColumn TItem="DockerComposeStackDto" Title="@L["Actions"]" MinWidth="28rem" Sortable="false" Filterable="false">
            <Template Context="s">
                <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                @* STD-BTN detection 11: Start visible with its destructive Stop, the other actions in the menu. *@
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                    <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@AgentOffline" OnClick="@(() => ComposeActionAsync(s.Name, DockerComposeAction.Up))" title="@L["Start"]" Label="@L["Start"]"><OmniIcon Name="OmniIconName.Play" /></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Danger" Disabled="@AgentOffline" OnClick="@(() => ComposeActionAsync(s.Name, DockerComposeAction.Down))" title="@L["Stop"]" Label="@L["Stop"]"><OmniIcon Name="OmniIconName.Stop" /></OmniButton>
                    <OmniOverflowMenu Label="@L["MoreActions"]">
                        <OmniMenuItem Disabled="@AgentOffline" OnClick="@(() => ComposeActionAsync(s.Name, DockerComposeAction.Restart))" title="@L["Restart"]"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["Restart"]</ChildContent></OmniMenuItem>
                        <OmniMenuItem Disabled="@AgentOffline" OnClick="@(() => OpenComposeEditorAsync(s.Name))" title="@L["EditCompose"]"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent>@L["EditCompose"]</ChildContent></OmniMenuItem>
                    </OmniOverflowMenu>
                </OmniStack>
                </span>
            </Template>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>

@if (_composeEditorVisible)
{
    <OmniCard Class="omni-u-mt-md">
        <OmniStack Gap="OmniSpacing.Small">
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Large">
                <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["DockerCompose"] - @_composeEditorStack</OmniText>
                <div class="flex-spacer"></div>
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@CloseComposeEditor" title="@L["Close"]"><OmniIcon Name="OmniIconName.Close" /></OmniButton>
            </OmniStack>
            @* Recette R3-34: a failed read says why; while the file is requested, OE's busy veil lies over
               the editor, which stays mounted underneath (R3-32, the same rule as the Apache editor). *@
            @if (!string.IsNullOrWhiteSpace(_composeError))
            {
                <OmniAlert Severity="OmniSeverity.Danger">
                    <Icon><OmniIcon Name="OmniIconName.Error" /></Icon>
                    <ChildContent><OmniText Element="OmniTextElement.Strong">@L["TaskFailed"]</OmniText><OmniText Element="OmniTextElement.Paragraph" Class="task-output-error">@_composeError</OmniText></ChildContent>
                </OmniAlert>
            }
            <div class="@(_composeFileLoading ? "omni-busy" : null)" aria-busy="@(_composeFileLoading ? "true" : "false")"
                 title="@(_composeFileLoading ? L["RequestingCompose"].Value : null)">
                <OmniCodeEditor @bind-Value="_composeEditorContent" Language="yaml" Height="24rem"
                                InteropModulePath="./js/omni-code-editor-frame.js?v=1"
                                Label="@L["DockerCompose"]" Disabled="@_composeFileLoading" />
            </div>
            @if (!_composeFileLoading)
            {
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Justify="OmniJustification.End">
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@CloseComposeEditor"><OmniIcon Name="OmniIconName.Close" /> <span>@L["Cancel"]</span></OmniButton>
                    @if (CanAdmin)
                    {
                        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@SaveComposeFileAsync" Disabled="@(AgentOffline || string.IsNullOrWhiteSpace(_composeEditorContent))" Class="@(_composeDeploying ? "btn-busy" : null)" Busy="@(_composeDeploying)"><OmniIcon Name="OmniIconName.RocketLaunch" /> <span>@L["Deploy"]</span></OmniButton>
                    }
                </OmniStack>
            }
        </OmniStack>
    </OmniCard>
}
