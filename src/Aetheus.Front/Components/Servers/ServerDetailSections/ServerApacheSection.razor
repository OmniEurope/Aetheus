@inject GridExportContext ExportContext
@inherits ServerActionSectionBase
@using Microsoft.AspNetCore.Components.Sections

<AgentOfflineNotice Server="@Server" />

@* Recette R-29: the page's main action sits in the page header, on the title line, with its menu beside it.
   R3-41/R3-42: Restart is the one visible action (blue); Start, Stop, Reload and Test sit in the
   "More actions" menu with the conditions their buttons had. *@
<SectionContent SectionName="@PageHeaderActions.SectionName">
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => ExecuteActionAsync(ApacheAction.Restart))" Disabled="@(AgentOffline || !Apache.IsRunning)" Class="@(_actionRunning ? "btn-busy" : null)" Busy="@(_actionRunning)"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@L["Restart"]</span></ChildContent></OmniButton>
    <OmniOverflowMenu Label="@L["MoreActions"]">
        <OmniMenuItem OnClick="@(() => ExecuteActionAsync(ApacheAction.Start))" Disabled="@(AgentOffline || Apache.IsRunning)"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent>@L["Start"]</ChildContent></OmniMenuItem>
        <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => ShowDestructiveConfirm(L["StopApache"], L["ConfirmStopApache"], () => ExecuteActionAsync(ApacheAction.Stop), L["Stop"].Value, OmniIconName.Stop))" Disabled="@(AgentOffline || !Apache.IsRunning || _actionRunning)"><Icon><OmniIcon Name="OmniIconName.Stop" /></Icon><ChildContent>@L["Stop"]</ChildContent></OmniMenuItem>
        <OmniMenuItem OnClick="@(() => ExecuteActionAsync(ApacheAction.Reload))" Disabled="@(AgentOffline || !Apache.IsRunning)"><Icon><OmniIcon Name="OmniIconName.Sync" /></Icon><ChildContent>@L["Reload"]</ChildContent></OmniMenuItem>
        <OmniMenuItem Disabled="@AgentOffline" OnClick="@(() => ExecuteActionAsync(ApacheAction.TestConfig))" title="@L["TestConfig"]"><Icon><OmniIcon Name="OmniIconName.CheckCircle" /></Icon><ChildContent>@L["Test"]</ChildContent></OmniMenuItem>
    </OmniOverflowMenu>
</SectionContent>

@* --- Status bar ---
   Recette R-120: the version moved into the page title and "Running" is the normal state, so it is no longer shown;
   only a stopped Apache is flagged. The row exists only when there is something to say, to give the room back. *@
@if (!Apache.IsRunning || Apache.Pid.HasValue)
{
    <OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-lg">
        @if (!Apache.IsRunning)
        {
            <OmniBadge Icon="@(BadgeIcon.ForState(GetStatusBadge(false)))" Fill="OmniFill.Solid" Tone="@GetStatusBadge(false)">@L["Stopped"]</OmniBadge>
        }
        @if (Apache.Pid.HasValue)
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">PID @Apache.Pid</OmniText>
        }
    </OmniRow>
}

<ServerTaskFollower @ref="_follower" ServerId="@ServerId" NamePrefix="Apache" SettleOnHeartbeat="true" />

@if (Apache.CollectionDegraded)
{
        <OmniAlert Severity="OmniSeverity.Warning" Title="@L["ApacheCollectionDegraded"]">
        @L["ApacheCollectionDegradedHint"]
        @if (!string.IsNullOrWhiteSpace(Apache.CollectionDiagnostics))
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-mt-sm omni-u-mb-0">
                @Apache.CollectionDiagnostics
            </OmniText>
        }
        </OmniAlert>
}

<UrlSyncedTabs Slugs="@(new[] { "sites", "modules", "logs", "relations" })">
    <Tabs>
        @* --- Sites tab (enabled + disabled, split) --- *@
        <OmniTabsItem Key="sites" Title="@L["Sites"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("language")" /></Icon><ChildContent>
            @* Recette R-120: no count and no free-text filter above the lists (the grids filter by column, in the
               row under their header, and the headings carry the counts). Both grids are capped to about ten rows
               and scroll inside, neither fills the remaining height. *@
            @* Item #5.1: one row per domain (ServerName), with port chips for each vhost the
               domain serves. A `:80` + `:443` pair that share the same .conf - the common case -
               collapses from 2 rows to 1. Per-port action buttons disable/edit the matching
               config file. *@
            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-md omni-u-mb-sm">
                @L["SitesEnabled"] (@EnabledVirtualHostGroups.Count)
            </OmniHeading>
            <OmniDataGrid @ref="_enabledGrid" ExportTitle="@ExportContext.Title(L["SitesEnabled"])" ExportFields="@ExportContext.Fields()" Items="@EnabledVirtualHostGroups" TItem="ApacheVirtualHostGroup" KeyOf="@(row => row.ServerName)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.TenRowsMaxHeight" ShowHeaderFilterMenu="false"
                OnRowClick="@(args => OpenConfigEditorAsync(Path.GetFileName(args.Item.Primary.ConfigFile)))">
                <Columns>
                    <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="ApacheVirtualHostGroup" Property="ServerName" Title="@L["ServerName"]" Filterable="true">
                        <Template Context="g"><strong>@g.ServerName</strong></Template>
                    </OmniDataGridColumn>
                    @* Recette R-13: the VirtualHost count has its own column (it was a "× n" badge beside the name). *@
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" Property="BlockCount" Title="@L["ApacheBlocks"]" Width="6rem" TextAlign="OmniAlignment.End" Filterable="false" />
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" ExportValue="@PortsExport" Title="@L["Ports"]" Width="12.5rem" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <OmniRow Gap="OmniSpacing.XSmall">
                                @foreach (var m in g.Members)
                                {
                                    <NumberBadge Fill="OmniFill.Solid" Tone="@(m.Port == 443 ? OmniTone.Success : OmniTone.Accent)"
                                        title="@($"{m.Port} → {System.IO.Path.GetFileName(m.ConfigFile)}")">@m.Port.ToString()</NumberBadge>
                                }
                            </OmniRow>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" Title="@L["Actions"]" Width="20rem" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <OmniRow Gap="OmniSpacing.XSmall">
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenConfigEditorAsync(Path.GetFileName(g.Primary.ConfigFile)))" title="@L["EditConfig"]" Label="@L["EditConfig"]"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon></OmniButton>
                                @foreach (var m in g.Members)
                                {
                                    <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Danger" OnClick="@(() => ExecuteActionAsync(ApacheAction.DisableSite, Path.GetFileName(m.ConfigFile)))" title="@($"{L["Disable"]} {Path.GetFileName(m.ConfigFile)} ({m.Port})")"><Icon><OmniIcon Name="OmniIconName.Prohibit" /></Icon><ChildContent><span>@($":{m.Port}")</span></ChildContent></OmniButton>
                                }
                            </OmniRow>
                            </span>
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>

            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-lg omni-u-mb-sm">
                @L["SitesDisabled"] (@DisabledVirtualHostGroups.Count)
            </OmniHeading>
            <OmniDataGrid @ref="_disabledGrid" ExportTitle="@ExportContext.Title(L["SitesDisabled"])" ExportFields="@ExportContext.Fields()" Items="@DisabledVirtualHostGroups" TItem="ApacheVirtualHostGroup" KeyOf="@(row => row.ServerName)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.TenRowsMaxHeight" ShowHeaderFilterMenu="false"
                OnRowClick="@(args => OpenConfigEditorAsync(Path.GetFileName(args.Item.Primary.ConfigFile)))">
                <Columns>
                    <OmniDataGridColumn Class="omni-data-grid__cell--text" Frozen="true" TItem="ApacheVirtualHostGroup" Property="ServerName" Title="@L["ServerName"]" Filterable="true">
                        <Template Context="g"><strong>@g.ServerName</strong></Template>
                    </OmniDataGridColumn>
                    @* Recette R-13: the VirtualHost count has its own column (it was a "× n" badge beside the name). *@
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" Property="BlockCount" Title="@L["ApacheBlocks"]" Width="6rem" TextAlign="OmniAlignment.End" Filterable="false" />
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" ExportValue="@PortsExport" Title="@L["Ports"]" Width="12.5rem" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <OmniRow Gap="OmniSpacing.XSmall">
                                @foreach (var m in g.Members)
                                {
                                    <NumberBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@m.Port.ToString()</NumberBadge>
                                }
                            </OmniRow>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" Title="@L["Actions"]" Width="20rem" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <OmniRow Gap="OmniSpacing.XSmall">
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenConfigEditorAsync(Path.GetFileName(g.Primary.ConfigFile)))" title="@L["EditConfig"]" Label="@L["EditConfig"]"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon></OmniButton>
                                @foreach (var m in g.Members)
                                {
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => ExecuteActionAsync(ApacheAction.EnableSite, Path.GetFileName(m.ConfigFile)))" title="@($"{L["Enable"]} {Path.GetFileName(m.ConfigFile)} ({m.Port})")"><Icon><OmniIcon Name="OmniIconName.Check" /></Icon><ChildContent><span>@($":{m.Port}")</span></ChildContent></OmniButton>
                                }
                                @* Recette R-12: a disabled site's file can be deleted, one entry per file of the row. *@
                                <OmniOverflowMenu Label="@L["MoreActions"]">
                                    @foreach (var file in SiteFiles(g))
                                    {
                                        <OmniMenuItem Tone="OmniTone.Danger" Disabled="@AgentOffline" OnClick="@(() => ConfirmDeleteSite(file))"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@string.Format(L["ApacheDeleteSiteItem"], file)</ChildContent></OmniMenuItem>
                                    }
                                </OmniOverflowMenu>
                            </OmniRow>
                            </span>
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>
        </ChildContent></OmniTabsItem>

        @* --- Modules tab --- *@
        <OmniTabsItem Key="modules" Title="@L["Modules"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("extension")" /></Icon><ChildContent>
            @* Recette R-120: no count and no free-text filter above the grid; the grid filters by column, in the row
               under its header. *@
            <OmniDataGrid @ref="_modulesGrid" ExportTitle="@ExportContext.Title(L["Modules"])" ExportFields="@ExportContext.Fields()" FillAvailableHeight="true" Items="@Apache.Modules" TItem="ApacheModuleDto" KeyOf="@(row => row.Name)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" ShowHeaderFilterMenu="false">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="ApacheModuleDto" Property="Name" Title="@L["Module"]" Filterable="true" />
                    <OmniDataGridColumn TItem="ApacheModuleDto" Property="Type" Title="@L["Type"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect">
                        <Template Context="m">
                            <OmniBadge Icon="@(BadgeIcon.Of(m.Type == "static" ? OmniIconName.Document : OmniIconName.ArrowRight))" Fill="OmniFill.Solid" Tone="@(m.Type == "static" ? OmniTone.Neutral : OmniTone.Accent)">@m.Type</OmniBadge>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="ApacheModuleDto" Title="@L["Actions"]" Width="10rem" Sortable="false">
                        <Template Context="m">
                            @if (m.Type == "shared")
                            {
                                @if (m.IsEnabled && IsEssentialModule(m))
                                {
                                    <OmniBadge Icon="@BadgeIcon.Of(OmniIconName.Lock)" Fill="OmniFill.Tonal" Tone="OmniTone.Neutral">@L["ApacheModuleEssential"]</OmniBadge>
                                }
                                else if (m.IsEnabled)
                                {
                                    <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Danger" OnClick="@(() => ShowDestructiveConfirm(L["DisableModule"], string.Format(L["ConfirmDisableModule"], m.Name),
                                            () => ExecuteActionAsync(ApacheAction.DisableModule, m.Name.Replace("_module", "")), L["Disable"].Value, OmniIconName.Prohibit))" title="@L["Disable"]" Label="@L["Disable"]"><Icon><OmniIcon Name="OmniIconName.Prohibit" /></Icon></OmniButton>
                                }
                                else
                                {
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => ExecuteActionAsync(ApacheAction.EnableModule, m.Name.Replace("_module", "")))" title="@L["Enable"]" Label="@L["Enable"]"><Icon><OmniIcon Name="OmniIconName.Check" /></Icon></OmniButton>
                                }
                            }
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>
        </ChildContent></OmniTabsItem>

        @* --- Logs tab --- *@
        <OmniTabsItem Key="logs" Title="@L["Logs"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("terminal")" /></Icon><ChildContent>
            <OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-md">
                <OmniDropDown aria-label="@L["SelectLogType"]" @bind-Value="_logType" TValue="string" Options="@((new[] { "error", "access" }).ToOptions(item => (string)item, item => item))"
                    Class="w-rem-8-75" />
                <OmniNumeric aria-label="@L["Lines"]" @bind-Value="_logLines" TValue="int" Minimum="1" Maximum="10000" Class="w-rem-6" />
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@L["Lines"]</OmniText>
                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Primary" OnClick="@FetchLogsAsync" Class="@(_logLoading ? "btn-busy" : null)" Busy="@(_logLoading)"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L["ViewLogs"]</span></ChildContent></OmniButton>
                @* STD-BTN detection 11: View logs visible, the other actions in the menu. *@
                <OmniOverflowMenu Label="@L["MoreActions"]">
                    <OmniMenuItem OnClick="@ToggleFollow" Disabled="@(AgentOffline && !_logFollowing)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_logFollowing ? "stop" : "play_arrow"))" /></Icon><ChildContent>@(_logFollowing ? L["StopFollow"] : L["FollowLogs"])</ChildContent></OmniMenuItem>
                </OmniOverflowMenu>
            </OmniRow>

            @if (_logContent is not null)
            {
                <OmniCodeBlock Code="@_logContent" Title="@($"{L["Logs"]} - {_logType}")" Wrap="true" Class="@(_logFollowing ? "apache-log-output code-block-bounded apache-log-follow" : "apache-log-output code-block-bounded")" />
            }
        </ChildContent></OmniTabsItem>

        @* --- Relations tab --- *@
        <OmniTabsItem Key="relations" Title="@L["Relations"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("link")" /></Icon><ChildContent>
            <ModuleLinksTab ServerId="ServerId" SourceType="ModuleLinkType.Apache" Resources="@ApacheResourceNames" />
        </ChildContent></OmniTabsItem>
    </Tabs>
</UrlSyncedTabs>
