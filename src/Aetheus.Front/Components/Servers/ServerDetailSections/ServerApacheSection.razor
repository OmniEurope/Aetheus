@inject GridExportContext ExportContext
@inherits ServerActionSectionBase

<AgentOfflineNotice Server="@Server" />

@* --- Status bar --- *@
<OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-lg">
    <OmniBadge Fill="OmniFill.Solid" Tone="@GetStatusBadge(Apache.IsRunning)">@(Apache.IsRunning ? L["Running"] : L["Stopped"])</OmniBadge>
    @if (!string.IsNullOrEmpty(Apache.Version))
    {
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">v@(Apache.Version)</OmniText>
    }
    @if (Apache.Pid.HasValue)
    {
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">PID @Apache.Pid</OmniText>
    }
    <div class="blade-content-spacer"></div>

    @* Recette R3-41/R3-42: Restart is the zone's one visible action (blue); Start, Stop, Reload and Test
       sit in the "More actions" menu with the conditions their buttons had. *@
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => ExecuteActionAsync(ApacheAction.Restart))" Disabled="@(AgentOffline || !Apache.IsRunning)" Class="@(_actionRunning ? "btn-busy" : null)" Busy="@(_actionRunning)"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Restart"]</span></OmniButton>
    <OmniOverflowMenu Label="@L["MoreActions"]">
        <OmniMenuItem OnClick="@(() => ExecuteActionAsync(ApacheAction.Start))" Disabled="@(AgentOffline || Apache.IsRunning)"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent>@L["Start"]</ChildContent></OmniMenuItem>
        <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => ShowDestructiveConfirm(L["StopApache"], L["ConfirmStopApache"], () => ExecuteActionAsync(ApacheAction.Stop), L["Stop"].Value, OmniIconName.Stop))" Disabled="@(AgentOffline || !Apache.IsRunning || _actionRunning)"><Icon><OmniIcon Name="OmniIconName.Stop" /></Icon><ChildContent>@L["Stop"]</ChildContent></OmniMenuItem>
        <OmniMenuItem OnClick="@(() => ExecuteActionAsync(ApacheAction.Reload))" Disabled="@(AgentOffline || !Apache.IsRunning)"><Icon><OmniIcon Name="OmniIconName.Sync" /></Icon><ChildContent>@L["Reload"]</ChildContent></OmniMenuItem>
        <OmniMenuItem Disabled="@AgentOffline" OnClick="@(() => ExecuteActionAsync(ApacheAction.TestConfig))" title="@L["TestConfig"]"><Icon><OmniIcon Name="OmniIconName.CheckCircle" /></Icon><ChildContent>@L["Test"]</ChildContent></OmniMenuItem>
    </OmniOverflowMenu>
</OmniRow>

<ServerTaskFollower @ref="_follower" ServerId="@ServerId" NamePrefix="Apache" />

@if (Apache.CollectionDegraded)
{
        <OmniAlert Severity="OmniSeverity.Warning" Class="omni-u-mb-lg" Title="@L["ApacheCollectionDegraded"]">
        @L["ApacheCollectionDegradedHint"]
        @if (!string.IsNullOrWhiteSpace(Apache.CollectionDiagnostics))
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-mt-sm omni-u-mb-0">
                @Apache.CollectionDiagnostics
            </OmniText>
        }
        </OmniAlert>
}

<UrlSyncedTabs Slugs="@(new[] { "sites", "modules", "logs", "relations" })">
    <Tabs>
        @* --- Sites tab (enabled + disabled, split) --- *@
        <OmniTabsItem Key="sites" Title="@L["Sites"]">
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                <CountBadge Value="@FilteredVirtualHosts.Count" Variant="OmniTone.Accent" />
                <OmniTextBox aria-label="@L["FilterSites"]" @bind-Value="_vhostSearch" Placeholder="@L["FilterSites"]" />
            </OmniStack>

            @* Item #5.1: one row per domain (ServerName), with port chips for each vhost the
               domain serves. A `:80` + `:443` pair that share the same .conf - the common case -
               collapses from 2 rows to 1. Per-port action buttons disable/edit the matching
               config file. *@
            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-md omni-u-mb-sm">
                @L["SitesEnabled"] (@EnabledVirtualHostGroups.Count)
            </OmniHeading>
            <OmniDataGrid @ref="_enabledGrid" ExportTitle="@ExportContext.Title(L["SitesEnabled"])" ExportFields="@ExportContext.Fields()" Items="@EnabledVirtualHostGroups" TItem="ApacheVirtualHostGroup" KeyOf="@(row => row.ServerName)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight"
                OnRowClick="@(args => OpenConfigEditorAsync(Path.GetFileName(args.Item.Primary.ConfigFile)))">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="ApacheVirtualHostGroup" Property="ServerName" Title="@L["ServerName"]" Width="16.25rem" Filterable="true">
                        <Template Context="g">
                            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                <strong>@g.ServerName</strong>
                                @if (g.Members.Count > 1)
                                {
                                    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral" title="@L["ApacheVirtualHostCountHint", g.Members.Count]">@($"× {g.Members.Count}")</OmniBadge>
                                }
                            </OmniStack>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" ExportValue="@PortsExport" Title="@L["Ports"]" Width="12.5rem" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <OmniRow Gap="OmniSpacing.XSmall">
                                @foreach (var m in g.Members)
                                {
                                    <OmniBadge Fill="OmniFill.Solid" Tone="@(m.Port == 443 ? OmniTone.Success : OmniTone.Accent)"
                                        title="@($"{m.Port} → {System.IO.Path.GetFileName(m.ConfigFile)}")">@m.Port.ToString()</OmniBadge>
                                }
                            </OmniRow>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" Title="@L["Actions"]" Width="20rem" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <OmniRow Gap="OmniSpacing.XSmall">
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenConfigEditorAsync(Path.GetFileName(g.Primary.ConfigFile)))" title="@L["EditConfig"]" Label="@L["EditConfig"]"><OmniIcon Name="OmniIconName.Edit" /></OmniButton>
                                @foreach (var m in g.Members)
                                {
                                    <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Danger" OnClick="@(() => ExecuteActionAsync(ApacheAction.DisableSite, Path.GetFileName(m.ConfigFile)))" title="@($"{L["Disable"]} ({m.Port})")"><OmniIcon Name="OmniIconName.Prohibit" /> <span>@($":{m.Port}")</span></OmniButton>
                                }
                            </OmniRow>
                            </span>
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>

            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mt-lg omni-u-mb-sm">
                @L["SitesDisabled"] (@DisabledVirtualHostGroups.Count)
            </OmniHeading>
            <OmniDataGrid @ref="_disabledGrid" ExportTitle="@ExportContext.Title(L["SitesDisabled"])" ExportFields="@ExportContext.Fields()" FillAvailableHeight="true" Items="@DisabledVirtualHostGroups" TItem="ApacheVirtualHostGroup" KeyOf="@(row => row.ServerName)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3"
                OnRowClick="@(args => OpenConfigEditorAsync(Path.GetFileName(args.Item.Primary.ConfigFile)))">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="ApacheVirtualHostGroup" Property="ServerName" Title="@L["ServerName"]" Width="16.25rem" Filterable="true">
                        <Template Context="g">
                            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Center">
                                <strong>@g.ServerName</strong>
                                @if (g.Members.Count > 1)
                                {
                                    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral" title="@L["ApacheVirtualHostCountHint", g.Members.Count]">@($"× {g.Members.Count}")</OmniBadge>
                                }
                            </OmniStack>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" ExportValue="@PortsExport" Title="@L["Ports"]" Width="12.5rem" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <OmniRow Gap="OmniSpacing.XSmall">
                                @foreach (var m in g.Members)
                                {
                                    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@m.Port.ToString()</OmniBadge>
                                }
                            </OmniRow>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="ApacheVirtualHostGroup" Title="@L["Actions"]" Width="20rem" Sortable="false" Filterable="false">
                        <Template Context="g">
                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <OmniRow Gap="OmniSpacing.XSmall">
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenConfigEditorAsync(Path.GetFileName(g.Primary.ConfigFile)))" title="@L["EditConfig"]" Label="@L["EditConfig"]"><OmniIcon Name="OmniIconName.Edit" /></OmniButton>
                                @foreach (var m in g.Members)
                                {
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => ExecuteActionAsync(ApacheAction.EnableSite, Path.GetFileName(m.ConfigFile)))" title="@($"{L["Enable"]} ({m.Port})")"><OmniIcon Name="OmniIconName.Check" /> <span>@($":{m.Port}")</span></OmniButton>
                                }
                            </OmniRow>
                            </span>
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>
        </OmniTabsItem>

        @* --- Modules tab --- *@
        <OmniTabsItem Key="modules" Title="@L["Modules"]">
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                <CountBadge Value="@FilteredModules.Count" Variant="OmniTone.Accent" />
                <OmniTextBox aria-label="@L["FilterModules"]" @bind-Value="_moduleSearch" Placeholder="@L["FilterModules"]" />
            </OmniStack>
            <OmniDataGrid @ref="_modulesGrid" ExportTitle="@ExportContext.Title(L["Modules"])" ExportFields="@ExportContext.Fields()" FillAvailableHeight="true" Items="@FilteredModules" TItem="ApacheModuleDto" KeyOf="@(row => row.Name)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="ApacheModuleDto" Property="Name" Title="@L["Module"]" Filterable="true" />
                    <OmniDataGridColumn TItem="ApacheModuleDto" Property="Type" Title="@L["Type"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect">
                        <Template Context="m">
                            <OmniBadge Fill="OmniFill.Solid" Tone="@(m.Type == "static" ? OmniTone.Neutral : OmniTone.Accent)">@m.Type</OmniBadge>
                        </Template>
                    </OmniDataGridColumn>
                    <OmniDataGridColumn TItem="ApacheModuleDto" Title="@L["Actions"]" Width="10rem" Sortable="false">
                        <Template Context="m">
                            @if (m.Type == "shared")
                            {
                                @if (m.IsEnabled)
                                {
                                    <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Danger" OnClick="@(() => ShowDestructiveConfirm(L["DisableModule"], string.Format(L["ConfirmDisableModule"], m.Name),
                                            () => ExecuteActionAsync(ApacheAction.DisableModule, m.Name.Replace("_module", "")), L["Disable"].Value, OmniIconName.Prohibit))" title="@L["Disable"]" Label="@L["Disable"]"><OmniIcon Name="OmniIconName.Prohibit" /></OmniButton>
                                }
                                else
                                {
                                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Secondary" OnClick="@(() => ExecuteActionAsync(ApacheAction.EnableModule, m.Name.Replace("_module", "")))" title="@L["Enable"]" Label="@L["Enable"]"><OmniIcon Name="OmniIconName.Check" /></OmniButton>
                                }
                            }
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>
        </OmniTabsItem>

        @* --- Logs tab --- *@
        <OmniTabsItem Key="logs" Title="@L["Logs"]">
            <OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-md">
                <OmniDropDown aria-label="@L["SelectLogType"]" @bind-Value="_logType" TValue="string" Options="@((new[] { "error", "access" }).ToOptions(item => (string)item, item => item))"
                    Class="w-rem-8-75" />
                <OmniNumeric aria-label="@L["Lines"]" @bind-Value="_logLines" TValue="int" Minimum="1" Maximum="10000" Class="w-rem-6" />
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@L["Lines"]</OmniText>
                <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Primary" OnClick="@FetchLogsAsync" Class="@(_logLoading ? "btn-busy" : null)" Busy="@(_logLoading)"><OmniIcon Name="OmniIconName.Download" /> <span>@L["ViewLogs"]</span></OmniButton>
                @* STD-BTN detection 11: View logs visible, the other actions in the menu. *@
                <OmniOverflowMenu Label="@L["MoreActions"]">
                    <OmniMenuItem OnClick="@ToggleFollow" Disabled="@(AgentOffline && !_logFollowing)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_logFollowing ? "stop" : "play_arrow"))" /></Icon><ChildContent>@(_logFollowing ? L["StopFollow"] : L["FollowLogs"])</ChildContent></OmniMenuItem>
                </OmniOverflowMenu>
            </OmniRow>

            @if (_logContent is not null)
            {
                <OmniCodeBlock Code="@_logContent" Title="@($"{L["Logs"]} - {_logType}")" Wrap="true" Class="@(_logFollowing ? "apache-log-output code-block-bounded apache-log-follow" : "apache-log-output code-block-bounded")" />
            }
        </OmniTabsItem>

        @* --- Relations tab --- *@
        <OmniTabsItem Key="relations" Title="@L["Relations"]">
            <ModuleLinksTab ServerId="ServerId" SourceType="ModuleLinkType.Apache" Resources="@ApacheResourceNames" />
        </OmniTabsItem>
    </Tabs>
</UrlSyncedTabs>
