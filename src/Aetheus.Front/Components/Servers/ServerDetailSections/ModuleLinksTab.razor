<OmniStack>
    <OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
        <CountBadge Value="@_totalCount" Variant="OmniTone.Accent" />
        <div class="blade-content-spacer"></div>
        @* STD-BTN detection 11: Add visible, the other actions in the menu. *@
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenAddDialogAsync" title="@L["AddLink"]"><Icon><OmniIcon Name="OmniIconName.Link" /></Icon><ChildContent><span>@L["Add"]</span></ChildContent></OmniButton>
        <OmniOverflowMenu Label="@L["MoreActions"]">
            <OmniMenuItem OnClick="@AutoDetectAsync" Disabled="@_detecting" title="@L["AutoDetect"]"><Icon><OmniIcon Name="OmniIconName.Sparkle" /></Icon><ChildContent>@L["Detect"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    </OmniRow>

    <OmniTextBox aria-label="@L["Search"]" Placeholder="@L["Search"]" @bind-Value="_search" @bind-Value:after="OnSearchChangedAsync"
        Class="pipeline-list-search" />

    <AetheusDataGrid FullHeight="true" @ref="_grid" Data="@_links" TItem="LinkedResourceDto"
        Count="@_totalCount" IsLoading="@_loading" LoadData="@OnLoadDataAsync" ExportRead="@ReadExportAsync"
        PageSize="25" Density="OmniDensity.Compact" EmptyText="@L["NoRecords"]"
        Virtualize="@AetheusGrid.RemoteVirtualization"
        VirtualData="@(() => new OmniDataGridResult<LinkedResourceDto>(_links, _totalCount))">
            <Columns>
                <OmniDataGridColumn Frozen="true" TItem="LinkedResourceDto" Property="Type" Title="@L["Type"]" Width="120px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@TypeText" >
                    <Template Context="l">
                        <OmniBadge Icon="@(BadgeIcon.For(GetTypeBadge(l.Type)))" Fill="OmniFill.Solid" Tone="@GetTypeBadge(l.Type)">@L.Localize(l.Type)</OmniBadge>
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="LinkedResourceDto" Property="Identifier" Title="@L["Resource"]" Filterable="true" />
                <OmniDataGridColumn TItem="LinkedResourceDto" Property="IsAutoDetected" Title="@L["Source"]" Width="120px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@SourceText" >
                    <Template Context="l">
                        <OmniBadge Icon="@(BadgeIcon.Of(l.IsAutoDetected ? OmniIconName.Sync : OmniIconName.Edit))" Fill="OmniFill.Solid" Tone="@(l.IsAutoDetected ? OmniTone.Neutral : OmniTone.Neutral)">@(l.IsAutoDetected ? L["Auto"] : L["Manual"])</OmniBadge>
                    </Template>
                </OmniDataGridColumn>
                <OmniDataGridColumn TItem="LinkedResourceDto" Title="@L["Actions"]" Width="100px" Sortable="false" Filterable="false" >
                    <Template Context="l">
                        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteLinkAsync(l.LinkId))" title="@L["Unlink"]"><Icon><OmniIcon Name="OmniIconName.LinkBreak" /></Icon></OmniButton>
                    </Template>
                </OmniDataGridColumn>
            </Columns>
    </AetheusDataGrid>
</OmniStack>
