@inject GridExportContext ExportContext

<OmniStack>
@if (!CanManagePackages)
{
    @* Capability notice + live heartbeat as two aligned tiles. The capability self-heals on the next
       heartbeat (re-install with --enable-package-manage); the notice clears itself once a beat lands
       reporting the aetheus-package sudoers grant, no manual reload needed. *@
    <OmniTileGrid Columns="2" Gap="OmniSpacing.Large">
        <OmniCard Class="capability-warning-tile">
            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center">
                <OmniIcon Name="OmniIconName.Lock" Class="capability-warning-icon" />
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["ServiceInstallCapabilityDisabled"]</OmniText>
            </OmniStack>
        </OmniCard>
        <OmniCard Class="heartbeat-tile">
            <HeartbeatPulse Server="Server" />
        </OmniCard>
    </OmniTileGrid>
}

<ServerTaskFollower @ref="_follower" ServerId="@ServerId" SettleOnHeartbeat="true" />
<ServiceActionsInFlightBanner Services="@Server.Services" ActionStateOf="@ActionStateOf" />

<UrlSyncedTabs Slugs="@(new[] { "manageable", "other", "system" })">
    <Tabs>
        <OmniTabsItem Key="manageable" Title="@($"{L["Manageable"]} ({ModuleCount})")"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("build"))" /></Icon><ChildContent>
<OmniStack>
            <OmniHeading Level="OmniHeadingLevel.H5">@L["InstalledServices"] (@ModuleInstalled.Count())</OmniHeading>
            @if (!ModuleInstalled.Any())
            {
                <EmptyState Icon="build" Title="@L["NoServicesToDisplay"]" />
            }
            else
            {
                <ManageableServiceGrid ShowInFlightBanner="false" MailStackManaged="@Server.Mail.IsManagedByAetheus" Services="@ModuleInstalled" Installed="true" ShowModuleLink="true"
                    CanManagePackages="@CanManagePackages" ActionStateOf="@ActionStateOf" ServerOnline="@ServerOnline" ServerId="@ServerId"
                    OnStart="@(n => ExecuteActionAsync(ServiceAction.Start, n))"
                    OnStop="@(n => ConfirmAndExecuteAsync(ServiceAction.Stop, n))"
                    OnRestart="@(n => ConfirmAndExecuteAsync(ServiceAction.Restart, n))"
                    OnLogs="@ViewServiceLogsAsync" OnUninstall="@UninstallServiceAsync"
                    OnOpenModule="@OpenServiceModule" OnBulk="@BulkActionAsync" />
            }

            <OmniHeading Level="OmniHeadingLevel.H5">@L["AvailableServices"] (@ModuleNotInstalled.Count())</OmniHeading>
            @if (!ModuleNotInstalled.Any())
            {
                <OmniAlert Severity="OmniSeverity.Success">
                    @L["AllServicesInstalled"]
                </OmniAlert>
            }
            else
            {
                <ManageableServiceGrid ShowInFlightBanner="false" MailStackManaged="@Server.Mail.IsManagedByAetheus" Services="@ModuleNotInstalled" Installed="false"
                    CanManagePackages="@CanManagePackages" CanInstallTeamspeak="@Server.TeamspeakSetupAvailable" ActionStateOf="@ActionStateOf" ServerOnline="@ServerOnline" ServerId="@ServerId"
                    OnInstall="@InstallServiceAsync" OnBulk="@BulkActionAsync" />
            }
</OmniStack>
        </ChildContent></OmniTabsItem>

        <OmniTabsItem Key="other" Title="@($"{L["OtherServices"]} ({OtherCount})")"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("apps"))" /></Icon><ChildContent>
<OmniStack>
            @* Recette R3-59: a package that is not a service (a command-line client) is never in the service lists;
               say so, and show the complete read-only package list at the end of this tab. *@
            <OmniAlert Severity="OmniSeverity.Info" Class="services-packages-not-listed">
                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["ServicesPackagesNotListed"]</OmniText>
                <OmniLink Href="@($"/servers/{ServerId}/updates")">@L["ServicesPackagesSeeUpdates"]</OmniLink>
            </OmniAlert>
            <OmniHeading Level="OmniHeadingLevel.H5">@L["InstalledServices"] (@OtherInstalled.Count())</OmniHeading>
            @if (!OtherInstalled.Any())
            {
                <EmptyState Icon="build" Title="@L["NoServicesToDisplay"]" />
            }
            else
            {
                <ManageableServiceGrid ShowInFlightBanner="false" MailStackManaged="@Server.Mail.IsManagedByAetheus" Services="@OtherInstalled" Installed="true" ShowModuleLink="false"
                    CanManagePackages="@CanManagePackages" ActionStateOf="@ActionStateOf" ServerOnline="@ServerOnline" ServerId="@ServerId"
                    OnStart="@(n => ExecuteActionAsync(ServiceAction.Start, n))"
                    OnStop="@(n => ConfirmAndExecuteAsync(ServiceAction.Stop, n))"
                    OnRestart="@(n => ConfirmAndExecuteAsync(ServiceAction.Restart, n))"
                    OnLogs="@ViewServiceLogsAsync" OnUninstall="@UninstallServiceAsync" OnBulk="@BulkActionAsync" />
            }

            <OmniHeading Level="OmniHeadingLevel.H5">@L["AvailableServices"] (@OtherNotInstalled.Count())</OmniHeading>
            @if (!OtherNotInstalled.Any())
            {
                <OmniAlert Severity="OmniSeverity.Success">
                    @L["AllServicesInstalled"]
                </OmniAlert>
            }
            else
            {
                <ManageableServiceGrid ShowInFlightBanner="false" MailStackManaged="@Server.Mail.IsManagedByAetheus" Services="@OtherNotInstalled" Installed="false"
                    CanManagePackages="@CanManagePackages" CanInstallTeamspeak="@Server.TeamspeakSetupAvailable" ActionStateOf="@ActionStateOf" ServerOnline="@ServerOnline" ServerId="@ServerId"
                    OnInstall="@InstallServiceAsync" OnBulk="@BulkActionAsync" />
            }

            <div>
                <ServerPackageInventory Server="@Server" ServerId="@ServerId" />
            </div>
</OmniStack>
        </ChildContent></OmniTabsItem>

        <OmniTabsItem Key="system" Title="@($"{L["System"]} ({SystemCount})")"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("settings"))" /></Icon><ChildContent>
<OmniStack>
            @if (!SystemServices.Any())
            {
                <EmptyState Icon="build" Title="@L["NoServicesToDisplay"]" />
            }
            else
            {
                <OmniDataGrid @ref="_systemGrid" ExportTitle="@ExportContext.Title(L["Services"])" ExportFields="@ExportContext.Fields()" Items="@SystemServices.ToList()" TItem="ServiceInfoDto" KeyOf="@(row => row.Name)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" FillAvailableHeight="true">
                    <Columns>
                        <OmniDataGridColumn Frozen="true" TItem="ServiceInfoDto" Property="Name" Title="@L["Service"]" Filterable="true" />
                        <OmniDataGridColumn TItem="ServiceInfoDto" Property="Type" Title="@L["Type"]" Width="7.5rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@TypeText">
                            <Template Context="svc">
                                <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@ManageableServiceGrid.FormatType(svc.Type)</OmniBadge>
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="ServiceInfoDto" Property="Status" Title="@L["Status"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText">
                            <Template Context="svc">@StatusText(svc.Status)</Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="ServiceInfoDto" Property="IsRunning" Title="@L["Running"]" Width="6.25rem" Sortable="false" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@YesNoText">
                            <Template Context="svc">
                                <OmniBadge Icon="@(BadgeIcon.ForState(svc.IsRunning ? OmniTone.Accent : OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="@(svc.IsRunning ? OmniTone.Accent : OmniTone.Neutral)">@(svc.IsRunning ? L["Yes"] : L["No"])</OmniBadge>
                            </Template>
                        </OmniDataGridColumn>
                    </Columns>
                </OmniDataGrid>
            }
</OmniStack>
        </ChildContent></OmniTabsItem>
    </Tabs>
</UrlSyncedTabs>

@if (_logsVisible)
{
    <OmniCard>
        <OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L["Logs"] - @_logsServiceName</OmniText>
            <div class="flex-spacer"></div>
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@L["LogLines"]</OmniText>
            <OmniDropDown aria-label="@L["LogLines"]" TValue="int" Value="@_logLines" Options="@(LineOptions.ToOptions(item => (int)item, item => item))" ValueChanged="@(v => OnLogLinesChanged((int)v))"
                ValueExpression="@(() => _logLines)" Class="log-lines-select" />
            <OmniSwitch TValue="bool" TextFirst="true" Value="_logFollow" ValueExpression="@(() => _logFollow)" ValueChanged="@(v => OnFollowChangedAsync(v))" Class="omni-u-text-muted">@L["FollowLogs"]</OmniSwitch>
            @* The open log viewer refreshes its tail every 30 seconds when auto-refresh is
               enabled. *@
            <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@CloseLogsAsync" title="@L["Close"]"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon></OmniButton>
        </OmniStack>
        @* Recette R-116: while a read is pending, OE's busy veil lies over the log zone; the lines already on screen
           stay mounted underneath, and a zone that holds nothing yet is a veiled block of sensible height. *@
        <OmniStack Class="@(_logsLoading ? (string.IsNullOrEmpty(_logsContent) ? "omni-busy action-veil-placeholder" : "omni-busy") : null)" aria-busy="@(_logsLoading ? "true" : "false")" data-testid="service-logs-zone">
        @if (!_logsLoading || !string.IsNullOrEmpty(_logsContent))
        {
            @if (HasInsufficientJournalPermissions)
            {
                <OmniAlert Severity="OmniSeverity.Warning">
                    @L["JournalPermissionInsufficient"]
                </OmniAlert>
            }
            <OmniCodeBlock Code="@(string.IsNullOrWhiteSpace(_logsContent) ? L["NoLogsAvailable"].Value : _logsContent)" Title="@L["Output"]" Wrap="true" Class="docker-logs code-block-bounded" />
            @if (_logFollow)
            {
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mt-sm">
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted omni-u-m-0">@L["FollowingLogs"]</OmniText>
                </OmniStack>
            }
        }
        </OmniStack>
    </OmniCard>
}
</OmniStack>
