<OmniStack Gap="OmniSpacing.Small">
    <OmniFormField Label="@L["TargetType"]" For="module-link-target-type" Required="true" Class="omni-u-w-100">
        <OmniDropDown Id="module-link-target-type" TValue="ModuleLinkType" name="module-link-target-type" Options="@(TargetTypes.ToOptions(item => (ModuleLinkType)item, item => item))" @bind-Value="_targetType" />
    </OmniFormField>
    <OmniFormField Label="@L["TargetIdentifier"]" For="module-link-target-identifier" Required="true" Class="omni-u-w-100">
        <OmniTextBox Id="module-link-target-identifier" @bind-Value="_targetIdentifier" Placeholder="@L["ResourceName"]" />
    </OmniFormField>
    <OmniFormField Label="@L["SourceResource"]" For="module-link-source-resource" Required="true" Class="omni-u-w-100">
        <OmniDropDown Id="module-link-source-resource" TValue="string" name="module-link-source-resource" Options="@(Resources.ToOptions(item => (string)item, item => item))" @bind-Value="_sourceIdentifier" />
    </OmniFormField>
    <Aetheus.Front.Components.Shared.DialogFooter OnCancel="@(() => Dialog.Close())">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@Save" Disabled="@(string.IsNullOrWhiteSpace(_targetIdentifier) || string.IsNullOrWhiteSpace(_sourceIdentifier))"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@L["Add"]</span></ChildContent></OmniButton>
    </Aetheus.Front.Components.Shared.DialogFooter>
</OmniStack>
