@inject GridExportContext ExportContext
<ServerMailDeliveryPanel Delivery="@Delivery" HostIpv4="@HostIpv4" />
<OmniRow Align="OmniAlignment.Center" Gap="OmniSpacing.Small" Class="omni-u-mb-sm">
    <OmniBadge Fill="OmniFill.Solid" Tone="@(QueueSize > 0 ? OmniTone.Warning : OmniTone.Success)">@QueueSize.ToString()</OmniBadge>
    @if (_pendingTaskId is not null)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@L["MailWaitingForTask"]</OmniText>
    }
    <div class="blade-content-spacer"></div>
    @* STD-BTN detection 11: Load visible, the other actions in the menu. *@
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@LoadAsync" Disabled="@(_pendingTaskId is not null)"><Icon><OmniIcon Name="OmniIconName.Eye" /></Icon><ChildContent><span>@L["MailQueueLoad"]</span></ChildContent></OmniButton>
    @if (CanManage)
    {
        <OmniOverflowMenu Label="@L["MoreActions"]">
            <OmniMenuItem OnClick="@FlushAsync"><Icon><OmniIcon Name="OmniIconName.PaperPlaneRight" /></Icon><ChildContent>@L["FlushQueue"]</ChildContent></OmniMenuItem>
            <OmniMenuItem OnClick="@ApplyRetryTuningAsync" Disabled="@(HelperVersion < RetryTuningMinimumHelperVersion)"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["MailApplyRetryTuning"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    }
</OmniRow>
@if (_loaded && _items.Count == 0)
{
    <OmniText Element="OmniTextElement.Paragraph">@L["MailQueueEmpty"]</OmniText>
}
else
{
    <OmniDataGrid @ref="_grid" ExportTitle="@ExportContext.Title(L["MailQueue"])" ExportFields="@ExportContext.Fields()" FillAvailableHeight="true" Items="@_items" TItem="MailQueueItemDto" KeyOf="@(row => row.Id)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" EmptyText="@L["NoRecords"]" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="MailQueueItemDto" Property="Id" Title="ID" Width="7.5rem" Filterable="true" />
            <OmniDataGridColumn TItem="MailQueueItemDto" Property="Sender" Title="@L["Sender"]" Width="12.5rem" Filterable="true" />
            <OmniDataGridColumn TItem="MailQueueItemDto" Property="Recipient" Title="@L["Recipient"]" Width="13.75rem" Filterable="true" />
            <OmniDataGridColumn TItem="MailQueueItemDto" Title="@L["Size"]" Width="5.625rem" Sortable="false">
                <Template Context="q"><OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@FormatBytes(q.SizeBytes)</OmniText></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="MailQueueItemDto" Property="Status" Title="@L["Status"]" Width="20rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterSearchable="true" />
            @if (CanManage)
            {
                <OmniDataGridColumn TItem="MailQueueItemDto" Title="@L["Actions"]" Width="7.5rem" Sortable="false">
                    <Template Context="q">
                        <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteAsync(q.Id))" title="@L["Delete"]" Label="@L["Delete"]"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon></OmniButton>
                    </Template>
                </OmniDataGridColumn>
            }
        </Columns>
    </OmniDataGrid>
}
