@* "Réinstaller la messagerie" (R2-083 / R2-088): offered whenever a mail stack is on the host. *@
<AgentOfflineNotice Server="@Server" />

<ServerMailReinstall @ref="_reinstall" Server="@Server" ServerId="@ServerId" Mail="@Mail" CanManage="@Server.MailSetupAvailable" RunningChanged="@(() => StateHasChanged())" />

@* Recette R2-126: while the stack is erased, only the banner above; the state and the tabs come back after. *@
@if (_reinstall?.Erasing != true)
{

@* Recette R2-080: not configured yet, the page is the step-by-step setup assistant. "Installed" means a
   configured mail stack (R2-059): Postfix and Dovecot installed alone from the Services tab, with no domain
   and no account, still need the setup. Recette R2-089: until the counts are read nothing is concluded. *@
@if (!Mail.IsInstalled)
{
    <ServerMailSetupAssistant @ref="_assistant" Server="@Server" ServerId="@ServerId" />
}
else if (_countsFailed)
{
    @* SITE-FUNC-METRICS-001: a failed read is said, not shown as a load that never ends. *@
    <OmniAlert Severity="OmniSeverity.Danger" Class="omni-u-mb-lg mail-counts-failed">
        @L["LoadFailed"]
        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@ReadCountsAsync"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Retry"]</span></OmniButton>
    </OmniAlert>
}
else if (!_countsRead)
{
    <AetheusLoader Size="OmniControlSize.Small" Class="omni-u-mb-lg mail-counts-loading" />
}
else if (_domainCount == 0 && _accountCount == 0)
{
    <ServerMailSetupAssistant @ref="_assistant" Server="@Server" ServerId="@ServerId" StackPresent="true" />
}
else
{
    @* Recette R2-090: the page opens on the state of the stack, the work tabs below. *@
    <ServerMailStatusList @ref="_statusList" ServerId="@ServerId" Mail="@Mail" CanManage="@CanManageTasks"
        DefaultSender="@DefaultSender" OnUsageMeasured="@ReloadDataAsync" />
}

@if (Mail.IsInstalled)
{
    <UrlSyncedTabs Slugs="@(new[] { "domains", "accounts", "aliases", "spam", "queue", "logs", "relations" })">
        <Tabs>
            @* --- Domains tab --- *@
            <OmniTabsItem Key="domains" Title="@L["MailDomains"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("dns"))" /></Icon><ChildContent>
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                    <CountBadge Value="@_domainCount" Variant="OmniTone.Accent" />
                    <div class="blade-content-spacer"></div>
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenAddDomainDialogAsync" Disabled="@AgentOffline" title="@L["AddDomain"]"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Add"]</span></OmniButton>
                </OmniStack>
                <AetheusDataGrid FullHeight="true" @ref="_domainsGrid" Data="@_domains" Count="@_domainCount"
                    TItem="MailDomainDto" IsLoading="@_domainsLoading" LoadData="@LoadDomainsAsync" ExportRead="@ReadDomainsExportAsync" ExportName="@L["MailDomains"]"
                    PageSize="25" Density="OmniDensity.Compact" AllowSorting="true" EmptyText="@L["NoMailDomains"]"
                    Virtualize="@AetheusGrid.RemoteVirtualization"
                    VirtualData="@(() => new OmniDataGridResult<MailDomainDto>(_domains, _domainCount))">
                    <Columns>
                        <OmniDataGridColumn Frozen="true" TItem="MailDomainDto" Property="Name" Title="@L["DomainName"]" Width="250px" Filterable="true" />
                        <OmniDataGridColumn TItem="MailDomainDto" Property="DkimSelector" Title="DKIM" Width="120px" Filterable="true" >
                            <Template Context="d">
                                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@d.DkimSelector</OmniText>
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="MailDomainDto" Title="DNS" ExportValue="@DnsExport" Width="180px" Filterable="false" >
                            <Template Context="d">
                                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                                    <OmniBadge Fill="OmniFill.Solid" Tone="@(d.HasSpf ? OmniTone.Success : OmniTone.Neutral)">SPF</OmniBadge>
                                    <OmniBadge Fill="OmniFill.Solid" Tone="@(d.HasDkim ? OmniTone.Success : OmniTone.Neutral)">DKIM</OmniBadge>
                                    <OmniBadge Fill="OmniFill.Solid" Tone="@(d.HasDmarc ? OmniTone.Success : OmniTone.Neutral)">DMARC</OmniBadge>
                                </OmniStack>
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="MailDomainDto" Title="@L["Status"]" Width="200px" Sortable="false">
                            <Template Context="d">
                                <MailRecordBadges IsActive="@d.IsActive" Source="@d.Source" MissingSince="@d.MissingSince" />
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="MailDomainDto" Title="@L["Actions"]" Width="200px" Sortable="false">
                            <Template Context="d">
                                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ShowDnsRecordsAsync(d))" title="@L["DnsRecords"]" Label="@L["DnsRecords"]"><OmniIcon Name="OmniIconName.Database" /></OmniButton>
                                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => VerifyDnsAsync(d))" title="@L["MailVerifyDns"]" Label="@L["MailVerifyDns"]"><OmniIcon Name="OmniIconName.ShieldCheck" /></OmniButton>
                                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => ShowDkimRotation(d))" Disabled="@AgentOffline" title="@L["RotateDkimKey"]" Label="@L["RotateDkimKey"]"><OmniIcon Name="OmniIconName.Key" /></OmniButton>
                                    <OmniButton Variant="OmniButtonVariant.Danger" Disabled="@AgentOffline" OnClick="@(() => ShowConfirm(L["DeleteDomain"], string.Format(L["ConfirmDeleteMailDomain"], d.Name),
                                            () => DeleteDomainAsync(d.Id)))" title="@L["Delete"]" Label="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                                </OmniStack>
                            </Template>
                        </OmniDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </ChildContent></OmniTabsItem>

            @* --- Accounts tab --- *@
            <OmniTabsItem Key="accounts" Title="@L["MailAccounts"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("people"))" /></Icon><ChildContent>
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                    <CountBadge Value="@_accountCount" Variant="OmniTone.Accent" />
                    <div class="blade-content-spacer"></div>
                    @* Recette R1-17: how to read these mailboxes in an external mail client. *@
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@OpenMailClientHelpAsync"><OmniIcon Name="@MaterialIconMap.Resolve("help")" /> <span>@L["MailClientHelpButton"]</span></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenAddAccountDialogAsync" Disabled="@AgentOffline" title="@L["AddAccount"]"><OmniIcon Name="OmniIconName.UserPlus" /> <span>@L["Add"]</span></OmniButton>
                </OmniStack>
                <AetheusDataGrid FullHeight="true" @ref="_accountsGrid" Data="@_accounts" Count="@_accountCount"
                    TItem="MailAccountDto" IsLoading="@_accountsLoading" LoadData="@LoadAccountsAsync" ExportRead="@ReadAccountsExportAsync" ExportName="@L["MailAccounts"]"
                    PageSize="25" Density="OmniDensity.Compact" AllowSorting="true" EmptyText="@L["NoRecords"]"
                    Virtualize="@AetheusGrid.RemoteVirtualization"
                    VirtualData="@(() => new OmniDataGridResult<MailAccountDto>(_accounts, _accountCount))">
                    <Columns>
                        <OmniDataGridColumn Frozen="true" TItem="MailAccountDto" Property="Email" Title="@L["Email"]" Width="300px" Filterable="true" />
                        <OmniDataGridColumn TItem="MailAccountDto" Title="@L["Quota"]" Width="200px" Filterable="false" >
                            <Template Context="a">
                                <OmniStack Gap="OmniSpacing.XSmall">
                                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@QuotaText(a)</OmniText>
                                    @if (a.QuotaMb > 0)
                                    {
                                        <OmniProgressBar Value="@UsagePercent(a)" ShowValue="false" Class="h-progress-thin"
                                            Tone="@QuotaStyle(a)" />
                                    }
                                </OmniStack>
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="MailAccountDto" Title="@L["Status"]" Width="200px" Sortable="false">
                            <Template Context="a">
                                <MailRecordBadges IsActive="@a.IsActive" Source="@a.Source" MissingSince="@a.MissingSince" />
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="MailAccountDto" Property="CreatedAt" Title="@L["Created"]" Width="140px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" >
                            <Template Context="a">
                                <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@a.CreatedAt.ToString("d")</OmniText>
                            </Template>
                        </OmniDataGridColumn>
                        <OmniDataGridColumn TItem="MailAccountDto" Title="@L["Actions"]" Width="120px" Sortable="false">
                            <Template Context="a">
                                @* Recette R1-17: the integrated mailbox of the account. *@
                                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.XSmall">
                                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenMailbox(a))" Disabled="@(!a.IsActive || a.MissingSince is not null)" title="@L["MailboxOpen"]" Label="@L["MailboxOpen"]"><OmniIcon Name="@MaterialIconMap.Resolve("inbox")" /></OmniButton>
                                    <OmniButton Variant="OmniButtonVariant.Danger" Disabled="@AgentOffline" OnClick="@(() => ShowConfirm(L["DeleteAccount"], string.Format(L["ConfirmDeleteMailAccount"], a.Email),
                                            () => DeleteAccountAsync(a.Id)))" title="@L["Delete"]" Label="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                                </OmniStack>
                            </Template>
                        </OmniDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </ChildContent></OmniTabsItem>

            @* --- Aliases tab --- *@
            <OmniTabsItem Key="aliases" Title="@L["Aliases"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("alternate_email"))" /></Icon><ChildContent>
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                    <CountBadge Value="@_aliasCount" Variant="OmniTone.Accent" />
                    <div class="blade-content-spacer"></div>
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenAddAliasDialogAsync" Disabled="@AgentOffline" title="@L["AddAlias"]"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Add"]</span></OmniButton>
                </OmniStack>
                <AetheusDataGrid FullHeight="true" @ref="_aliasesGrid" Data="@_aliases" Count="@_aliasCount"
                    TItem="MailAliasDto" IsLoading="@_aliasesLoading" LoadData="@LoadAliasesAsync" ExportRead="@ReadAliasesExportAsync" ExportName="@L["Aliases"]"
                    PageSize="25" Density="OmniDensity.Compact" AllowSorting="true" EmptyText="@L["NoMailAliases"]"
                    Virtualize="@AetheusGrid.RemoteVirtualization"
                    VirtualData="@(() => new OmniDataGridResult<MailAliasDto>(_aliases, _aliasCount))">
                        <Columns>
                            <OmniDataGridColumn Frozen="true" TItem="MailAliasDto" Property="SourceEmail" Title="@L["Source"]" Width="250px" Filterable="true" />
                            <OmniDataGridColumn TItem="MailAliasDto" Title="" Width="40px" Filterable="false" >
                                <Template Context="a">
                                    <OmniIcon Name="OmniIconName.ArrowRight" Class="icon-md-app" />
                                </Template>
                            </OmniDataGridColumn>
                            <OmniDataGridColumn TItem="MailAliasDto" Property="DestinationEmail" Title="@L["Destination"]" Width="250px" Filterable="true" />
                            <OmniDataGridColumn TItem="MailAliasDto" Title="@L["Status"]" Width="200px" Sortable="false">
                                <Template Context="a">
                                    <MailRecordBadges IsActive="@a.IsActive" Source="@a.Source" MissingSince="@a.MissingSince" />
                                </Template>
                            </OmniDataGridColumn>
                            <OmniDataGridColumn TItem="MailAliasDto" Title="" Width="80px" TextAlign="OmniDataGridTextAlign.End" Filterable="false" >
                                <Template Context="a">
                                    <OmniButton Variant="OmniButtonVariant.Danger" Disabled="@AgentOffline" OnClick="@(() => ShowConfirm(L["DeleteAlias"], L["ConfirmDeleteAlias"],
                                            () => DeleteAliasAsync(a.Id)))" title="@L["Delete"]" Label="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                                </Template>
                            </OmniDataGridColumn>
                        </Columns>
                </AetheusDataGrid>
            </ChildContent></OmniTabsItem>

            @* --- Spam filter tab --- *@
            <OmniTabsItem Key="spam" Title="@L["MailSpamFilter"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("shield")" /></Icon><ChildContent>
                <ServerMailSpamTab Spam="@Mail.SpamFilter" ServerId="@ServerId" CanManage="@CanManageTasks" />
            </ChildContent></OmniTabsItem>

            @* --- Queue tab --- *@
            <OmniTabsItem Key="queue" Title="@L["MailQueue"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("queue")" /></Icon><ChildContent>
                <ServerMailQueueTab @ref="_queueTab" ServerId="@ServerId" QueueSize="@Mail.QueueSize" CanManage="@CanManageTasks" />
            </ChildContent></OmniTabsItem>

            @* --- Logs tab --- *@
            <OmniTabsItem Key="logs" Title="@L["Logs"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("article")" /></Icon><ChildContent>
                <ServerMailLogsTab @ref="_logsTab" ServerId="@ServerId" />
            </ChildContent></OmniTabsItem>

            @* --- Relations tab --- *@
            <OmniTabsItem Key="relations" Title="@L["Relations"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("link"))" /></Icon><ChildContent>
                <ModuleLinksTab ServerId="ServerId" SourceType="ModuleLinkType.Mail" Resources="@MailResourceNames" />
            </ChildContent></OmniTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}
}
