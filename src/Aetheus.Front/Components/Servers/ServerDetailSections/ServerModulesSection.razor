@inject GridExportContext ExportContext
@if (_modules is null)
{
    <AetheusLoader />
}
else
{
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Class="omni-u-mb-lg" Gap="OmniSpacing.Large">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => _addVisible = true)"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Add"]</span></OmniButton>
    </OmniStack>

    <OmniDataGrid Items="@_modules" ExportTitle="@ExportContext.Title(L["Modules"])" ExportFields="@ExportContext.Fields()" TItem="ServerModuleDto" EmptyText="@L["NoRecords"]" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight">
        <Columns>
            <OmniDataGridColumn Frozen="true" TItem="ServerModuleDto" Property="Name" Title="@L["Name"]"  Filterable="true"/>
            <OmniDataGridColumn TItem="ServerModuleDto" Property="Type" Title="@L["Type"]" Width="8.125rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@TypeText">
                <Template Context="m">
                    <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@L.Localize(m.Type)</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ServerModuleDto" Property="Status" Title="@L["Status"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusText">
                <Template Context="m">
                    <OmniBadge Fill="OmniFill.Solid" Tone="@GetModuleStatusBadge(m.Status)">@L[m.Status.ToString()]</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="ServerModuleDto" Property="Version" Title="@L["Version"]" Width="6.25rem"  Filterable="true"/>
            <OmniDataGridColumn TItem="ServerModuleDto" Title="@L["Actions"]" MinWidth="9rem" Sortable="false">
                <Template Context="m">
                    <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteModuleAsync(m))" title="@L["Delete"]" Label="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </OmniDataGrid>

    @if (_addVisible)
    {
        <OmniCard Class="omni-u-mt-lg">
            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-mb-sm">@L["AddModule"]</OmniHeading>
            <OmniTemplateForm TModel="AddModuleModel" Model="@_addModel" OnValidSubmit="@((EditContext context) => AddModuleAsync((AddModuleModel)context.Model))">
            <OmniDataAnnotationsValidator Localizer="@L" />
            <OmniRow Gap="OmniSpacing.Large">
                <OmniColumn Span="12" MediumSpan="4">
                    <OmniFormField For="oe-pages-servers-serverdetailsections-servermodulessection-1"><LabelContent>@L["Name"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_addModel.Name" maxlength="100" Id="oe-pages-servers-serverdetailsections-servermodulessection-1" />
                        <ValidationMessage For="@(() => _addModel.Name)" />
                    </ChildContent></OmniFormField>
                </OmniColumn>
                <OmniColumn Span="6" MediumSpan="3">
                    <OmniFormField Label="@L["Type"]" For="oe-formfield-pages-servers-serverdetailsections-servermodulessection-1">
                        <OmniDropDown Id="oe-formfield-pages-servers-serverdetailsections-servermodulessection-1" TValue="ServerModuleType" Options="@(_moduleTypes.ToOptions(item => (ServerModuleType)item, item => item))" @bind-Value="_addModel.Type" />
                    </OmniFormField>
                </OmniColumn>
                <OmniColumn Span="6" MediumSpan="3">
                    <OmniFormField For="oe-pages-servers-serverdetailsections-servermodulessection-3"><LabelContent>@L["Version"]</LabelContent><ChildContent>
                        <OmniTextBox @bind-Value="_addModel.Version" maxlength="50" Id="oe-pages-servers-serverdetailsections-servermodulessection-3" />
                    </ChildContent></OmniFormField>
                </OmniColumn>
                <OmniColumn Span="12" MediumSpan="2">
                    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Class="omni-u-mt-xl">
                        <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_addSaving ? "btn-busy" : null)" Busy="@(_addSaving)"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Add"]</span></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => _addVisible = false)"><OmniIcon Name="OmniIconName.Close" /> <span>@L["Cancel"]</span></OmniButton>
                    </OmniStack>
                </OmniColumn>
            </OmniRow>
            </OmniTemplateForm>
        </OmniCard>
    }
}
