@* Recette R3-23 / R3-26: one check that says, without SSH, whether a mail stack left anything on the host
   after an uninstall or a reinstall: packages (configuration files left, rc, included), directories, the
   Aetheus marker and the mail ports still listening. While it runs, OE's veil lies over the card. *@
<OmniCard Class="@(Busy ? "omni-u-mb-lg mail-leftovers omni-busy" : "omni-u-mb-lg mail-leftovers")" aria-busy="@(Busy ? "true" : "false")">
    <OmniStack Gap="OmniSpacing.Medium">
        <OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0">@L["MailLeftoversTitle"]</OmniHeading>
            @if (AgentCanCheck)
            {
                <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@CheckAsync" Disabled="@AgentOffline" Busy="@Busy" Class="mail-leftovers-check">
                    <Icon><OmniIcon Name="OmniIconName.ListChecks" /></Icon><ChildContent><span>@L["MailLeftoversCheck"]</span></ChildContent>
                </OmniButton>
            }
        </OmniStack>
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["MailLeftoversIntro"]</OmniText>
        @if (!AgentCanCheck)
        {
            <OmniAlert Severity="OmniSeverity.Warning" Class="mail-leftovers-agent-old">@L["MailLeftoversNeedsAgentUpdate"]</OmniAlert>
        }
        else if (AgentOffline)
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Danger" Class="omni-u-m-0">@L["AgentOfflineActionBlocked"]</OmniText>
        }
        @if (_failure is { } failure)
        {
            <OmniAlert Severity="OmniSeverity.Danger" Class="mail-leftovers-failed">
                <OmniText Element="OmniTextElement.Strong">@L["MailLeftoversIncomplete"]</OmniText>
                <OmniText Element="OmniTextElement.Paragraph" Class="task-output-error">@failure</OmniText>
            </OmniAlert>
        }
        else if (_report is { IsClean: true })
        {
            <OmniAlert Severity="OmniSeverity.Success" Class="mail-leftovers-clean">@L["MailLeftoversClean"]</OmniAlert>
        }
        else if (_report is { } report)
        {
            <OmniAlert Severity="OmniSeverity.Warning" Title="@L["MailLeftoversFound"]" Class="mail-leftovers-found">
                <OmniStack Gap="OmniSpacing.Small">
                    @foreach (var group in Groups(report))
                    {
                        <OmniStack Gap="OmniSpacing.XSmall" Class="mail-leftovers-group" data-kind="@group.Kind">
                            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0">@L[GroupTitleKey(group.Kind)]</OmniText>
                            @foreach (var item in group.Items)
                            {
                                <OmniText Element="OmniTextElement.Small" Class="omni-u-m-0 mail-leftover">@ItemText(item)</OmniText>
                            }
                        </OmniStack>
                    }
                </OmniStack>
            </OmniAlert>
        }
        @if (_taskId is { } taskId)
        {
            <OmniLink Href="@($"/tasks/{taskId}")">@L["ServerTaskOpen", taskId]</OmniLink>
        }
    </OmniStack>
</OmniCard>
