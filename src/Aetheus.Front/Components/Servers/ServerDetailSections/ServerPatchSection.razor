@inject GridExportContext ExportContext

<OmniStack Gap="OmniSpacing.Large">
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Justify="OmniJustification.Between" Gap="OmniSpacing.Large">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            <OmniIcon Name="OmniIconName.ShieldCheck" />
        </OmniStack>
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
            @* STD-BTN detection 11: Apply visible, the other actions in the menu. *@
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@ApplyAsync" Disabled="@(!CanApply)" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><OmniIcon Name="OmniIconName.Download" /> <span>@L["PatchApply"]</span></OmniButton>
            <OmniOverflowMenu Label="@L["MoreActions"]">
                <OmniMenuItem OnClick="@CheckAsync" Disabled="@_busy"><Icon><OmniIcon Name="OmniIconName.Search" /></Icon><ChildContent>@L["PatchCheck"]</ChildContent></OmniMenuItem>
            </OmniOverflowMenu>
        </OmniStack>
    </OmniStack>

    @if (_loading)
    {
        <AetheusLoader Size="OmniControlSize.Small" />
    }
    else if (_status is null || !_status.PackageManagerPresent)
    {
        <EmptyState Icon="help" Title="@L["PatchNotApplicableTitle"]" Description="@L["PatchNotApplicableDescription"]" />
    }
    else if (!_status.Known)
    {
        <OmniCard>
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                <OmniIcon Name="OmniIconName.Question" />
                <OmniText Element="OmniTextElement.Paragraph">@L["PatchUnknown"]</OmniText>
            </OmniStack>
        </OmniCard>
    }
    else
    {
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Center">
            <OmniBadge Fill="OmniFill.Solid" Tone="@(_status.PendingTotal > 0 ? OmniTone.Warning : OmniTone.Success)">@string.Format(L["PatchPendingCount"], _status.PendingTotal)</OmniBadge>
            <OmniBadge Fill="OmniFill.Solid" Tone="@SecurityBadgeStyle">@string.Format(L["PatchSecurityCount"], _status.PendingSecurity)</OmniBadge>
            @if (_status.CheckedAt is not null)
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@string.Format(L["PatchCheckedAt"], _status.CheckedAt.Value.ToString("g"))</OmniText>
            }
        </OmniStack>

        @if (!CanApply)
        {
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@L["PatchApplyDisabledHint"]</OmniText>
        }

        @if (_status.Updates.Count > 0)
        {
            <OmniDataGrid @ref="_grid" ExportTitle="@ExportContext.Title(L["PatchTitle"])" ExportFields="@ExportContext.Fields()" FillAvailableHeight="true" Items="@_status.Updates" TItem="PendingUpdateDto" KeyOf="@(row => row.Package)" NewRowHighlight="@(TimeSpan.FromSeconds(5))" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3">
                <Columns>
                    <OmniDataGridColumn Frozen="true" TItem="PendingUpdateDto" Property="Package" Title="@L["PatchPackage"]"  Filterable="true"/>
                    <OmniDataGridColumn TItem="PendingUpdateDto" Property="CurrentVersion" Title="@L["PatchCurrentVersion"]" Width="200px"  Filterable="true"/>
                    <OmniDataGridColumn TItem="PendingUpdateDto" Property="CandidateVersion" Title="@L["PatchCandidateVersion"]" Width="200px"  Filterable="true"/>
                    <OmniDataGridColumn TItem="PendingUpdateDto" Property="IsSecurity" Title="@L["PatchSecurity"]" Width="120px" Filterable="true" FilterType="OmniDataGridColumnFilterType.Select" FilterValues="@GridFilterText.Booleans" FormatFilterValue="@YesNoText">
                        <Template Context="u">
                            @if (u.IsSecurity)
                            {
                                <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Danger">@L["PatchSecurityYes"]</OmniBadge>
                            }
                        </Template>
                    </OmniDataGridColumn>
                </Columns>
            </OmniDataGrid>
        }
    }
</OmniStack>
