<OmniRow Gap="OmniSpacing.XSmall">
    <OmniBadge Width="OmniBadgeWidth.Medium" Fill="OmniFill.Solid" Tone="@(IsActive ? OmniTone.Success : OmniTone.Neutral)">@(IsActive ? L["Active"] : L["Inactive"])</OmniBadge>
    @if (Source == MailRecordSource.Adopted)
    {
        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@L["MailRecordAdopted"]</OmniBadge>
    }
    @if (MissingSince is not null)
    {
        <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Warning" title="@MissingSince.Value.ToString("g")">@L["MailRecordMissing"]</OmniBadge>
    }
</OmniRow>
