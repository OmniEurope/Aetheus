<OmniRow Gap="OmniSpacing.XSmall">
    <OmniBadge Icon="@(BadgeIcon.ForState(IsActive ? OmniTone.Success : OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="@(IsActive ? OmniTone.Success : OmniTone.Neutral)">@(IsActive ? L["Active"] : L["Inactive"])</OmniBadge>
    @if (Source == MailRecordSource.Adopted)
    {
        <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Accent))" Fill="OmniFill.Solid" Tone="OmniTone.Accent">@L["MailRecordAdopted"]</OmniBadge>
    }
    @if (MissingSince is not null)
    {
        <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Warning))" Fill="OmniFill.Solid" Tone="OmniTone.Warning" title="@MissingSince.Value.ToString("g")">@L["MailRecordMissing"]</OmniBadge>
    }
</OmniRow>
