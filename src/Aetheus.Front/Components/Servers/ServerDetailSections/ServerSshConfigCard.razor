@* PLAN-010 lot 1: what the agent read of sshd and of the authorized keys. A value the agent could
   not read is shown as unknown, with the reason, never as a safe default.
   R-48, R-49: three blocks one under the other (state of the configuration, authorized keys per account,
   recent changes), each one stacked and wrapping, so nothing sits in fixed columns on a phone. *@

<OmniCard Class="ssh-config-card">
    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Wrap="true" Class="omni-u-mb-md">
        <OmniIcon Name="OmniIconName.LockKey" Class="omni-u-text-muted" />
        <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0 flex-1">@L["SshConfiguration"]</OmniText>
        @if (Status is null)
        {
            <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.Question))" Tone="OmniTone.Neutral">@L["SshNotCollected"]</OmniBadge>
        }
    </OmniStack>

    @if (Status is null)
    {
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-text-muted omni-u-m-0 ssh-not-collected">@L["SshNotCollectedHint"]</OmniText>
    }
    else
    {
        var snapshot = Status.Snapshot;
        <section class="ssh-section ssh-state">
            <OmniHeading Level="OmniHeadingLevel.H6" Class="omni-u-mb-sm">@L["SshConfigurationState"]</OmniHeading>
            <OmniDescriptionList Columns="3">
                <OmniDescriptionItem Term="@L["SshPermitRootLogin"]" Class="ssh-setting-permitrootlogin">
                    <OmniBadge Icon="@(BadgeIcon.For(RootLoginTone(snapshot.PermitRootLogin.Value)))" Tone="@RootLoginTone(snapshot.PermitRootLogin.Value)">@SettingText(snapshot.PermitRootLogin)</OmniBadge>
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@SourceText(snapshot, snapshot.PermitRootLogin)</OmniText>
                </OmniDescriptionItem>
                <OmniDescriptionItem Term="@L["SshPasswordAuthentication"]" Class="ssh-setting-passwordauthentication">
                    <OmniBadge Icon="@(BadgeIcon.For(PasswordTone(snapshot.PasswordAuthentication.Value)))" Tone="@PasswordTone(snapshot.PasswordAuthentication.Value)">@SettingText(snapshot.PasswordAuthentication)</OmniBadge>
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@SourceText(snapshot, snapshot.PasswordAuthentication)</OmniText>
                </OmniDescriptionItem>
                <OmniDescriptionItem Term="@L["SshAuthorizedKeysFile"]" Class="ssh-setting-authorizedkeysfile">
                    <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0 ssh-wrap">@SettingText(snapshot.AuthorizedKeysFile)</OmniText>
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@SourceText(snapshot, snapshot.AuthorizedKeysFile)</OmniText>
                </OmniDescriptionItem>
            </OmniDescriptionList>

            @if (snapshot.UnreadableFiles.Count > 0)
            {
                <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mt-md ssh-unreadable-files">
                    <OmniIcon Name="OmniIconName.ShieldWarning" Class="omni-u-text-warning" />
                    <OmniText Element="OmniTextElement.Small" Class="omni-u-m-0 ssh-wrap">@string.Format(L["SshUnreadableConfigFiles"], string.Join(", ", snapshot.UnreadableFiles))</OmniText>
                </OmniStack>
            }
        </section>

        <section class="ssh-section ssh-keys omni-u-mt-lg">
            <OmniHeading Level="OmniHeadingLevel.H6" Class="omni-u-mb-sm">@L["SshAuthorizedKeys"]</OmniHeading>
            <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Medium">
                @foreach (var account in KeyAccounts(snapshot))
                {
                    <div class="ssh-account">
                        <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Wrap="true" Class="omni-u-mb-xs">
                            <OmniIcon Name="OmniIconName.User" Class="omni-u-text-muted" />
                            <OmniText Element="OmniTextElement.Strong" Class="omni-u-m-0 ssh-account-name">@account.User</OmniText>
                        </OmniStack>
                        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Small">
                            @foreach (var file in account.Files)
                            {
                                <div class="ssh-keys-file">
                                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Wrap="true">
                                        <OmniIcon Name="OmniIconName.Key" Class="omni-u-text-muted" />
                                        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0 flex-1 ssh-keys-path ssh-wrap">@file.Path</OmniText>
                                        <OmniBadge Icon="@(BadgeIcon.Of(file.State == AuthorizedKeysFileState.Read ? OmniIconName.Check : OmniIconName.Warning))" Tone="@(file.State == AuthorizedKeysFileState.Read ? OmniTone.Neutral : OmniTone.Warning)">@FileStateText(file)</OmniBadge>
                                    </OmniStack>
                                    @if (file.State == AuthorizedKeysFileState.Unreadable)
                                    {
                                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0">@string.Format(L["SshKeysUnreadableHint"], file.User)</OmniText>
                                    }
                                    @foreach (var key in file.Keys)
                                    {
                                        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 ssh-key-fingerprint ssh-wrap">@key.KeyType @key.Fingerprint</OmniText>
                                    }
                                </div>
                            }
                        </OmniStack>
                    </div>
                }
                @if (snapshot.AuthorizedKeys.All(f => f.State == AuthorizedKeysFileState.Absent))
                {
                    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 ssh-no-keys">@L["SshNoAuthorizedKeys"]</OmniText>
                }
            </OmniStack>
        </section>

        <section class="ssh-section ssh-changes omni-u-mt-lg">
            <OmniHeading Level="OmniHeadingLevel.H6" Class="omni-u-mb-sm">@L["SshRecentChanges"]</OmniHeading>
            @if (Status.RecentChanges.Count == 0)
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 ssh-no-change">@L["SshNoChangeSinceBaseline"]</OmniText>
            }
            else
            {
                <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Medium">
                    @foreach (var change in Status.RecentChanges)
                    {
                        <div class="ssh-change">
                            <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Wrap="true">
                                <OmniBadge Icon="@(BadgeIcon.ForState(ChangeTone(change.Severity)))" Tone="@ChangeTone(change.Severity)">@ChangeSeverityText(change.Severity)</OmniBadge>
                                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0" title="@change.DetectedAt.ToString("F")">@RelativeTime.FormatAgo(L, change.DetectedAt)</OmniText>
                            </OmniStack>
                            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0 ssh-wrap">@change.Message</OmniText>
                        </div>
                    }
                </OmniStack>
            }
        </section>

        <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.XSmall" Class="omni-u-mt-md">
            @* R-50: when the agent last reported, so a reading that looks stale can be told from a quiet host. *@
            <OmniText Element="OmniTextElement.Small" Class="omni-u-m-0 ssh-last-report">@LastReportText()</OmniText>
            <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-m-0 ssh-observed">
                @string.Format(L["SshObservedSince"], Status.BaselineAt.ToString("g"), Status.ObservedAt.ToString("g"))
            </OmniText>
        </OmniStack>
    }
</OmniCard>
