<OmniTemplateForm TModel="CronForm" Model="@_form" OnValidSubmit="@Save">
    <OmniDataAnnotationsValidator Localizer="@L" />
    <OmniStack Gap="OmniSpacing.Small">
        <OmniFormField For="oe-pages-servers-serverdetailsections-cronjobdialog-1" Help="@L["CronNonRootHint"]"><LabelContent>@L["User"]</LabelContent><ChildContent>
            <OmniTextBox @bind-Value="_form.User" Placeholder="deploy" maxlength="64" Id="oe-pages-servers-serverdetailsections-cronjobdialog-1" />
            <ValidationMessage For="@(() => _form.User)" />
        </ChildContent></OmniFormField>
        <OmniFormField Label="@L["Schedule"]" For="Schedule">
            <OmniTextBox @bind-Value="_form.Schedule" Id="Schedule" Placeholder="*/5 * * * *" maxlength="100" />
            <ValidationMessage For="@(() => _form.Schedule)" />
        </OmniFormField>
        @{
            var v = ScheduleValidation;
        }
        @if (!string.IsNullOrWhiteSpace(_form.Schedule))
        {
            @if (v.IsValid)
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="cron-next-run">
                    @L["NextRun"]: @v.NextRun
                </OmniText>
            }
            else if (!string.IsNullOrEmpty(v.Error))
            {
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="cron-error">
                    @v.Error
                </OmniText>
            }
        }
        <OmniFormField For="oe-pages-servers-serverdetailsections-cronjobdialog-3"><LabelContent>@L["Command"]</LabelContent><ChildContent>
            <OmniTextBox @bind-Value="_form.Command" Placeholder="/usr/bin/backup.sh" maxlength="1000" Id="oe-pages-servers-serverdetailsections-cronjobdialog-3" />
            <ValidationMessage For="@(() => _form.Command)" />
        </ChildContent></OmniFormField>
        <Aetheus.Front.Components.Shared.DialogFooter OnCancel="@Cancel">
            <OmniButton Variant="OmniButtonVariant.Primary" Disabled="@(!ScheduleValidation.IsValid)" ButtonType="OmniButtonType.Submit"><OmniIcon Name="OmniIconName.Save" /> <span>@L["Save"]</span></OmniButton>
        </Aetheus.Front.Components.Shared.DialogFooter>
    </OmniStack>
</OmniTemplateForm>
