@if (AgentServer is { } agentServer)
{
    <AgentOfflineNotice Server="@agentServer" />
}

@* --- Status bar --- *@
<OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-lg">
    <OmniBadge Fill="OmniFill.Solid" Tone="@(Ps.IsInstalled ? OmniTone.Success : OmniTone.Neutral)">@(Ps.IsInstalled ? L["Installed"] : L["NotInstalled"])</OmniBadge>
    @if (Ps.IsInstalled)
    {
        <OmniBadge Fill="OmniFill.Solid" Tone="@(Ps.IsRunning ? OmniTone.Success : OmniTone.Danger)">@(Ps.IsRunning ? L["Running"] : L["Stopped"])</OmniBadge>
        @if (!string.IsNullOrEmpty(Ps.Version))
        {
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">v@(Ps.Version)</OmniText>
        }
        @if (!string.IsNullOrEmpty(Ps.Mode))
        {
            <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Accent">@($"{L["Mode"]}: {Ps.Mode}")</OmniBadge>
        }
        <OmniBadge Fill="OmniFill.Solid" Tone="@GetBlockedCountBadgeStyle(Ps.BlockedCount)">@($"{Ps.BlockedCount} {L["BlockedIps"]}")</OmniBadge>
    }
    <div class="blade-content-spacer"></div>

    @if (!Ps.IsInstalled)
    {
        <OmniButton Disabled="@AgentOffline" Variant="OmniButtonVariant.Primary" OnClick="@OpenSetupDialogAsync"><OmniIcon Name="OmniIconName.RocketLaunch" /> <span>@L["PortsentrySetup"]</span></OmniButton>
    }
    else
    {
        @* Recette R3-41: Restart is the zone's one visible action; Start, Stop and the logs sit in the
           "More actions" menu. *@
        <OmniButton Disabled="@(AgentOffline || _actionRunning)" Variant="OmniButtonVariant.Primary" OnClick="@(() => ExecuteActionAsync(PortsentryAction.Restart))" Class="@(_actionRunning ? "btn-busy" : null)" Busy="@_actionRunning"><OmniIcon Name="OmniIconName.Refresh" /> <span>@L["Restart"]</span></OmniButton>
        <OmniOverflowMenu Label="@L["MoreActions"]">
            <OmniMenuItem Disabled="@(AgentOffline || _actionRunning)" OnClick="@(() => ExecuteActionAsync(PortsentryAction.Start))"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent>@L["Start"]</ChildContent></OmniMenuItem>
            <OmniMenuItem Tone="OmniTone.Danger" Disabled="@(AgentOffline || _actionRunning)" OnClick="@(() => ExecuteActionAsync(PortsentryAction.Stop))"><Icon><OmniIcon Name="OmniIconName.Stop" /></Icon><ChildContent>@L["Stop"]</ChildContent></OmniMenuItem>
            <OmniMenuItem Disabled="@AgentOffline" OnClick="@GetLogsAsync"><Icon><OmniIcon Name="OmniIconName.Document" /></Icon><ChildContent>@L["ViewLogs"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    }
</OmniRow>

<ServerTaskFollower @ref="_follower" ServerId="@ServerId" NamePrefix="PortSentry" />

@if (Ps.IsInstalled)
{
    <UrlSyncedTabs Slugs="@(new[] { "blocked", "whitelist", "config" })">
        <Tabs>
            @* --- Blocked IPs tab --- *@
            <OmniTabsItem Key="blocked" Title="@L["BlockedIps"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("block"))" /></Icon><ChildContent>
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center" Class="omni-u-mb-sm">
                    <CountBadge Value="@_blockedCount" Variant="@GetBlockedCountBadgeStyle(_blockedCount)" />
                </OmniStack>
                <AetheusDataGrid FullHeight="true" @ref="_blockedGrid" Data="@_blockedIps" Count="@_blockedCount"
                    TItem="PortsentryBlockedIpDto" IsLoading="@_blockedLoading" LoadData="@LoadBlockedAsync" ExportRead="@ReadBlockedExportAsync" ExportName="@L["BlockedIps"]"
                    PageSize="25" Density="OmniDensity.Compact" AllowSorting="true" EmptyText="@L["NoBlockedIps"]"
                    Virtualize="@AetheusGrid.RemoteVirtualization"
                    VirtualData="@(() => new OmniDataGridResult<PortsentryBlockedIpDto>(_blockedIps, _blockedCount))">
                    <Columns>
                            <OmniDataGridColumn Frozen="true" TItem="PortsentryBlockedIpDto" Property="IpAddress" Title="@L["IpAddress"]" Width="180px" Filterable="true" />
                            <OmniDataGridColumn TItem="PortsentryBlockedIpDto" Property="Protocol" Title="@L["Protocol"]" Width="100px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_protocolValues" />
                            <OmniDataGridColumn TItem="PortsentryBlockedIpDto" Property="BlockedAt" Title="@L["BlockedAt"]" Width="180px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" >
                                <Template Context="b">
                                    @* SITE-FUNC-PORTSENTRY-001: the agent sends DateTime.MinValue when the blocked file carries no date. *@
                                    @(b.BlockedAt == default ? "-" : b.BlockedAt.ToString("g"))
                                </Template>
                            </OmniDataGridColumn>
                            <OmniDataGridColumn TItem="PortsentryBlockedIpDto" Property="Reason" Title="@L["Reason"]" Filterable="true" />
                            <OmniDataGridColumn TItem="PortsentryBlockedIpDto" Title="" Width="80px" TextAlign="OmniDataGridTextAlign.End" Filterable="false" >
                                <Template Context="b">
                                    <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@AgentOffline" OnClick="@(() => UnblockIpAsync(b.IpAddress))" title="@L["Unblock"]"><OmniIcon Name="OmniIconName.LockOpen" /></OmniButton>
                                </Template>
                            </OmniDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </ChildContent></OmniTabsItem>

            @* --- Whitelist tab --- *@
            <OmniTabsItem Key="whitelist" Title="@L["Whitelist"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("shield"))" /></Icon><ChildContent>
                <OmniRow Gap="OmniSpacing.Small" Align="OmniAlignment.End" Class="omni-u-mb-md">
                    <div>
                        <OmniLabel For="WlIp">@L["IpAddress"]</OmniLabel>
                        <OmniTextBox @bind-Value="_whitelistIp" Id="WlIp" Placeholder="192.168.1.1" Class="w-rem-11" />
                    </div>
                    <div>
                        <OmniLabel For="WlDesc">@L["Description"]</OmniLabel>
                        <OmniTextBox @bind-Value="_whitelistDesc" Id="WlDesc" Placeholder="@L["WhitelistDescription"]" Class="w-rem-15-625" />
                    </div>
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@AddWhitelistIpAsync"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Add"]</span></OmniButton>
                </OmniRow>
                <AetheusDataGrid FullHeight="true" @ref="_whitelistGrid" Data="@_whitelist" Count="@_whitelistCount"
                    TItem="PortsentryWhitelistIpDto" IsLoading="@_whitelistLoading" LoadData="@LoadWhitelistAsync" ExportRead="@ReadWhitelistExportAsync" ExportName="@L["Whitelist"]"
                    PageSize="25" Density="OmniDensity.Compact" AllowSorting="true" EmptyText="@L["NoWhitelistEntries"]"
                    Virtualize="@AetheusGrid.RemoteVirtualization"
                    VirtualData="@(() => new OmniDataGridResult<PortsentryWhitelistIpDto>(_whitelist, _whitelistCount))">
                    <Columns>
                            <OmniDataGridColumn Frozen="true" TItem="PortsentryWhitelistIpDto" Property="IpAddress" Title="@L["IpAddress"]" Width="180px" Filterable="true" />
                            <OmniDataGridColumn TItem="PortsentryWhitelistIpDto" Property="Description" Title="@L["Description"]" Filterable="true" />
                            <OmniDataGridColumn TItem="PortsentryWhitelistIpDto" Property="CreatedAt" Title="@L["CreatedAt"]" Width="180px" Filterable="true" FilterType="OmniDataGridColumnFilterType.DateRange" FilterIncludesTime="true" >
                                <Template Context="w">
                                    @w.CreatedAt.ToString("g")
                                </Template>
                            </OmniDataGridColumn>
                            <OmniDataGridColumn TItem="PortsentryWhitelistIpDto" Title="" Width="80px" TextAlign="OmniDataGridTextAlign.End" Filterable="false" >
                                <Template Context="w">
                                    <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => RemoveWhitelistIpAsync(w))" title="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                                </Template>
                            </OmniDataGridColumn>
                    </Columns>
                </AetheusDataGrid>
            </ChildContent></OmniTabsItem>

            @* --- Configuration tab --- *@
            <OmniTabsItem Key="config" Title="@L["Configuration"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve(("settings"))" /></Icon><ChildContent>
                <OmniRow Gap="OmniSpacing.Large" Class="omni-u-mb-lg">
                    <OmniColumn Span="12" MediumSpan="6">
                        <OmniFieldset><Legend>@L["TcpPorts"]</Legend><ChildContent>
                            <OmniText Element="OmniTextElement.Paragraph">@(string.IsNullOrEmpty(Ps.TcpPorts) ? "-" : Ps.TcpPorts)</OmniText>
                        </ChildContent></OmniFieldset>
                    </OmniColumn>
                    <OmniColumn Span="12" MediumSpan="6">
                        <OmniFieldset><Legend>@L["UdpPorts"]</Legend><ChildContent>
                            <OmniText Element="OmniTextElement.Paragraph">@(string.IsNullOrEmpty(Ps.UdpPorts) ? "-" : Ps.UdpPorts)</OmniText>
                        </ChildContent></OmniFieldset>
                    </OmniColumn>
                </OmniRow>
            </ChildContent></OmniTabsItem>
        </Tabs>
    </UrlSyncedTabs>
}
