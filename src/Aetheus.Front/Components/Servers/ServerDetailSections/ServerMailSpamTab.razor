<OmniStack Gap="OmniSpacing.Medium">
    @if (!Spam.IsInstalled)
    {
        <OmniAlert Severity="OmniSeverity.Info">@L["MailSpamNotInstalled"]</OmniAlert>
        @if (CanManage)
        {
            <div>
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@InstallAsync" Disabled="@_busy"><Icon><OmniIcon Name="OmniIconName.Monitor" /></Icon><ChildContent><span>@L["MailInstallSpamFilter"]</span></ChildContent></OmniButton>
            </div>
        }
    }
    else
    {
        <OmniRow Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
            <NumberBadge Fill="OmniFill.Solid" Tone="@(Spam.IsRunning ? OmniTone.Success : OmniTone.Danger)">@($"{Spam.Name} {Spam.Version} {(Spam.IsRunning ? L["Running"] : L["Stopped"])}".Trim())</NumberBadge>
            <div class="blade-content-spacer"></div>
            @if (CanManage)
            {
                @* STD-BTN detection 11: Start visible, the other actions in the menu. *@
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => RunAsync(MailAction.StartSpamFilter))" Disabled="@_busy"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent><span>@L["Start"]</span></ChildContent></OmniButton>
                <OmniOverflowMenu Label="@L["MoreActions"]">
                    <OmniMenuItem OnClick="@(() => RunAsync(MailAction.RestartSpamFilter))" Disabled="@_busy"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["Restart"]</ChildContent></OmniMenuItem>
                    <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => RunAsync(MailAction.StopSpamFilter))" Disabled="@_busy"><Icon><OmniIcon Name="OmniIconName.Stop" /></Icon><ChildContent>@L["Stop"]</ChildContent></OmniMenuItem>
                </OmniOverflowMenu>
            }
        </OmniRow>

        <OmniRow Gap="OmniSpacing.Large">
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["MailGreylistScore"] : @Score(Spam.GreylistScore)</OmniText>
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["MailAddHeaderScore"] : @Score(Spam.AddHeaderScore)</OmniText>
            <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@L["MailRejectScore"] : @Score(Spam.RejectScore)</OmniText>
        </OmniRow>

        @if (CanManage)
        {
            <OmniRow Gap="OmniSpacing.Small">
                @* STD-BTN detection 11: Learn visible, the other actions in the menu. *@
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@LearnAsync" Disabled="@_busy"><Icon><OmniIcon Name="OmniIconName.Flask" /></Icon><ChildContent><span>@L["MailLearn"]</span></ChildContent></OmniButton>
                <OmniOverflowMenu Label="@L["MoreActions"]">
                    <OmniMenuItem OnClick="@EditThresholdsAsync" Disabled="@_busy"><Icon><OmniIcon Name="OmniIconName.Sliders" /></Icon><ChildContent>@L["MailSpamThresholds"]</ChildContent></OmniMenuItem>
                </OmniOverflowMenu>
            </OmniRow>
        }
    }
</OmniStack>
