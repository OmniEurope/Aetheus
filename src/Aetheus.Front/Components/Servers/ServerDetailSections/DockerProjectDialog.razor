@inject GridExportContext ExportContext
<OmniStack>
<OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
    <OmniHeading Level="OmniHeadingLevel.H5" Class="omni-u-m-0"><strong>@(string.IsNullOrEmpty(Project) ? L["NoProject"] : Project)</strong></OmniHeading>
    <div class="flex-spacer"></div>
    @* STD-BTN detection 11: Start visible, the other actions in the menu. *@
    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => CloseWithAction(DockerContainerAction.Start))" title="@L["StartAll"]"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent><span>@L["Start"]</span></ChildContent></OmniButton>
    <OmniOverflowMenu Label="@L["MoreActions"]">
        <OmniMenuItem OnClick="@(() => CloseWithAction(DockerContainerAction.Restart))" title="@L["RestartAll"]"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["Restart"]</ChildContent></OmniMenuItem>
        <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => CloseWithAction(DockerContainerAction.Stop))"><Icon><OmniIcon Name="OmniIconName.Stop" /></Icon><ChildContent>@L["StopAll"]</ChildContent></OmniMenuItem>
    </OmniOverflowMenu>
</OmniStack>

<OmniTabs>
        <OmniTabsItem Title="@L["Containers"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("deployed_code")" /></Icon><ChildContent><OmniDataGrid Items="@Containers" ExportTitle="@ExportContext.Title(L["Containers"])" ExportFields="@ExportContext.Fields()" TItem="DockerContainerDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight"><Columns><OmniDataGridColumn Frozen="true" TItem="DockerContainerDto" Property="Name" Title="@L["Name"]" Filterable="true" /><OmniDataGridColumn TItem="DockerContainerDto" Property="Image" Title="@L["Image"]" Filterable="true" /><OmniDataGridColumn TItem="DockerContainerDto" Property="State" Title="@L["State"]" Width="6.25rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" /><OmniDataGridColumn TItem="DockerContainerDto" Property="Status" Value="@(c => DockerContainerStatusText.Format(c.Status, L))" Title="@L["Status"]" Filterable="true" /><OmniDataGridColumn TItem="DockerContainerDto" Property="Ports" Title="@L["Ports"]" Filterable="true" /></Columns></OmniDataGrid></ChildContent></OmniTabsItem>
        <OmniTabsItem Title="@L["DockerImages"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("layers")" /></Icon><ChildContent><OmniDataGrid Items="@Images" ExportTitle="@ExportContext.Title(L["DockerImages"])" ExportFields="@ExportContext.Fields()" TItem="DockerImageDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight"><Columns><OmniDataGridColumn Frozen="true" TItem="DockerImageDto" Property="Repository" Title="@L["Repository"]" Filterable="true" /><OmniDataGridColumn TItem="DockerImageDto" Property="Tag" Title="@L["Tag"]" Width="7.5rem" Filterable="true" /><OmniDataGridColumn TItem="DockerImageDto" Property="Size" Title="@L["Size"]" Width="6.25rem" Filterable="true"><Template Context="img">@DisplayFormatting.DockerSize(img.Size)</Template></OmniDataGridColumn></Columns></OmniDataGrid></ChildContent></OmniTabsItem>
        <OmniTabsItem Title="@L["DockerNetworks"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("lan")" /></Icon><ChildContent><OmniDataGrid Items="@Networks" ExportTitle="@ExportContext.Title(L["DockerNetworks"])" ExportFields="@ExportContext.Fields()" TItem="DockerNetworkDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight"><Columns><OmniDataGridColumn Frozen="true" TItem="DockerNetworkDto" Property="Name" Title="@L["Name"]" Filterable="true" /><OmniDataGridColumn TItem="DockerNetworkDto" Property="Driver" Title="@L["Driver"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" /><OmniDataGridColumn TItem="DockerNetworkDto" Property="Scope" Title="@L["Scope"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" /></Columns></OmniDataGrid></ChildContent></OmniTabsItem>
        <OmniTabsItem Title="@L["DockerVolumes"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("storage")" /></Icon><ChildContent><OmniDataGrid Items="@Volumes" ExportTitle="@ExportContext.Title(L["DockerVolumes"])" ExportFields="@ExportContext.Fields()" TItem="DockerVolumeDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight"><Columns><OmniDataGridColumn Frozen="true" TItem="DockerVolumeDto" Property="Name" Title="@L["Name"]" Filterable="true" /><OmniDataGridColumn TItem="DockerVolumeDto" Property="Driver" Title="@L["Driver"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" /><OmniDataGridColumn TItem="DockerVolumeDto" Property="Mountpoint" Title="@L["Mountpoint"]" Filterable="true" /></Columns></OmniDataGrid></ChildContent></OmniTabsItem>
        <OmniTabsItem Title="@L["DockerCompose"]"><Icon><OmniIcon Name="@MaterialIconMap.Resolve("view_list")" /></Icon><ChildContent><OmniDataGrid Items="@ComposeStacks" ExportTitle="@ExportContext.Title(L["DockerCompose"])" ExportFields="@ExportContext.Fields()" TItem="DockerComposeStackDto" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" MaxHeight="@AetheusGrid.ScrollMaxHeight"><Columns><OmniDataGridColumn Frozen="true" TItem="DockerComposeStackDto" Property="Name" Title="@L["Stack"]" Filterable="true" /><OmniDataGridColumn TItem="DockerComposeStackDto" Property="Status" Title="@L["Status"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" /><OmniDataGridColumn TItem="DockerComposeStackDto" Property="ConfigFile" Title="@L["Config"]" Filterable="true" /></Columns></OmniDataGrid></ChildContent></OmniTabsItem>
</OmniTabs>

<DialogFooter CancelText="@L["Close"]" OnCancel="@(() => Dialog.Close())" />
</OmniStack>
