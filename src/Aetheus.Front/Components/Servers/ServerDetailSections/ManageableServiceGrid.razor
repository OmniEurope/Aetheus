@inject GridExportContext ExportContext
@* One manageable-services grid (installed OR available) with multi-select + a bulk-action bar, so the
   same action can be applied to several services at once. Reused by both the Manageable and Other tabs.
   Logs stay per-service (no bulk) - viewing N log streams at once makes no sense. *@
@namespace Aetheus.Front.Components.Servers.ServerDetailSections
<OmniStack>
@if (_selected.Count > 0)
{
    <OmniStack Orientation="OmniOrientation.Horizontal" Wrap="true" Align="OmniAlignment.Center" Gap="OmniSpacing.Small" Class="omni-u-p-sm omni-u-rounded service-bulk-bar">
        <OmniText Element="OmniTextElement.Paragraph" Class="omni-u-m-0">@string.Format(L["ServicesSelected"], _selected.Count)</OmniText>
        <div class="flex-spacer"></div>
        @* Recette R3-41: one visible action per zone (Start, or Install on the available tab); the others and
           the end of the selection sit in the "More actions" menu. *@
        @if (Installed)
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => FireBulkAsync("Start"))" Disabled="@(!ServerOnline)"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon><ChildContent><span>@L["Start"]</span></ChildContent></OmniButton>
        }
        else
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => FireBulkAsync("Install"))" Disabled="@(!ServerOnline || (!CanManagePackages && !CanInstallTeamspeak))"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@L["Install"]</span></ChildContent></OmniButton>
        }
        <OmniOverflowMenu Label="@L["MoreActions"]">
            @if (Installed)
            {
                <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => FireBulkAsync("Stop"))" Disabled="@(!ServerOnline)"><Icon><OmniIcon Name="OmniIconName.Stop" /></Icon><ChildContent>@L["Stop"]</ChildContent></OmniMenuItem>
                <OmniMenuItem OnClick="@(() => FireBulkAsync("Restart"))" Disabled="@(!ServerOnline)"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["Restart"]</ChildContent></OmniMenuItem>
                <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => FireBulkAsync("Uninstall"))" Disabled="@(!ServerOnline || !CanManagePackages)"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["Uninstall"]</ChildContent></OmniMenuItem>
            }
            <OmniMenuItem OnClick="@ClearSelection"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent>@L["ClearSelection"]</ChildContent></OmniMenuItem>
        </OmniOverflowMenu>
    </OmniStack>
}

@* Recette R2-030 (2026-10-02): an install or uninstall only moved its button; the line under the
   status was easy to miss. What runs is said above the grid, with a moving bar, until it ends. *@
@if (ShowInFlightBanner)
{
    <ServiceActionsInFlightBanner Services="@Services" ActionStateOf="@ActionStateOf" />
}

@* R-509: on the module grid a click on the row opens the service's module; the checkbox, the
   buttons and the task link keep their own click and key (SITE-FUNC-HOME-CAPABILITY-001). *@
<OmniDataGrid @ref="_grid" ShowFooterBar="true" BarButtonSize="OmniControlSize.Medium" ExportTitle="@ExportContext.Title(L["Services"])" ExportFields="@ExportContext.Fields()" Items="@Services.ToList()" TItem="ServiceInfoDto" KeyOf="@(row => row.Name)" NewRowHighlight="@(TimeSpan.FromSeconds(5))"
    RowRender="@OnRowRenderInternal" ScrollMode="OmniDataGridScrollMode.Virtual" VirtualizationOverscanCount="3" FillAvailableHeight="@Installed" MaxHeight="@(Installed ? null : AetheusGrid.ScrollMaxHeight)"
    OnRowClick="@OnRowClickedAsync" Class="@(OpensModuleOnRowClick ? "aetheus-clickable-rows" : null)">
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="ServiceInfoDto" Key="SelectService" Title="@L["SelectAll"]" Width="2.875rem" Sortable="false" Filterable="false">
            <HeaderContent>
                <OmniCheckBox aria-label="@L["SelectAll"]" TValue="bool" Value="@AllSelected" ValueChanged="@ToggleAll" ValueExpression="@(() => AllSelected)" title="@L["SelectAll"]" />
            </HeaderContent>
            <Template Context="svc">
                @{ var serviceSelected = _selected.Contains(svc.Name); }
                <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    <OmniCheckBox TValue="bool" Value="@serviceSelected" ValueChanged="@(value => ToggleOne(svc.Name, value))" ValueExpression="@(() => serviceSelected)" aria-label="@svc.Name" />
                </span>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn Class="omni-data-grid__cell--text" TItem="ServiceInfoDto" Property="Name" Title="@L["Service"]" Filterable="true">
            <Template Context="svc">
                @if (Installed && ShowModuleLink)
                {
                    <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.XSmall">
                        @* Service management is the row's primary blue action. *@
                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OnOpenModule.InvokeAsync(svc.Name))" title="@($"{L["OpenModule"]}: {svc.Name}")" Label="@($"{L["OpenModule"]}: {svc.Name}")"><Icon><OmniIcon Name="OmniIconName.OpenExternal" /></Icon></OmniButton>
                        </span>
                        <span>@svc.Name</span>
                    </OmniStack>
                }
                else
                {
                    @svc.Name
                }
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ServiceInfoDto" Property="Type" Title="@L["Type"]" Width="7.5rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@TypeText">
            <Template Context="svc">
                <OmniBadge Icon="@(BadgeIcon.For(OmniTone.Neutral))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@FormatType(svc.Type)</OmniBadge>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ServiceInfoDto" Property="Status" Title="@L["Status"]" Width="12rem" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@StatusFilterText">
            <Template Context="svc">
                @{ var action = ActionOf(svc.Name); }
                <div>
                <OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.XSmall" Align="OmniAlignment.Start">
                    @if (Installed)
                    {
                        @* The host's word is translated, and only a failure is red. *@
                        <OmniBadge Icon="@(BadgeIcon.ForState(GetStatusBadgeStyle(svc.Status, svc.IsRunning)))" Fill="OmniFill.Solid" Tone="@GetStatusBadgeStyle(svc.Status, svc.IsRunning)" title="@svc.Status">@StatusText(svc.Status, svc.IsRunning)</OmniBadge>
                    }
                    else
                    {
                        <OmniBadge Icon="@(BadgeIcon.Of(OmniIconName.Prohibit))" Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@L["NotInstalled"]</OmniBadge>
                    }
                    @* What the action launched on this service is doing, linked to its task. *@
                    @if (action is not null)
                    {
                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" class="service-action-state service-action-state--@action.Phase.ToString().ToLowerInvariant()">
                            <OmniLink Href="@($"/tasks/{action.TaskId}")">@ActionText(action)</OmniLink>
                        </span>
                    }
                </OmniStack>
                @* The progress bar belongs to the banner above the grid. *@
                </div>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ServiceInfoDto" Key="Actions" Title="@L["Actions"]" Width="8rem" Sortable="false" TextAlign="OmniAlignment.Center">
            <Template Context="svc">
                @if (Installed)
                {
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.XSmall" Justify="OmniJustification.Center">
                        @* Recette R3-41: Start and Stop share the row's one visible action, according to the
                           service state; Restart, the logs and Uninstall sit in the "More actions" menu. *@
                        @if (!svc.IsRunning)
                        {
                            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OnStart.InvokeAsync(svc.Name))" Disabled="@(!ServerOnline)" Class="@(IsBusy(svc.Name) ? "btn-busy" : null)" Busy="@IsBusy(svc.Name)" title="@ActionTitle(L["Start"].Value)" Label="@ActionTitle(L["Start"].Value)"><Icon><OmniIcon Name="OmniIconName.Play" /></Icon></OmniButton>
                        }
                        else
                        {
                            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => OnStop.InvokeAsync(svc.Name))" Disabled="@(!ServerOnline)" Class="@(IsBusy(svc.Name) ? "btn-busy" : null)" Busy="@IsBusy(svc.Name)" title="@ActionTitle(L["Stop"].Value)" Label="@ActionTitle(L["Stop"].Value)"><Icon><OmniIcon Name="OmniIconName.Stop" /></Icon></OmniButton>
                        }
                        <OmniOverflowMenu Label="@($"{L["MoreActions"]}: {svc.Name}")">
                            <OmniMenuItem OnClick="@(() => OnRestart.InvokeAsync(svc.Name))" Disabled="@(!ServerOnline || IsBusy(svc.Name))"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent>@L["Restart"]</ChildContent></OmniMenuItem>
                            <OmniMenuItem OnClick="@(() => OnLogs.InvokeAsync(svc.Name))"><Icon><OmniIcon Name="OmniIconName.Document" /></Icon><ChildContent>@L["ViewLogs"]</ChildContent></OmniMenuItem>
                            <OmniMenuItem Tone="OmniTone.Danger" OnClick="@(() => OnUninstall.InvokeAsync(svc.Name))" Disabled="@(!ServerOnline || !CanManagePackages || IsMailStackLocked(svc.Name) || IsBusy(svc.Name))" title="@(!ServerOnline ? L["AgentOfflineActionBlocked"].Value : IsMailStackLocked(svc.Name) ? L["MailStackManagedServiceHint"].Value : CanManagePackages ? L["Uninstall"].Value : L["ServiceInstallCapabilityDisabled"].Value)"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@L["Uninstall"]</ChildContent></OmniMenuItem>
                        </OmniOverflowMenu>
                    </OmniStack>
                    </span>
                }
                else
                {
                    <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(() => OnInstall.InvokeAsync(svc.Name))" Disabled="@(!ServerOnline || !CanInstall(svc.Name))" Class="@(IsBusy(svc.Name) ? "btn-busy" : null)" Busy="@IsBusy(svc.Name)" title="@(!ServerOnline ? L["AgentOfflineActionBlocked"].Value : InstallTitle(svc.Name))"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon></OmniButton>
                    </span>
                }
            </Template>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>
</OmniStack>
