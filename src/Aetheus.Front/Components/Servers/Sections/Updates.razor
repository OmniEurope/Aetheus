@inherits ServerTaskAwareSectionBase
@page "/servers/{Id:int}/updates"
@layout Aetheus.Front.Layout.ServerDetailLayout
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

<PageTitle>@(Loader?.Server?.Name ?? L["Server"]) - @L["PatchTitle"] - Aetheus</PageTitle>

@if (Loader?.Server is not null)
{
    <Aetheus.Front.Components.Servers.ServerDetailSections.ServerPatchSection
        @ref="_section"
        ServerId="@Id"
        Server="@Loader.Server"
        PatchManagementAvailable="@Loader.Server.PatchManagementAvailable"
        OnRefreshRequested="StateHasChanged" />
}
