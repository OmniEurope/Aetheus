@inherits ServerTaskAwareSectionBase
@page "/servers/{Id:int}/apache"
@layout Aetheus.Front.Layout.ServerDetailLayout
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aetheus.Front.Resources.AppStrings> L

@* R-120: the installed version is part of the title. *@
<PageTitle>@(Loader?.Server?.Name ?? L["Server"]) - @L["Apache"]@(string.IsNullOrWhiteSpace(Loader?.Server?.Apache?.Version) ? "" : " " + Loader?.Server?.Apache?.Version?.Trim()) - Aetheus</PageTitle>

@if (Loader?.Server is not null)
{
    <Aetheus.Front.Components.Servers.ServerDetailSections.ServerApacheSection
        @ref="_section" Server="@Loader.Server" ServerId="@Id" />
}
