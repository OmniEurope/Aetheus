@* Render commands through OmniCodeBlock with a title when labelled and the compact one-line form
   otherwise. *@
<OmniCodeBlock Code="@Code" Title="@Label" Inline="@(InlineLine && Label is null)" Wrap="@(!InlineLine)"
               Class="wizard-code-block" OnCopy="@OnCopied" />
