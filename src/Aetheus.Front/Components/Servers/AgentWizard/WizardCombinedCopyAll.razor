@* "Copy all" button plus the consolidated combined command. *@
<OmniStack Gap="OmniSpacing.Small" Class="wizard-step-section">
    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@CopyAllAsync" title="@L["WizardCopyAll"]" Label="@L["WizardCopyAll"]">
        <Icon><OmniIcon Name="OmniIconName.Copy" /></Icon>
    </OmniButton>
    <WizardCodeBlock Code="@Combined" InlineLine="true" />
</OmniStack>
