@inherits AgentInstallOptionsComponentBase
@* Install step: instructions + download button + one-shot installer link. *@
<OmniStack Orientation="OmniOrientation.Vertical" Gap="OmniSpacing.Large">
    <p>@L["WizardInstallDescription"]</p>
    <WizardInstallInstructions Platform="@Platform" ServerBaseUrl="@ServerBaseUrl" SiteVersion="@SiteVersion" Token="@InstallerToken"
                               IncludePipelineRunner="@IncludePipelineRunner" IncludeServerManagement="@IncludeServerManagement"
                               IncludeDeploymentAgent="@IncludeDeploymentAgent"
                               IncludePatchManagement="@IncludePatchManagement"
                               IncludeFirewallManagement="@IncludeFirewallManagement"
                               IncludeDocker="@IncludeDocker" DevModeInsecureTls="@DevModeInsecureTls" />
    @* STD-BTN detection 11: Download visible, the other actions in the menu. *@
    <OmniRow Gap="OmniSpacing.Small">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenDownloadAsync"><Icon><OmniIcon Name="OmniIconName.Download" /></Icon><ChildContent><span>@DownloadLabel</span></ChildContent></OmniButton>
        @if (!string.IsNullOrWhiteSpace(InstallerToken))
        {
            <OmniOverflowMenu Label="@L["MoreActions"]">
                <OmniMenuItem OnClick="@CopyInstallerLinkAsync"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((_linkCopied ? "check" : "link"))" /></Icon><ChildContent>@(_linkCopied ? L["WizardInstallerLinkCopied"] : L["WizardCopyInstallerLink"])</ChildContent></OmniMenuItem>
            </OmniOverflowMenu>
        }
    </OmniRow>
    @if (!string.IsNullOrWhiteSpace(InstallerToken))
    {
        <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted" Class="omni-u-text-muted">
            @L["WizardInstallerLinkHint"]
        </OmniText>
    }
</OmniStack>
