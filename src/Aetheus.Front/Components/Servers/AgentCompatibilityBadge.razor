@if (Value is not null)
{
    <span title="@L[$"AgentCompatibility_{Value.Status}"]">
        <OmniBadge Fill="OmniFill.Solid" Tone="@BadgeVariantFor(Value.Status)" Icon="@BadgeIcon.Of(IconFor(Value.Status))">
            @L[$"AgentCompatibility_{Value.Status}"]
        </OmniBadge>
    </span>
}
