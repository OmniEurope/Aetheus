@namespace Aetheus.Front.Components.Servers
@* Standard dismiss button for dialogs opened via DialogService.OpenAsync. Guarantees every dialog
   has at least one button to close it, with the shared close icon and label. *@

<OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(_ => Dialog.Close())">
    <Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent>@(Text ?? L["Close"])</ChildContent>
</OmniButton>
