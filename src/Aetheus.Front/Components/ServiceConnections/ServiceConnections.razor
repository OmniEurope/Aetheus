@page "/service-connections"

<PageTitle>@L["ServiceConnections"] - Aetheus</PageTitle>

<OmniPageHeader Title="@L["ServiceConnections"]" Subtitle="@Breadcrumb.Subtitle()">
    <Icon><OmniIcon Name="@MaterialIconMap.Resolve("hub")" /></Icon>
    <Badges>
    </Badges>
    <Actions>
        @if (_canWrite)
        {
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@OpenCreateDialogAsync"><OmniIcon Name="OmniIconName.Add" /> <span>@L["Create"]</span></OmniButton>
        }
    </Actions>
    <Filters>
        <OmniTextBox aria-label="@L["Search"]" Placeholder="@L["Search"]" @bind-Value="_search" @bind-Value:after="ReloadGridAsync" Class="pipeline-list-search" />
    </Filters>
</OmniPageHeader>

<AetheusDataGrid @ref="_grid" TItem="ServiceConnectionDto" Data="@_items" Count="@_count" LoadData="@LoadData" ExportRead="@ReadExportAsync"
    PageSize="20" AllowSorting="true" IsLoading="@_loading" Density="OmniDensity.Compact" FullHeight="true"
    Virtualize="@AetheusGrid.RemoteVirtualization"
    VirtualData="@(() => new OmniDataGridResult<ServiceConnectionDto>(_items, _count))">
    <EmptyTemplate>
        <EmptyState Icon="hub" Title="@L["NoServiceConnections"]" Description="@L["NoServiceConnectionsDescription"]" />
    </EmptyTemplate>
    <Columns>
        <OmniDataGridColumn Frozen="true" TItem="ServiceConnectionDto" Property="Name" Title="@L["Name"]" MinWidth="10rem" Filterable="true" />
        <OmniDataGridColumn TItem="ServiceConnectionDto" Property="Type" Title="@L["Type"]" Width="150px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FormatFilterValue="@TypeText" >
            <Template Context="c">
                <OmniBadge Fill="OmniFill.Solid" Tone="OmniTone.Neutral">@TypeText(c.Type.ToString())</OmniBadge>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ServiceConnectionDto" Property="Url" Title="@L["Url"]" Filterable="true" >
            <Template Context="c">
                <span class="text-mono">@(string.IsNullOrEmpty(c.Url) ? "-" : c.Url)</span>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ServiceConnectionDto" Property="ProjectName" Title="@L["Project"]" Width="160px" Filterable="true" FilterType="OmniDataGridColumnFilterType.MultiSelect" FilterValues="@_filterValues.Projects" FilterSearchable="true" >
            <Template Context="c">@(c.ProjectName ?? "-")</Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ServiceConnectionDto" Title="@L["ConnectionStatus"]" Width="230px" Sortable="false" Filterable="false" >
            <Template Context="c">
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => TestAsync(c.Id))" Class="@((_testing.Contains(c.Id)) ? "btn-busy" : null)" Busy="@((_testing.Contains(c.Id)))" title="@L["TestConnection"]" Label="@L["TestConnection"]"><OmniIcon Name="OmniIconName.Broadcast" /></OmniButton>
                    @if (_testResults.TryGetValue(c.Id, out var result))
                    {
                        <OmniBadge Fill="OmniFill.Solid" Tone="@StatusBadge(result.Status)"
                            title="@result.Message">@L.Localize(result.Status)</OmniBadge>
                    }
                </OmniStack>
            </Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="ServiceConnectionDto" Title="@L["Actions"]" Width="120px" Sortable="false" TextAlign="OmniDataGridTextAlign.Center" Filterable="false" >
            <Template Context="c">
                @if (_canWrite)
                {
                    <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(() => OpenEditDialogAsync(c))" title="@L["Edit"]" Label="@L["Edit"]"><OmniIcon Name="OmniIconName.Edit" /></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(() => DeleteAsync(c))" title="@L["Delete"]" Label="@L["Delete"]"><OmniIcon Name="OmniIconName.Delete" /></OmniButton>
                }
            </Template>
        </OmniDataGridColumn>
    </Columns>
</AetheusDataGrid>
