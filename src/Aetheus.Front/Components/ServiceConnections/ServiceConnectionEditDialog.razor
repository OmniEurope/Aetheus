@inherits EntityEditDialogBase

@if (_loading)
{
    <AetheusLoader Size="OmniControlSize.Small" />
}
else
{
    <OmniTemplateForm TModel="EditModel" Model="@_model" OnValidSubmit="@SubmitAsync">
        <OmniDataAnnotationsValidator Localizer="@L" />
        <OmniRow Gap="OmniSpacing.Large">
            <OmniColumn Span="12" MediumSpan="6">
                <OmniFormField For="oe-pages-serviceconnections-serviceconnectioneditdialog-1" Class="omni-u-w-100"><LabelContent>@L["Name"]</LabelContent><ChildContent>
                    <OmniTextBox @bind-Value="_model.Name" Id="oe-pages-serviceconnections-serviceconnectioneditdialog-1" />
                </ChildContent></OmniFormField>
                <ValidationMessage For="@(() => _model.Name)" />
            </OmniColumn>
            <OmniColumn Span="12" MediumSpan="6">
                <OmniFormField Label="@L["Type"]" Class="omni-u-w-100" For="oe-formfield-pages-serviceconnections-serviceconnectioneditdialog-1">
                    <OmniDropDown Id="oe-formfield-pages-serviceconnections-serviceconnectioneditdialog-1" @bind-Value="_model.Type" Options="@_types"
                        Disabled="@IsEdit" />
                </OmniFormField>
            </OmniColumn>
            <OmniColumn Span="12">
                <OmniFormField For="oe-pages-serviceconnections-serviceconnectioneditdialog-3" Class="omni-u-w-100"><LabelContent>@L["Description"]</LabelContent><ChildContent>
                    <OmniTextBox @bind-Value="_model.Description" Id="oe-pages-serviceconnections-serviceconnectioneditdialog-3" />
                </ChildContent></OmniFormField>
            </OmniColumn>
            <OmniColumn Span="12">
                <OmniFormField For="oe-pages-serviceconnections-serviceconnectioneditdialog-4" Class="omni-u-w-100"><LabelContent>@L["Url"]</LabelContent><ChildContent>
                    <OmniTextBox @bind-Value="_model.Url" Placeholder="@L["PlaceholderServiceUrl"]" Id="oe-pages-serviceconnections-serviceconnectioneditdialog-4" />
                </ChildContent></OmniFormField>
            </OmniColumn>
            <OmniColumn Span="12">
                <OmniFormField For="oe-pages-serviceconnections-serviceconnectioneditdialog-5" Help="@L["ServiceConnectionCredentialsHint"]" Class="omni-u-w-100"><LabelContent>@L["Credentials"]</LabelContent><ChildContent>
                    <OmniTextArea @bind-Value="_model.ConfigurationJson" Rows="5" Class="text-mono" Id="oe-pages-serviceconnections-serviceconnectioneditdialog-5" />
                </ChildContent></OmniFormField>
                <ValidationMessage For="@(() => _model.ConfigurationJson)" />
            </OmniColumn>
        </OmniRow>
        <DialogFooter OnCancel="@Cancel">
            <OmniButton Variant="OmniButtonVariant.Primary" ButtonType="OmniButtonType.Submit" Class="@(_busy ? "btn-busy" : null)" Busy="@(_busy)"><Icon><OmniIcon Name="@MaterialIconMap.Resolve((IsEdit ? "save" : "add"))" /></Icon><ChildContent><span>@(IsEdit ? L["Save"] : L["Create"])</span></ChildContent></OmniButton>
        </DialogFooter>
    </OmniTemplateForm>
}
