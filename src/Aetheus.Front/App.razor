@using Aetheus.Front.Layout
@* Wrap pages and overlays in the same OE theme scope and overlay host (ADR-046) so appearance and
   notification behaviour remain consistent. The scope binds no appearance parameter: it follows OE's
   OmniAppearanceState, the signed-in user's preference (R1-66), and writes the snapshot omni-boot.js
   replays before Blazor starts. *@
<OmniThemeScope Id="@ThemeScopeId" SnapshotKey="@ThemeSnapshotKey">
    <OmniComponentsHost OverlayService="@Overlays" Notifications="@NotificationOptions">
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Aetheus.Front.Components.Shared.NotFound)">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
                <FocusOnNavigate RouteData="@routeData" Selector="h1, h2, h3, [data-focus-target]" />
            </Found>
        </Router>
    </OmniComponentsHost>
</OmniThemeScope>
