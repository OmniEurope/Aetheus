{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "staged-whitespace",
         "group": "pre-commit",
         "command": "pwsh",
         "args": [
            "-NoProfile",
            "-File",
            "scripts/check-staged-whitespace.ps1"
         ]
      },
      {
         "name": "build",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "build",
            "-c",
            "Release",
            "--warnaserror",
            "-p:HUSKY=0",
            "-m:1",
            "-v",
            "q"
         ]
      },
      {
         "name": "spdx-check",
         "group": "pre-commit",
         "command": "pwsh",
         "args": [
            "-NoProfile",
            "-Command",
            "& { $marker = 'SPDX-License-Identifier: EUPL-1.2'; $missing = 0; Get-ChildItem -Path src,tests -Include '*.cs','*.razor' -Recurse -File | Where-Object { $_.FullName -notmatch '[\\\\/](obj|bin|Migrations)[\\\\/]' } | ForEach-Object { $head = Get-Content $_.FullName -TotalCount 5 -ErrorAction SilentlyContinue; if (-not ($head -match [regex]::Escape($marker))) { Write-Host \"Missing SPDX: $($_.FullName)\"; $missing++ } }; if ($missing -gt 0) { Write-Error \"$missing file(s) missing SPDX header. Run: pwsh scripts/add-spdx-header.ps1\"; exit 1 } }"
         ]
      },
      {
         "name": "credential-ban",
         "group": "pre-commit",
         "command": "pwsh",
         "args": [
            "-NoProfile",
            "-Command",
            "& { $files = @('src/Aetheus.Back/appsettings.json', 'src/Aetheus.Back/appsettings.Development.json'); $bad = 0; foreach ($f in $files) { if (Test-Path $f) { $json = Get-Content $f -Raw; if ($json -match '\"(Password|Secret|Key|Token)\"\\s*:\\s*\"(?!\\s*\")[^\"]+\"') { Write-Host \"Credential detected in $f\"; $bad++ } } }; if ($bad -gt 0) { Write-Error 'Potential credentials in appsettings - remove before committing'; exit 1 } }"
         ]
      },
      {
         "name": "staged-secrets",
         "group": "pre-commit",
         "command": "pwsh",
         "args": [
            "-NoProfile",
            "-File",
            "scripts/check-staged-secrets.ps1"
         ]
      },
      {
         "name": "quality-precheck",
         "group": "pre-push",
         "command": "pwsh",
         "args": [
            "-NoProfile",
            "-File",
            "scripts/check-quality-before-push.ps1"
         ]
      },
      {
         "name": "test-backend",
         "group": "pre-push",
         "command": "dotnet",
         "args": [
            "test",
            "--project",
            "tests/Aetheus.Back.Tests/Aetheus.Back.Tests.csproj",
            "--no-progress"
         ]
      },
      {
         "name": "test-agent-core",
         "group": "pre-push",
         "command": "dotnet",
         "args": [
            "test",
            "--project",
            "tests/Aetheus.Agent.Core.Tests/Aetheus.Agent.Core.Tests.csproj",
            "--no-progress"
         ]
      },
      {
         "name": "test-front",
         "group": "pre-push",
         "command": "dotnet",
         "args": [
            "test",
            "--project",
            "tests/Aetheus.Front.Tests/Aetheus.Front.Tests.csproj",
            "--no-progress"
         ]
      },
      {
         "name": "test-analyzers",
         "group": "pre-push",
         "command": "dotnet",
         "args": [
            "test",
            "--project",
            "tests/Aetheus.Analyzers.Tests/Aetheus.Analyzers.Tests.csproj",
            "--no-progress"
         ]
      }
   ]
}
