#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# git exports the hooking repository to hook processes (GIT_DIR, and from a linked worktree the
# common directory too). Every git command the test suites spawn in their own temp repositories
# then silently targets THIS repository instead: on 2026-08-28 a pre-push run replaced the real
# index with a fixture tree; on 2026-09-17, run from a linked worktree after only four variables
# were unset, fixtures rewrote the real branches and force-pushed a fixture commit to origin main.
# Unset every repository-local variable git itself declares, not a hand-kept subset.
unset $(git rev-parse --local-env-vars)

# The full suite (`ylaunch -ta`: unit, integration and E2E) runs before the code can reach a
# shared branch (user decision 2026-11-10: a push leads to production, so everything is replayed
# first; this replaces the former "-ta green before a candidate" rule). Before that decision only
# the unit suites ran here; even they were added because commit ad1b1f15 pushed a broken
# architecture test to develop and nightly 1955 was the first thing to notice.
# The hook builds against the published OmniEurope.Blazor package, like CI (user decision
# 2026-11-10): the test-all task sets UseLocalOmniEurope=false, which MSBuild reads from the
# environment, so no build of the hook compiles the local OE sources (their shared obj folder made
# two concurrent runs collide). Daily ylaunch builds keep the local sources.
dotnet husky run --group pre-push
