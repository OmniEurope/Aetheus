# Version-control and agent bookkeeping never belong in an image build context.
.git
.claude
.codex
.agents
.vs

# Host/CI build outputs must not overwrite RID-specific assets restored inside Docker.
**/bin
**/obj
/artifacts
/TestResults
**/TestResults
/.pipeline-artifacts

# Local-only state and credentials.
/data
/logs
**/node_modules
*.user
*.suo
.env
.env.*
!.env.example

# Recette R1-1: local-only trees a developer checkout grows (worktrees, coverage and tool scratch,
# recette evidence). The pipeline's own context stays under 81 MB (CI #2641, #2647); the 8.59 GB once
# reported was not reproduced there, so these only keep a local build context small.
/.worktrees
/.cov-*
/.tmp-*
/.playwright-mcp
/docs/runbooks/recette-pieces-temporaires
