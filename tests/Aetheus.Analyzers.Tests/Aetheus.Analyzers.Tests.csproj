<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <!-- The analyzer testing harness has conservative transitive Roslyn dependencies.
         Keep explicit CodeAnalysis references here so central package management aligns
         the harness with the solution-wide Roslyn toolchain declared in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    <!-- Direct ref keeps the patched release ahead of the vulnerable transitive one (Analyzer.Testing). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzer csproj sets IncludeBuildOutput=false / IsRoslynComponent; reference it as an
         analyzer AND keep the output assembly so the tests can use the analyzer types directly. -->
    <ProjectReference Include="..\..\src\Aetheus.Analyzers\Aetheus.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
