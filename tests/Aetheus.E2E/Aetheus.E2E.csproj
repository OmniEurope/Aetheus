<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- QA executes CI outputs in an isolated container whose NuGet cache path differs from the build agent.
         Keep test discovery independent from Microsoft.NET.Test.Sdk's generated package-path import. -->
    <IsTestProject>true</IsTestProject>
    <!-- Two runners, on purpose. In the repository, global.json puts `dotnet test` in
         Microsoft.Testing.Platform mode, which refuses any project that is not on it: the NUnit runner
         does that. The browser image (Dockerfile.e2e) carries no global.json and is driven with the
         VSTest arguments of the run-qa-e2e-suite function and of the agent's production smoke step, and that
         agent is the one already installed on the host when a release reaches it: Microsoft.NET.Test.Sdk
         keeps that invocation working. Both are set here and not only in tests/Directory.Build.props,
         because the image receives the root Directory.Build.props and this project, not the tests/
         directory files.
         The NUnit runner is only switched on where global.json is: once it is, the project is a
         Microsoft.Testing.Platform application, and on a .NET 10 SDK that platform's MSBuild targets
         refuse the VSTest target outright ("Testing with VSTest target is no longer supported"). -->
    <EnableNUnitRunner Condition="Exists('$(MSBuildThisFileDirectory)../../global.json')">true</EnableNUnitRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.NUnit" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aetheus.WebAnalytics\Aetheus.WebAnalytics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>

  <!-- Recette R-30 (PageRulesTests). The baseline of the presentation-rule violations is checked in and embedded, so the
       QA container, which runs the pre-built outputs without the sources, reads the same file as a developer. -->
  <ItemGroup>
    <EmbeddedResource Include="PageRules\page-rules-baseline.txt" LogicalName="page-rules-baseline.txt" />
  </ItemGroup>

  <!-- The @page directives of Aetheus.Front, captured at build time and embedded, so that PageInventory cannot drift from
       the routes the front really has without a test failing, and without the QA container needing the sources. -->
  <UsingTask TaskName="CaptureRazorPageDirectives" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDirectory ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var directive = new Regex("^@page\\s+\"[^\"]+\"\\s*$", RegexOptions.Multiline);
        var separator = Path.DirectorySeparatorChar;
        var lines = Directory.EnumerateFiles(SourceDirectory, "*.razor", SearchOption.AllDirectories)
            .Where(file => !file.Contains(separator + "obj" + separator) && !file.Contains(separator + "bin" + separator))
            .OrderBy(file => file, StringComparer.Ordinal)
            .SelectMany(file => directive.Matches(File.ReadAllText(file)).Cast<Match>().Select(match => match.Value.Trim()))
            .ToArray();
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || !File.ReadAllLines(OutputFile).SequenceEqual(lines))
            File.WriteAllLines(OutputFile, lines);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CaptureFrontPageDirectives" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <FrontPageDirectivesFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'front-page-directives.txt'))</FrontPageDirectivesFile>
    </PropertyGroup>
    <CaptureRazorPageDirectives SourceDirectory="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'src', 'Aetheus.Front'))"
                                OutputFile="$(FrontPageDirectivesFile)" />
    <ItemGroup>
      <EmbeddedResource Include="$(FrontPageDirectivesFile)" LogicalName="front-page-directives.txt" />
    </ItemGroup>
  </Target>

</Project>
