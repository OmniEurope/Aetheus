<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- xunit.v3 ships Xunit.TestResult, which collides with the domain entity under the global
         `using Xunit`. Alias the unqualified name back to the entity (no test uses Xunit.TestResult). -->
    <Using Include="Aetheus.Back.Data.Entities.TestResult" Alias="TestResult" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aetheus.Back\Aetheus.Back.csproj" />
    <ProjectReference Include="..\..\src\Aetheus.Agent.Core\Aetheus.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\agent-protocol\*.json"
             Link="fixtures\agent-protocol\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests that only exist on one OS: see tests/Shared/PlatformSpecificTests.cs. -->
    <Compile Include="..\Shared\PlatformSpecificTests.cs" Link="Shared\PlatformSpecificTests.cs" />
    <!-- Exercises the real SARIF parser with output written by the accessibility suite. -->
    <Compile Include="..\Aetheus.E2E\AccessibilitySarif.cs" Link="Shared\AccessibilitySarif.cs" />
  </ItemGroup>

</Project>
