      "name": "nightly-evidence-test",
      "description": "nightly-evidence.test.mjs: deterministic evidence, then altered bytes and another source refused.",
      "files": {
        "a.bin": "first",
        "b.bin": "second"
      },
      "steps": [
        {
          "arguments": [
            "create",
            "0123456789abcdef0123456789abcdef01234567",
            "evidence.json",
            "b.bin",
            "a.bin"
          ],
          "stdout": "Created independent nightly evidence for 0123456789abcdef0123456789abcdef01234567.\n",
          "evidence": "{\n  \"schema\": 1,\n  \"kind\": \"nightly-demo-payload\",\n  \"sourceSha\": \"0123456789abcdef0123456789abcdef01234567\",\n  \"artifacts\": [\n    {\n      \"name\": \"a.bin\",\n      \"bytes\": 5,\n      \"sha256\": \"a7937b64b8caa58f03721bb6bacf5c78cb235febe0e70b1b84cd99541461a08e\"\n    },\n    {\n      \"name\": \"b.bin\",\n      \"bytes\": 6,\n      \"sha256\": \"16367aacb67a4a017c8da8ab95682ccb390863780f7114dda0a0e0c55644c7c4\"\n    }\n  ]\n}\n"
        },
        {
          "arguments": [
            "verify",
            "0123456789abcdef0123456789abcdef01234567",
            "evidence.json",
            "a.bin",
            "b.bin"
          ],
          "stdout": "Verified independent nightly evidence for 0123456789abcdef0123456789abcdef01234567.\n"
        },
        {
          "write": {
            "a.bin": "altered"
          }
        },
        {
          "arguments": [
            "verify",
            "0123456789abcdef0123456789abcdef01234567",
            "evidence.json",
            "a.bin",
            "b.bin"
          ],
          "error": {
            "name": "Error",
            "message": "The nightly payload differs from its independent evidence."
          },
          "stdout": ""
        },
        {
          "arguments": [
            "verify",
